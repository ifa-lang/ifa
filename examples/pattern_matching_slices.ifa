// Exemples d'utilisation des motifs de tranches et tableaux (slice patterns) en langage IFA.
// Illustre la déstructuration d'arités fixes et dynamiques avec le motif de reste (rest pattern).

fn inspect_slice(arr: [i64; 3]) -> i64 {
    return match arr {
        [0, 0, 0] => 0,
        [first, 2, third] => first * 10 + third,
        [x, y, z] => x + y + z,
    };
}

fn inspect_with_rest(arr: [i64; 4]) -> i64 {
    return match arr {
        [0, ..mid, 0] => 100,
        [first, ..mid, last] => first * 100 + last,
    };
}

fn inspect_prefix_suffix(arr: [i64; 5]) -> i64 {
    return match arr {
        [1, 2, ..mid, 9] => 42,
        [first, 0, .., last] => first + last,
        [..] => 0,
    };
}

pub fn main() -> i64 {
    let t1 = inspect_slice([0, 0, 0]);
    let t2 = inspect_slice([3, 2, 5]);
    let t3 = inspect_slice([10, 20, 30]);

    let r1 = inspect_with_rest([0, 4, 8, 0]);
    let r2 = inspect_with_rest([5, 1, 2, 9]);

    let p1 = inspect_prefix_suffix([1, 2, 7, 8, 9]);
    let p2 = inspect_prefix_suffix([10, 0, 30, 40, 50]);
    let p3 = inspect_prefix_suffix([10, 99, 30, 40, 50]);

    // Validation globale des calculs :
    // t1: 0, t2: 35, t3: 60 (somme: 95)
    // r1: 100, r2: 509 (somme: 609)
    // p1: 42, p2: 60, p3: 0 (somme: 102)
    // Total = 95 + 609 + 102 = 806
    return (t1 + t2 + t3) + (r1 + r2) + (p1 + p2 + p3);
}
