// Exemple idiomatique IFA : Interpolation de chaînes de caractères,
// concaténation d'expressions et formatage typé à l'exécution et au comptime.

struct TransactionEvent {
    id: String,
    amount_xof: i64,
    success: bool
}

struct CurrencyInfo {
    code: String,
    symbol: String
}

impl CurrencyInfo {
    pub fn to_string(c: CurrencyInfo) -> String {
        return c.code + " (" + c.symbol + ")";
    }
}

comptime fn generate_header(service: String, version: i64) -> String {
    return "{service} v{version} - Initialized";
}

pub fn main() -> i64 {
    // 1. Interpolation basique de variables locales
    let user = "SystemOperator";
    let node_id: i64 = 7;
    let greeting = "Bienvenue {user} sur le nœud {node_id}";

    // 2. Interpolation avec expressions arithmétiques
    let latency_ms: i64 = 12;
    let threshold_ms: i64 = 50;
    let metric_msg = "Latence : {latency_ms * 2} ms (seuil : {threshold_ms} ms)";

    // 3. Interpolation avec champs de structure
    let tx = TransactionEvent(
        id: "TX-44019",
        amount_xof: 125000,
        success: true
    );
    let audit_log = "Transaction {tx.id} - Montant : {tx.amount_xof} XOF (succès : {tx.success})";

    // 4. Interpolation directe de structure via la méthode to_string / Display
    let dev = CurrencyInfo(code: "XOF", symbol: "CFA");
    let dev_msg = "Devise opérationnelle : {dev}";

    // 5. Échappement des accolades avec doubles accolades {{ et }}
    let config_json = "Format {{'tx_id': {tx.id}, 'valid': {tx.success}}}";

    // 6. Concaténation de chaînes avec l'opérateur + et fusion de constantes statiques
    let prefix = "Statut : ";
    let status_line = prefix + audit_log;
    let folded_banner = "Serveur : " + "IFA-Cluster-Alpha" + " (En ligne)";

    // 7. Évaluation au comptime
    let header = comptime generate_header("IFA-Gateway", 1);

    if tx.success && node_id == 7 {
        return 42;
    }
    return 0;
}
