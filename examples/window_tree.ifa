struct WindowNode {
    id: String,
    title: String,
    parent: ?ref WindowNode,
    children: List<WindowNode>
}

fn attach_child(inout parent: WindowNode, mut child: WindowNode) {
    child.parent = ref parent;
    parent.children.push(child);
}

pub fn main() {
    mut root = WindowNode(id: "root", title: "Desktop Manager", parent: None, children: List::new());
    let term = WindowNode(id: "win-1", title: "Terminal Shell", parent: None, children: List::new());
    let browser = WindowNode(id: "win-2", title: "Web Navigator", parent: None, children: List::new());

    attach_child(inout root, term);
    attach_child(inout root, browser);

    println("Tree initialized with root:", root.title);
    println("Root children count:", root.children.len());
}
