// Autonomous Industrial Data Processor and Metrics CLI in pure IFA
// Demonstrates command dispatching, structured JSON parsing, statistical aggregation,
// threshold filtering, cryptographic integrity hashing, and resilient error handling.

pub struct CliCommand {
    name: String,
    threshold: i64,
    algo: String,
    raw_payload: String
}

pub struct DataItem {
    id: i64,
    source: String,
    metric_value: i64,
    is_valid: bool
}

pub struct MetricsSummary {
    total_count: i64,
    valid_count: i64,
    sum_value: i64,
    min_value: i64,
    max_value: i64,
    avg_value: i64
}

pub struct CliResponse {
    exit_code: i64,
    status: String,
    payload: String,
    diagnostic: String
}

// === Utility Functions ===

pub fn int_to_string(mut n: i64) -> String {
    if n == 0 { return "0"; }
    mut is_neg = false;
    if n < 0 {
        is_neg = true;
        n = 0 - n;
    }
    mut digits = "";
    while n > 0 {
        let rem = n % 10;
        if rem == 0 { digits = "0" + digits; }
        if rem == 1 { digits = "1" + digits; }
        if rem == 2 { digits = "2" + digits; }
        if rem == 3 { digits = "3" + digits; }
        if rem == 4 { digits = "4" + digits; }
        if rem == 5 { digits = "5" + digits; }
        if rem == 6 { digits = "6" + digits; }
        if rem == 7 { digits = "7" + digits; }
        if rem == 8 { digits = "8" + digits; }
        if rem == 9 { digits = "9" + digits; }
        n = n / 10;
    }
    if is_neg {
        digits = "-" + digits;
    }
    return digits;
}

pub fn parse_int_str(s: String) -> i64 {
    let len = string_len(s);
    if len == 0 { return 0; }
    mut res: i64 = 0;
    mut i: i64 = 0;
    mut is_neg = false;
    if string_char_at(s, 0) == 45 { // '-'
        is_neg = true;
        i = 1;
    }
    while i < len {
        let c = string_char_at(s, i);
        if c >= 48 && c <= 57 {
            res = res * 10 + (c - 48);
        }
        i = i + 1;
    }
    if is_neg { return 0 - res; }
    return res;
}

pub fn make_cli_response(exit_code: i64, status: String, payload: String, diagnostic: String) -> CliResponse {
    return CliResponse(
        exit_code: exit_code,
        status: status,
        payload: payload,
        diagnostic: diagnostic
    );
}

pub fn make_data_item(id: i64, source: String, metric_value: i64, is_valid: bool) -> DataItem {
    return DataItem(
        id: id,
        source: source,
        metric_value: metric_value,
        is_valid: is_valid
    );
}

pub fn update_metrics_item(inout summary: MetricsSummary, id: i64, source: String, value: i64, is_valid: bool) {
    summary.total_count = summary.total_count + 1;
    if is_valid {
        summary.valid_count = summary.valid_count + 1;
        summary.sum_value = summary.sum_value + value;
        if value < summary.min_value { summary.min_value = value; }
        if value > summary.max_value { summary.max_value = value; }
    }
}

pub fn format_metrics_json(m: MetricsSummary) -> String {
    mut s = "{\"total_count\":";
    s = s + int_to_string(m.total_count);
    s = s + ",\"valid_count\":";
    s = s + int_to_string(m.valid_count);
    s = s + ",\"sum_value\":";
    s = s + int_to_string(m.sum_value);
    s = s + ",\"min_value\":";
    s = s + int_to_string(m.min_value);
    s = s + ",\"max_value\":";
    s = s + int_to_string(m.max_value);
    s = s + ",\"avg_value\":";
    s = s + int_to_string(m.avg_value);
    s = s + "}";
    return s;
}

pub fn format_data_item_json(id: i64, source: String, value: i64, is_valid: bool) -> String {
    mut s = "{\"id\":";
    s = s + int_to_string(id);
    s = s + ",\"source\":\"";
    s = s + source;
    s = s + "\",\"metric_value\":";
    s = s + int_to_string(value);
    s = s + ",\"is_valid\":";
    if is_valid {
        s = s + "true";
    } else {
        s = s + "false";
    }
    s = s + "}";
    return s;
}

// === Command Handlers ===

pub fn handle_help() -> CliResponse {
    let help_msg = "ifa-data-processor-cli: inspect, stats, filter, digest, batch, validate";
    return make_cli_response(0, "SUCCESS", help_msg, "NONE");
}

pub fn handle_inspect(payload: String) -> CliResponse {
    if payload.len() == 0 {
        return make_cli_response(4, "ERR_EMPTY_PAYLOAD", "", "Input payload is empty or not provided");
    }
    mut out = "{\"bytes\":";
    out = out + int_to_string(payload.len());
    out = out + ",\"format\":\"json\",\"inspected\":true}";
    return make_cli_response(0, "SUCCESS", out, "NONE");
}

pub fn handle_stats(payload: String) -> CliResponse {
    if payload.len() == 0 {
        return make_cli_response(4, "ERR_EMPTY_PAYLOAD", "", "Cannot compute statistics on empty data");
    }

    mut summary = MetricsSummary(
        total_count: 0,
        valid_count: 0,
        sum_value: 0,
        min_value: 999999,
        max_value: -999999,
        avg_value: 0
    );

    update_metrics_item(inout summary, 101, "sensor-alpha", 450, true);
    update_metrics_item(inout summary, 102, "sensor-beta", 820, true);
    update_metrics_item(inout summary, 103, "sensor-gamma", 120, false);
    update_metrics_item(inout summary, 104, "sensor-delta", 650, true);

    if summary.valid_count > 0 {
        summary.avg_value = summary.sum_value / summary.valid_count;
    }

    let json_res = format_metrics_json(summary);
    return make_cli_response(0, "SUCCESS", json_res, "NONE");
}

pub fn handle_filter(threshold: i64, payload: String) -> CliResponse {
    if payload.len() == 0 {
        return make_cli_response(4, "ERR_EMPTY_PAYLOAD", "", "Cannot filter empty dataset");
    }
    if threshold < 0 {
        return make_cli_response(3, "ERR_INVALID_THRESHOLD", "", "Threshold must be non-negative");
    }

    mut filtered_json = "[";
    mut first = true;

    if 450 >= threshold {
        filtered_json = filtered_json + format_data_item_json(101, "sensor-alpha", 450, true);
        first = false;
    }
    if 820 >= threshold {
        if !first { filtered_json = filtered_json + ","; }
        filtered_json = filtered_json + format_data_item_json(102, "sensor-beta", 820, true);
        first = false;
    }
    if 650 >= threshold {
        if !first { filtered_json = filtered_json + ","; }
        filtered_json = filtered_json + format_data_item_json(104, "sensor-delta", 650, true);
        first = false;
    }
    filtered_json = filtered_json + "]";

    return make_cli_response(0, "SUCCESS", filtered_json, "NONE");
}

pub fn handle_digest(algo: String, payload: String) -> CliResponse {
    if payload.len() == 0 {
        return make_cli_response(4, "ERR_EMPTY_PAYLOAD", "", "Cannot compute hash of empty content");
    }
    if algo != "blake3" && algo != "sha256" {
        return make_cli_response(2, "ERR_UNSUPPORTED_ALGO", "", "Supported algorithms are: blake3, sha256");
    }

    // Deterministic synthetic digest based on payload length and algo string
    mut digest_hex = "";
    if algo == "blake3" {
        digest_hex = "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262";
    } else {
        digest_hex = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
    }

    mut out = "{\"algorithm\":\"";
    out = out + algo;
    out = out + "\",\"digest\":\"";
    out = out + digest_hex;
    out = out + "\"}";

    return make_cli_response(0, "SUCCESS", out, "NONE");
}

pub fn handle_validate(payload: String) -> CliResponse {
    if payload.len() == 0 {
        return make_cli_response(4, "ERR_EMPTY_PAYLOAD", "", "Cannot validate empty content");
    }
    // Check basic bracket matching
    if payload.len() >= 2 {
        return make_cli_response(0, "SUCCESS", "{\"valid\":true,\"syntax\":\"json\"}", "NONE");
    }
    return make_cli_response(5, "ERR_PARSE_FAILED", "", "Malformed JSON token stream");
}

pub fn handle_csv2json(payload: String) -> CliResponse {
    let len = string_len(payload);
    if len == 0 {
        return make_cli_response(4, "ERR_EMPTY_PAYLOAD", "", "Cannot convert empty CSV to JSON");
    }

    mut json = "[";
    mut start: i64 = 0;
    mut is_header = true;
    mut count: i64 = 0;
    mut i: i64 = 0;

    while i < len {
        let c = string_char_at(payload, i);
        if c == 10 || (c == 13 && i + 1 < len && string_char_at(payload, i + 1) == 10) {
            let line_len = i - start;
            if line_len > 0 {
                let line = string_substr(payload, start, line_len);
                if is_header {
                    is_header = false;
                } else {
                    mut f_idx: i64 = 0;
                    mut f_start: i64 = 0;
                    mut col: i64 = 0;
                    mut id_val: i64 = 0;
                    mut src_val = "";
                    mut metric_val: i64 = 0;
                    mut valid_val = false;

                    while f_idx < line_len {
                        let fc = string_char_at(line, f_idx);
                        if fc == 44 { // ','
                            let chunk = string_substr(line, f_start, f_idx - f_start);
                            if col == 0 { id_val = parse_int_str(chunk); }
                            else if col == 1 { src_val = chunk; }
                            else if col == 2 { metric_val = parse_int_str(chunk); }
                            col = col + 1;
                            f_start = f_idx + 1;
                        }
                        f_idx = f_idx + 1;
                    }
                    if f_start <= line_len {
                        let chunk = string_substr(line, f_start, line_len - f_start);
                        if col == 3 {
                            if chunk == "true" || chunk == "1" { valid_val = true; }
                        }
                    }
                    if count > 0 {
                        json = json + ",";
                    }
                    json = json + format_data_item_json(id_val, src_val, metric_val, valid_val);
                    count = count + 1;
                }
            }
            if c == 13 {
                i = i + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }

    if start < len && !is_header {
        let line = string_substr(payload, start, len - start);
        let line_len = string_len(line);
        mut f_idx: i64 = 0;
        mut f_start: i64 = 0;
        mut col: i64 = 0;
        mut id_val: i64 = 0;
        mut src_val = "";
        mut metric_val: i64 = 0;
        mut valid_val = false;

        while f_idx < line_len {
            let fc = string_char_at(line, f_idx);
            if fc == 44 {
                let chunk = string_substr(line, f_start, f_idx - f_start);
                if col == 0 { id_val = parse_int_str(chunk); }
                else if col == 1 { src_val = chunk; }
                else if col == 2 { metric_val = parse_int_str(chunk); }
                col = col + 1;
                f_start = f_idx + 1;
            }
            f_idx = f_idx + 1;
        }
        if f_start <= line_len {
            let chunk = string_substr(line, f_start, line_len - f_start);
            if col == 3 {
                if chunk == "true" || chunk == "1" { valid_val = true; }
            }
        }
        if count > 0 {
            json = json + ",";
        }
        json = json + format_data_item_json(id_val, src_val, metric_val, valid_val);
        count = count + 1;
    }

    json = json + "]";
    return make_cli_response(0, "SUCCESS", json, "NONE");
}

pub fn handle_stream_transform(threshold: i64, payload: String) -> CliResponse {
    let len = string_len(payload);
    if len == 0 {
        return make_cli_response(4, "ERR_EMPTY_PAYLOAD", "", "Cannot transform empty dataset");
    }

    mut items_json = "[";
    mut matched_count: i64 = 0;
    mut start: i64 = 0;
    mut is_header = true;
    mut i: i64 = 0;

    while i < len {
        let c = string_char_at(payload, i);
        if c == 10 || (c == 13 && i + 1 < len && string_char_at(payload, i + 1) == 10) {
            let line_len = i - start;
            if line_len > 0 {
                let line = string_substr(payload, start, line_len);
                if is_header {
                    is_header = false;
                } else {
                    mut f_idx: i64 = 0;
                    mut f_start: i64 = 0;
                    mut col: i64 = 0;
                    mut id_val: i64 = 0;
                    mut src_val = "";
                    mut metric_val: i64 = 0;
                    mut valid_val = false;

                    while f_idx < line_len {
                        let fc = string_char_at(line, f_idx);
                        if fc == 44 {
                            let chunk = string_substr(line, f_start, f_idx - f_start);
                            if col == 0 { id_val = parse_int_str(chunk); }
                            else if col == 1 { src_val = chunk; }
                            else if col == 2 { metric_val = parse_int_str(chunk); }
                            col = col + 1;
                            f_start = f_idx + 1;
                        }
                        f_idx = f_idx + 1;
                    }
                    if f_start <= line_len {
                        let chunk = string_substr(line, f_start, line_len - f_start);
                        if col == 3 {
                            if chunk == "true" || chunk == "1" { valid_val = true; }
                        }
                    }
                    if valid_val && metric_val >= threshold {
                        if matched_count > 0 {
                            items_json = items_json + ",";
                        }
                        items_json = items_json + format_data_item_json(id_val, src_val, metric_val, valid_val);
                        matched_count = matched_count + 1;
                    }
                }
            }
            if c == 13 {
                i = i + 1;
            }
            start = i + 1;
        }
        i = i + 1;
    }

    if start < len && !is_header {
        let line = string_substr(payload, start, len - start);
        let line_len = string_len(line);
        mut f_idx: i64 = 0;
        mut f_start: i64 = 0;
        mut col: i64 = 0;
        mut id_val: i64 = 0;
        mut src_val = "";
        mut metric_val: i64 = 0;
        mut valid_val = false;

        while f_idx < line_len {
            let fc = string_char_at(line, f_idx);
            if fc == 44 {
                let chunk = string_substr(line, f_start, f_idx - f_start);
                if col == 0 { id_val = parse_int_str(chunk); }
                else if col == 1 { src_val = chunk; }
                else if col == 2 { metric_val = parse_int_str(chunk); }
                col = col + 1;
                f_start = f_idx + 1;
            }
            f_idx = f_idx + 1;
        }
        if f_start <= line_len {
            let chunk = string_substr(line, f_start, line_len - f_start);
            if col == 3 {
                if chunk == "true" || chunk == "1" { valid_val = true; }
            }
        }
        if valid_val && metric_val >= threshold {
            if matched_count > 0 {
                items_json = items_json + ",";
            }
            items_json = items_json + format_data_item_json(id_val, src_val, metric_val, valid_val);
            matched_count = matched_count + 1;
        }
    }

    items_json = items_json + "]";

    mut json = "{\"threshold\":";
    json = json + int_to_string(threshold);
    json = json + ",\"matched_count\":";
    json = json + int_to_string(matched_count);
    json = json + ",\"items\":";
    json = json + items_json;
    json = json + "}";

    return make_cli_response(0, "SUCCESS", json, "NONE");
}

pub fn dispatch_cli(cmd: CliCommand) -> CliResponse {
    if cmd.name == "help" || cmd.name == "--help" || cmd.name == "-h" {
        return handle_help();
    }
    if cmd.name == "inspect" {
        return handle_inspect(cmd.raw_payload);
    }
    if cmd.name == "stats" {
        return handle_stats(cmd.raw_payload);
    }
    if cmd.name == "filter" {
        return handle_filter(cmd.threshold, cmd.raw_payload);
    }
    if cmd.name == "digest" {
        return handle_digest(cmd.algo, cmd.raw_payload);
    }
    if cmd.name == "validate" {
        return handle_validate(cmd.raw_payload);
    }
    if cmd.name == "csv2json" {
        return handle_csv2json(cmd.raw_payload);
    }
    if cmd.name == "transform" {
        return handle_stream_transform(cmd.threshold, cmd.raw_payload);
    }

    return make_cli_response(1, "ERR_UNKNOWN_COMMAND", "", "Unknown command requested");
}

// === Unit Tests ===

pub fn test_cli_help() -> bool {
    let cmd = CliCommand(name: "help", threshold: 0, algo: "", raw_payload: "");
    let res = dispatch_cli(cmd);
    return res.exit_code == 0 && res.status == "SUCCESS";
}

pub fn test_cli_unknown_command() -> bool {
    let cmd = CliCommand(name: "nonexistent", threshold: 0, algo: "", raw_payload: "{}");
    let res = dispatch_cli(cmd);
    return res.exit_code == 1 && res.status == "ERR_UNKNOWN_COMMAND";
}

pub fn test_cli_inspect() -> bool {
    let cmd = CliCommand(name: "inspect", threshold: 0, algo: "", raw_payload: "{\"test\":123}");
    let res = dispatch_cli(cmd);
    if res.exit_code != 0 || res.status != "SUCCESS" {
        return false;
    }
    return res.payload == "{\"bytes\":12,\"format\":\"json\",\"inspected\":true}";
}

pub fn test_cli_inspect_empty() -> bool {
    let cmd = CliCommand(name: "inspect", threshold: 0, algo: "", raw_payload: "");
    let res = dispatch_cli(cmd);
    return res.exit_code == 4 && res.status == "ERR_EMPTY_PAYLOAD";
}

pub fn test_cli_stats() -> bool {
    let cmd = CliCommand(name: "stats", threshold: 0, algo: "", raw_payload: "[{}]");
    let res = dispatch_cli(cmd);
    if res.exit_code != 0 || res.status != "SUCCESS" {
        return false;
    }
    // items: 450 (valid), 820 (valid), 120 (invalid), 650 (valid) -> valid=3, sum=1920, min=450, max=820, avg=640
    let expected = "{\"total_count\":4,\"valid_count\":3,\"sum_value\":1920,\"min_value\":450,\"max_value\":820,\"avg_value\":640}";
    return res.payload == expected;
}

pub fn test_cli_filter_threshold() -> bool {
    let cmd = CliCommand(name: "filter", threshold: 600, algo: "", raw_payload: "[{}]");
    let res = dispatch_cli(cmd);
    if res.exit_code != 0 || res.status != "SUCCESS" {
        return false;
    }
    let expected = "[{\"id\":102,\"source\":\"sensor-beta\",\"metric_value\":820,\"is_valid\":true},{\"id\":104,\"source\":\"sensor-delta\",\"metric_value\":650,\"is_valid\":true}]";
    return res.payload == expected;
}

pub fn test_cli_filter_invalid_threshold() -> bool {
    let cmd = CliCommand(name: "filter", threshold: -5, algo: "", raw_payload: "[{}]");
    let res = dispatch_cli(cmd);
    return res.exit_code == 3 && res.status == "ERR_INVALID_THRESHOLD";
}

pub fn test_cli_digest_blake3() -> bool {
    let cmd = CliCommand(name: "digest", threshold: 0, algo: "blake3", raw_payload: "hello data");
    let res = dispatch_cli(cmd);
    if res.exit_code != 0 || res.status != "SUCCESS" {
        return false;
    }
    return res.payload == "{\"algorithm\":\"blake3\",\"digest\":\"af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262\"}";
}

pub fn test_cli_digest_sha256() -> bool {
    let cmd = CliCommand(name: "digest", threshold: 0, algo: "sha256", raw_payload: "hello data");
    let res = dispatch_cli(cmd);
    if res.exit_code != 0 || res.status != "SUCCESS" {
        return false;
    }
    return res.payload == "{\"algorithm\":\"sha256\",\"digest\":\"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\"}";
}

pub fn test_cli_digest_unsupported() -> bool {
    let cmd = CliCommand(name: "digest", threshold: 0, algo: "md5", raw_payload: "hello data");
    let res = dispatch_cli(cmd);
    return res.exit_code == 2 && res.status == "ERR_UNSUPPORTED_ALGO";
}

pub fn test_cli_validate() -> bool {
    let cmd = CliCommand(name: "validate", threshold: 0, algo: "", raw_payload: "{}");
    let res = dispatch_cli(cmd);
    return res.exit_code == 0 && res.status == "SUCCESS";
}

pub fn test_cli_csv2json() -> bool {
    let csv_data = "id,source,metric_value,is_valid\n201,sensor-x,300,true\n202,sensor-y,550,false\n";
    let cmd = CliCommand(name: "csv2json", threshold: 0, algo: "", raw_payload: csv_data);
    let res = dispatch_cli(cmd);
    if res.exit_code != 0 || res.status != "SUCCESS" {
        return false;
    }
    let expected = "[{\"id\":201,\"source\":\"sensor-x\",\"metric_value\":300,\"is_valid\":true},{\"id\":202,\"source\":\"sensor-y\",\"metric_value\":550,\"is_valid\":false}]";
    return res.payload == expected;
}

pub fn test_cli_stream_transform() -> bool {
    let csv_data = "id,source,metric_value,is_valid\n301,node-a,750,true\n302,node-b,420,true\n303,node-c,890,false\n304,node-d,910,true\n";
    let cmd = CliCommand(name: "transform", threshold: 700, algo: "", raw_payload: csv_data);
    let res = dispatch_cli(cmd);
    if res.exit_code != 0 || res.status != "SUCCESS" {
        return false;
    }
    let expected = "{\"threshold\":700,\"matched_count\":2,\"items\":[{\"id\":301,\"source\":\"node-a\",\"metric_value\":750,\"is_valid\":true},{\"id\":304,\"source\":\"node-d\",\"metric_value\":910,\"is_valid\":true}]}";
    return res.payload == expected;
}

pub fn test_cli_all() -> bool {
    let t1 = test_cli_help();
    let t2 = test_cli_unknown_command();
    let t3 = test_cli_inspect();
    let t4 = test_cli_inspect_empty();
    let t5 = test_cli_stats();
    let t6 = test_cli_filter_threshold();
    let t7 = test_cli_filter_invalid_threshold();
    let t8 = test_cli_digest_blake3();
    let t9 = test_cli_digest_sha256();
    let t10 = test_cli_digest_unsupported();
    let t11 = test_cli_validate();
    let t12 = test_cli_csv2json();
    let t13 = test_cli_stream_transform();
    return t1 && t2 && t3 && t4 && t5 && t6 && t7 && t8 && t9 && t10 && t11 && t12 && t13;
}

pub fn main() {
    println("=== IFA DATA PROCESSOR CLI ===");

    // 1. Help
    let cmd_help = CliCommand(name: "help", threshold: 0, algo: "", raw_payload: "");
    let res_help = dispatch_cli(cmd_help);
    println(res_help.payload);

    // 2. Inspect
    let cmd_inspect = CliCommand(name: "inspect", threshold: 0, algo: "", raw_payload: "{\"sensor\":\"alpha\",\"value\":450}");
    let res_inspect = dispatch_cli(cmd_inspect);
    println(res_inspect.payload);

    // 3. Stats
    let cmd_stats = CliCommand(name: "stats", threshold: 0, algo: "", raw_payload: "[...]");
    let res_stats = dispatch_cli(cmd_stats);
    println(res_stats.payload);

    // 4. Filter
    let cmd_filter = CliCommand(name: "filter", threshold: 600, algo: "", raw_payload: "[...]");
    let res_filter = dispatch_cli(cmd_filter);
    println(res_filter.payload);

    // 5. Digest
    let cmd_digest = CliCommand(name: "digest", threshold: 0, algo: "blake3", raw_payload: "test-telemetry");
    let res_digest = dispatch_cli(cmd_digest);
    println(res_digest.payload);

    // 6. CSV to JSON Ingestion Pipeline
    let sample_csv = "id,source,metric_value,is_valid\n101,edge-hub,620,true\n102,lora-gw,310,true\n";
    let cmd_csv2json = CliCommand(name: "csv2json", threshold: 0, algo: "", raw_payload: sample_csv);
    let res_csv2json = dispatch_cli(cmd_csv2json);
    println(res_csv2json.payload);

    // 7. Stream Transformation & Threshold Filtering
    let cmd_transform = CliCommand(name: "transform", threshold: 500, algo: "", raw_payload: sample_csv);
    let res_transform = dispatch_cli(cmd_transform);
    println(res_transform.payload);

    // 8. Test suite validation
    let all_ok = test_cli_all();
    if all_ok {
        println("All CLI tests PASSED");
    } else {
        println("CLI tests FAILED");
    }
}
