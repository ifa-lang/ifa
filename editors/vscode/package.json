{
  "name": "ifa-language-support",
  "displayName": "IFA Programming Language",
  "description": "Language support, syntax highlighting, and LSP integration for IFA",
  "version": "0.1.0",
  "publisher": "ifa-lang",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ifa",
        "aliases": ["IFA", "ifa"],
        "extensions": [".ifa"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ifa",
        "scopeName": "source.ifa",
        "path": "./syntaxes/ifa.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "ifa",
        "scopes": {
          "keyword": ["keyword.control.ifa"],
          "type": ["entity.name.type.ifa"],
          "struct": ["entity.name.type.struct.ifa"],
          "enum": ["entity.name.type.enum.ifa"],
          "function": ["entity.name.function.ifa"],
          "method": ["entity.name.function.method.ifa"],
          "parameter": ["variable.parameter.ifa"],
          "variable": ["variable.other.ifa"],
          "property": ["variable.other.property.ifa"],
          "string": ["string.quoted.double.ifa"],
          "number": ["constant.numeric.ifa"],
          "operator": ["keyword.operator.ifa"],
          "comment": ["comment.line.double-slash.ifa"]
        }
      }
    ]
  }
}
