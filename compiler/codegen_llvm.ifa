    lines.push("  ; === Copy-on-Write Freeze Read-Only: %" + cow.target_var + " ===");
    lines.push("  %" + cow.target_var + " = call ptr @ifa_rt_cow_freeze(ptr %" + cow.src_var + ")");
    return lines;
}

// Emits FIR SSA for Copy-on-Write Freeze Read-Only
pub fn emit_fir_cow_freeze(cow: AstCowFreeze) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("    %" + cow.target_var + " = fir.cow_freeze %" + cow.src_var);
    return lines;
}

// Emits LLVM IR for Copy-on-Write Clone Subtree
pub fn emit_llvm_cow_clone_subtree(cow: AstCowCloneSubtree) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("  ; === Copy-on-Write Clone Subtree: %" + cow.target_var + " ===");
    lines.push("  %" + cow.target_var + " = call ptr @ifa_rt_cow_clone_subtree(ptr %" + cow.root_var + ", i64 " + int_to_str(cow.node_count) + ")");
    return lines;
}

// Emits FIR SSA for Copy-on-Write Clone Subtree
pub fn emit_fir_cow_clone_subtree(cow: AstCowCloneSubtree) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("    %" + cow.target_var + " = fir.cow_clone_subtree %" + cow.root_var + ", nodes=" + int_to_str(cow.node_count));
    return lines;
}

// Emits LLVM IR for SSA Phi Node
pub fn emit_llvm_ssa_phi(phi: AstSsaPhi) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("  ; === SSA Phi Node: %" + phi.target_var + " ===");
    mut incoming = "";
    mut i = 0;
    while i < phi.pairs.len() {
        let p = phi.pairs[i];
        if i > 0 {
            incoming = incoming + ", ";
        }
        incoming = incoming + "[ %" + p.val_var + ", %" + p.block_label + " ]";
        i = i + 1;
    }
    lines.push("  %" + phi.target_var + " = phi " + phi.ty + " " + incoming);
    return lines;
}

// Emits FIR SSA for Phi Node
pub fn emit_fir_ssa_phi(phi: AstSsaPhi) -> List<String> {
    mut lines: List<String> = List::new();
    mut incoming = "";
    mut i = 0;
    while i < phi.pairs.len() {
        let p = phi.pairs[i];
        if i > 0 {
            incoming = incoming + ", ";
        }
        incoming = incoming + "[ %" + p.val_var + ", ^" + p.block_label + " ]";
        i = i + 1;
    }
    lines.push("    %" + phi.target_var + " = fir.phi " + incoming);
    return lines;
}

// Emits LLVM IR for SSA Select Node
pub fn emit_llvm_ssa_select(sel: AstSsaSelect) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("  ; === SSA Select Node: %" + sel.target_var + " ===");
    lines.push("  %" + sel.target_var + " = select i1 %" + sel.cond_var + ", " + sel.ty + " %" + sel.true_var + ", " + sel.ty + " %" + sel.false_var);
    return lines;
}

// Emits FIR SSA for Select Node
pub fn emit_fir_ssa_select(sel: AstSsaSelect) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("    %" + sel.target_var + " = fir.select %" + sel.cond_var + ", %" + sel.true_var + ", %" + sel.false_var);
    return lines;
}

// Unit test 29: Scoped arena creation, generational allocation and reset
pub fn test_codegen_arena_allocation_and_reset() -> bool {
    let ac = AstArenaCreate(target_var: "arena_hdl", capacity_bytes: 65536);
    let llvm_ac = emit_llvm_arena_create(ac);
    let fir_ac = emit_fir_arena_create(ac);
    if llvm_ac.len() != 1 || fir_ac.len() != 1 {
        return false;
    }
    if llvm_ac[0] != "  %arena_hdl = call i16 @ifa_rt_arena_create(i64 65536)" {
        return false;
    }
    if fir_ac[0] != "    %arena_hdl = fir.arena_create capacity=65536" {
        return false;
    }

    let aa = AstArenaAlloc(target_var: "buf_ptr", arena_id: 1, size_bytes: 1024, align_bytes: 8);
    let llvm_aa = emit_llvm_arena_alloc(aa);
    let fir_aa = emit_fir_arena_alloc(aa);
    if llvm_aa.len() != 1 || fir_aa.len() != 1 {
        return false;
    }
    if llvm_aa[0] != "  %buf_ptr = call ptr @ifa_rt_gen_alloc(i64 1024, i64 8, i16 1)" {
        return false;
    }
    if fir_aa[0] != "    %buf_ptr = fir.arena_alloc arena=1, size=1024, align=8" {
        return false;
    }

    let ar = AstArenaReset(arena_var: "arena_hdl");
    let llvm_ar = emit_llvm_arena_reset(ar);
    let fir_ar = emit_fir_arena_reset(ar);
    if llvm_ar.len() != 1 || fir_ar.len() != 1 {
        return false;
    }
    if llvm_ar[0] != "  call void @ifa_rt_arena_reset(i16 %arena_hdl)" {
        return false;
    }
    return fir_ar[0] == "    fir.arena_reset %arena_hdl";
}

// Unit test 30: Generational reference safety verification and UAF guard emission
pub fn test_codegen_gen_ref_check() -> bool {
    let chk = AstGenRefCheck(
        ptr_var: "raw_node_ptr",
        expected_gen: 7,
        arena_id: 2,
        target_checked_var: "safe_node_ref"
    );

    let llvm_lines = emit_llvm_gen_ref_check(chk);
    let fir_lines = emit_fir_gen_ref_check(chk);

    if llvm_lines.len() != 10 || fir_lines.len() != 1 {
        return false;
    }

    let has_hdr_ptr = llvm_lines[1] == "  %safe_node_ref.hdr_ptr = getelementptr i8, ptr %raw_node_ptr, i64 -8";
    let has_load_hdr = llvm_lines[2] == "  %safe_node_ref.hdr = load i64, ptr %safe_node_ref.hdr_ptr, align 8";
    let has_cmp = llvm_lines[4] == "  %safe_node_ref.gen_ok = icmp eq i32 %safe_node_ref.cur_gen, 7";
    let has_panic = llvm_lines[7] == "  call void @ifa_panic_uaf(ptr %raw_node_ptr, i32 7, i32 %safe_node_ref.cur_gen, i16 2)";
    let has_fir = fir_lines[0] == "    %safe_node_ref = fir.gen_ref_check %raw_node_ptr, gen=7, arena=2";

    return has_hdr_ptr && has_load_hdr && has_cmp && has_panic && has_fir;
}

// Unit test 31: Guaranteed Copy-on-Write in-place mutation lowering
pub fn test_codegen_cow_make_mut() -> bool {
    let cow = AstCowMakeMut(
        target_var: "mut_ast_buf",
        src_var: "shared_ast_buf",
        elem_size: 4096,
        align_bytes: 8
    );

    let llvm_lines = emit_llvm_cow_make_mut(cow);
    let fir_lines = emit_fir_cow_make_mut(cow);

    if llvm_lines.len() != 2 || fir_lines.len() != 1 {
        return false;
    }

    let has_llvm = llvm_lines[1] == "  %mut_ast_buf = call ptr @ifa_rt_cow_make_mut(ptr %shared_ast_buf, i64 4096, i64 8)";
    let has_fir = fir_lines[0] == "    %mut_ast_buf = fir.cow_make_mut %shared_ast_buf, size=4096, align=8";

    return has_llvm && has_fir;
}

// Unit test 32: Copy-on-Write Subtree Slicing and Freeze Read-Only lowering
pub fn test_codegen_cow_slice_and_freeze() -> bool {
    let sl = AstCowSlice(
        target_var: "slice_buf",
        src_var: "ast_tree_buf",
        offset_bytes: 128,
        len_bytes: 512
    );
    let llvm_sl = emit_llvm_cow_slice(sl);
    let fir_sl = emit_fir_cow_slice(sl);
    if llvm_sl.len() != 2 || fir_sl.len() != 1 {
        return false;
    }
    if llvm_sl[1] != "  %slice_buf = call ptr @ifa_rt_cow_slice(ptr %ast_tree_buf, i64 128, i64 512)" {
        return false;
    }
    if fir_sl[0] != "    %slice_buf = fir.cow_slice %ast_tree_buf, offset=128, len=512" {
        return false;
    }

    let fr = AstCowFreeze(
        target_var: "frozen_buf",
        src_var: "slice_buf"
    );
    let llvm_fr = emit_llvm_cow_freeze(fr);
    let fir_fr = emit_fir_cow_freeze(fr);
    if llvm_fr.len() != 2 || fir_fr.len() != 1 {
        return false;
    }
    if llvm_fr[1] != "  %frozen_buf = call ptr @ifa_rt_cow_freeze(ptr %slice_buf)" {
        return false;
    }
    return fir_fr[0] == "    %frozen_buf = fir.cow_freeze %slice_buf";
}

// Unit test 33: Copy-on-Write Clone Subtree O(1) lowering
pub fn test_codegen_cow_clone_subtree() -> bool {
    let cl = AstCowCloneSubtree(
        target_var: "cloned_ast_root",
        root_var: "orig_ast_root",
        node_count: 64
    );
    let llvm_cl = emit_llvm_cow_clone_subtree(cl);
    let fir_cl = emit_fir_cow_clone_subtree(cl);
    if llvm_cl.len() != 2 || fir_cl.len() != 1 {
        return false;
    }
    if llvm_cl[1] != "  %cloned_ast_root = call ptr @ifa_rt_cow_clone_subtree(ptr %orig_ast_root, i64 64)" {
        return false;
    }
    return fir_cl[0] == "    %cloned_ast_root = fir.cow_clone_subtree %orig_ast_root, nodes=64";
}

// Unit test 34: Advanced SSA Phi Node and Branchless Select lowering
pub fn test_codegen_ssa_phi_and_select() -> bool {
    mut pairs: List<AstSsaPhiPair> = List::new();
    pairs.push(AstSsaPhiPair(val_var: "val_then", block_label: "then.block"));
    pairs.push(AstSsaPhiPair(val_var: "val_else", block_label: "else.block"));

    let phi = AstSsaPhi(
        target_var: "merged_val",
        ty: "i64",
        pairs: pairs
    );
    let llvm_phi = emit_llvm_ssa_phi(phi);
    let fir_phi = emit_fir_ssa_phi(phi);
    if llvm_phi.len() != 2 || fir_phi.len() != 1 {
        return false;
    }
    if llvm_phi[1] != "  %merged_val = phi i64 [ %val_then, %then.block ], [ %val_else, %else.block ]" {
        return false;
    }
    if fir_phi[0] != "    %merged_val = fir.phi [ %val_then, ^then.block ], [ %val_else, ^else.block ]" {
        return false;
    }

    let sel = AstSsaSelect(
        target_var: "cond_res",
        cond_var: "flag",
        ty: "i64",
        true_var: "x",
        false_var: "y"
    );
    let llvm_sel = emit_llvm_ssa_select(sel);
    let fir_sel = emit_fir_ssa_select(sel);
    if llvm_sel.len() != 2 || fir_sel.len() != 1 {
        return false;
    }
    if llvm_sel[1] != "  %cond_res = select i1 %flag, i64 %x, i64 %y" {
        return false;
    }
    return fir_sel[0] == "    %cond_res = fir.select %flag, %x, %y";
}

