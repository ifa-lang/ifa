// Pure IFA Self-Hosting Compiler - LLVM Codegen Module (`compiler/codegen_llvm.ifa`)
// Deterministic textual LLVM IR (.ll) code generator for reproducible self-hosting builds.

pub struct AstExpr {
    kind: i64,
    val: i64,
    name: String,
    op: i64,
    left: ?ref AstExpr,
    right: ?ref AstExpr
}

pub struct AstStmt {
    is_return: bool,
    target_var: String,
    expr: ?ref AstExpr
}

pub struct AstFunction {
    name: String,
    param_name: String,
    statements: List<AstStmt>
}

// Complex AST: While Loop representation
pub struct AstWhile {
    cond_left: ?ref AstExpr,
    cond_op: i64, // 1: ==, 2: !=, 3: <, 4: <=, 5: >, 6: >=
    cond_right: ?ref AstExpr,
    body_target_var: String,
    body_expr: ?ref AstExpr
}

// Complex AST: If/Else conditional branching representation
pub struct AstIf {
    cond_left: ?ref AstExpr,
    cond_op: i64, // 1: ==, 2: !=, 3: <, 4: <=, 5: >, 6: >=
    cond_right: ?ref AstExpr,
    then_expr: ?ref AstExpr,
    has_else: bool,
    else_expr: ?ref AstExpr
}

// Complex AST: Pattern for Match expressions
pub struct AstPattern {
    kind: i64, // 1: Wildcard `_`, 2: Literal, 3: Identifier
    val: i64,
    name: String
}

// Complex AST: Match Arm
pub struct AstMatchArm {
    pat: AstPattern,
    expr: ?ref AstExpr
}

// Complex AST: Pattern Match Expression
pub struct AstMatch {
    target_var: String,
    arms: List<AstMatchArm>
}

// Complex AST: Generic Method representation with deterministic mangling
pub struct AstGenericMethod {
    trait_name: String,
    struct_name: String,
    method_name: String,
    type_param: String,
    mangled_name: String
}

// Complex AST: Comprehensive Function combining loops, match, and generic calls
pub struct AstComplexFunction {
    name: String,
    param_name: String,
    init_statements: List<AstStmt>,
    has_while: bool,
    while_loop: AstWhile,
    has_match: bool,
    match_stmt: AstMatch,
    has_generic_call: bool,
    generic_callee: String,
    return_var: String
}

// AST: Constant Definition for global emission
pub struct AstConstDef {
    is_pub: bool,
    name: String,
    ty: String,
    val: i64
}

// AST: Enum Variant Definition
pub struct AstEnumVariantDef {
    name: String,
    discriminant: i64
}

// AST: Enum Declaration Definition
pub struct AstEnumDef {
    is_pub: bool,
    name: String,
    variants: List<AstEnumVariantDef>
}

// AST: Struct Field Definition for LLVM codegen
pub struct AstStructFieldDef {
    name: String,
    ty: String
}

// AST: Struct Definition for LLVM codegen
pub struct AstStructDef {
    is_pub: bool,
    name: String,
    fields: List<AstStructFieldDef>
}

// AST: Struct Instantiation Field Value
pub struct AstStructInitField {
    name: String,
    val: i64
}

// AST: Struct Instantiation for LLVM codegen
pub struct AstStructInit {
    struct_name: String,
    target_var: String,
    fields: List<AstStructInitField>
}

// AST: VTable Definition for Trait Dispatch
pub struct AstVTableDef {
    trait_name: String,
    struct_name: String,
    method_names: List<String>
}

// AST: Function Pointer Indirect Call representation
pub struct AstFnPtrCall {
    fn_var: String,
    arg_var: String,
    target_var: String,
    return_ty: String,
    param_ty: String
}

// AST: Thunk definition for zero-allocation stack closures
pub struct AstThunkDef {
    thunk_name: String,
    target_fn: String,
    env_struct_name: String,
    captured_fields: List<AstStructFieldDef>,
    param_name: String,
    param_type: String,
    return_type: String
}

// AST: Closure stack instantiation
pub struct AstClosureInit {
    closure_name: String,
    env_var: String,
    thunk_name: String,
    captured_vals: List<AstStructInitField>
}

// AST: Fiber spawn expression for cooperative multitasking
pub struct AstSpawnExpr {
    target_var: String,
    entry_fn: String,
    has_arg: bool,
    arg_var: String
}

// AST: Channel creation statement
pub struct AstChanCreate {
    target_var: String,
    elem_type: String,
    capacity: i64
}

// AST: Channel send statement
pub struct AstChanSend {
    chan_var: String,
    val_var: String,
    val_ty: String,
    res_var: String
}

// AST: Channel receive statement
pub struct AstChanRecv {
    chan_var: String,
    target_val_var: String,
    val_ty: String,
    res_var: String
}

// AST: Multi-channel select multiplexer
pub struct AstChanSelect {
    target_var: String,
    chan_vars: List<String>,
    has_default: bool
}

// AST: Multi-channel select multiplexer with timeout and priority weights
pub struct AstChanSelectTimed {
    target_var: String,
    chan_vars: List<String>,
    priorities: List<i64>,
    has_priorities: bool,
    timeout_ns: i64,
    has_default: bool
}

// AST: Structured concurrency task nursery enclosing scoped fibers
pub struct AstTaskNursery {
    nursery_var: String,
    spawns: List<AstSpawnExpr>,
    use_isolated_arenas: bool
}

pub fn mangle_generic_method(
    trait_name: String,
    struct_name: String,
    method_name: String,
    type_param: String
) -> String {
    return struct_name + "$" + method_name + "$" + type_param;
}

pub fn int_to_digit(n: i64) -> String {
    if n == 0 { return "0"; }
    if n == 1 { return "1"; }
    if n == 2 { return "2"; }
    if n == 3 { return "3"; }
    if n == 4 { return "4"; }
    if n == 5 { return "5"; }
    if n == 6 { return "6"; }
    if n == 7 { return "7"; }
    if n == 8 { return "8"; }
    if n == 9 { return "9"; }
    return "0";
}

pub fn int_to_str(mut n: i64) -> String {
    if n == 0 {
        return "0";
    }
    mut is_neg = false;
    if n < 0 {
        is_neg = true;
        n = 0 - n;
    }
    mut digits = "";
    while n > 0 {
        let rem = n % 10;
        let d = int_to_digit(rem);
        digits = d + digits;
        n = n / 10;
    }
    if is_neg {
        return "-" + digits;
    }
    return digits;
}

// FIR SSA Code Generator: lowers recursive AST expressions into linear SSA instructions
pub fn emit_fir_expression(
    expr: ?ref AstExpr,
    inout temp_id: i64,
    env1_var: String,
    env1_reg: String,
    env2_var: String,
    env2_reg: String,
    inout instructions: List<String>
) -> String {
    let k = expr?.kind ?? 0;
    if k == 1 {
        // Integer constant: %tN = const <val>
        let reg = "%t" + int_to_str(temp_id);
        temp_id = temp_id + 1;
        let line = "    " + reg + " = const " + int_to_str(expr?.val ?? 0);
        instructions.push(line);
        return reg;
    }
    if k == 2 {
        let name = expr?.name ?? "";
        // Variable lookup: check SSA environment mapping or use parameter register
        if name == env1_var && env1_reg != "" {
            return env1_reg;
        }
        if name == env2_var && env2_reg != "" {
            return env2_reg;
        }
        return "%" + name;
    }
    if k == 3 {
        // Binary operation: recursively emit LHS and RHS operands
        let lhs_reg = emit_fir_expression(
            expr?.left,
            inout temp_id,
            env1_var,
            env1_reg,
            env2_var,
            env2_reg,
            inout instructions
        );
        let rhs_reg = emit_fir_expression(
            expr?.right,
            inout temp_id,
            env1_var,
            env1_reg,
            env2_var,
            env2_reg,
            inout instructions
        );

        let reg = "%t" + int_to_str(temp_id);
        temp_id = temp_id + 1;

        mut op_name = "add";
        let op = expr?.op ?? 0;
        if op == 2 {
            op_name = "sub";
        }
        if op == 3 {
            op_name = "mul";
        }
        if op == 4 {
            op_name = "div";
        }
        if op == 5 {
            op_name = "icmp_eq";
        }
        if op == 6 {
            op_name = "icmp_ne";
        }
        if op == 7 {
            op_name = "icmp_slt";
        }
        if op == 8 {
            op_name = "icmp_sle";
        }
        if op == 9 {
            op_name = "icmp_sgt";
        }
        if op == 10 {
            op_name = "icmp_sge";
        }

        let line = "    " + reg + " = " + op_name + " " + lhs_reg + ", " + rhs_reg;
        instructions.push(line);
        return reg;
    }
    if k == 4 {
        // Function or Method Call: %tN = call @callee(%arg)
        let arg_reg = emit_fir_expression(
            expr?.left,
            inout temp_id,
            env1_var,
            env1_reg,
            env2_var,
            env2_reg,
            inout instructions
        );
        let reg = "%t" + int_to_str(temp_id);
        temp_id = temp_id + 1;
        let callee = expr?.name ?? "unknown";
        let line = "    " + reg + " = call @" + callee + "(" + arg_reg + ")";
        instructions.push(line);
        return reg;
    }
    return "%t0";
}

// Lowers recursive AST expressions to LLVM IR instructions
pub fn emit_llvm_expression(
    expr: ?ref AstExpr,
    inout temp_id: i64,
    env1_var: String,
    env1_reg: String,
    env2_var: String,
    env2_reg: String,
    inout instructions: List<String>
) -> String {
    let k = expr?.kind ?? 0;
    if k == 1 {
        let reg = "%t" + int_to_str(temp_id);
        temp_id = temp_id + 1;
        let line = "  " + reg + " = add i64 0, " + int_to_str(expr?.val ?? 0);
        instructions.push(line);
        return reg;
    }
    if k == 2 {
        let name = expr?.name ?? "";
        if name == env1_var && env1_reg != "" {
            return env1_reg;
        }
        if name == env2_var && env2_reg != "" {
            return env2_reg;
        }
        return "%" + name;
    }
    if k == 3 {
        let lhs_reg = emit_llvm_expression(
            expr?.left,
            inout temp_id,
            env1_var,
            env1_reg,
            env2_var,
            env2_reg,
            inout instructions
        );
        let rhs_reg = emit_llvm_expression(
            expr?.right,
            inout temp_id,
            env1_var,
            env1_reg,
            env2_var,
            env2_reg,
            inout instructions
        );
        let reg = "%t" + int_to_str(temp_id);
        temp_id = temp_id + 1;

        let op = expr?.op ?? 0;
        mut line = "  " + reg + " = add i64 " + lhs_reg + ", " + rhs_reg;
        if op == 2 {
            line = "  " + reg + " = sub i64 " + lhs_reg + ", " + rhs_reg;
        } else if op == 3 {
            line = "  " + reg + " = mul i64 " + lhs_reg + ", " + rhs_reg;
        } else if op == 4 {
            line = "  " + reg + " = sdiv i64 " + lhs_reg + ", " + rhs_reg;
        } else if op == 5 {
            line = "  " + reg + " = icmp eq i64 " + lhs_reg + ", " + rhs_reg;
        } else if op == 6 {
            line = "  " + reg + " = icmp ne i64 " + lhs_reg + ", " + rhs_reg;
        } else if op == 7 {
            line = "  " + reg + " = icmp slt i64 " + lhs_reg + ", " + rhs_reg;
        } else if op == 8 {
            line = "  " + reg + " = icmp sle i64 " + lhs_reg + ", " + rhs_reg;
        } else if op == 9 {
            line = "  " + reg + " = icmp sgt i64 " + lhs_reg + ", " + rhs_reg;
        } else if op == 10 {
            line = "  " + reg + " = icmp sge i64 " + lhs_reg + ", " + rhs_reg;
        }
        instructions.push(line);
        return reg;
    }
    if k == 4 {
        let arg_reg = emit_llvm_expression(
            expr?.left,
            inout temp_id,
            env1_var,
            env1_reg,
            env2_var,
            env2_reg,
            inout instructions
        );
        let reg = "%t" + int_to_str(temp_id);
        temp_id = temp_id + 1;
        let callee = expr?.name ?? "unknown";
        let line = "  " + reg + " = call i64 @" + callee + "(i64 " + arg_reg + ")";
        instructions.push(line);
        return reg;
    }
    return "%t0";
}

// Lowers While Loop to FIR SSA blocks
pub fn emit_fir_while_loop(
    while_ast: AstWhile,
    loop_id: i64,
    inout temp_id: i64,
    inout env_var: String,
    inout env_reg: String,
    inout lines: List<String>
) {
    let id_str = int_to_str(loop_id);
    let cond_bb = "bb_while_cond_" + id_str;
    let body_bb = "bb_while_body_" + id_str;
    let end_bb = "bb_while_end_" + id_str;

    lines.push("    br " + cond_bb);
    lines.push("  " + cond_bb + ":");

    let lhs = emit_fir_expression(while_ast.cond_left, inout temp_id, env_var, env_reg, "", "", inout lines);
    let rhs = emit_fir_expression(while_ast.cond_right, inout temp_id, env_var, env_reg, "", "", inout lines);

    let cmp_reg = "%t" + int_to_str(temp_id);
    temp_id = temp_id + 1;
    mut op_name = "icmp_slt";
    if while_ast.cond_op == 1 { op_name = "icmp_eq"; }
    if while_ast.cond_op == 2 { op_name = "icmp_ne"; }
    if while_ast.cond_op == 4 { op_name = "icmp_sle"; }
    if while_ast.cond_op == 5 { op_name = "icmp_sgt"; }
    if while_ast.cond_op == 6 { op_name = "icmp_sge"; }

    lines.push("    " + cmp_reg + " = " + op_name + " " + lhs + ", " + rhs);
    lines.push("    cond_br " + cmp_reg + ", " + body_bb + ", " + end_bb);

    lines.push("  " + body_bb + ":");
    let body_reg = emit_fir_expression(while_ast.body_expr, inout temp_id, env_var, env_reg, "", "", inout lines);
    if while_ast.body_target_var != "" {
        env_var = while_ast.body_target_var;
        env_reg = body_reg;
    }
    lines.push("    br " + cond_bb);

    lines.push("  " + end_bb + ":");
}

// Lowers While Loop to textual LLVM IR blocks
pub fn emit_llvm_while_loop(
    while_ast: AstWhile,
    loop_id: i64,
    inout temp_id: i64,
    inout env_var: String,
    inout env_reg: String,
    inout lines: List<String>
) {
    let id_str = int_to_str(loop_id);
    let cond_lbl = "while.cond." + id_str;
    let body_lbl = "while.body." + id_str;
    let end_lbl = "while.end." + id_str;

    lines.push("  br label %" + cond_lbl);
    lines.push(cond_lbl + ":");

    let lhs = emit_llvm_expression(while_ast.cond_left, inout temp_id, env_var, env_reg, "", "", inout lines);
    let rhs = emit_llvm_expression(while_ast.cond_right, inout temp_id, env_var, env_reg, "", "", inout lines);

    let cmp_reg = "%t" + int_to_str(temp_id);
    temp_id = temp_id + 1;
    mut cmp_op = "slt";
    if while_ast.cond_op == 1 { cmp_op = "eq"; }
    if while_ast.cond_op == 2 { cmp_op = "ne"; }
    if while_ast.cond_op == 4 { cmp_op = "sle"; }
    if while_ast.cond_op == 5 { cmp_op = "sgt"; }
    if while_ast.cond_op == 6 { cmp_op = "sge"; }

    lines.push("  " + cmp_reg + " = icmp " + cmp_op + " i64 " + lhs + ", " + rhs);
    lines.push("  br i1 " + cmp_reg + ", label %" + body_lbl + ", label %" + end_lbl);

    lines.push(body_lbl + ":");
    let body_reg = emit_llvm_expression(while_ast.body_expr, inout temp_id, env_var, env_reg, "", "", inout lines);
    if while_ast.body_target_var != "" {
        env_var = while_ast.body_target_var;
        env_reg = body_reg;
    }
    lines.push("  br label %" + cond_lbl);

    lines.push(end_lbl + ":");
}

// Lowers If/Else to FIR SSA blocks
pub fn emit_fir_if_else(
    if_ast: AstIf,
    if_id: i64,
    inout temp_id: i64,
    env_var: String,
    env_reg: String,
    inout result_reg: String,
    inout lines: List<String>
) {
    let id_str = int_to_str(if_id);
    let then_bb = "bb_if_then_" + id_str;
    let else_bb = "bb_if_else_" + id_str;
    let exit_bb = "bb_if_exit_" + id_str;

    let lhs = emit_fir_expression(if_ast.cond_left, inout temp_id, env_var, env_reg, "", "", inout lines);
    let rhs = emit_fir_expression(if_ast.cond_right, inout temp_id, env_var, env_reg, "", "", inout lines);

    let cmp_reg = "%t" + int_to_str(temp_id);
    temp_id = temp_id + 1;
    mut op_name = "icmp_eq";
    if if_ast.cond_op == 2 { op_name = "icmp_ne"; }
    if if_ast.cond_op == 3 { op_name = "icmp_slt"; }
    if if_ast.cond_op == 4 { op_name = "icmp_sle"; }
    if if_ast.cond_op == 5 { op_name = "icmp_sgt"; }
    if if_ast.cond_op == 6 { op_name = "icmp_sge"; }

    lines.push("    " + cmp_reg + " = " + op_name + " " + lhs + ", " + rhs);
    lines.push("    cond_br " + cmp_reg + ", " + then_bb + ", " + else_bb);

    lines.push("  " + then_bb + ":");
    let then_val_reg = emit_fir_expression(if_ast.then_expr, inout temp_id, env_var, env_reg, "", "", inout lines);
    lines.push("    br " + exit_bb);

    lines.push("  " + else_bb + ":");
    mut else_val_reg = "0";
    if if_ast.has_else {
        else_val_reg = emit_fir_expression(if_ast.else_expr, inout temp_id, env_var, env_reg, "", "", inout lines);
    }
    lines.push("    br " + exit_bb);

    lines.push("  " + exit_bb + ":");
    result_reg = "%t" + int_to_str(temp_id);
    temp_id = temp_id + 1;
    lines.push("    " + result_reg + " = phi [" + then_val_reg + ", ^" + then_bb + "], [" + else_val_reg + ", ^" + else_bb + "]");
}

// Lowers If/Else conditional branching to textual LLVM IR blocks
pub fn emit_llvm_if_else(
    if_ast: AstIf,
    if_id: i64,
    inout temp_id: i64,
    env_var: String,
    env_reg: String,
    inout result_reg: String,
    inout lines: List<String>
) {
    let id_str = int_to_str(if_id);
    let then_lbl = "if.then." + id_str;
    let else_lbl = "if.else." + id_str;
    let exit_lbl = "if.exit." + id_str;

    let lhs = emit_llvm_expression(if_ast.cond_left, inout temp_id, env_var, env_reg, "", "", inout lines);
    let rhs = emit_llvm_expression(if_ast.cond_right, inout temp_id, env_var, env_reg, "", "", inout lines);

    let cmp_reg = "%t" + int_to_str(temp_id);
    temp_id = temp_id + 1;
    mut cmp_op = "eq";
    if if_ast.cond_op == 2 { cmp_op = "ne"; }
    if if_ast.cond_op == 3 { cmp_op = "slt"; }
    if if_ast.cond_op == 4 { cmp_op = "sle"; }
    if if_ast.cond_op == 5 { cmp_op = "sgt"; }
    if if_ast.cond_op == 6 { cmp_op = "sge"; }

    lines.push("  " + cmp_reg + " = icmp " + cmp_op + " i64 " + lhs + ", " + rhs);
    lines.push("  br i1 " + cmp_reg + ", label %" + then_lbl + ", label %" + else_lbl);

    lines.push(then_lbl + ":");
    let then_val_reg = emit_llvm_expression(if_ast.then_expr, inout temp_id, env_var, env_reg, "", "", inout lines);
    lines.push("  br label %" + exit_lbl);

    lines.push(else_lbl + ":");
    mut else_val_reg = "0";
    if if_ast.has_else {
        else_val_reg = emit_llvm_expression(if_ast.else_expr, inout temp_id, env_var, env_reg, "", "", inout lines);
    }
    lines.push("  br label %" + exit_lbl);

    lines.push(exit_lbl + ":");
    result_reg = "%t" + int_to_str(temp_id);
    temp_id = temp_id + 1;
    lines.push("  " + result_reg + " = phi i64 [ " + then_val_reg + ", %" + then_lbl + " ], [ " + else_val_reg + ", %" + else_lbl + " ]");
}

// Lowers Pattern Matching to FIR SSA blocks
pub fn emit_fir_match(
    match_ast: AstMatch,
    match_id: i64,
    inout temp_id: i64,
    target_reg: String,
    inout result_reg: String,
    inout lines: List<String>
) {
    let m_id = int_to_str(match_id);
    let exit_bb = "bb_match_exit_" + m_id;
    let start_check_bb = "bb_match_check_" + m_id + "_0";

    lines.push("    br " + start_check_bb);

    mut i: i64 = 0;
    while i < match_ast.arms.len() {
        let i_str = int_to_str(i);
        let check_bb = "bb_match_check_" + m_id + "_" + i_str;
        let arm_bb = "bb_match_arm_" + m_id + "_" + i_str;
        let next_check_bb = "bb_match_check_" + m_id + "_" + int_to_str(i + 1);

        lines.push("  " + check_bb + ":");
        let arm = match_ast.arms[i];

        if arm.pat.kind == 1 || arm.pat.kind == 3 {
            lines.push("    br " + arm_bb);
        } else {
            let cmp_reg = "%t" + int_to_str(temp_id);
            temp_id = temp_id + 1;
            let val_str = int_to_str(arm.pat.val);
            lines.push("    " + cmp_reg + " = icmp_eq " + target_reg + ", " + val_str);
            lines.push("    cond_br " + cmp_reg + ", " + arm_bb + ", " + next_check_bb);
        }

        lines.push("  " + arm_bb + ":");
        let arm_res = emit_fir_expression(arm.expr, inout temp_id, arm.pat.name, target_reg, "", "", inout lines);
        result_reg = arm_res;
        lines.push("    br " + exit_bb);

        i = i + 1;
    }

    lines.push("  " + exit_bb + ":");
}

// Lowers Pattern Matching to textual LLVM IR blocks
pub fn emit_llvm_match(
    match_ast: AstMatch,
    match_id: i64,
    inout temp_id: i64,
    target_reg: String,
    inout result_reg: String,
    inout lines: List<String>
) {
    let m_id = int_to_str(match_id);
    let exit_lbl = "match.exit." + m_id;
    let start_check_lbl = "match.check." + m_id + ".0";

    lines.push("  br label %" + start_check_lbl);

    mut i: i64 = 0;
    while i < match_ast.arms.len() {
        let i_str = int_to_str(i);
        let check_lbl = "match.check." + m_id + "." + i_str;
        let arm_lbl = "match.arm." + m_id + "." + i_str;
        let next_check_lbl = "match.check." + m_id + "." + int_to_str(i + 1);

        lines.push(check_lbl + ":");
        let arm = match_ast.arms[i];

        if arm.pat.kind == 1 || arm.pat.kind == 3 {
            lines.push("  br label %" + arm_lbl);
        } else {
            let cmp_reg = "%t" + int_to_str(temp_id);
            temp_id = temp_id + 1;
            let val_str = int_to_str(arm.pat.val);
            lines.push("  " + cmp_reg + " = icmp eq i64 " + target_reg + ", " + val_str);
            lines.push("  br i1 " + cmp_reg + ", label %" + arm_lbl + ", label %" + next_check_lbl);
        }

        lines.push(arm_lbl + ":");
        let arm_res = emit_llvm_expression(arm.expr, inout temp_id, arm.pat.name, target_reg, "", "", inout lines);
        result_reg = arm_res;
        lines.push("  br label %" + exit_lbl);

        i = i + 1;
    }

    lines.push(exit_lbl + ":");
}

// Lowers an entire Complex Function containing loops, pattern matching, and generic calls
pub fn emit_fir_complex_function(func: AstComplexFunction) -> List<String> {
    mut lines: List<String> = List::new();
    let header = "fir.func @" + func.name + "(%" + func.param_name + ": i64) -> i64 {";
    lines.push(header);
    lines.push("  bb0:");

    mut temp_counter: i64 = 0;
    mut env_var = func.param_name;
    mut env_reg = "%" + func.param_name;

    mut i: i64 = 0;
    while i < func.init_statements.len() {
        let stmt = func.init_statements[i];
        let res_reg = emit_fir_expression(stmt.expr, inout temp_counter, env_var, env_reg, "", "", inout lines);
        env_var = stmt.target_var;
        env_reg = res_reg;
        i = i + 1;
    }

    if func.has_while {
        emit_fir_while_loop(func.while_loop, 0, inout temp_counter, inout env_var, inout env_reg, inout lines);
    }

    mut match_result = env_reg;
    if func.has_match {
        emit_fir_match(func.match_stmt, 0, inout temp_counter, env_reg, inout match_result, inout lines);
        env_reg = match_result;
    }

    if func.has_generic_call {
        let reg = "%t" + int_to_str(temp_counter);
        temp_counter = temp_counter + 1;
        lines.push("    " + reg + " = call @" + func.generic_callee + "(" + env_reg + ")");
        env_reg = reg;
    }

    lines.push("    ret " + env_reg);
    lines.push("}");
    return lines;
}

// Lowers an entire Complex Function to textual LLVM IR
pub fn emit_llvm_complex_function(func: AstComplexFunction) -> List<String> {
    mut lines: List<String> = List::new();
    let header = "define i64 @" + func.name + "(i64 %" + func.param_name + ") {";
    lines.push(header);
    lines.push("entry:");

    mut temp_counter: i64 = 0;
    mut env_var = func.param_name;
    mut env_reg = "%" + func.param_name;

    mut i: i64 = 0;
    while i < func.init_statements.len() {
        let stmt = func.init_statements[i];
        let res_reg = emit_llvm_expression(stmt.expr, inout temp_counter, env_var, env_reg, "", "", inout lines);
        env_var = stmt.target_var;
        env_reg = res_reg;
        i = i + 1;
    }

    if func.has_while {
        emit_llvm_while_loop(func.while_loop, 0, inout temp_counter, inout env_var, inout env_reg, inout lines);
    }

    mut match_result = env_reg;
    if func.has_match {
        emit_llvm_match(func.match_stmt, 0, inout temp_counter, env_reg, inout match_result, inout lines);
        env_reg = match_result;
    }

    if func.has_generic_call {
        let reg = "%t" + int_to_str(temp_counter);
        temp_counter = temp_counter + 1;
        lines.push("  " + reg + " = call i64 @" + func.generic_callee + "(i64 " + env_reg + ")");
        env_reg = reg;
    }

    lines.push("  ret i64 " + env_reg);
    lines.push("}");
    return lines;
}

// FIR SSA Code Generator: lowers parsed AST functions into complete SSA basic block representations
pub fn emit_fir_function(func: AstFunction) -> List<String> {
    mut lines: List<String> = List::new();
    let header = "fir.func @" + func.name + "(%" + func.param_name + ": i64) -> i64 {";
    lines.push(header);
    lines.push("  bb0:");

    mut temp_counter: i64 = 0;
    mut env1_var = "";
    mut env1_reg = "";
    mut env2_var = "";
    mut env2_reg = "";

    mut i: i64 = 0;
    while i < func.statements.len() {
        let stmt = func.statements[i];
        if stmt.is_return {
            let res_reg = emit_fir_expression(
                stmt.expr,
                inout temp_counter,
                env1_var,
                env1_reg,
                env2_var,
                env2_reg,
                inout lines
            );
            lines.push("    ret " + res_reg);
        } else {
            let res_reg = emit_fir_expression(
                stmt.expr,
                inout temp_counter,
                env1_var,
                env1_reg,
                env2_var,
                env2_reg,
                inout lines
            );
            if env1_var == "" {
                env1_var = stmt.target_var;
                env1_reg = res_reg;
            } else {
                env2_var = stmt.target_var;
                env2_reg = res_reg;
            }
        }
        i = i + 1;
    }

    lines.push("}");
    return lines;
}

// Emits bit-for-bit deterministic textual LLVM IR (.ll) for a function
pub fn emit_llvm_ir_function(func: AstFunction) -> List<String> {
    mut lines: List<String> = List::new();
    let header = "define i64 @" + func.name + "(i64 %" + func.param_name + ") {";
    lines.push(header);
    lines.push("entry:");

    mut temp_counter: i64 = 0;
    mut env1_var = "";
    mut env1_reg = "";
    mut env2_var = "";
    mut env2_reg = "";

    mut i: i64 = 0;
    while i < func.statements.len() {
        let stmt = func.statements[i];
        if stmt.is_return {
            let res_reg = emit_fir_expression(
                stmt.expr,
                inout temp_counter,
                env1_var,
                env1_reg,
                env2_var,
                env2_reg,
                inout lines
            );
            lines.push("  ret i64 " + res_reg);
        } else {
            let res_reg = emit_fir_expression(
                stmt.expr,
                inout temp_counter,
                env1_var,
                env1_reg,
                env2_var,
                env2_reg,
                inout lines
            );
            if env1_var == "" {
                env1_var = stmt.target_var;
                env1_reg = res_reg;
            } else {
                env2_var = stmt.target_var;
                env2_reg = res_reg;
            }
        }
        i = i + 1;
    }

    lines.push("}");
    return lines;
}

// Unit test 1: FIR SSA expression lowering
pub fn test_codegen_fir_expression() -> bool {
    mut pool: List<AstExpr> = List::new();
    let left = AstExpr(kind: 1, val: 15, name: "", op: 0, left: None, right: None);
    pool.push(left);
    let left_idx = pool.len() - 1;
    let right = AstExpr(kind: 1, val: 27, name: "", op: 0, left: None, right: None);
    pool.push(right);
    let right_idx = pool.len() - 1;
    let root = AstExpr(
        kind: 3,
        val: 0,
        name: "",
        op: 1,
        left: ref pool[left_idx],
        right: ref pool[right_idx]
    );

    mut temp_id: i64 = 0;
    mut instructions: List<String> = List::new();
    let final_reg = emit_fir_expression(
        ref root,
        inout temp_id,
        "",
        "",
        "",
        "",
        inout instructions
    );

    if final_reg != "%t2" {
        return false;
    }
    if instructions.len() != 3 {
        return false;
    }
    return instructions[2] == "    %t2 = add %t0, %t1";
}

// Unit test 2: Deterministic function lowering
pub fn test_codegen_function_emission() -> bool {
    mut pool: List<AstExpr> = List::new();
    let expr_const = AstExpr(kind: 1, val: 40, name: "", op: 0, left: None, right: None);
    pool.push(expr_const);
    let c_idx = pool.len() - 1;

    mut stmts: List<AstStmt> = List::new();
    let stmt1 = AstStmt(is_return: false, target_var: "bonus", expr: ref pool[c_idx]);
    stmts.push(stmt1);

    let expr_x = AstExpr(kind: 2, val: 0, name: "x", op: 0, left: None, right: None);
    pool.push(expr_x);
    let x_idx = pool.len() - 1;

    let expr_bonus = AstExpr(kind: 2, val: 0, name: "bonus", op: 0, left: None, right: None);
    pool.push(expr_bonus);
    let b_idx = pool.len() - 1;

    let expr_add = AstExpr(kind: 3, val: 0, name: "", op: 1, left: ref pool[x_idx], right: ref pool[b_idx]);
    pool.push(expr_add);
    let add_idx = pool.len() - 1;

    let stmt2 = AstStmt(is_return: true, target_var: "", expr: ref pool[add_idx]);
    stmts.push(stmt2);

    let func = AstFunction(name: "compute", param_name: "x", statements: stmts);
    let lines = emit_fir_function(func);

    if lines.len() != 6 {
        return false;
    }
    return lines[0] == "fir.func @compute(%x: i64) -> i64 {";
}

// Unit test 3: While Loop Lowering (FIR SSA and textual LLVM IR)
pub fn test_codegen_while_loop() -> bool {
    mut pool: List<AstExpr> = List::new();
    let expr_x = AstExpr(kind: 2, val: 0, name: "x", op: 0, left: None, right: None);
    pool.push(expr_x);
    let x_idx = pool.len() - 1;

    let expr_limit = AstExpr(kind: 1, val: 10, name: "", op: 0, left: None, right: None);
    pool.push(expr_limit);
    let lim_idx = pool.len() - 1;

    let expr_one = AstExpr(kind: 1, val: 1, name: "", op: 0, left: None, right: None);
    pool.push(expr_one);
    let one_idx = pool.len() - 1;

    let expr_inc = AstExpr(kind: 3, val: 0, name: "", op: 1, left: ref pool[x_idx], right: ref pool[one_idx]);
    pool.push(expr_inc);
    let inc_idx = pool.len() - 1;

    let loop_ast = AstWhile(
        cond_left: ref pool[x_idx],
        cond_op: 3, // slt (<)
        cond_right: ref pool[lim_idx],
        body_target_var: "x",
        body_expr: ref pool[inc_idx]
    );

    // Verify FIR SSA emission
    mut temp_id: i64 = 0;
    mut fir_lines: List<String> = List::new();
    mut env_var = "x";
    mut env_reg = "%x";
    emit_fir_while_loop(loop_ast, 0, inout temp_id, inout env_var, inout env_reg, inout fir_lines);

    if fir_lines.len() != 10 {
        return false;
    }
    if fir_lines[0] != "    br bb_while_cond_0" {
        return false;
    }
    if fir_lines[1] != "  bb_while_cond_0:" {
        return false;
    }

    // Verify LLVM IR emission
    mut temp_id_llvm: i64 = 0;
    mut llvm_lines: List<String> = List::new();
    mut env_var_llvm = "x";
    mut env_reg_llvm = "%x";
    emit_llvm_while_loop(loop_ast, 0, inout temp_id_llvm, inout env_var_llvm, inout env_reg_llvm, inout llvm_lines);

    if llvm_lines.len() != 10 {
        return false;
    }
    if llvm_lines[0] != "  br label %while.cond.0" {
        return false;
    }
    if llvm_lines[1] != "while.cond.0:" {
        return false;
    }

    return true;
}

// Unit test 4: Pattern Match Lowering (FIR SSA and textual LLVM IR)
pub fn test_codegen_pattern_match() -> bool {
    mut pool: List<AstExpr> = List::new();
    let expr10 = AstExpr(kind: 1, val: 10, name: "", op: 0, left: None, right: None);
    pool.push(expr10);
    let idx10 = pool.len() - 1;

    let expr20 = AstExpr(kind: 1, val: 20, name: "", op: 0, left: None, right: None);
    pool.push(expr20);
    let idx20 = pool.len() - 1;

    let expr42 = AstExpr(kind: 1, val: 42, name: "", op: 0, left: None, right: None);
    pool.push(expr42);
    let idx42 = pool.len() - 1;

    mut arms: List<AstMatchArm> = List::new();
    arms.push(AstMatchArm(
        pat: AstPattern(kind: 2, val: 1, name: ""),
        expr: ref pool[idx10]
    ));
    arms.push(AstMatchArm(
        pat: AstPattern(kind: 2, val: 2, name: ""),
        expr: ref pool[idx20]
    ));
    arms.push(AstMatchArm(
        pat: AstPattern(kind: 1, val: 0, name: "_"),
        expr: ref pool[idx42]
    ));

    let match_ast = AstMatch(target_var: "code", arms: arms);

    // Verify FIR SSA emission
    mut temp_id: i64 = 0;
    mut fir_lines: List<String> = List::new();
    mut res_reg = "";
    emit_fir_match(match_ast, 0, inout temp_id, "%code", inout res_reg, inout fir_lines);

    if fir_lines.len() != 19 {
        return false;
    }
    if fir_lines[0] != "    br bb_match_check_0_0" {
        return false;
    }

    // Verify LLVM IR emission
    mut temp_id_llvm: i64 = 0;
    mut llvm_lines: List<String> = List::new();
    mut res_reg_llvm = "";
    emit_llvm_match(match_ast, 0, inout temp_id_llvm, "%code", inout res_reg_llvm, inout llvm_lines);

    if llvm_lines.len() != 19 {
        return false;
    }
    if llvm_lines[0] != "  br label %match.check.0.0" {
        return false;
    }

    return true;
}

// Unit test 5: Generic Method Call & Deterministic Mangling
pub fn test_codegen_generic_method_call() -> bool {
    let mangled = mangle_generic_method(
        "Diagnosable",
        "DiagnosticReporter",
        "diagnose",
        "CompileDiagnostic"
    );
    if mangled != "DiagnosticReporter$diagnose$CompileDiagnostic" {
        return false;
    }

    mut pool: List<AstExpr> = List::new();
    let arg_expr = AstExpr(kind: 1, val: 42, name: "", op: 0, left: None, right: None);
    pool.push(arg_expr);
    let arg_idx = pool.len() - 1;

    let call_expr = AstExpr(
        kind: 4,
        val: 0,
        name: mangled,
        op: 0,
        left: ref pool[arg_idx],
        right: None
    );
    pool.push(call_expr);
    let call_idx = pool.len() - 1;

    mut temp_id: i64 = 0;
    mut fir_lines: List<String> = List::new();
    let res = emit_fir_expression(ref pool[call_idx], inout temp_id, "", "", "", "", inout fir_lines);

    if res != "%t1" {
        return false;
    }
    if fir_lines.len() != 2 {
        return false;
    }
    return fir_lines[1] == "    %t1 = call @DiagnosticReporter$diagnose$CompileDiagnostic(%t0)";
}

// Unit test 6: Complex Function Lowering (combining init stmts, while loop, match, and call)
pub fn test_codegen_complex_function() -> bool {
    mut pool: List<AstExpr> = List::new();

    // 1. Init stmt: let x = 0;
    let expr_zero = AstExpr(kind: 1, val: 0, name: "", op: 0, left: None, right: None);
    pool.push(expr_zero);
    let zero_idx = pool.len() - 1;

    mut init_stmts: List<AstStmt> = List::new();
    init_stmts.push(AstStmt(is_return: false, target_var: "x", expr: ref pool[zero_idx]));

    // 2. While loop: while x < 5 { x = x + 1; }
    let expr_x = AstExpr(kind: 2, val: 0, name: "x", op: 0, left: None, right: None);
    pool.push(expr_x);
    let x_idx = pool.len() - 1;

    let expr_five = AstExpr(kind: 1, val: 5, name: "", op: 0, left: None, right: None);
    pool.push(expr_five);
    let five_idx = pool.len() - 1;

    let expr_one = AstExpr(kind: 1, val: 1, name: "", op: 0, left: None, right: None);
    pool.push(expr_one);
    let one_idx = pool.len() - 1;

    let expr_add = AstExpr(kind: 3, val: 0, name: "", op: 1, left: ref pool[x_idx], right: ref pool[one_idx]);
    pool.push(expr_add);
    let add_idx = pool.len() - 1;

    let while_ast = AstWhile(
        cond_left: ref pool[x_idx],
        cond_op: 3,
        cond_right: ref pool[five_idx],
        body_target_var: "x",
        body_expr: ref pool[add_idx]
    );

    // 3. Match: match x { 5 => 42, _ => 0 }
    let expr42 = AstExpr(kind: 1, val: 42, name: "", op: 0, left: None, right: None);
    pool.push(expr42);
    let idx42 = pool.len() - 1;

    mut arms: List<AstMatchArm> = List::new();
    arms.push(AstMatchArm(
        pat: AstPattern(kind: 2, val: 5, name: ""),
        expr: ref pool[idx42]
    ));
    arms.push(AstMatchArm(
        pat: AstPattern(kind: 1, val: 0, name: "_"),
        expr: ref pool[zero_idx]
    ));
    let match_ast = AstMatch(target_var: "x", arms: arms);

    let comp_func = AstComplexFunction(
        name: "complex_pipeline",
        param_name: "seed",
        init_statements: init_stmts,
        has_while: true,
        while_loop: while_ast,
        has_match: true,
        match_stmt: match_ast,
        has_generic_call: true,
        generic_callee: "identity$i64",
        return_var: "res"
    );

    let fir_lines = emit_fir_complex_function(comp_func);
    if fir_lines.len() < 20 {
        return false;
    }
    if fir_lines[0] != "fir.func @complex_pipeline(%seed: i64) -> i64 {" {
        return false;
    }

    let llvm_lines = emit_llvm_complex_function(comp_func);
    if llvm_lines.len() < 20 {
        return false;
    }
    if llvm_lines[0] != "define i64 @complex_pipeline(i64 %seed) {" {
        return false;
    }

    return true;
}

// Lowers constant definitions to textual LLVM IR global constants
pub fn emit_llvm_global_const(c: AstConstDef) -> String {
    mut linkage = "private ";
    if c.is_pub {
        linkage = "";
    }
    mut align_val = "8";
    if c.ty == "i32" {
        align_val = "4";
    }
    return "@" + c.name + " = " + linkage + "unnamed_addr constant " + c.ty + " " + int_to_str(c.val) + ", align " + align_val;
}

// Lowers constant definitions to FIR globals
pub fn emit_fir_global_const(c: AstConstDef) -> String {
    return "fir.global @" + c.name + " : " + c.ty + " = " + int_to_str(c.val);
}

// Emits textual LLVM type definition for Enum
pub fn emit_llvm_enum_type(e: AstEnumDef) -> String {
    return "%" + e.name + " = type { i32 }";
}

// Emits FIR type definition for Enum
pub fn emit_fir_enum_type(e: AstEnumDef) -> String {
    return "fir.type @" + e.name + " = !fir.enum<i32>";
}

// Emits textual LLVM getter function for an enum variant discriminant
pub fn emit_llvm_variant_getter(enum_name: String, v: AstEnumVariantDef) -> List<String> {
    mut lines: List<String> = List::new();
    let fn_name = "@" + enum_name + "$" + v.name;
    lines.push("define i32 " + fn_name + "() unnamed_addr {");
    lines.push("  ret i32 " + int_to_str(v.discriminant));
    lines.push("}");
    return lines;
}

// Emits FIR getter function for an enum variant discriminant
pub fn emit_fir_variant_getter(enum_name: String, v: AstEnumVariantDef) -> List<String> {
    mut lines: List<String> = List::new();
    let fn_name = "@" + enum_name + "$" + v.name;
    lines.push("fir.func " + fn_name + "() -> i32 {");
    lines.push("    %res = fir.constant " + int_to_str(v.discriminant) + " : i32");
    lines.push("    return %res");
    lines.push("}");
    return lines;
}

// Unit test 7: Global Constant LLVM and FIR emission
pub fn test_codegen_global_constants() -> bool {
    let c1 = AstConstDef(is_pub: true, name: "MAX_BUFFER_SIZE", ty: "i64", val: 4096);
    let c2 = AstConstDef(is_pub: false, name: "DEFAULT_ALIGN", ty: "i32", val: 8);

    let llvm1 = emit_llvm_global_const(c1);
    let llvm2 = emit_llvm_global_const(c2);

    if llvm1 != "@MAX_BUFFER_SIZE = unnamed_addr constant i64 4096, align 8" {
        return false;
    }
    if llvm2 != "@DEFAULT_ALIGN = private unnamed_addr constant i32 8, align 4" {
        return false;
    }

    let fir1 = emit_fir_global_const(c1);
    let fir2 = emit_fir_global_const(c2);

    if fir1 != "fir.global @MAX_BUFFER_SIZE : i64 = 4096" {
        return false;
    }
    if fir2 != "fir.global @DEFAULT_ALIGN : i32 = 8" {
        return false;
    }
    return true;
}

// Unit test 8: Enum Type and Variant Discriminant Getter emission
pub fn test_codegen_enum_definitions() -> bool {
    mut variants: List<AstEnumVariantDef> = List::new();
    variants.push(AstEnumVariantDef(name: "Eof", discriminant: 0));
    variants.push(AstEnumVariantDef(name: "Identifier", discriminant: 1));
    variants.push(AstEnumVariantDef(name: "Number", discriminant: 2));
    variants.push(AstEnumVariantDef(name: "Plus", discriminant: 3));

    let enum_def = AstEnumDef(is_pub: true, name: "TokenKind", variants: variants);

    let ty_llvm = emit_llvm_enum_type(enum_def);
    if ty_llvm != "%TokenKind = type { i32 }" {
        return false;
    }

    let ty_fir = emit_fir_enum_type(enum_def);
    if ty_fir != "fir.type @TokenKind = !fir.enum<i32>" {
        return false;
    }

    let get_eof_llvm = emit_llvm_variant_getter(enum_def.name, enum_def.variants[0]);
    if get_eof_llvm.len() != 3 {
        return false;
    }
    if get_eof_llvm[0] != "define i32 @TokenKind$Eof() unnamed_addr {" {
        return false;
    }
    if get_eof_llvm[1] != "  ret i32 0" {
        return false;
    }

    let get_plus_fir = emit_fir_variant_getter(enum_def.name, enum_def.variants[3]);
    if get_plus_fir.len() != 4 {
        return false;
    }
    if get_plus_fir[0] != "fir.func @TokenKind$Plus() -> i32 {" {
        return false;
    }
    if get_plus_fir[1] != "    %res = fir.constant 3 : i32" {
        return false;
    }

    return true;
}

// Emits textual LLVM type definition for Struct
pub fn emit_llvm_struct_type(s: AstStructDef) -> String {
    mut line = "%" + s.name + " = type { ";
    mut i: i64 = 0;
    while i < s.fields.len() {
        if i > 0 {
            line = line + ", ";
        }
        line = line + s.fields[i].ty;
        i = i + 1;
    }
    line = line + " }";
    return line;
}

// Emits FIR type definition for Struct
pub fn emit_fir_struct_type(s: AstStructDef) -> String {
    mut line = "fir.type @" + s.name + " = !fir.struct<";
    mut i: i64 = 0;
    while i < s.fields.len() {
        if i > 0 {
            line = line + ", ";
        }
        line = line + s.fields[i].name + ": " + s.fields[i].ty;
        i = i + 1;
    }
    line = line + ">";
    return line;
}

// Emits LLVM IR local stack instantiation for a struct
pub fn emit_llvm_struct_instantiation(init: AstStructInit, struct_def: AstStructDef) -> List<String> {
    mut lines: List<String> = List::new();
    let ptr_var = "%" + init.target_var;
    lines.push("  " + ptr_var + " = alloca %" + init.struct_name + ", align 8");
    mut i: i64 = 0;
    while i < init.fields.len() {
        let field_idx_str = int_to_str(i);
        let gep_var = ptr_var + ".f" + field_idx_str;
        lines.push("  " + gep_var + " = getelementptr inbounds %" + init.struct_name + ", ptr " + ptr_var + ", i32 0, i32 " + field_idx_str);
        let field_ty = struct_def.fields[i].ty;
        let field_val_str = int_to_str(init.fields[i].val);
        lines.push("  store " + field_ty + " " + field_val_str + ", ptr " + gep_var + ", align 8");
        i = i + 1;
    }
    return lines;
}

// Emits FIR stack instantiation for a struct
pub fn emit_fir_struct_instantiation(init: AstStructInit) -> List<String> {
    mut lines: List<String> = List::new();
    let ptr_var = "%" + init.target_var;
    lines.push("    " + ptr_var + " = fir.alloca !" + init.struct_name);
    mut i: i64 = 0;
    while i < init.fields.len() {
        let field_idx_str = int_to_str(i);
        let val_str = int_to_str(init.fields[i].val);
        lines.push("    fir.struct_set " + ptr_var + "[" + field_idx_str + "] = " + val_str);
        i = i + 1;
    }
    return lines;
}

// Emits textual LLVM global constant vtable definition
pub fn emit_llvm_vtable(vt: AstVTableDef) -> String {
    let vt_name = "@" + vt.struct_name + "$" + vt.trait_name + "$vtable";
    let count_str = int_to_str(vt.method_names.len());
    mut s = vt_name + " = constant [" + count_str + " x ptr] [";
    mut i: i64 = 0;
    while i < vt.method_names.len() {
        if i > 0 {
            s = s + ", ";
        }
        s = s + "ptr @" + vt.struct_name + "$" + vt.method_names[i];
        i = i + 1;
    }
    s = s + "], align 8";
    return s;
}

// Emits FIR global vtable definition
pub fn emit_fir_vtable(vt: AstVTableDef) -> String {
    let vt_name = "fir.vtable @" + vt.struct_name + "$" + vt.trait_name + " = [";
    mut s = vt_name;
    mut i: i64 = 0;
    while i < vt.method_names.len() {
        if i > 0 {
            s = s + ", ";
        }
        s = s + "@" + vt.struct_name + "$" + vt.method_names[i];
        i = i + 1;
    }
    s = s + "]";
    return s;
}

// Emits LLVM indirect method call via vtable dispatch
pub fn emit_llvm_vtable_call(
    vt: AstVTableDef,
    method_idx: i64,
    self_var: String,
    res_var: String
) -> List<String> {
    mut lines: List<String> = List::new();
    let count_str = int_to_str(vt.method_names.len());
    let vt_name = "@" + vt.struct_name + "$" + vt.trait_name + "$vtable";
    let slot_reg = "%vt_slot." + res_var;
    let fn_reg = "%fn_ptr." + res_var;
    let idx_str = int_to_str(method_idx);
    lines.push("  " + slot_reg + " = getelementptr inbounds [" + count_str + " x ptr], ptr " + vt_name + ", i64 0, i64 " + idx_str);
    lines.push("  " + fn_reg + " = load ptr, ptr " + slot_reg + ", align 8");
    lines.push("  %" + res_var + " = call i64 " + fn_reg + "(ptr %" + self_var + ")");
    return lines;
}

// Emits FIR indirect method call via vtable dispatch
pub fn emit_fir_vtable_call(
    vt: AstVTableDef,
    method_idx: i64,
    self_var: String,
    res_var: String
) -> List<String> {
    mut lines: List<String> = List::new();
    let fn_reg = "%fn_ptr." + res_var;
    let vt_ref = "@" + vt.struct_name + "$" + vt.trait_name;
    let idx_str = int_to_str(method_idx);
    lines.push("    " + fn_reg + " = fir.vtable_get " + vt_ref + "[" + idx_str + "]");
    lines.push("    %" + res_var + " = fir.call_indirect " + fn_reg + "(%" + self_var + ")");
    return lines;
}

// Unit test 9: Struct definition and instantiation LLVM and FIR emission
pub fn test_codegen_struct_definitions() -> bool {
    mut fields: List<AstStructFieldDef> = List::new();
    fields.push(AstStructFieldDef(name: "x", ty: "i64"));
    fields.push(AstStructFieldDef(name: "y", ty: "i64"));

    let struct_def = AstStructDef(is_pub: true, name: "Point", fields: fields);

    let ty_llvm = emit_llvm_struct_type(struct_def);
    if ty_llvm != "%Point = type { i64, i64 }" {
        return false;
    }

    let ty_fir = emit_fir_struct_type(struct_def);
    if ty_fir != "fir.type @Point = !fir.struct<x: i64, y: i64>" {
        return false;
    }

    mut init_fields: List<AstStructInitField> = List::new();
    init_fields.push(AstStructInitField(name: "x", val: 10));
    init_fields.push(AstStructInitField(name: "y", val: 32));

    let inst = AstStructInit(
        struct_name: "Point",
        target_var: "pt",
        fields: init_fields
    );

    let llvm_inst = emit_llvm_struct_instantiation(inst, struct_def);
    if llvm_inst.len() != 5 {
        return false;
    }
    if llvm_inst[0] != "  %pt = alloca %Point, align 8" {
        return false;
    }
    if llvm_inst[1] != "  %pt.f0 = getelementptr inbounds %Point, ptr %pt, i32 0, i32 0" {
        return false;
    }
    if llvm_inst[2] != "  store i64 10, ptr %pt.f0, align 8" {
        return false;
    }
    if llvm_inst[3] != "  %pt.f1 = getelementptr inbounds %Point, ptr %pt, i32 0, i32 1" {
        return false;
    }
    if llvm_inst[4] != "  store i64 32, ptr %pt.f1, align 8" {
        return false;
    }

    let fir_inst = emit_fir_struct_instantiation(inst);
    if fir_inst.len() != 3 {
        return false;
    }
    if fir_inst[0] != "    %pt = fir.alloca !Point" {
        return false;
    }
    if fir_inst[1] != "    fir.struct_set %pt[0] = 10" {
        return false;
    }
    if fir_inst[2] != "    fir.struct_set %pt[1] = 32" {
        return false;
    }

    return true;
}

// Unit test 10: Trait vtable emission and dynamic dispatch
pub fn test_codegen_vtable_dispatch() -> bool {
    mut methods: List<String> = List::new();
    methods.push("describe");
    methods.push("compute_hash");

    let vt = AstVTableDef(
        trait_name: "Describable",
        struct_name: "Point",
        method_names: methods
    );

    let llvm_vt = emit_llvm_vtable(vt);
    if llvm_vt != "@Point$Describable$vtable = constant [2 x ptr] [ptr @Point$describe, ptr @Point$compute_hash], align 8" {
        return false;
    }

    let fir_vt = emit_fir_vtable(vt);
    if fir_vt != "fir.vtable @Point$Describable = [@Point$describe, @Point$compute_hash]" {
        return false;
    }

    let llvm_call = emit_llvm_vtable_call(vt, 0, "pt", "res");
    if llvm_call.len() != 3 {
        return false;
    }
    if llvm_call[0] != "  %vt_slot.res = getelementptr inbounds [2 x ptr], ptr @Point$Describable$vtable, i64 0, i64 0" {
        return false;
    }
    if llvm_call[1] != "  %fn_ptr.res = load ptr, ptr %vt_slot.res, align 8" {
        return false;
    }
    if llvm_call[2] != "  %res = call i64 %fn_ptr.res(ptr %pt)" {
        return false;
    }

    let fir_call = emit_fir_vtable_call(vt, 1, "pt", "hash_val");
    if fir_call.len() != 2 {
        return false;
    }
    if fir_call[0] != "    %fn_ptr.hash_val = fir.vtable_get @Point$Describable[1]" {
        return false;
    }
    if fir_call[1] != "    %hash_val = fir.call_indirect %fn_ptr.hash_val(%pt)" {
        return false;
    }

    return true;
}

// Emits LLVM function pointer indirect call
pub fn emit_llvm_fn_ptr_call(call: AstFnPtrCall) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("  %" + call.target_var + " = call " + call.return_ty + " %" + call.fn_var + "(" + call.param_ty + " %" + call.arg_var + ")");
    return lines;
}

// Emits FIR function pointer indirect call
pub fn emit_fir_fn_ptr_call(call: AstFnPtrCall) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("    %" + call.target_var + " = fir.call_indirect %" + call.fn_var + "(%" + call.arg_var + ")");
    return lines;
}

// Emits LLVM higher-order function call passing named function pointer
pub fn emit_llvm_higher_order_call(
    callee: String,
    fn_target: String,
    val_var: String,
    res_var: String
) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("  %" + res_var + " = call i64 @" + callee + "(ptr @" + fn_target + ", i64 %" + val_var + ")");
    return lines;
}

// Emits FIR higher-order function call passing named function symbol
pub fn emit_fir_higher_order_call(
    callee: String,
    fn_target: String,
    val_var: String,
    res_var: String
) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("    %" + res_var + " = fir.call @" + callee + "(@" + fn_target + ", %" + val_var + ")");
    return lines;
}

// Emits internal LLVM thunk function unpacking stack-allocated environment and invoking target
pub fn emit_llvm_thunk_definition(thunk: AstThunkDef) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("define internal " + thunk.return_type + " @" + thunk.thunk_name + "(ptr %env_ptr, " + thunk.param_type + " %" + thunk.param_name + ") {");
    lines.push("entry:");
    mut i: i64 = 0;
    mut call_args = "";
    while i < thunk.captured_fields.len() {
        let f = thunk.captured_fields[i];
        let slot = "%cap_slot." + f.name;
        let val = "%cap_val." + f.name;
        let idx_str = int_to_str(i);
        lines.push("  " + slot + " = getelementptr inbounds %" + thunk.env_struct_name + ", ptr %env_ptr, i32 0, i32 " + idx_str);
        lines.push("  " + val + " = load " + f.ty + ", ptr " + slot + ", align 8");
        call_args = call_args + f.ty + " " + val + ", ";
        i = i + 1;
    }
    call_args = call_args + thunk.param_type + " %" + thunk.param_name;
    lines.push("  %thunk_res = call " + thunk.return_type + " @" + thunk.target_fn + "(" + call_args + ")");
    lines.push("  ret " + thunk.return_type + " %thunk_res");
    lines.push("}");
    return lines;
}

// Emits FIR thunk function definition
pub fn emit_fir_thunk_definition(thunk: AstThunkDef) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("fir.func internal @" + thunk.thunk_name + "(%env_ptr: ptr, %" + thunk.param_name + ": " + thunk.param_type + ") -> " + thunk.return_type + " {");
    lines.push("entry:");
    lines.push("  %thunk_res = fir.thunk_invoke @" + thunk.target_fn + "(%env_ptr, %" + thunk.param_name + ")");
    lines.push("  fir.return %thunk_res");
    lines.push("}");
    return lines;
}

// Emits LLVM stack-allocated closure environment initialization
pub fn emit_llvm_closure_instantiation(
    init: AstClosureInit,
    env_struct_name: String
) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("  %" + init.env_var + " = alloca %" + env_struct_name + ", align 8");
    mut i: i64 = 0;
    while i < init.captured_vals.len() {
        let cf = init.captured_vals[i];
        let slot = "%" + init.env_var + ".f" + int_to_str(i);
        let idx_str = int_to_str(i);
        let val_str = int_to_str(cf.val);
        lines.push("  " + slot + " = getelementptr inbounds %" + env_struct_name + ", ptr %" + init.env_var + ", i32 0, i32 " + idx_str);
        lines.push("  store i64 " + val_str + ", ptr " + slot + ", align 8");
        i = i + 1;
    }
    return lines;
}

// Emits FIR stack-allocated closure environment initialization
pub fn emit_fir_closure_instantiation(
    init: AstClosureInit,
    env_struct_name: String
) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("    %" + init.env_var + " = fir.alloca !" + env_struct_name);
    mut i: i64 = 0;
    while i < init.captured_vals.len() {
        let cf = init.captured_vals[i];
        let idx_str = int_to_str(i);
        let val_str = int_to_str(cf.val);
        lines.push("    fir.struct_set %" + init.env_var + "[" + idx_str + "] = " + val_str);
        i = i + 1;
    }
    return lines;
}

// Emits LLVM closure invocation via thunk and stack environment pointer
pub fn emit_llvm_closure_call(
    thunk_name: String,
    env_var: String,
    arg_var: String,
    res_var: String
) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("  %" + res_var + " = call i64 @" + thunk_name + "(ptr %" + env_var + ", i64 %" + arg_var + ")");
    return lines;
}

// Emits FIR closure invocation via thunk and environment
pub fn emit_fir_closure_call(
    thunk_name: String,
    env_var: String,
    arg_var: String,
    res_var: String
) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("    %" + res_var + " = fir.call @" + thunk_name + "(%" + env_var + ", %" + arg_var + ")");
    return lines;
}

// Unit test 11: Function pointer indirect call and higher-order function lowering
pub fn test_codegen_fn_pointer_and_indirect_call() -> bool {
    let call_ast = AstFnPtrCall(
        fn_var: "strategy_fn",
        arg_var: "input_val",
        target_var: "res",
        return_ty: "i64",
        param_ty: "i64"
    );

    let llvm_call = emit_llvm_fn_ptr_call(call_ast);
    if llvm_call.len() != 1 {
        return false;
    }
    if llvm_call[0] != "  %res = call i64 %strategy_fn(i64 %input_val)" {
        return false;
    }

    let fir_call = emit_fir_fn_ptr_call(call_ast);
    if fir_call.len() != 1 {
        return false;
    }
    if fir_call[0] != "    %res = fir.call_indirect %strategy_fn(%input_val)" {
        return false;
    }

    let ho_llvm = emit_llvm_higher_order_call("apply_fn", "square", "val", "step1");
    if ho_llvm.len() != 1 {
        return false;
    }
    if ho_llvm[0] != "  %step1 = call i64 @apply_fn(ptr @square, i64 %val)" {
        return false;
    }

    let ho_fir = emit_fir_higher_order_call("apply_fn", "square", "val", "step1");
    if ho_fir.len() != 1 {
        return false;
    }
    if ho_fir[0] != "    %step1 = fir.call @apply_fn(@square, %val)" {
        return false;
    }

    return true;
}

// Unit test 12: Lightweight zero-allocation adapter thunk and stack closure lowering
pub fn test_codegen_lightweight_thunk_and_closure() -> bool {
    mut cap_fields: List<AstStructFieldDef> = List::new();
    cap_fields.push(AstStructFieldDef(name: "offset", ty: "i64"));

    let thunk_def = AstThunkDef(
        thunk_name: "__ifa_thunk_custom_lambda",
        target_fn: "custom_lambda$body",
        env_struct_name: "ClosureEnv$1",
        captured_fields: cap_fields,
        param_name: "v",
        param_type: "i64",
        return_type: "i64"
    );

    let llvm_thunk = emit_llvm_thunk_definition(thunk_def);
    if llvm_thunk.len() != 7 {
        return false;
    }
    if llvm_thunk[0] != "define internal i64 @__ifa_thunk_custom_lambda(ptr %env_ptr, i64 %v) {" {
        return false;
    }
    if llvm_thunk[2] != "  %cap_slot.offset = getelementptr inbounds %ClosureEnv$1, ptr %env_ptr, i32 0, i32 0" {
        return false;
    }
    if llvm_thunk[3] != "  %cap_val.offset = load i64, ptr %cap_slot.offset, align 8" {
        return false;
    }
    if llvm_thunk[4] != "  %thunk_res = call i64 @custom_lambda$body(i64 %cap_val.offset, i64 %v)" {
        return false;
    }

    let fir_thunk = emit_fir_thunk_definition(thunk_def);
    if fir_thunk.len() != 5 {
        return false;
    }
    if fir_thunk[0] != "fir.func internal @__ifa_thunk_custom_lambda(%env_ptr: ptr, %v: i64) -> i64 {" {
        return false;
    }

    mut cap_vals: List<AstStructInitField> = List::new();
    cap_vals.push(AstStructInitField(name: "offset", val: 5));

    let closure_init = AstClosureInit(
        closure_name: "custom_lambda",
        env_var: "closure_env",
        thunk_name: "__ifa_thunk_custom_lambda",
        captured_vals: cap_vals
    );

    let llvm_closure = emit_llvm_closure_instantiation(closure_init, "ClosureEnv$1");
    if llvm_closure.len() != 3 {
        return false;
    }
    if llvm_closure[0] != "  %closure_env = alloca %ClosureEnv$1, align 8" {
        return false;
    }
    if llvm_closure[1] != "  %closure_env.f0 = getelementptr inbounds %ClosureEnv$1, ptr %closure_env, i32 0, i32 0" {
        return false;
    }
    if llvm_closure[2] != "  store i64 5, ptr %closure_env.f0, align 8" {
        return false;
    }

    let fir_closure = emit_fir_closure_instantiation(closure_init, "ClosureEnv$1");
    if fir_closure.len() != 2 {
        return false;
    }
    if fir_closure[0] != "    %closure_env = fir.alloca !ClosureEnv$1" {
        return false;
    }
    if fir_closure[1] != "    fir.struct_set %closure_env[0] = 5" {
        return false;
    }

    let llvm_call = emit_llvm_closure_call("__ifa_thunk_custom_lambda", "closure_env", "arg_val", "step3");
    if llvm_call.len() != 1 {
        return false;
    }
    if llvm_call[0] != "  %step3 = call i64 @__ifa_thunk_custom_lambda(ptr %closure_env, i64 %arg_val)" {
        return false;
    }

    let fir_call = emit_fir_closure_call("__ifa_thunk_custom_lambda", "closure_env", "arg_val", "step3");
    if fir_call.len() != 1 {
        return false;
    }
    if fir_call[0] != "    %step3 = fir.call @__ifa_thunk_custom_lambda(%closure_env, %arg_val)" {
        return false;
    }

    return true;
}

// Emits LLVM fiber spawn calling runtime entry point
pub fn emit_llvm_fiber_spawn(sp_expr: AstSpawnExpr) -> List<String> {
    mut lines: List<String> = List::new();
    if sp_expr.has_arg {
        lines.push("  %" + sp_expr.target_var + " = call i64 @ifa_rt_fiber_spawn(ptr @" + sp_expr.entry_fn + ", ptr %" + sp_expr.arg_var + ")");
    } else {
        lines.push("  %" + sp_expr.target_var + " = call i64 @ifa_rt_fiber_spawn(ptr @" + sp_expr.entry_fn + ", ptr null)");
    }
    return lines;
}

// Emits FIR fiber spawn instruction
pub fn emit_fir_fiber_spawn(sp_expr: AstSpawnExpr) -> List<String> {
    mut lines: List<String> = List::new();
    if sp_expr.has_arg {
        lines.push("    %" + sp_expr.target_var + " = fir.fiber_spawn @" + sp_expr.entry_fn + "(%" + sp_expr.arg_var + ")");
    } else {
        lines.push("    %" + sp_expr.target_var + " = fir.fiber_spawn @" + sp_expr.entry_fn + "()");
    }
    return lines;
}

// Emits LLVM fiber cooperative yield
pub fn emit_llvm_fiber_yield() -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("  call void @ifa_rt_fiber_yield()");
    return lines;
}

// Emits FIR fiber cooperative yield
pub fn emit_fir_fiber_yield() -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("    fir.fiber_yield");
    return lines;
}

// Emits LLVM fiber join waiting on fiber ID
pub fn emit_llvm_fiber_join(fid_var: String) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("  call void @ifa_rt_fiber_join(i64 %" + fid_var + ")");
    return lines;
}

// Emits FIR fiber join instruction
pub fn emit_fir_fiber_join(fid_var: String) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("    fir.fiber_join %" + fid_var);
    return lines;
}

// Emits LLVM channel creation
pub fn emit_llvm_chan_create(init: AstChanCreate) -> List<String> {
    mut lines: List<String> = List::new();
    let cap_str = int_to_str(init.capacity);
    lines.push("  %" + init.target_var + " = call ptr @ifa_rt_channel_create(i64 " + cap_str + ")");
    return lines;
}

// Emits FIR channel creation
pub fn emit_fir_chan_create(init: AstChanCreate) -> List<String> {
    mut lines: List<String> = List::new();
    let cap_str = int_to_str(init.capacity);
    lines.push("    %" + init.target_var + " = fir.chan_create<" + init.elem_type + ">(" + cap_str + ")");
    return lines;
}

// Emits LLVM channel send
pub fn emit_llvm_chan_send(send: AstChanSend) -> List<String> {
    mut lines: List<String> = List::new();
    let slot_var = "%chan_slot." + send.val_var;
    lines.push("  " + slot_var + " = alloca " + send.val_ty + ", align 8");
    lines.push("  store " + send.val_ty + " %" + send.val_var + ", ptr " + slot_var + ", align 8");
    lines.push("  %" + send.res_var + " = call i32 @ifa_rt_channel_send(ptr %" + send.chan_var + ", ptr " + slot_var + ")");
    return lines;
}

// Emits FIR channel send
pub fn emit_fir_chan_send(send: AstChanSend) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("    %" + send.res_var + " = fir.chan_send %" + send.chan_var + ", %" + send.val_var);
    return lines;
}

// Emits LLVM channel receive
pub fn emit_llvm_chan_recv(recv: AstChanRecv) -> List<String> {
    mut lines: List<String> = List::new();
    let slot_var = "%chan_recv_slot." + recv.target_val_var;
    lines.push("  " + slot_var + " = alloca " + recv.val_ty + ", align 8");
    lines.push("  %" + recv.res_var + " = call i32 @ifa_rt_channel_recv(ptr %" + recv.chan_var + ", ptr " + slot_var + ")");
    lines.push("  %" + recv.target_val_var + " = load " + recv.val_ty + ", ptr " + slot_var + ", align 8");
    return lines;
}

// Emits FIR channel receive
pub fn emit_fir_chan_recv(recv: AstChanRecv) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("    %" + recv.target_val_var + ", %" + recv.res_var + " = fir.chan_recv %" + recv.chan_var);
    return lines;
}

// Emits LLVM channel close
pub fn emit_llvm_chan_close(chan_var: String) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("  call void @ifa_rt_channel_close(ptr %" + chan_var + ")");
    return lines;
}

// Emits FIR channel close
pub fn emit_fir_chan_close(chan_var: String) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("    fir.chan_close %" + chan_var);
    return lines;
}

// Emits LLVM multi-channel select multiplexer
pub fn emit_llvm_chan_select(sel: AstChanSelect) -> List<String> {
    mut lines: List<String> = List::new();
    let count_str = int_to_str(sel.chan_vars.len());
    let arr_var = "%sel_arr." + sel.target_var;
    lines.push("  " + arr_var + " = alloca [" + count_str + " x ptr], align 8");
    mut i: i64 = 0;
    while i < sel.chan_vars.len() {
        let idx_str = int_to_str(i);
        let elem_slot = "%sel_elem." + sel.target_var + "." + idx_str;
        lines.push("  " + elem_slot + " = getelementptr inbounds [" + count_str + " x ptr], ptr " + arr_var + ", i64 0, i64 " + idx_str);
        lines.push("  store ptr %" + sel.chan_vars[i] + ", ptr " + elem_slot + ", align 8");
        i = i + 1;
    }
    mut def_flag = "0";
    if sel.has_default {
        def_flag = "1";
    }
    lines.push("  %" + sel.target_var + " = call i64 @ifa_rt_channel_select(ptr " + arr_var + ", i64 " + count_str + ", i32 " + def_flag + ")");
    return lines;
}

// Emits FIR multi-channel select multiplexer
pub fn emit_fir_chan_select(sel: AstChanSelect) -> List<String> {
    mut lines: List<String> = List::new();
    mut def_flag = "0";
    if sel.has_default {
        def_flag = "1";
    }
    mut chan_list = "[";
    mut i: i64 = 0;
    while i < sel.chan_vars.len() {
        if i > 0 {
            chan_list = chan_list + ", ";
        }
        chan_list = chan_list + "%" + sel.chan_vars[i];
        i = i + 1;
    }
    chan_list = chan_list + "]";
    lines.push("    %" + sel.target_var + " = fir.chan_select " + chan_list + ", default=" + def_flag);
    return lines;
}

// Unit test 13: Fiber spawn and yield lowering to runtime calls
pub fn test_codegen_fiber_spawn_and_yield() -> bool {
    let spawn_simple = AstSpawnExpr(
        target_var: "fid_simple",
        entry_fn: "worker_task",
        has_arg: false,
        arg_var: ""
    );

    let llvm_sp1 = emit_llvm_fiber_spawn(spawn_simple);
    if llvm_sp1.len() != 1 {
        return false;
    }
    if llvm_sp1[0] != "  %fid_simple = call i64 @ifa_rt_fiber_spawn(ptr @worker_task, ptr null)" {
        return false;
    }

    let fir_sp1 = emit_fir_fiber_spawn(spawn_simple);
    if fir_sp1.len() != 1 {
        return false;
    }
    if fir_sp1[0] != "    %fid_simple = fir.fiber_spawn @worker_task()" {
        return false;
    }

    let spawn_arg = AstSpawnExpr(
        target_var: "fid_arg",
        entry_fn: "worker_task_ctx",
        has_arg: true,
        arg_var: "task_ctx"
    );

    let llvm_sp2 = emit_llvm_fiber_spawn(spawn_arg);
    if llvm_sp2.len() != 1 {
        return false;
    }
    if llvm_sp2[0] != "  %fid_arg = call i64 @ifa_rt_fiber_spawn(ptr @worker_task_ctx, ptr %task_ctx)" {
        return false;
    }

    let fir_sp2 = emit_fir_fiber_spawn(spawn_arg);
    if fir_sp2.len() != 1 {
        return false;
    }
    if fir_sp2[0] != "    %fid_arg = fir.fiber_spawn @worker_task_ctx(%task_ctx)" {
        return false;
    }

    let llvm_yield = emit_llvm_fiber_yield();
    if llvm_yield.len() != 1 || llvm_yield[0] != "  call void @ifa_rt_fiber_yield()" {
        return false;
    }

    let fir_yield = emit_fir_fiber_yield();
    if fir_yield.len() != 1 || fir_yield[0] != "    fir.fiber_yield" {
        return false;
    }

    let llvm_join = emit_llvm_fiber_join("fid_simple");
    if llvm_join.len() != 1 || llvm_join[0] != "  call void @ifa_rt_fiber_join(i64 %fid_simple)" {
        return false;
    }

    let fir_join = emit_fir_fiber_join("fid_simple");
    if fir_join.len() != 1 || fir_join[0] != "    fir.fiber_join %fid_simple" {
        return false;
    }

    return true;
}

// Unit test 14: Channel create, send, recv, and close lowering
pub fn test_codegen_channel_operations() -> bool {
    let chan_init = AstChanCreate(
        target_var: "data_ch",
        elem_type: "i64",
        capacity: 64
    );

    let llvm_create = emit_llvm_chan_create(chan_init);
    if llvm_create.len() != 1 || llvm_create[0] != "  %data_ch = call ptr @ifa_rt_channel_create(i64 64)" {
        return false;
    }

    let fir_create = emit_fir_chan_create(chan_init);
    if fir_create.len() != 1 || fir_create[0] != "    %data_ch = fir.chan_create<i64>(64)" {
        return false;
    }

    let send_op = AstChanSend(
        chan_var: "data_ch",
        val_var: "payload",
        val_ty: "i64",
        res_var: "send_st"
    );

    let llvm_send = emit_llvm_chan_send(send_op);
    if llvm_send.len() != 3 {
        return false;
    }
    if llvm_send[0] != "  %chan_slot.payload = alloca i64, align 8" {
        return false;
    }
    if llvm_send[1] != "  store i64 %payload, ptr %chan_slot.payload, align 8" {
        return false;
    }
    if llvm_send[2] != "  %send_st = call i32 @ifa_rt_channel_send(ptr %data_ch, ptr %chan_slot.payload)" {
        return false;
    }

    let fir_send = emit_fir_chan_send(send_op);
    if fir_send.len() != 1 || fir_send[0] != "    %send_st = fir.chan_send %data_ch, %payload" {
        return false;
    }

    let recv_op = AstChanRecv(
        chan_var: "data_ch",
        target_val_var: "in_val",
        val_ty: "i64",
        res_var: "recv_st"
    );

    let llvm_recv = emit_llvm_chan_recv(recv_op);
    if llvm_recv.len() != 3 {
        return false;
    }
    if llvm_recv[0] != "  %chan_recv_slot.in_val = alloca i64, align 8" {
        return false;
    }
    if llvm_recv[1] != "  %recv_st = call i32 @ifa_rt_channel_recv(ptr %data_ch, ptr %chan_recv_slot.in_val)" {
        return false;
    }
    if llvm_recv[2] != "  %in_val = load i64, ptr %chan_recv_slot.in_val, align 8" {
        return false;
    }

    let fir_recv = emit_fir_chan_recv(recv_op);
    if fir_recv.len() != 1 || fir_recv[0] != "    %in_val, %recv_st = fir.chan_recv %data_ch" {
        return false;
    }

    let llvm_close = emit_llvm_chan_close("data_ch");
    if llvm_close.len() != 1 || llvm_close[0] != "  call void @ifa_rt_channel_close(ptr %data_ch)" {
        return false;
    }

    let fir_close = emit_fir_chan_close("data_ch");
    if fir_close.len() != 1 || fir_close[0] != "    fir.chan_close %data_ch" {
        return false;
    }

    return true;
}

// Unit test 15: Multi-channel select multiplexer lowering
pub fn test_codegen_channel_select() -> bool {
    mut chans: List<String> = List::new();
    chans.push("ch_alpha");
    chans.push("ch_beta");

    let sel = AstChanSelect(
        target_var: "selected_idx",
        chan_vars: chans,
        has_default: true
    );

    let llvm_sel = emit_llvm_chan_select(sel);
    if llvm_sel.len() != 6 {
        return false;
    }
    if llvm_sel[0] != "  %sel_arr.selected_idx = alloca [2 x ptr], align 8" {
        return false;
    }
    if llvm_sel[1] != "  %sel_elem.selected_idx.0 = getelementptr inbounds [2 x ptr], ptr %sel_arr.selected_idx, i64 0, i64 0" {
        return false;
    }
    if llvm_sel[2] != "  store ptr %ch_alpha, ptr %sel_elem.selected_idx.0, align 8" {
        return false;
    }
    if llvm_sel[3] != "  %sel_elem.selected_idx.1 = getelementptr inbounds [2 x ptr], ptr %sel_arr.selected_idx, i64 0, i64 1" {
        return false;
    }
    if llvm_sel[4] != "  store ptr %ch_beta, ptr %sel_elem.selected_idx.1, align 8" {
        return false;
    }
    if llvm_sel[5] != "  %selected_idx = call i64 @ifa_rt_channel_select(ptr %sel_arr.selected_idx, i64 2, i32 1)" {
        return false;
    }

    let fir_sel = emit_fir_chan_select(sel);
    if fir_sel.len() != 1 || fir_sel[0] != "    %selected_idx = fir.chan_select [%ch_alpha, %ch_beta], default=1" {
        return false;
    }

    return true;
}

// Emits LLVM multi-channel select multiplexer with timeout and priorities
pub fn emit_llvm_chan_select_timed(sel: AstChanSelectTimed) -> List<String> {
    mut lines: List<String> = List::new();
    let count_str = int_to_str(sel.chan_vars.len());
    let arr_var = "%sel_arr." + sel.target_var;
    lines.push("  " + arr_var + " = alloca [" + count_str + " x ptr], align 8");
    mut i: i64 = 0;
    while i < sel.chan_vars.len() {
        let idx_str = int_to_str(i);
        let elem_slot = "%sel_elem." + sel.target_var + "." + idx_str;
        lines.push("  " + elem_slot + " = getelementptr inbounds [" + count_str + " x ptr], ptr " + arr_var + ", i64 0, i64 " + idx_str);
        lines.push("  store ptr %" + sel.chan_vars[i] + ", ptr " + elem_slot + ", align 8");
        i = i + 1;
    }

    mut prio_ptr_var = "null";
    if sel.has_priorities {
        let prio_arr_var = "%sel_prio_arr." + sel.target_var;
        lines.push("  " + prio_arr_var + " = alloca [" + count_str + " x i32], align 4");
        mut j: i64 = 0;
        while j < sel.priorities.len() {
            let j_str = int_to_str(j);
            let prio_slot = "%sel_prio_elem." + sel.target_var + "." + j_str;
            lines.push("  " + prio_slot + " = getelementptr inbounds [" + count_str + " x i32], ptr " + prio_arr_var + ", i64 0, i64 " + j_str);
            let p_val_str = int_to_str(sel.priorities[j]);
            lines.push("  store i32 " + p_val_str + ", ptr " + prio_slot + ", align 4");
            j = j + 1;
        }
        prio_ptr_var = prio_arr_var;
    }

    let timeout_str = int_to_str(sel.timeout_ns);
    mut def_flag = "0";
    if sel.has_default {
        def_flag = "1";
    }
    lines.push("  %" + sel.target_var + " = call i64 @ifa_rt_channel_select_timed(ptr " + arr_var + ", ptr " + prio_ptr_var + ", i64 " + count_str + ", i64 " + timeout_str + ", i32 " + def_flag + ")");
    return lines;
}

// Emits FIR multi-channel select multiplexer with timeout and priorities
pub fn emit_fir_chan_select_timed(sel: AstChanSelectTimed) -> List<String> {
    mut lines: List<String> = List::new();
    mut chan_list = "[";
    mut i: i64 = 0;
    while i < sel.chan_vars.len() {
        if i > 0 {
            chan_list = chan_list + ", ";
        }
        chan_list = chan_list + "%" + sel.chan_vars[i];
        i = i + 1;
    }
    chan_list = chan_list + "]";

    mut prio_list = "[]";
    if sel.has_priorities {
        prio_list = "[";
        mut j: i64 = 0;
        while j < sel.priorities.len() {
            if j > 0 {
                prio_list = prio_list + ", ";
            }
            prio_list = prio_list + int_to_str(sel.priorities[j]);
            j = j + 1;
        }
        prio_list = prio_list + "]";
    }

    mut def_flag = "0";
    if sel.has_default {
        def_flag = "1";
    }
    let timeout_str = int_to_str(sel.timeout_ns);
    lines.push("    %" + sel.target_var + " = fir.chan_select_timed " + chan_list + ", priorities=" + prio_list + ", timeout=" + timeout_str + ", default=" + def_flag);
    return lines;
}

// Emits LLVM structured concurrency task nursery
pub fn emit_llvm_task_nursery(nursery: AstTaskNursery) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("  ; === Structured Concurrency Task Nursery: " + nursery.nursery_var + " ===");
    mut i: i64 = 0;
    while i < nursery.spawns.len() {
        let sp = nursery.spawns[i];
        let fid_var = "%" + nursery.nursery_var + ".fid." + int_to_str(i);
        mut arg_repr = "null";
        if sp.has_arg {
            arg_repr = "%" + sp.arg_var;
        }
        if nursery.use_isolated_arenas {
            lines.push("  " + fid_var + " = call i64 @ifa_rt_fiber_spawn_with_arena(ptr @" + sp.entry_fn + ", ptr " + arg_repr + ")");
        } else {
            lines.push("  " + fid_var + " = call i64 @ifa_rt_fiber_spawn(ptr @" + sp.entry_fn + ", ptr " + arg_repr + ")");
        }
        i = i + 1;
    }
    mut k: i64 = 0;
    while k < nursery.spawns.len() {
        let fid_var = "%" + nursery.nursery_var + ".fid." + int_to_str(k);
        lines.push("  call void @ifa_rt_fiber_join(i64 " + fid_var + ")");
        k = k + 1;
    }
    return lines;
}

// Emits FIR structured concurrency task nursery
pub fn emit_fir_task_nursery(nursery: AstTaskNursery) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("    fir.nursery_begin %" + nursery.nursery_var);
    mut i: i64 = 0;
    while i < nursery.spawns.len() {
        let sp = nursery.spawns[i];
        if sp.has_arg {
            lines.push("    %" + nursery.nursery_var + ".fid." + int_to_str(i) + " = fir.fiber_spawn @" + sp.entry_fn + "(%" + sp.arg_var + ")");
        } else {
            lines.push("    %" + nursery.nursery_var + ".fid." + int_to_str(i) + " = fir.fiber_spawn @" + sp.entry_fn + "()");
        }
        i = i + 1;
    }
    lines.push("    fir.nursery_join_all %" + nursery.nursery_var);
    return lines;
}

// Unit test 16: Timed and prioritized channel select lowering
pub fn test_codegen_timed_and_prioritized_channel_select() -> bool {
    mut chans: List<String> = List::new();
    chans.push("ch_urgent");
    chans.push("ch_normal");

    mut prios: List<i64> = List::new();
    prios.push(10);
    prios.push(1);

    let sel_timed = AstChanSelectTimed(
        target_var: "timed_idx",
        chan_vars: chans,
        priorities: prios,
        has_priorities: true,
        timeout_ns: 5000000,
        has_default: false
    );

    let llvm_timed = emit_llvm_chan_select_timed(sel_timed);
    if llvm_timed.len() != 11 {
        return false;
    }
    if llvm_timed[0] != "  %sel_arr.timed_idx = alloca [2 x ptr], align 8" {
        return false;
    }
    if llvm_timed[5] != "  %sel_prio_arr.timed_idx = alloca [2 x i32], align 4" {
        return false;
    }
    if llvm_timed[7] != "  store i32 10, ptr %sel_prio_elem.timed_idx.0, align 4" {
        return false;
    }
    if llvm_timed[9] != "  store i32 1, ptr %sel_prio_elem.timed_idx.1, align 4" {
        return false;
    }
    if llvm_timed[10] != "  %timed_idx = call i64 @ifa_rt_channel_select_timed(ptr %sel_arr.timed_idx, ptr %sel_prio_arr.timed_idx, i64 2, i64 5000000, i32 0)" {
        return false;
    }

    let fir_timed = emit_fir_chan_select_timed(sel_timed);
    if fir_timed.len() != 1 || fir_timed[0] != "    %timed_idx = fir.chan_select_timed [%ch_urgent, %ch_normal], priorities=[10, 1], timeout=5000000, default=0" {
        return false;
    }

    return true;
}

// Unit test 17: Structured concurrency task nursery lowering
pub fn test_codegen_task_nursery_concurrency() -> bool {
    mut spawns: List<AstSpawnExpr> = List::new();
    spawns.push(AstSpawnExpr(
        target_var: "",
        entry_fn: "bg_worker_a",
        has_arg: false,
        arg_var: ""
    ));
    spawns.push(AstSpawnExpr(
        target_var: "",
        entry_fn: "bg_worker_b",
        has_arg: true,
        arg_var: "ctx_ptr"
    ));

    let nursery = AstTaskNursery(
        nursery_var: "nursery_scope",
        spawns: spawns,
        use_isolated_arenas: true
    );

    let llvm_nursery = emit_llvm_task_nursery(nursery);
    if llvm_nursery.len() != 5 {
        return false;
    }
    if llvm_nursery[0] != "  ; === Structured Concurrency Task Nursery: nursery_scope ===" {
        return false;
    }
    if llvm_nursery[1] != "  %nursery_scope.fid.0 = call i64 @ifa_rt_fiber_spawn_with_arena(ptr @bg_worker_a, ptr null)" {
        return false;
    }
    if llvm_nursery[2] != "  %nursery_scope.fid.1 = call i64 @ifa_rt_fiber_spawn_with_arena(ptr @bg_worker_b, ptr %ctx_ptr)" {
        return false;
    }
    if llvm_nursery[3] != "  call void @ifa_rt_fiber_join(i64 %nursery_scope.fid.0)" {
        return false;
    }
    if llvm_nursery[4] != "  call void @ifa_rt_fiber_join(i64 %nursery_scope.fid.1)" {
        return false;
    }

    let fir_nursery = emit_fir_task_nursery(nursery);
    if fir_nursery.len() != 4 {
        return false;
    }
    if fir_nursery[0] != "    fir.nursery_begin %nursery_scope" {
        return false;
    }
    if fir_nursery[1] != "    %nursery_scope.fid.0 = fir.fiber_spawn @bg_worker_a()" {
        return false;
    }
    if fir_nursery[2] != "    %nursery_scope.fid.1 = fir.fiber_spawn @bg_worker_b(%ctx_ptr)" {
        return false;
    }
    if fir_nursery[3] != "    fir.nursery_join_all %nursery_scope" {
        return false;
    }

    return true;
}

// Unit test 18: If/else conditional branching codegen validation
pub fn test_codegen_if_else() -> bool {
    let var_x = AstExpr(kind: 2, val: 0, name: "x", op: 0, left: None, right: None);
    let lit42 = AstExpr(kind: 1, val: 42, name: "", op: 0, left: None, right: None);
    let lit100 = AstExpr(kind: 1, val: 100, name: "", op: 0, left: None, right: None);
    let lit0 = AstExpr(kind: 1, val: 0, name: "", op: 0, left: None, right: None);

    let if_ast = AstIf(
        cond_left: ref var_x,
        cond_op: 1, // ==
        cond_right: ref lit42,
        then_expr: ref lit100,
        has_else: true,
        else_expr: ref lit0
    );

    mut temp_id: i64 = 0;
    mut res_reg = "";
    mut llvm_lines: List<String> = List::new();
    emit_llvm_if_else(if_ast, 0, inout temp_id, "x", "%x", inout res_reg, inout llvm_lines);

    if llvm_lines.len() < 8 {
        return false;
    }
    if llvm_lines[1] != "  %t1 = icmp eq i64 %x, %t0" {
        return false;
    }
    if llvm_lines[2] != "  br i1 %t1, label %if.then.0, label %if.else.0" {
        return false;
    }
    mut has_phi = false;
    mut i: i64 = 0;
    while i < llvm_lines.len() {
        let line = llvm_lines[i];
        if line == "  %t4 = phi i64 [ %t2, %if.then.0 ], [ %t3, %if.else.0 ]" {
            has_phi = true;
        }
        i = i + 1;
    }
    return has_phi;
}

