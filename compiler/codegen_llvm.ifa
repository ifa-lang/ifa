    println("=== IFA Compiler LLVM Codegen Module ===");
    let t1 = test_codegen_fir_expression();
    let t2 = test_codegen_function_emission();
    let t3 = test_codegen_while_loop();
    let t4 = test_codegen_pattern_match();
    let t5 = test_codegen_generic_method_call();
    let t6 = test_codegen_complex_function();
    let t7 = test_codegen_global_constants();
    let t8 = test_codegen_enum_definitions();
    let t9 = test_codegen_struct_definitions();
    let t10 = test_codegen_vtable_dispatch();
    let t11 = test_codegen_fn_pointer_and_indirect_call();
    let t12 = test_codegen_lightweight_thunk_and_closure();
    let t13 = test_codegen_fiber_spawn_and_yield();
    let t14 = test_codegen_channel_operations();
    let t15 = test_codegen_channel_select();
    let t16 = test_codegen_timed_and_prioritized_channel_select();
    let t17 = test_codegen_task_nursery_concurrency();
    let t18 = test_codegen_if_else();
    if t1 && t2 && t3 && t4 && t5 && t6 && t7 && t8 && t9 && t10 && t11 && t12 && t13 && t14 && t15 && t16 && t17 && t18 {
        println("Codegen validation tests: ALL PASSED");
    } else {
        println("Codegen validation tests: FAILED");
    }
}
