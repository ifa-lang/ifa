// Pure IFA Self-Hosting Compiler - LLVM Codegen Module (`compiler/codegen_llvm.ifa`)
// Deterministic textual LLVM IR (.ll) code generator for reproducible self-hosting builds.

pub struct AstExpr {
    kind: i64,
    val: i64,
    name: String,
    op: i64,
    left: ?ref AstExpr,
    right: ?ref AstExpr
}

pub struct AstStmt {
    is_return: bool,
    target_var: String,
    expr: ?ref AstExpr
}

pub struct AstFunction {
    name: String,
    param_name: String,
    params: List<String>,
    statements: List<AstStmt>,
    is_variadic: bool
}

// Flattens call arguments from an AstExpr (kind: 4) into an ordered list
pub fn collect_call_arguments(call_expr: ?ref AstExpr, inout args: List<?ref AstExpr>) {
    if call_expr?.left == None {
        return;
    }
    args.push(call_expr?.left);
    if call_expr?.right == None {
        return;
    }
    mut curr = call_expr?.right;
    while curr != None {
        let ck = curr?.kind ?? 0;
        if ck == 9 {
            args.push(curr?.left);
            curr = curr?.right;
        } else {
            args.push(curr);
            curr = None;
        }
    }
}

// Complex AST: While Loop representation
pub struct AstWhile {
    cond_left: ?ref AstExpr,
    cond_op: i64, // 1: ==, 2: !=, 3: <, 4: <=, 5: >, 6: >=
    cond_right: ?ref AstExpr,
    body_target_var: String,
    body_expr: ?ref AstExpr
}

// Complex AST: If/Else conditional branching representation
pub struct AstIf {
    cond_left: ?ref AstExpr,
    cond_op: i64, // 1: ==, 2: !=, 3: <, 4: <=, 5: >, 6: >=
    cond_right: ?ref AstExpr,
    then_expr: ?ref AstExpr,
    has_else: bool,
    else_expr: ?ref AstExpr
}

// Complex AST: Pattern for Match expressions
pub struct AstPattern {
    kind: i64,         // 1: Wildcard `_`, 2: Literal, 3: Identifier / Binding, 4: Variant
    val: i64,          // Literal integer value
    name: String,      // Identifier / Variant name
    sub_pat_name: String, // Sub-pattern variable name
    has_sub: bool      // Whether variant has sub-pattern payload
}

// Complex AST: Match Arm
pub struct AstMatchArm {
    pat: AstPattern,
    expr: ?ref AstExpr
}

// Complex AST: Pattern Match Expression
pub struct AstMatch {
    target_var: String,
    arms: List<AstMatchArm>
}

// Complex AST: Generic Method representation with deterministic mangling
pub struct AstGenericMethod {
    trait_name: String,
    struct_name: String,
    method_name: String,
    type_param: String,
    mangled_name: String
}

// Complex AST: Comprehensive Function combining loops, match, and generic calls
pub struct AstComplexFunction {
    name: String,
    param_name: String,
    init_statements: List<AstStmt>,
    has_while: bool,
    while_loop: AstWhile,
    has_match: bool,
    match_stmt: AstMatch,
    has_generic_call: bool,
    generic_callee: String,
    return_var: String
}

// AST: Constant Definition for global emission
pub struct AstConstDef {
    is_pub: bool,
    name: String,
    ty: String,
    val: i64
}

// AST: Enum Variant Definition
pub struct AstEnumVariantDef {
    name: String,
    discriminant: i64
}

// AST: Enum Declaration Definition
pub struct AstEnumDef {
    is_pub: bool,
    name: String,
    variants: List<AstEnumVariantDef>
}

// AST: Struct Field Definition for LLVM codegen
pub struct AstStructFieldDef {
    name: String,
    ty: String
}

// AST: Struct Definition for LLVM codegen
pub struct AstStructDef {
    is_pub: bool,
    name: String,
    fields: List<AstStructFieldDef>
}

// AST: Struct Instantiation Field Value
pub struct AstStructInitField {
    name: String,
    val: i64
}

// AST: Struct Instantiation for LLVM codegen
pub struct AstStructInit {
    struct_name: String,
    target_var: String,
    fields: List<AstStructInitField>
}

// AST: VTable Definition for Trait Dispatch
pub struct AstVTableDef {
    trait_name: String,
    struct_name: String,
    method_names: List<String>
}

// AST: Function Pointer Indirect Call representation
pub struct AstFnPtrCall {
    fn_var: String,
    arg_var: String,
    target_var: String,
    return_ty: String,
    param_ty: String
}

// AST: Thunk definition for zero-allocation stack closures
pub struct AstThunkDef {
    thunk_name: String,
    target_fn: String,
    env_struct_name: String,
    captured_fields: List<AstStructFieldDef>,
    param_name: String,
    param_type: String,
    return_type: String
}

// AST: Closure stack instantiation
pub struct AstClosureInit {
    closure_name: String,
    env_var: String,
    thunk_name: String,
    captured_vals: List<AstStructInitField>
}

// AST: Fiber spawn expression for cooperative multitasking
pub struct AstSpawnExpr {
    target_var: String,
    entry_fn: String,
    has_arg: bool,
    arg_var: String
}

// AST: Channel creation statement
pub struct AstChanCreate {
    target_var: String,
    elem_type: String,
    capacity: i64
}

// AST: Channel send statement
pub struct AstChanSend {
    chan_var: String,
    val_var: String,
    val_ty: String,
    res_var: String
}

// AST: Channel receive statement
pub struct AstChanRecv {
    chan_var: String,
    target_val_var: String,
    val_ty: String,
    res_var: String
}

// AST: Multi-channel select multiplexer
pub struct AstChanSelect {
    target_var: String,
    chan_vars: List<String>,
    has_default: bool
}

// AST: Multi-channel select multiplexer with timeout and priority weights
pub struct AstChanSelectTimed {
    target_var: String,
    chan_vars: List<String>,
    priorities: List<i64>,
    has_priorities: bool,
    timeout_ns: i64,
    has_default: bool
}

// AST: Structured concurrency task nursery enclosing scoped fibers
pub struct AstTaskNursery {
    nursery_var: String,
    spawns: List<AstSpawnExpr>,
    use_isolated_arenas: bool
}

// AST: Generational arena creation
pub struct AstArenaCreate {
    target_var: String,
    capacity_bytes: i64
}

// AST: Generational memory allocation
pub struct AstArenaAlloc {
    target_var: String,
    arena_id: i64,
    size_bytes: i64,
    align_bytes: i64
}

// AST: Generational arena reset
pub struct AstArenaReset {
    arena_var: String
}

// AST: Generational reference safety verification
pub struct AstGenRefCheck {
    ptr_var: String,
    expected_gen: i64,
    arena_id: i64,
    target_checked_var: String
}

// AST: Guaranteed in-place Copy-on-Write mutation
pub struct AstCowMakeMut {
    target_var: String,
    src_var: String,
    elem_size: i64,
    align_bytes: i64
}

// AST: Guaranteed Copy-on-Write Subtree Slicing
pub struct AstCowSlice {
    target_var: String,
    src_var: String,
    offset_bytes: i64,
    len_bytes: i64
}

// AST: Guaranteed Copy-on-Write Freeze Read-Only
pub struct AstCowFreeze {
    target_var: String,
    src_var: String
}

// AST: Guaranteed Copy-on-Write Clone Subtree
pub struct AstCowCloneSubtree {
    target_var: String,
    root_var: String,
