// Pure IFA Self-Hosting Compiler - Semantic Analysis & Evaluation Module (`compiler/sema.ifa`)
// Typage, symbol resolution, generational reference traversal, and AST function evaluation.

pub struct AstExpr {
    kind: i64, // 1: Integer Literal, 2: Variable, 3: Binary Operation
    val: i64,
    name: String,
    op: i64,   // 1: Add (+), 2: Sub (-), 3: Mul (*), 4: Div (/)
    left: ?ref AstExpr,
    right: ?ref AstExpr
}

pub struct AstStmt {
    is_return: bool,
    target_var: String,
    expr: ?ref AstExpr
}

pub struct AstFunction {
    name: String,
    param_name: String,
    statements: List<AstStmt>
}

// AST Expression Evaluator traversing generational references safely
pub fn eval_expression(
    expr: ?ref AstExpr,
    param_name: String,
    param_val: i64,
    v1_name: String,
    v1_val: i64,
    v2_name: String,
    v2_val: i64
) -> i64 {
    let k = expr?.kind ?? 0;
    if k == 1 {
        // Integer Literal
        return expr?.val ?? 0;
    }
    if k == 2 {
        // Variable resolution
        let name = expr?.name ?? "";
        if name == param_name {
            return param_val;
        }
        if name == v1_name {
            return v1_val;
        }
        if name == v2_name {
            return v2_val;
        }
        return 0;
    }
    if k == 3 {
        // Binary operation evaluated recursively
        let left_val = eval_expression(expr?.left, param_name, param_val, v1_name, v1_val, v2_name, v2_val);
        let right_val = eval_expression(expr?.right, param_name, param_val, v1_name, v1_val, v2_name, v2_val);

        let op = expr?.op ?? 0;
        if op == 1 {
            return left_val + right_val;
        }
        if op == 2 {
            return left_val - right_val;
        }
        if op == 3 {
            return left_val * right_val;
        }
        if op == 4 {
            if right_val != 0 {
                return left_val / right_val;
            }
            return 0;
        }
    }
    if k == 4 {
        // Tuple expression (pair): encode as packed value (left * 1000) + right
        let left_val = eval_expression(expr?.left, param_name, param_val, v1_name, v1_val, v2_name, v2_val);
        let right_val = eval_expression(expr?.right, param_name, param_val, v1_name, v1_val, v2_name, v2_val);
        return (left_val * 1000) + right_val;
    }
    if k == 5 {
        // Tuple index access: tup.0 or tup.1
        let idx = expr?.val ?? 0;
        let tup_val = eval_expression(expr?.left, param_name, param_val, v1_name, v1_val, v2_name, v2_val);
        if idx == 0 {
            return tup_val / 1000;
        } else {
            return tup_val - ((tup_val / 1000) * 1000);
        }
    }
    if k == 6 {
        // Arena allocation: alloc(val, arena)
        return eval_expression(expr?.left, param_name, param_val, v1_name, v1_val, v2_name, v2_val);
    }
    return 0;
}

// AST Function Executor with environment tracking
pub fn execute_ast_function(func: AstFunction, arg_val: i64) -> i64 {
    mut v1_name = "";
    mut v1_val: i64 = 0;
    mut v2_name = "";
    mut v2_val: i64 = 0;

    mut i: i64 = 0;
    while i < func.statements.len() {
        let stmt = func.statements[i];
        if stmt.is_return {
            return eval_expression(stmt.expr, func.param_name, arg_val, v1_name, v1_val, v2_name, v2_val);
        } else {
            if v1_name == "" {
                v1_name = stmt.target_var;
                v1_val = eval_expression(stmt.expr, func.param_name, arg_val, v1_name, v1_val, v2_name, v2_val);
            } else {
                v2_name = stmt.target_var;
                v2_val = eval_expression(stmt.expr, func.param_name, arg_val, v1_name, v1_val, v2_name, v2_val);
            }
        }
        i = i + 1;
    }
    return 0;
}

// Generic container demonstrating polymorphic methods in self-hosting IFA compiler
pub struct CompilerResult<T> {
    success: bool,
    payload: T
}

pub fn wrap_result<T>(val: T) -> CompilerResult<T> {
    return CompilerResult(success: true, payload: val);
}

pub fn unwrap<T>(res: CompilerResult<T>) -> T {
    return res.payload;
}

// Trait and bounded generic container in self-hosting IFA compiler
pub trait Diagnosable {
    fn diagnose(self) -> String;
}

pub struct CompileDiagnostic {
    code: String,
    message: String,
}

pub fn diagnose(d: CompileDiagnostic) -> String {
    return d.message;
}

pub struct DiagnosticReporter<T: Diagnosable> {
    entry: T,
}

pub fn report_entry<T: Diagnosable>(rep: DiagnosticReporter<T>) -> String {
    return rep.entry.diagnose();
}

// Pattern matching representation for semantic evaluation
pub struct AstPattern {
    kind: i64,         // 1: Wildcard `_`, 2: Literal, 3: Identifier / Binding, 4: Variant
    val: i64,          // Literal integer value
    name: String,      // Identifier / Variant name
    has_sub: bool,     // Whether variant has sub-pattern payload
    sub_pat_name: String // Sub-pattern variable name
}

pub struct AstMatchArm {
    pat: AstPattern,
    expr: ?ref AstExpr
}

pub struct AstMatch {
    target_var: String,
    arms: List<AstMatchArm>
}

// Evaluates a pattern matching AST against a runtime value
pub fn eval_pattern_match(m: AstMatch, target_val: i64) -> i64 {
    mut i: i64 = 0;
    while i < m.arms.len() {
        let arm = m.arms[i];
        if arm.pat.kind == 1 {
            // Wildcard '_' matches anything
            return eval_expression(arm.expr, "", 0, "", 0, "", 0);
        } else if arm.pat.kind == 2 {
            // Literal value match
            if arm.pat.val == target_val {
                return eval_expression(arm.expr, "", 0, "", 0, "", 0);
            }
        } else if arm.pat.kind == 3 {
            // Identifier variable binding
            return eval_expression(arm.expr, arm.pat.name, target_val, "", 0, "", 0);
        }
        i = i + 1;
    }
    return 0;
}

// Unit test 1: Semantic evaluation over generational AST nodes
pub fn test_sema_eval() -> bool {
    mut node_left = AstExpr(kind: 2, val: 0, name: "x", op: 0, left: None, right: None);
    mut node_right = AstExpr(kind: 1, val: 40, name: "", op: 0, left: None, right: None);

    let bin_expr = AstExpr(
        kind: 3,
        val: 0,
        name: "",
        op: 1,
        left: ref node_left,
        right: ref node_right
    );

    let result = eval_expression(ref bin_expr, "x", 2, "bonus", 40, "", 0);
    return result == 42;
}

// Unit test 2: Polymorphic method dispatch on generic result container
pub fn test_sema_polymorphic_method() -> bool {
    let res = wrap_result(42);
    let unwrapped = res.unwrap();
    if unwrapped != 42 {
        return false;
    }
    let res_str = wrap_result("ifa_sema_ok");
    let unwrapped_str = res_str.unwrap();
    return unwrapped_str == "ifa_sema_ok";
}

// Unit test 3: Generic trait bound verification
pub fn test_sema_generic_trait_bound() -> bool {
    let diag = CompileDiagnostic(code: "E0001", message: "type mismatch");
    let rep = DiagnosticReporter(entry: diag);
    let msg = report_entry(rep);
    return msg == "type mismatch";
}

// Unit test 4: Semantic Pattern Matching evaluation
pub fn test_sema_pattern_matching() -> bool {
    mut pool: List<AstExpr> = List::new();
    let expr10 = AstExpr(kind: 1, val: 10, name: "", op: 0, left: None, right: None);
    pool.push(expr10);
    let idx10 = pool.len() - 1;

    let expr20 = AstExpr(kind: 1, val: 20, name: "", op: 0, left: None, right: None);
    pool.push(expr20);
    let idx20 = pool.len() - 1;

    let expr42 = AstExpr(kind: 1, val: 42, name: "", op: 0, left: None, right: None);
    pool.push(expr42);
    let idx42 = pool.len() - 1;

    mut arms: List<AstMatchArm> = List::new();
    // Arm 1: 1 => 10
    let pat1 = AstPattern(kind: 2, val: 1, name: "", has_sub: false, sub_pat_name: "");
    arms.push(AstMatchArm(pat: pat1, expr: ref pool[idx10]));
    // Arm 2: 2 => 20
    let pat2 = AstPattern(kind: 2, val: 2, name: "", has_sub: false, sub_pat_name: "");
    arms.push(AstMatchArm(pat: pat2, expr: ref pool[idx20]));
    // Arm 3: _ => 42
    let pat_def = AstPattern(kind: 1, val: 0, name: "_", has_sub: false, sub_pat_name: "");
    arms.push(AstMatchArm(pat: pat_def, expr: ref pool[idx42]));

    let match_ast = AstMatch(target_var: "status", arms: arms);

    let res1 = eval_pattern_match(match_ast, 1);
    let res2 = eval_pattern_match(match_ast, 2);
    let res_def = eval_pattern_match(match_ast, 999);

    if res1 != 10 {
        return false;
    }
    if res2 != 20 {
        return false;
    }
    return res_def == 42;
}

// Type alias symbol table and resolution
pub struct TypeAliasTable {
    names: List<String>,
    targets: List<String>
}

pub fn make_type_alias_table() -> TypeAliasTable {
    return TypeAliasTable(names: List::new(), targets: List::new());
}

pub fn register_type_alias(inout table: TypeAliasTable, name: String, target: String) {
    table.names.push(name);
    table.targets.push(target);
}

pub fn resolve_type_alias(table: TypeAliasTable, ty: String) -> String {
    mut i: i64 = 0;
    while i < table.names.len() {
        if table.names[i] == ty {
            let target = table.targets[i];
            if target != ty {
                return resolve_type_alias(table, target);
            }
            return target;
        }
        i = i + 1;
    }
    return ty;
}

// Explicit scoped arena allocator for generational memory management
pub struct ScopedArena {
    name: String,
    capacity: i64,
    allocated_bytes: i64,
    active_borrows: i64
}

pub fn make_scoped_arena(name: String, capacity: i64) -> ScopedArena {
    return ScopedArena(
        name: name,
        capacity: capacity,
        allocated_bytes: 0,
        active_borrows: 0
    );
}

pub fn arena_allocate(arena: ScopedArena, bytes: i64) -> ScopedArena {
    if arena.allocated_bytes + bytes > arena.capacity {
        return arena;
    }
    return ScopedArena(
        name: arena.name,
        capacity: arena.capacity,
        allocated_bytes: arena.allocated_bytes + bytes,
        active_borrows: arena.active_borrows
    );
}

pub fn arena_borrow_exclusive(arena: ScopedArena) -> ScopedArena {
    if arena.active_borrows > 0 {
        return arena;
    }
    return ScopedArena(
        name: arena.name,
        capacity: arena.capacity,
        allocated_bytes: arena.allocated_bytes,
        active_borrows: 1
    );
}

pub fn arena_release_exclusive(arena: ScopedArena) -> ScopedArena {
    return ScopedArena(
        name: arena.name,
        capacity: arena.capacity,
        allocated_bytes: arena.allocated_bytes,
        active_borrows: 0
    );
}

// Unit test 5: Semantic Type Alias recursive resolution
pub fn test_sema_type_alias_resolution() -> bool {
    mut table = make_type_alias_table();
    register_type_alias(inout table, "NodeId", "i64");
    register_type_alias(inout table, "VertexId", "NodeId");

    let res1 = resolve_type_alias(table, "NodeId");
    let res2 = resolve_type_alias(table, "VertexId");
    let res3 = resolve_type_alias(table, "String");

    if res1 != "i64" {
        return false;
    }
    if res2 != "i64" {
        return false;
    }
    return res3 == "String";
}

// Unit test 6: Semantic Tuple evaluation and member access
pub fn test_sema_tuple_operations() -> bool {
    mut pool: List<AstExpr> = List::new();
    let elem_left = AstExpr(kind: 1, val: 40, name: "", op: 0, left: None, right: None);
    pool.push(elem_left);
    let idx_left = pool.len() - 1;

    let elem_right = AstExpr(kind: 1, val: 2, name: "", op: 0, left: None, right: None);
    pool.push(elem_right);
    let idx_right = pool.len() - 1;

    // Tuple literal `(40, 2)` -> encoded as 40002
    let tuple_expr = AstExpr(
        kind: 4,
        val: 2,
        name: "tuple",
        op: 0,
        left: ref pool[idx_left],
        right: ref pool[idx_right]
    );
    pool.push(tuple_expr);
    let idx_tup = pool.len() - 1;

    // Tuple index 0 access
    let access_0 = AstExpr(
        kind: 5,
        val: 0,
        name: "tup",
        op: 0,
        left: ref pool[idx_tup],
        right: None
    );

    // Tuple index 1 access
    let access_1 = AstExpr(
        kind: 5,
        val: 1,
        name: "tup",
        op: 0,
        left: ref pool[idx_tup],
        right: None
    );

    let val0 = eval_expression(ref access_0, "", 0, "", 0, "", 0);
    let val1 = eval_expression(ref access_1, "", 0, "", 0, "", 0);

    if val0 != 40 {
        return false;
    }
    if val1 != 2 {
        return false;
    }
    return val0 + val1 == 42;
}

// Unit test 7: Explicit arena allocation and exclusive access semantics
pub fn test_sema_arena_allocation() -> bool {
    let arena0 = make_scoped_arena("scratch", 1024);
    let arena1 = arena_allocate(arena0, 128);
    if arena1.allocated_bytes != 128 {
        return false;
    }

    // Test exclusive borrow
    let arena_borrowed = arena_borrow_exclusive(arena1);
    if arena_borrowed.active_borrows != 1 {
        return false;
    }
    let arena_released = arena_release_exclusive(arena_borrowed);
    return arena_released.active_borrows == 0;
}

// Constant symbol table and lookup
pub struct ConstSymbolTable {
    names: List<String>,
    values: List<i64>
}

pub fn make_const_table() -> ConstSymbolTable {
    return ConstSymbolTable(names: List::new(), values: List::new());
}

pub fn register_const(inout table: ConstSymbolTable, name: String, val: i64) {
    table.names.push(name);
    table.values.push(val);
}

pub fn resolve_const(table: ConstSymbolTable, name: String) -> i64 {
    mut i: i64 = 0;
    while i < table.names.len() {
        if table.names[i] == name {
            return table.values[i];
        }
        i = i + 1;
    }
    return 0;
}

pub fn has_const(table: ConstSymbolTable, name: String) -> bool {
    mut i: i64 = 0;
    while i < table.names.len() {
        if table.names[i] == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Enum symbol table and discriminant resolution
pub struct EnumSymbolTable {
    enum_names: List<String>,
    variant_names: List<String>,
    discriminants: List<i64>
}

pub fn make_enum_table() -> EnumSymbolTable {
    return EnumSymbolTable(
        enum_names: List::new(),
        variant_names: List::new(),
        discriminants: List::new()
    );
}

pub fn register_enum_variant(
    inout table: EnumSymbolTable,
    enum_name: String,
    variant_name: String,
    disc: i64
) {
    table.enum_names.push(enum_name);
    table.variant_names.push(variant_name);
    table.discriminants.push(disc);
}

pub fn resolve_enum_discriminant(
    table: EnumSymbolTable,
    enum_name: String,
    variant_name: String
) -> i64 {
    mut i: i64 = 0;
    while i < table.enum_names.len() {
        if table.enum_names[i] == enum_name && table.variant_names[i] == variant_name {
            return table.discriminants[i];
        }
        i = i + 1;
    }
    return -1;
}

// Unit test 8: Constant resolution and lookup
pub fn test_sema_const_resolution() -> bool {
    mut table = make_const_table();
    register_const(inout table, "MAX_BUFFER_SIZE", 4096);
    register_const(inout table, "DEFAULT_ALIGN", 8);

    if !has_const(table, "MAX_BUFFER_SIZE") {
        return false;
    }
    if !has_const(table, "DEFAULT_ALIGN") {
        return false;
    }
    if has_const(table, "NON_EXISTENT") {
        return false;
    }

    let val1 = resolve_const(table, "MAX_BUFFER_SIZE");
    let val2 = resolve_const(table, "DEFAULT_ALIGN");

    return val1 == 4096 && val2 == 8;
}

// Unit test 9: Enum discriminant resolution
pub fn test_sema_enum_resolution() -> bool {
    mut table = make_enum_table();
    register_enum_variant(inout table, "TokenKind", "Eof", 0);
    register_enum_variant(inout table, "TokenKind", "Identifier", 1);
    register_enum_variant(inout table, "TokenKind", "Number", 2);
    register_enum_variant(inout table, "TokenKind", "Plus", 3);

    let d0 = resolve_enum_discriminant(table, "TokenKind", "Eof");
    let d1 = resolve_enum_discriminant(table, "TokenKind", "Identifier");
    let d2 = resolve_enum_discriminant(table, "TokenKind", "Number");
    let d3 = resolve_enum_discriminant(table, "TokenKind", "Plus");
    let d_missing = resolve_enum_discriminant(table, "TokenKind", "Minus");

    if d0 != 0 || d1 != 1 || d2 != 2 || d3 != 3 {
        return false;
    }
    return d_missing == -1;
}

pub fn main() {
    println("=== IFA Compiler Sema Module ===");
    let t1 = test_sema_eval();
    let t2 = test_sema_polymorphic_method();
    let t3 = test_sema_generic_trait_bound();
    let t4 = test_sema_pattern_matching();
    let t5 = test_sema_type_alias_resolution();
    let t6 = test_sema_tuple_operations();
    let t7 = test_sema_arena_allocation();
    let t8 = test_sema_const_resolution();
    let t9 = test_sema_enum_resolution();
    if t1 && t2 && t3 && t4 && t5 && t6 && t7 && t8 && t9 {
        println("Sema validation tests: ALL PASSED");
    } else {
        println("Sema validation tests: FAILED");
    }
}
