// Pure IFA Self-Hosting Compiler - Lexer Module (`compiler/lexer.ifa`)
// Deterministic lexical scanner and token generation for IFA bootstrap compiler.

comptime fn build_keyword_lut() -> [i64; 21] {
    return [1, 2, 3, 4, 5, 6, 7, 8, 9, 12, 13, 14, 15, 16, 17, 18, 19, 26, 27, 28, 29];
}

pub const KEYWORD_LUT = comptime build_keyword_lut();

// Token representation in IFA
pub struct Token {
    kind: i64,
    value: i64,
    lexeme: String
}

// Token constructor
pub fn make_token(kind: i64, value: i64, lexeme: String) -> Token {
    return Token(kind: kind, value: value, lexeme: lexeme);
}

// Append a token to the token stream inout list
pub fn advance_token(inout stream: List<Token>, kind: i64, value: i64, lexeme: String) {
    let tok = make_token(kind, value, lexeme);
    stream.push(tok);
}

// Populate sample program tokens:
// `fn compute(inout x: i64) -> i64 { let bonus = 40; return x + bonus; }`
pub fn populate_sample_tokens(inout tokens: List<Token>) {
    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "compute");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 5, 0, "inout");
    advance_token(inout tokens, 10, 0, "x");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 2, 0, "let");
    advance_token(inout tokens, 10, 0, "bonus");
    advance_token(inout tokens, 24, 0, "=");
    advance_token(inout tokens, 11, 40, "40");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 4, 0, "return");
    advance_token(inout tokens, 10, 0, "x");
    advance_token(inout tokens, 20, 0, "+");
    advance_token(inout tokens, 10, 0, "bonus");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");
}

// Tokenize sample program:
pub fn tokenize_sample_program() -> List<Token> {
    mut tokens: List<Token> = List::new();
    populate_sample_tokens(inout tokens);
    return tokens;
}

// Tokenize arithmetic program:
// `fn arithmetic(inout x: i64) -> i64 { let factor = 3; let offset = 10; return (x + 2) * factor + offset; }`
pub fn tokenize_arithmetic_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "arithmetic");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 5, 0, "inout");
    advance_token(inout tokens, 10, 0, "x");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 2, 0, "let");
    advance_token(inout tokens, 10, 0, "factor");
    advance_token(inout tokens, 24, 0, "=");
    advance_token(inout tokens, 11, 3, "3");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 2, 0, "let");
    advance_token(inout tokens, 10, 0, "offset");
    advance_token(inout tokens, 24, 0, "=");
    advance_token(inout tokens, 11, 10, "10");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 4, 0, "return");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 10, 0, "x");
    advance_token(inout tokens, 20, 0, "+");
    advance_token(inout tokens, 11, 2, "2");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 22, 0, "*");
    advance_token(inout tokens, 10, 0, "factor");
    advance_token(inout tokens, 20, 0, "+");
    advance_token(inout tokens, 10, 0, "offset");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize trait declaration:
// `pub trait Diagnosable { fn diagnose(self) -> String; }`
pub fn tokenize_trait_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    advance_token(inout tokens, 15, 0, "pub");
    advance_token(inout tokens, 9, 0, "trait");
    advance_token(inout tokens, 10, 0, "Diagnosable");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "diagnose");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 10, 0, "self");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "String");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize impl declaration:
// `impl Diagnosable for Diagnostic { fn diagnose(self) -> String { return msg; } }`
pub fn tokenize_impl_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    advance_token(inout tokens, 12, 0, "impl");
    advance_token(inout tokens, 10, 0, "Diagnosable");
    advance_token(inout tokens, 13, 0, "for");
    advance_token(inout tokens, 10, 0, "Diagnostic");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "diagnose");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 10, 0, "self");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "Diagnostic");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "String");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 4, 0, "return");
    advance_token(inout tokens, 10, 0, "msg");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize pattern matching expression:
// `match val { 1 => 10, 2 => 20, _ => 42 }`
pub fn tokenize_match_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    advance_token(inout tokens, 14, 0, "match");
    advance_token(inout tokens, 10, 0, "val");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 11, 1, "1");
    advance_token(inout tokens, 37, 0, "=>");
    advance_token(inout tokens, 11, 10, "10");
    advance_token(inout tokens, 39, 0, ",");
    advance_token(inout tokens, 11, 2, "2");
    advance_token(inout tokens, 37, 0, "=>");
    advance_token(inout tokens, 11, 20, "20");
    advance_token(inout tokens, 39, 0, ",");
    advance_token(inout tokens, 38, 0, "_");
    advance_token(inout tokens, 37, 0, "=>");
    advance_token(inout tokens, 11, 42, "42");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize full program with high-level items:
// pub trait Diagnosable { fn diagnose(self) -> String; }
// pub struct Diagnostic { code: i64, msg: String }
// fn compute(inout x: i64) -> i64 { return x; }
pub fn tokenize_full_module() -> List<Token> {
    mut tokens: List<Token> = List::new();

    // 1. Trait item
    advance_token(inout tokens, 15, 0, "pub");
    advance_token(inout tokens, 9, 0, "trait");
    advance_token(inout tokens, 10, 0, "Diagnosable");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "diagnose");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 10, 0, "self");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "String");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    // 2. Struct item
    advance_token(inout tokens, 15, 0, "pub");
    advance_token(inout tokens, 8, 0, "struct");
    advance_token(inout tokens, 10, 0, "Diagnostic");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 10, 0, "code");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 39, 0, ",");
    advance_token(inout tokens, 10, 0, "msg");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "String");
    advance_token(inout tokens, 33, 0, "}");

    // 3. Function item
    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "compute");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 5, 0, "inout");
    advance_token(inout tokens, 10, 0, "x");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 4, 0, "return");
    advance_token(inout tokens, 10, 0, "x");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize type alias declarations:
// `pub type NodeId = i64; type Pair = (i64, i64);`
pub fn tokenize_type_alias_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    // 1. pub type NodeId = i64;
    advance_token(inout tokens, 15, 0, "pub");
    advance_token(inout tokens, 17, 0, "type");
    advance_token(inout tokens, 10, 0, "NodeId");
    advance_token(inout tokens, 24, 0, "=");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 35, 0, ";");

    // 2. type Pair = (i64, i64);
    advance_token(inout tokens, 17, 0, "type");
    advance_token(inout tokens, 10, 0, "Pair");
    advance_token(inout tokens, 24, 0, "=");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 39, 0, ",");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 35, 0, ";");

    return tokens;
}

// Tokenize tuple expressions and function return type:
// `fn make_pair(inout a: i64) -> (i64, i64) { let p = (a, 42); return p; }`
pub fn tokenize_tuple_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "make_pair");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 5, 0, "inout");
    advance_token(inout tokens, 10, 0, "a");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 39, 0, ",");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 2, 0, "let");
    advance_token(inout tokens, 10, 0, "p");
    advance_token(inout tokens, 24, 0, "=");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 10, 0, "a");
    advance_token(inout tokens, 39, 0, ",");
    advance_token(inout tokens, 11, 42, "42");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 4, 0, "return");
    advance_token(inout tokens, 10, 0, "p");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize explicit arena declaration:
// `arena scratch; fn build_node(val: i64) -> i64 { return val; }`
pub fn tokenize_arena_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    advance_token(inout tokens, 18, 0, "arena");
    advance_token(inout tokens, 10, 0, "scratch");
    advance_token(inout tokens, 35, 0, ";");

    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "build_node");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 10, 0, "val");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 4, 0, "return");
    advance_token(inout tokens, 10, 0, "val");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize constant declarations:
// `pub const MAX_BUFFER_SIZE: i64 = 4096; const DEFAULT_ALIGN: i64 = 8;`
pub fn tokenize_const_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    // 1. pub const MAX_BUFFER_SIZE: i64 = 4096;
    advance_token(inout tokens, 15, 0, "pub");
    advance_token(inout tokens, 19, 0, "const");
    advance_token(inout tokens, 10, 0, "MAX_BUFFER_SIZE");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 24, 0, "=");
    advance_token(inout tokens, 11, 4096, "4096");
    advance_token(inout tokens, 35, 0, ";");

    // 2. const DEFAULT_ALIGN: i64 = 8;
    advance_token(inout tokens, 19, 0, "const");
    advance_token(inout tokens, 10, 0, "DEFAULT_ALIGN");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 24, 0, "=");
    advance_token(inout tokens, 11, 8, "8");
    advance_token(inout tokens, 35, 0, ";");

    return tokens;
}

// Tokenize enum declaration:
// `pub enum TokenKind { Eof, Identifier, Number, Plus }`
pub fn tokenize_enum_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    advance_token(inout tokens, 15, 0, "pub");
    advance_token(inout tokens, 26, 0, "enum");
    advance_token(inout tokens, 10, 0, "TokenKind");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 10, 0, "Eof");
    advance_token(inout tokens, 39, 0, ",");
    advance_token(inout tokens, 10, 0, "Identifier");
    advance_token(inout tokens, 39, 0, ",");
    advance_token(inout tokens, 10, 0, "Number");
    advance_token(inout tokens, 39, 0, ",");
    advance_token(inout tokens, 10, 0, "Plus");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize comptime directive program:
// `comptime { let limit = 100; } fn eval_limit() -> i64 { return comptime 100; }`
pub fn tokenize_comptime_directive_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    // 1. comptime block
    advance_token(inout tokens, 52, 0, "comptime");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 2, 0, "let");
    advance_token(inout tokens, 10, 0, "limit");
    advance_token(inout tokens, 24, 0, "=");
    advance_token(inout tokens, 11, 100, "100");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    // 2. fn eval_limit() -> i64 { return comptime 100; }
    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "eval_limit");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 4, 0, "return");
    advance_token(inout tokens, 52, 0, "comptime");
    advance_token(inout tokens, 11, 100, "100");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize syntax macro definition and invocation program:
// `macro def_calc($val) { fn calc() -> i64 { return $val; } } def_calc!(42);`
pub fn tokenize_syntax_macro_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    // 1. macro def_calc($val) { fn calc() -> i64 { return $val; } }
    advance_token(inout tokens, 51, 0, "macro");
    advance_token(inout tokens, 10, 0, "def_calc");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 53, 0, "$");
    advance_token(inout tokens, 10, 0, "val");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "calc");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 4, 0, "return");
    advance_token(inout tokens, 53, 0, "$");
    advance_token(inout tokens, 10, 0, "val");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");
    advance_token(inout tokens, 33, 0, "}");

    // 2. def_calc!(42);
    advance_token(inout tokens, 10, 0, "def_calc");
    advance_token(inout tokens, 50, 0, "!");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 11, 42, "42");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 35, 0, ";");

    return tokens;
}

// Tokenize while loop statement program:
// `fn count_down(mut x: i64) -> i64 { while x > 0 { x = x - 1; } return x; }`
pub fn tokenize_while_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "count_down");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 5, 0, "mut");
    advance_token(inout tokens, 10, 0, "x");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 32, 0, "{");

    // while x > 0 { x = x - 1; }
    advance_token(inout tokens, 27, 0, "while");
    advance_token(inout tokens, 10, 0, "x");
    advance_token(inout tokens, 44, 0, ">");
    advance_token(inout tokens, 11, 0, "0");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 10, 0, "x");
    advance_token(inout tokens, 24, 0, "=");
    advance_token(inout tokens, 10, 0, "x");
    advance_token(inout tokens, 21, 0, "-");
    advance_token(inout tokens, 11, 1, "1");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    // return x; }
    advance_token(inout tokens, 4, 0, "return");
    advance_token(inout tokens, 10, 0, "x");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize if/else branching statement program:
// `fn branch_check(x: i64) -> i64 { if x == 42 { return 100; } else { return 0; } }`
pub fn tokenize_if_else_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "branch_check");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 10, 0, "x");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 32, 0, "{");

    // if x == 42 { return 100; } else { return 0; }
    advance_token(inout tokens, 28, 0, "if");
    advance_token(inout tokens, 10, 0, "x");
    advance_token(inout tokens, 40, 0, "==");
    advance_token(inout tokens, 11, 42, "42");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 4, 0, "return");
    advance_token(inout tokens, 11, 100, "100");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");
    advance_token(inout tokens, 29, 0, "else");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 4, 0, "return");
    advance_token(inout tokens, 11, 0, "0");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Unit test: Token stream verification and list properties
pub fn test_lexer_stream() -> bool {
    let tokens = tokenize_sample_program();
    if tokens.len() != 22 {
        return false;
    }
    let first = tokens[0];
    if first.kind != 1 {
        return false;
    }
    let let_tok = tokens[11];
    if let_tok.kind != 2 {
        return false;
    }
    let num_tok = tokens[14];
    if num_tok.value != 40 {
        return false;
    }
    return true;
}

// Unit test: Comptime keyword LUT validation
pub fn test_comptime_keyword_lut() -> bool {
    return KEYWORD_LUT.len() == 21;
}

// Unit test: Type alias tokenization validation
pub fn test_lexer_type_alias() -> bool {
    let tokens = tokenize_type_alias_program();
    if tokens.len() != 15 {
        return false;
    }
    // 0: pub, 1: type, 2: NodeId, 3: =, 4: i64, 5: ;
    if tokens[0].kind != 15 || tokens[1].kind != 17 || tokens[2].lexeme != "NodeId" {
        return false;
    }
    // 6: type, 7: Pair
    if tokens[6].kind != 17 || tokens[7].lexeme != "Pair" {
        return false;
    }
    return true;
}

// Unit test: Tuple tokenization validation
pub fn test_lexer_tuples() -> bool {
    let tokens = tokenize_tuple_program();
    if tokens.len() != 28 {
        return false;
    }
    // Check let p = (a, 42);
    // index 18: (, 19: a, 20: ,, 21: 42, 22: )
    if tokens[18].kind != 30 || tokens[20].kind != 39 || tokens[22].kind != 31 {
        return false;
    }
    return tokens[21].value == 42;
}

// Unit test: Arena tokenization validation
pub fn test_lexer_arena() -> bool {
    let tokens = tokenize_arena_program();
    if tokens.len() != 17 {
        return false;
    }
    // index 0: arena, index 1: scratch, index 2: ;
    if tokens[0].kind != 18 || tokens[1].lexeme != "scratch" || tokens[2].kind != 35 {
        return false;
    }
    return true;
}

// Unit test: Constant declaration tokenization validation
pub fn test_lexer_const_declaration() -> bool {
    let tokens = tokenize_const_program();
    if tokens.len() != 15 {
        return false;
    }
    // 0: pub, 1: const, 2: MAX_BUFFER_SIZE, 6: 4096
    if tokens[0].kind != 15 || tokens[1].kind != 19 || tokens[2].lexeme != "MAX_BUFFER_SIZE" {
        return false;
    }
    if tokens[6].kind != 11 || tokens[6].value != 4096 {
        return false;
    }
    // 8: const, 9: DEFAULT_ALIGN, 13: 8
    if tokens[8].kind != 19 || tokens[9].lexeme != "DEFAULT_ALIGN" || tokens[13].value != 8 {
        return false;
    }
    return true;
}

// Unit test: Enum declaration tokenization validation
pub fn test_lexer_enum_declaration() -> bool {
    let tokens = tokenize_enum_program();
    if tokens.len() != 12 {
        return false;
    }
    // 0: pub, 1: enum, 2: TokenKind, 3: {, 4: Eof, 6: Identifier, 8: Number, 10: Plus, 11: }
    if tokens[0].kind != 15 || tokens[1].kind != 26 || tokens[2].lexeme != "TokenKind" {
        return false;
    }
    if tokens[4].lexeme != "Eof" || tokens[6].lexeme != "Identifier" {
        return false;
    }
    if tokens[8].lexeme != "Number" || tokens[10].lexeme != "Plus" || tokens[11].kind != 33 {
        return false;
    }
    return true;
}

// Unit test: Comptime directive tokenization validation
pub fn test_lexer_comptime_directives() -> bool {
    let tokens = tokenize_comptime_directive_program();
    if tokens.len() != 20 {
        return false;
    }
    // index 0: comptime (52), index 1: { (32)
    if tokens[0].kind != 52 || tokens[0].lexeme != "comptime" || tokens[1].kind != 32 {
        return false;
    }
    // index 5: 100 (11)
    if tokens[5].kind != 11 || tokens[5].value != 100 {
        return false;
    }
    // index 16: comptime (52), index 17: 100 (11)
    if tokens[16].kind != 52 || tokens[17].value != 100 {
        return false;
    }
    return true;
}

// Unit test: Syntax macro tokenization validation
pub fn test_lexer_syntax_macros() -> bool {
    let tokens = tokenize_syntax_macro_program();
    if tokens.len() != 26 {
        return false;
    }
    // index 0: macro (51), index 1: def_calc (10), index 3: $ (53), index 4: val (10)
    if tokens[0].kind != 51 || tokens[1].lexeme != "def_calc" || tokens[3].kind != 53 || tokens[4].lexeme != "val" {
        return false;
    }
    // invocation: index 20: def_calc (10), index 21: ! (50), index 23: 42 (11)
    if tokens[20].lexeme != "def_calc" || tokens[21].kind != 50 || tokens[23].value != 42 {
        return false;
    }
    return true;
}

// Unit test: While loop tokenization validation
pub fn test_lexer_while_loop() -> bool {
    let tokens = tokenize_while_program();
    if tokens.len() != 27 {
        return false;
    }
    // index 11: while (27), index 12: x (10), index 13: > (44), index 14: 0 (11)
    if tokens[11].kind != 27 || tokens[11].lexeme != "while" {
        return false;
    }
    if tokens[13].kind != 44 || tokens[14].kind != 11 {
        return false;
    }
    return true;
}

// Unit test: If/else conditional branching tokenization validation
pub fn test_lexer_if_else() -> bool {
    let tokens = tokenize_if_else_program();
    if tokens.len() != 26 {
        return false;
    }
    // index 10: if (28), index 12: == (40), index 13: 42 (11), index 19: else (29)
    if tokens[10].kind != 28 || tokens[10].lexeme != "if" {
        return false;
    }
    if tokens[12].kind != 40 || tokens[13].value != 42 {
        return false;
    }
    if tokens[19].kind != 29 || tokens[19].lexeme != "else" {
        return false;
    }
    return true;
}

// --- Streaming Source Lexer ---
//
// tokenize_source(src: String) -> List<Token>
//
// Performs a full character-by-character scan of a raw IFA source string and
// produces a deterministic token stream.  The function is used by the driver to
// lex source files read from disk with `fs::read_to_string`.
//
// Character code constants (ASCII):
//   space=32, tab=9, CR=13, LF=10
//   '0'=48 … '9'=57
//   'A'=65 … 'Z'=90
//   'a'=97 … 'z'=122
//   '_'=95
//   '"'=34   '\''=39   '/'=47   '*'=42   '\n'=10
//   '!'=33   '$'=36   '#'=35   '@'=64   '`'=96
//
// Token kind encoding matches the hand-built tokenizers above.

/// Return true when `c` is a decimal digit (0-9).
fn is_digit(c: i64) -> bool {
    return c >= 48 && c <= 57;
}

/// Return true when `c` is a valid first character of an identifier (letter or '_').
fn is_alpha(c: i64) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

/// Return true when `c` is a valid non-first character of an identifier.
fn is_alnum(c: i64) -> bool {
    return is_alpha(c) || is_digit(c);
}

/// Return the token kind for a known keyword string, or 10 (Ident) if unknown.
fn keyword_kind(word: String) -> i64 {
    if word == "fn"       { return 1; }
    if word == "let"      { return 2; }
    if word == "mut"      { return 3; }
    if word == "return"   { return 4; }
    if word == "inout"    { return 5; }
    if word == "in"       { return 6; }
    if word == "sink"     { return 7; }
    if word == "struct"   { return 8; }
    if word == "trait"    { return 9; }
    if word == "impl"     { return 12; }
    if word == "for"      { return 13; }
    if word == "match"    { return 14; }
    if word == "pub"      { return 15; }
    if word == "self"     { return 16; }
    if word == "type"     { return 17; }
    if word == "arena"    { return 18; }
    if word == "const"    { return 19; }
    if word == "enum"     { return 26; }
    if word == "while"    { return 27; }
    if word == "if"       { return 28; }
    if word == "else"     { return 29; }
    if word == "macro"    { return 51; }
    if word == "comptime" { return 52; }
    if word == "true"     { return 11; }
    if word == "false"    { return 11; }
    return 10;
}

/// Convert a single hex ASCII character to its 0..15 numeric value, or -1 if invalid.
fn hex_digit_val(c: i64) -> i64 {
    if c >= 48 && c <= 57 { return c - 48; }
    if c >= 65 && c <= 70 { return c - 55; }
    if c >= 97 && c <= 102 { return c - 87; }
    return -1;
}

/// Build a single-character string from an ASCII codepoint.
/// Returns an empty string for codepoints outside printable ASCII.
fn char_to_string(c: i64) -> String {
    // Map codepoint to a precomputed single-char string.
    // We cover the full printable ASCII range 32-126 plus common escapes and control characters.
    if c == 0   { return "\0"; }
    if c == 32  { return " "; }
    if c == 10  { return "\n"; }
    if c == 9   { return "\t"; }
    if c == 13  { return "\r"; }
    if c == 33  { return "!"; }
    if c == 34  { return "\""; }
    if c == 35  { return "#"; }
    if c == 36  { return "$"; }
    if c == 37  { return "%"; }
    if c == 38  { return "&"; }
    if c == 39  { return "'"; }
    if c == 40  { return "("; }
    if c == 41  { return ")"; }
    if c == 42  { return "*"; }
    if c == 43  { return "+"; }
    if c == 44  { return ","; }
    if c == 45  { return "-"; }
    if c == 46  { return "."; }
    if c == 47  { return "/"; }
    if c == 48  { return "0"; }
    if c == 49  { return "1"; }
    if c == 50  { return "2"; }
    if c == 51  { return "3"; }
    if c == 52  { return "4"; }
    if c == 53  { return "5"; }
    if c == 54  { return "6"; }
    if c == 55  { return "7"; }
    if c == 56  { return "8"; }
    if c == 57  { return "9"; }
    if c == 58  { return ":"; }
    if c == 59  { return ";"; }
    if c == 60  { return "<"; }
    if c == 61  { return "="; }
    if c == 62  { return ">"; }
    if c == 63  { return "?"; }
    if c == 64  { return "@"; }
    if c == 65  { return "A"; }
    if c == 66  { return "B"; }
    if c == 67  { return "C"; }
    if c == 68  { return "D"; }
    if c == 69  { return "E"; }
    if c == 70  { return "F"; }
    if c == 71  { return "G"; }
    if c == 72  { return "H"; }
    if c == 73  { return "I"; }
    if c == 74  { return "J"; }
    if c == 75  { return "K"; }
    if c == 76  { return "L"; }
    if c == 77  { return "M"; }
    if c == 78  { return "N"; }
    if c == 79  { return "O"; }
    if c == 80  { return "P"; }
    if c == 81  { return "Q"; }
    if c == 82  { return "R"; }
    if c == 83  { return "S"; }
    if c == 84  { return "T"; }
    if c == 85  { return "U"; }
    if c == 86  { return "V"; }
    if c == 87  { return "W"; }
    if c == 88  { return "X"; }
    if c == 89  { return "Y"; }
    if c == 90  { return "Z"; }
    if c == 91  { return "["; }
    if c == 92  { return "\\"; }
    if c == 93  { return "]"; }
    if c == 94  { return "^"; }
    if c == 95  { return "_"; }
    if c == 96  { return "`"; }
    if c == 97  { return "a"; }
    if c == 98  { return "b"; }
    if c == 99  { return "c"; }
    if c == 100 { return "d"; }
    if c == 101 { return "e"; }
    if c == 102 { return "f"; }
    if c == 103 { return "g"; }
    if c == 104 { return "h"; }
    if c == 105 { return "i"; }
    if c == 106 { return "j"; }
    if c == 107 { return "k"; }
    if c == 108 { return "l"; }
    if c == 109 { return "m"; }
    if c == 110 { return "n"; }
    if c == 111 { return "o"; }
    if c == 112 { return "p"; }
    if c == 113 { return "q"; }
    if c == 114 { return "r"; }
    if c == 115 { return "s"; }
    if c == 116 { return "t"; }
    if c == 117 { return "u"; }
    if c == 118 { return "v"; }
    if c == 119 { return "w"; }
    if c == 120 { return "x"; }
    if c == 121 { return "y"; }
    if c == 122 { return "z"; }
    if c == 123 { return "{"; }
    if c == 124 { return "|"; }
    if c == 125 { return "}"; }
    if c == 126 { return "~"; }
    return "";
}

/// Full deterministic source-level tokenizer.
///
/// Accepts the entire source text of an IFA module as a `String` and returns
/// a `List<Token>` using the same kind/value/lexeme encoding as the hand-built
/// tokenizers.  Whitespace and line comments (`//`) are silently skipped.
/// Block comments (`/* … */`) are also consumed without emitting tokens.
pub fn tokenize_source(src: String) -> List<Token> {
    mut tokens: List<Token> = List::new();
    let n = string_len(src);
    mut i: i64 = 0;

    while i < n {
        let c = string_char_at(src, i);

        // --- Skip whitespace ---
        if c == 32 || c == 9 || c == 13 || c == 10 {
            i = i + 1;
        } else {
            // --- Line comment: // ---
            if c == 47 {
                let c2 = string_char_at(src, i + 1);
                if c2 == 47 {
                    // Skip until end of line
                    i = i + 2;
                    while i < n && string_char_at(src, i) != 10 {
                        i = i + 1;
                    }
                } else {
                    // Block comment: /*
                    if c2 == 42 {
                        i = i + 2;
                        mut in_bcomment: bool = true;
                        while i < n && in_bcomment {
                            let bc = string_char_at(src, i);
                            if bc == 42 && string_char_at(src, i + 1) == 47 {
                                i = i + 2;
                                in_bcomment = false;
                            } else {
                                i = i + 1;
                            }
                        }
                    } else {
                        // Division operator
                        advance_token(inout tokens, 23, 0, "/");
                        i = i + 1;
                    }
                }
            } else {
                // --- Integer literal ---
                if is_digit(c) {
                    mut num_val: i64 = 0;
                    mut num_lex: String = "";
                    while i < n && is_digit(string_char_at(src, i)) {
                        let d = string_char_at(src, i);
                        num_val = num_val * 10 + (d - 48);
                        num_lex = num_lex + char_to_string(d);
                        i = i + 1;
                    }
                    advance_token(inout tokens, 11, num_val, num_lex);
                } else {
                    // --- Raw string literal: r"..." or r#"..."# ---
                    if c == 114 && i + 1 < n && string_char_at(src, i + 1) == 34 {
                        mut sl: String = "";
                        i = i + 2; // consume r"
                        while i < n && string_char_at(src, i) != 34 {
                            sl = sl + char_to_string(string_char_at(src, i));
                            i = i + 1;
                        }
                        if i < n && string_char_at(src, i) == 34 {
                            i = i + 1; // consume closing "
                        }
                        advance_token(inout tokens, 60, 0, sl);
                    } else if c == 114 && i + 2 < n && string_char_at(src, i + 1) == 35 && string_char_at(src, i + 2) == 34 {
                        mut sl: String = "";
                        i = i + 3; // consume r#"
                        while i < n && !(string_char_at(src, i) == 34 && i + 1 < n && string_char_at(src, i + 1) == 35) {
                            sl = sl + char_to_string(string_char_at(src, i));
                            i = i + 1;
                        }
                        if i + 1 < n && string_char_at(src, i) == 34 && string_char_at(src, i + 1) == 35 {
                            i = i + 2; // consume closing "#
                        }
                        advance_token(inout tokens, 60, 0, sl);
                    } else if is_alpha(c) {
                        mut word: String = "";
                        while i < n && is_alnum(string_char_at(src, i)) {
                            word = word + char_to_string(string_char_at(src, i));
                            i = i + 1;
                        }
                        let kk = keyword_kind(word);
                        let kv: i64 = if word == "true" { 1 } else { 0 };
                        advance_token(inout tokens, kk, kv, word);
                    } else {
                        // --- String literal with escape sequences ---
                        if c == 34 {
                            mut sl: String = "";
                            i = i + 1; // consume opening quote
                            while i < n && string_char_at(src, i) != 34 {
                                let sc = string_char_at(src, i);
                                // Backslash escape sequences
                                if sc == 92 && i + 1 < n {
                                    i = i + 1;
                                    let esc = string_char_at(src, i);
                                    if esc == 110 { sl = sl + "\n"; }
                                    else if esc == 116 { sl = sl + "\t"; }
                                    else if esc == 114 { sl = sl + "\r"; }
                                    else if esc == 34  { sl = sl + "\""; }
                                    else if esc == 39  { sl = sl + "'"; }
                                    else if esc == 92  { sl = sl + "\\"; }
                                    else if esc == 48  { sl = sl + "\0"; }
                                    else if esc == 120 && i + 2 < n {
                                        // Hex escape \xHH
                                        let h1 = hex_digit_val(string_char_at(src, i + 1));
                                        let h2 = hex_digit_val(string_char_at(src, i + 2));
                                        if h1 >= 0 && h2 >= 0 {
                                            let byte_val = h1 * 16 + h2;
                                            sl = sl + char_to_string(byte_val);
                                            i = i + 2;
                                        } else {
                                            sl = sl + "\\x";
                                        }
                                    } else {
                                        sl = sl + "\\" + char_to_string(esc);
                                    }
                                } else {
                                    sl = sl + char_to_string(sc);
                                }
                                i = i + 1;
                            }
                            if i < n && string_char_at(src, i) == 34 {
                                i = i + 1; // consume closing quote
                            }
                            advance_token(inout tokens, 60, 0, sl);
                        } else {
                            // --- Operators and punctuation ---
                            if c == 40 { advance_token(inout tokens, 30, 0, "("); i = i + 1; }
                            if c == 41 { advance_token(inout tokens, 31, 0, ")"); i = i + 1; }
                            if c == 123 { advance_token(inout tokens, 32, 0, "{"); i = i + 1; }
                            if c == 125 { advance_token(inout tokens, 33, 0, "}"); i = i + 1; }
                            if c == 91  { advance_token(inout tokens, 61, 0, "["); i = i + 1; }
                            if c == 93  { advance_token(inout tokens, 62, 0, "]"); i = i + 1; }
                            if c == 59  { advance_token(inout tokens, 35, 0, ";"); i = i + 1; }
                            if c == 44  { advance_token(inout tokens, 39, 0, ","); i = i + 1; }
                            if c == 46  {
                                let nc1 = string_char_at(src, i + 1);
                                let nc2 = string_char_at(src, i + 2);
                                if nc1 == 46 && nc2 == 46 {
                                    advance_token(inout tokens, 37, 0, "...");
                                    i = i + 3;
                                } else {
                                    advance_token(inout tokens, 42, 0, ".");
                                    i = i + 1;
                                }
                            }
                            if c == 36  { advance_token(inout tokens, 53, 0, "$"); i = i + 1; }
                            if c == 95  { advance_token(inout tokens, 38, 0, "_"); i = i + 1; }
                            // Colon / double-colon
                            if c == 58 {
                                let nc = string_char_at(src, i + 1);
                                if nc == 58 {
                                    advance_token(inout tokens, 34, 0, "::");
                                    i = i + 2;
                                } else {
                                    advance_token(inout tokens, 34, 0, ":");
                                    i = i + 1;
                                }
                            }
                            // = or == or =>
                            if c == 61 {
                                let nc = string_char_at(src, i + 1);
                                if nc == 61 {
                                    advance_token(inout tokens, 40, 0, "==");
                                    i = i + 2;
                                } else {
                                    if nc == 62 {
                                        advance_token(inout tokens, 37, 0, "=>");
                                        i = i + 2;
                                    } else {
                                        advance_token(inout tokens, 24, 0, "=");
                                        i = i + 1;
                                    }
                                }
                            }
                            // ! or !=
                            if c == 33 {
                                let nc = string_char_at(src, i + 1);
                                if nc == 61 {
                                    advance_token(inout tokens, 41, 0, "!=");
                                    i = i + 2;
                                } else {
                                    advance_token(inout tokens, 50, 0, "!");
                                    i = i + 1;
                                }
                            }
                            // < or <=
                            if c == 60 {
                                let nc = string_char_at(src, i + 1);
                                if nc == 61 {
                                    advance_token(inout tokens, 43, 0, "<=");
                                    i = i + 2;
                                } else {
                                    advance_token(inout tokens, 42, 0, "<");
                                    i = i + 1;
                                }
                            }
                            // > or >=
                            if c == 62 {
                                let nc = string_char_at(src, i + 1);
                                if nc == 61 {
                                    advance_token(inout tokens, 45, 0, ">=");
                                    i = i + 2;
                                } else {
                                    advance_token(inout tokens, 44, 0, ">");
                                    i = i + 1;
                                }
                            }
                            // + operator
                            if c == 43 { advance_token(inout tokens, 20, 0, "+"); i = i + 1; }
                            // - or ->
                            if c == 45 {
                                let nc = string_char_at(src, i + 1);
                                if nc == 62 {
                                    advance_token(inout tokens, 36, 0, "->");
                                    i = i + 2;
                                } else {
                                    advance_token(inout tokens, 21, 0, "-");
                                    i = i + 1;
                                }
                            }
                            // * operator
                            if c == 42 { advance_token(inout tokens, 22, 0, "*"); i = i + 1; }
                            // & or &&
                            if c == 38 {
                                let nc = string_char_at(src, i + 1);
                                if nc == 38 {
                                    advance_token(inout tokens, 46, 0, "&&");
                                    i = i + 2;
                                } else {
                                    advance_token(inout tokens, 48, 0, "&");
                                    i = i + 1;
                                }
                            }
                            // | or ||
                            if c == 124 {
                                let nc = string_char_at(src, i + 1);
                                if nc == 124 {
                                    advance_token(inout tokens, 47, 0, "||");
                                    i = i + 2;
                                } else {
                                    advance_token(inout tokens, 49, 0, "|");
                                    i = i + 1;
                                }
                            }
                            // Skip unknown character (@ # ` etc.)
                        }
                    }
                }
            }
        }
    }

    // EOF sentinel
    advance_token(inout tokens, 0, 0, "");
    return tokens;
}

// Unit test: tokenize_source correctly scans a minimal IFA snippet
pub fn test_tokenize_source_basic() -> bool {
    // Input: `fn add(x: i64) -> i64 { return x; }`
    let src = "fn add(x: i64) -> i64 { return x; }";
    let tokens = tokenize_source(src);
    // Expected: fn(1), add(10), ((30), x(10), :(34), i64(10), )(31), ->(36),
    //           i64(10), {(32), return(4), x(10), ;(35), }(33), EOF(0)  = 15 tokens
    if tokens.len() != 15 {
        return false;
    }
    if tokens[0].kind != 1 || tokens[0].lexeme != "fn" {
        return false;
    }
    if tokens[1].kind != 10 || tokens[1].lexeme != "add" {
        return false;
    }
    if tokens[7].kind != 36 || tokens[7].lexeme != "->" {
        return false;
    }
    if tokens[10].kind != 4 || tokens[10].lexeme != "return" {
        return false;
    }
    if tokens[14].kind != 0 {
        return false;
    }
    return true;
}

// Unit test: tokenize_source correctly scans integer literals
pub fn test_tokenize_source_integers() -> bool {
    let src = "let x = 42; let y = 100;";
    let tokens = tokenize_source(src);
    // let(2), x(10), =(24), 42(11,42), ;(35), let(2), y(10), =(24), 100(11,100), ;(35), EOF(0)
    if tokens.len() != 11 {
        return false;
    }
    if tokens[3].kind != 11 || tokens[3].value != 42 {
        return false;
    }
    if tokens[8].kind != 11 || tokens[8].value != 100 {
        return false;
    }
    return true;
}

// Unit test: tokenize_source skips // line comments
pub fn test_tokenize_source_comments() -> bool {
    let src = "// this is a comment\nfn foo() -> i64 { return 1; }";
    let tokens = tokenize_source(src);
    // fn(1), foo(10), ((30), )(31), ->(36), i64(10), {(32), return(4), 1(11,1), ;(35), }(33), EOF(0)
    if tokens.len() != 12 {
        return false;
    }
    if tokens[0].kind != 1 || tokens[0].lexeme != "fn" {
        return false;
    }
    return true;
}

// Unit test: tokenize_source scans variadic ellipsis token `...`
pub fn test_lexer_variadic_token() -> bool {
    let src = "fn print_fmt(fmt: i64, ...) -> i64 { return 0; }";
    let tokens = tokenize_source(src);
    mut has_ellipsis = false;
    mut i: i64 = 0;
    while i < tokens.len() {
        if tokens[i].kind == 37 && tokens[i].lexeme == "..." {
            has_ellipsis = true;
        }
        i = i + 1;
    }
    return has_ellipsis;
}

// Unit test: tokenize_source handles complex string escape sequences
pub fn test_lexer_complex_string_escapes() -> bool {
    let src = "let s = \"hello\\nworld\\t\\x41\\x42\\0\\\'\\\"\";";
    let tokens = tokenize_source(src);
    if tokens.len() < 5 { return false; }
    if tokens[3].kind != 60 { return false; }
    let lex = tokens[3].lexeme;
    return string_len(lex) > 0;
}

// Unit test: tokenize_source handles raw strings (r"..." and r#"..."#)
pub fn test_lexer_raw_strings() -> bool {
    let src1 = "let r1 = r\"C:\\path\\to\\file\";";
    let tokens1 = tokenize_source(src1);
    if tokens1.len() < 5 || tokens1[3].kind != 60 { return false; }
    if tokens1[3].lexeme != "C:\\path\\to\\file" { return false; }

    let src2 = "let r2 = r#\"raw \"quotes\" here\"#;";
    let tokens2 = tokenize_source(src2);
    if tokens2.len() < 5 || tokens2[3].kind != 60 { return false; }
    if tokens2[3].lexeme != "raw \"quotes\" here" { return false; }
    return true;
}

pub fn main() {
    println("=== IFA Compiler Lexer Module ===");
    let tokens = tokenize_sample_program();
    println("Sample tokens tokenized successfully:", tokens.len());
    let t_ok = test_lexer_stream();
    let t_lut = test_comptime_keyword_lut();
    let t_alias = test_lexer_type_alias();
    let t_tuple = test_lexer_tuples();
    let t_arena = test_lexer_arena();
    let t_const = test_lexer_const_declaration();
    let t_enum = test_lexer_enum_declaration();
    let t_comptime = test_lexer_comptime_directives();
    let t_macro = test_lexer_syntax_macros();
    let t_while = test_lexer_while_loop();
    let t_if_else = test_lexer_if_else();
    let t_src_basic = test_tokenize_source_basic();
    let t_src_int = test_tokenize_source_integers();
    let t_src_cmt = test_tokenize_source_comments();
    let t_variadic = test_lexer_variadic_token();
    let t_escapes = test_lexer_complex_string_escapes();
    let t_raw = test_lexer_raw_strings();
    if t_ok && t_lut && t_alias && t_tuple && t_arena && t_const && t_enum && t_comptime && t_macro && t_while && t_if_else && t_src_basic && t_src_int && t_src_cmt && t_variadic && t_escapes && t_raw {
        println("Lexer stream test: OK");
    } else {
        println("Lexer stream test: FAILED");
    }
}
