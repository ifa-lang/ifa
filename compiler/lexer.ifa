// Pure IFA Self-Hosting Compiler - Lexer Module (`compiler/lexer.ifa`)
// Deterministic lexical scanner and token generation for IFA bootstrap compiler.

comptime fn build_keyword_lut() -> [i64; 18] {
    return [1, 2, 3, 4, 5, 6, 7, 8, 9, 12, 13, 14, 15, 16, 17, 18, 19, 26];
}

pub const KEYWORD_LUT = comptime build_keyword_lut();

// Token representation in IFA
pub struct Token {
    kind: i64,
    value: i64,
    lexeme: String
}

// Token constructor
pub fn make_token(kind: i64, value: i64, lexeme: String) -> Token {
    return Token(kind: kind, value: value, lexeme: lexeme);
}

// Append a token to the token stream inout list
pub fn advance_token(inout stream: List<Token>, kind: i64, value: i64, lexeme: String) {
    let tok = make_token(kind, value, lexeme);
    stream.push(tok);
}

// Tokenize sample program:
// `fn compute(inout x: i64) -> i64 { let bonus = 40; return x + bonus; }`
pub fn tokenize_sample_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "compute");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 5, 0, "inout");
    advance_token(inout tokens, 10, 0, "x");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 2, 0, "let");
    advance_token(inout tokens, 10, 0, "bonus");
    advance_token(inout tokens, 24, 0, "=");
    advance_token(inout tokens, 11, 40, "40");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 4, 0, "return");
    advance_token(inout tokens, 10, 0, "x");
    advance_token(inout tokens, 20, 0, "+");
    advance_token(inout tokens, 10, 0, "bonus");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize arithmetic program:
// `fn arithmetic(inout x: i64) -> i64 { let factor = 3; let offset = 10; return (x + 2) * factor + offset; }`
pub fn tokenize_arithmetic_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "arithmetic");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 5, 0, "inout");
    advance_token(inout tokens, 10, 0, "x");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 2, 0, "let");
    advance_token(inout tokens, 10, 0, "factor");
    advance_token(inout tokens, 24, 0, "=");
    advance_token(inout tokens, 11, 3, "3");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 2, 0, "let");
    advance_token(inout tokens, 10, 0, "offset");
    advance_token(inout tokens, 24, 0, "=");
    advance_token(inout tokens, 11, 10, "10");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 4, 0, "return");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 10, 0, "x");
    advance_token(inout tokens, 20, 0, "+");
    advance_token(inout tokens, 11, 2, "2");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 22, 0, "*");
    advance_token(inout tokens, 10, 0, "factor");
    advance_token(inout tokens, 20, 0, "+");
    advance_token(inout tokens, 10, 0, "offset");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize trait declaration:
// `pub trait Diagnosable { fn diagnose(self) -> String; }`
pub fn tokenize_trait_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    advance_token(inout tokens, 15, 0, "pub");
    advance_token(inout tokens, 9, 0, "trait");
    advance_token(inout tokens, 10, 0, "Diagnosable");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "diagnose");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 10, 0, "self");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "String");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize impl declaration:
// `impl Diagnosable for Diagnostic { fn diagnose(self) -> String { return msg; } }`
pub fn tokenize_impl_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    advance_token(inout tokens, 12, 0, "impl");
    advance_token(inout tokens, 10, 0, "Diagnosable");
    advance_token(inout tokens, 13, 0, "for");
    advance_token(inout tokens, 10, 0, "Diagnostic");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "diagnose");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 10, 0, "self");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "Diagnostic");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "String");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 4, 0, "return");
    advance_token(inout tokens, 10, 0, "msg");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize pattern matching expression:
// `match val { 1 => 10, 2 => 20, _ => 42 }`
pub fn tokenize_match_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    advance_token(inout tokens, 14, 0, "match");
    advance_token(inout tokens, 10, 0, "val");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 11, 1, "1");
    advance_token(inout tokens, 37, 0, "=>");
    advance_token(inout tokens, 11, 10, "10");
    advance_token(inout tokens, 39, 0, ",");
    advance_token(inout tokens, 11, 2, "2");
    advance_token(inout tokens, 37, 0, "=>");
    advance_token(inout tokens, 11, 20, "20");
    advance_token(inout tokens, 39, 0, ",");
    advance_token(inout tokens, 38, 0, "_");
    advance_token(inout tokens, 37, 0, "=>");
    advance_token(inout tokens, 11, 42, "42");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize full program with high-level items:
// pub trait Diagnosable { fn diagnose(self) -> String; }
// pub struct Diagnostic { code: i64, msg: String }
// fn compute(inout x: i64) -> i64 { return x; }
pub fn tokenize_full_module() -> List<Token> {
    mut tokens: List<Token> = List::new();

    // 1. Trait item
    advance_token(inout tokens, 15, 0, "pub");
    advance_token(inout tokens, 9, 0, "trait");
    advance_token(inout tokens, 10, 0, "Diagnosable");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "diagnose");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 10, 0, "self");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "String");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    // 2. Struct item
    advance_token(inout tokens, 15, 0, "pub");
    advance_token(inout tokens, 8, 0, "struct");
    advance_token(inout tokens, 10, 0, "Diagnostic");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 10, 0, "code");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 39, 0, ",");
    advance_token(inout tokens, 10, 0, "msg");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "String");
    advance_token(inout tokens, 33, 0, "}");

    // 3. Function item
    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "compute");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 5, 0, "inout");
    advance_token(inout tokens, 10, 0, "x");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 4, 0, "return");
    advance_token(inout tokens, 10, 0, "x");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize type alias declarations:
// `pub type NodeId = i64; type Pair = (i64, i64);`
pub fn tokenize_type_alias_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    // 1. pub type NodeId = i64;
    advance_token(inout tokens, 15, 0, "pub");
    advance_token(inout tokens, 17, 0, "type");
    advance_token(inout tokens, 10, 0, "NodeId");
    advance_token(inout tokens, 24, 0, "=");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 35, 0, ";");

    // 2. type Pair = (i64, i64);
    advance_token(inout tokens, 17, 0, "type");
    advance_token(inout tokens, 10, 0, "Pair");
    advance_token(inout tokens, 24, 0, "=");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 39, 0, ",");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 35, 0, ";");

    return tokens;
}

// Tokenize tuple expressions and function return type:
// `fn make_pair(inout a: i64) -> (i64, i64) { let p = (a, 42); return p; }`
pub fn tokenize_tuple_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "make_pair");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 5, 0, "inout");
    advance_token(inout tokens, 10, 0, "a");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 39, 0, ",");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 2, 0, "let");
    advance_token(inout tokens, 10, 0, "p");
    advance_token(inout tokens, 24, 0, "=");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 10, 0, "a");
    advance_token(inout tokens, 39, 0, ",");
    advance_token(inout tokens, 11, 42, "42");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 4, 0, "return");
    advance_token(inout tokens, 10, 0, "p");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize explicit arena declaration:
// `arena scratch; fn build_node(val: i64) -> i64 { return val; }`
pub fn tokenize_arena_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    advance_token(inout tokens, 18, 0, "arena");
    advance_token(inout tokens, 10, 0, "scratch");
    advance_token(inout tokens, 35, 0, ";");

    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "build_node");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 10, 0, "val");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 4, 0, "return");
    advance_token(inout tokens, 10, 0, "val");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize constant declarations:
// `pub const MAX_BUFFER_SIZE: i64 = 4096; const DEFAULT_ALIGN: i64 = 8;`
pub fn tokenize_const_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    // 1. pub const MAX_BUFFER_SIZE: i64 = 4096;
    advance_token(inout tokens, 15, 0, "pub");
    advance_token(inout tokens, 19, 0, "const");
    advance_token(inout tokens, 10, 0, "MAX_BUFFER_SIZE");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 24, 0, "=");
    advance_token(inout tokens, 11, 4096, "4096");
    advance_token(inout tokens, 35, 0, ";");

    // 2. const DEFAULT_ALIGN: i64 = 8;
    advance_token(inout tokens, 19, 0, "const");
    advance_token(inout tokens, 10, 0, "DEFAULT_ALIGN");
    advance_token(inout tokens, 34, 0, ":");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 24, 0, "=");
    advance_token(inout tokens, 11, 8, "8");
    advance_token(inout tokens, 35, 0, ";");

    return tokens;
}

// Tokenize enum declaration:
// `pub enum TokenKind { Eof, Identifier, Number, Plus }`
pub fn tokenize_enum_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    advance_token(inout tokens, 15, 0, "pub");
    advance_token(inout tokens, 26, 0, "enum");
    advance_token(inout tokens, 10, 0, "TokenKind");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 10, 0, "Eof");
    advance_token(inout tokens, 39, 0, ",");
    advance_token(inout tokens, 10, 0, "Identifier");
    advance_token(inout tokens, 39, 0, ",");
    advance_token(inout tokens, 10, 0, "Number");
    advance_token(inout tokens, 39, 0, ",");
    advance_token(inout tokens, 10, 0, "Plus");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize comptime directive program:
// `comptime { let limit = 100; } fn eval_limit() -> i64 { return comptime 100; }`
pub fn tokenize_comptime_directive_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    // 1. comptime block
    advance_token(inout tokens, 52, 0, "comptime");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 2, 0, "let");
    advance_token(inout tokens, 10, 0, "limit");
    advance_token(inout tokens, 24, 0, "=");
    advance_token(inout tokens, 11, 100, "100");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    // 2. fn eval_limit() -> i64 { return comptime 100; }
    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "eval_limit");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 4, 0, "return");
    advance_token(inout tokens, 52, 0, "comptime");
    advance_token(inout tokens, 11, 100, "100");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");

    return tokens;
}

// Tokenize syntax macro definition and invocation program:
// `macro def_calc($val) { fn calc() -> i64 { return $val; } } def_calc!(42);`
pub fn tokenize_syntax_macro_program() -> List<Token> {
    mut tokens: List<Token> = List::new();

    // 1. macro def_calc($val) { fn calc() -> i64 { return $val; } }
    advance_token(inout tokens, 51, 0, "macro");
    advance_token(inout tokens, 10, 0, "def_calc");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 53, 0, "$");
    advance_token(inout tokens, 10, 0, "val");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 1, 0, "fn");
    advance_token(inout tokens, 10, 0, "calc");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 36, 0, "->");
    advance_token(inout tokens, 10, 0, "i64");
    advance_token(inout tokens, 32, 0, "{");
    advance_token(inout tokens, 4, 0, "return");
    advance_token(inout tokens, 53, 0, "$");
    advance_token(inout tokens, 10, 0, "val");
    advance_token(inout tokens, 35, 0, ";");
    advance_token(inout tokens, 33, 0, "}");
    advance_token(inout tokens, 33, 0, "}");

    // 2. def_calc!(42);
    advance_token(inout tokens, 10, 0, "def_calc");
    advance_token(inout tokens, 50, 0, "!");
    advance_token(inout tokens, 30, 0, "(");
    advance_token(inout tokens, 11, 42, "42");
    advance_token(inout tokens, 31, 0, ")");
    advance_token(inout tokens, 35, 0, ";");

    return tokens;
}

// Unit test: Token stream verification and list properties
pub fn test_lexer_stream() -> bool {
    let tokens = tokenize_sample_program();
    if tokens.len() != 22 {
        return false;
    }
    let first = tokens[0];
    if first.kind != 1 {
        return false;
    }
    let let_tok = tokens[11];
    if let_tok.kind != 2 {
        return false;
    }
    let num_tok = tokens[14];
    if num_tok.value != 40 {
        return false;
    }
    return true;
}

// Unit test: Comptime keyword LUT validation
pub fn test_comptime_keyword_lut() -> bool {
    return KEYWORD_LUT.len() == 18;
}

// Unit test: Type alias tokenization validation
pub fn test_lexer_type_alias() -> bool {
    let tokens = tokenize_type_alias_program();
    if tokens.len() != 15 {
        return false;
    }
    // 0: pub, 1: type, 2: NodeId, 3: =, 4: i64, 5: ;
    if tokens[0].kind != 15 || tokens[1].kind != 17 || tokens[2].lexeme != "NodeId" {
        return false;
    }
    // 6: type, 7: Pair
    if tokens[6].kind != 17 || tokens[7].lexeme != "Pair" {
        return false;
    }
    return true;
}

// Unit test: Tuple tokenization validation
pub fn test_lexer_tuples() -> bool {
    let tokens = tokenize_tuple_program();
    if tokens.len() != 28 {
        return false;
    }
    // Check let p = (a, 42);
    // index 18: (, 19: a, 20: ,, 21: 42, 22: )
    if tokens[18].kind != 30 || tokens[20].kind != 39 || tokens[22].kind != 31 {
        return false;
    }
    return tokens[21].value == 42;
}

// Unit test: Arena tokenization validation
pub fn test_lexer_arena() -> bool {
    let tokens = tokenize_arena_program();
    if tokens.len() != 17 {
        return false;
    }
    // index 0: arena, index 1: scratch, index 2: ;
    if tokens[0].kind != 18 || tokens[1].lexeme != "scratch" || tokens[2].kind != 35 {
        return false;
    }
    return true;
}

// Unit test: Constant declaration tokenization validation
pub fn test_lexer_const_declaration() -> bool {
    let tokens = tokenize_const_program();
    if tokens.len() != 15 {
        return false;
    }
    // 0: pub, 1: const, 2: MAX_BUFFER_SIZE, 6: 4096
    if tokens[0].kind != 15 || tokens[1].kind != 19 || tokens[2].lexeme != "MAX_BUFFER_SIZE" {
        return false;
    }
    if tokens[6].kind != 11 || tokens[6].value != 4096 {
        return false;
    }
    // 8: const, 9: DEFAULT_ALIGN, 13: 8
    if tokens[8].kind != 19 || tokens[9].lexeme != "DEFAULT_ALIGN" || tokens[13].value != 8 {
        return false;
    }
    return true;
}

// Unit test: Enum declaration tokenization validation
pub fn test_lexer_enum_declaration() -> bool {
    let tokens = tokenize_enum_program();
    if tokens.len() != 12 {
        return false;
    }
    // 0: pub, 1: enum, 2: TokenKind, 3: {, 4: Eof, 6: Identifier, 8: Number, 10: Plus, 11: }
    if tokens[0].kind != 15 || tokens[1].kind != 26 || tokens[2].lexeme != "TokenKind" {
        return false;
    }
    if tokens[4].lexeme != "Eof" || tokens[6].lexeme != "Identifier" {
        return false;
    }
    if tokens[8].lexeme != "Number" || tokens[10].lexeme != "Plus" || tokens[11].kind != 33 {
        return false;
    }
    return true;
}

// Unit test: Comptime directive tokenization validation
pub fn test_lexer_comptime_directives() -> bool {
    let tokens = tokenize_comptime_directive_program();
    if tokens.len() != 20 {
        return false;
    }
    // index 0: comptime (52), index 1: { (32)
    if tokens[0].kind != 52 || tokens[0].lexeme != "comptime" || tokens[1].kind != 32 {
        return false;
    }
    // index 5: 100 (11)
    if tokens[5].kind != 11 || tokens[5].value != 100 {
        return false;
    }
    // index 16: comptime (52), index 17: 100 (11)
    if tokens[16].kind != 52 || tokens[17].value != 100 {
        return false;
    }
    return true;
}

// Unit test: Syntax macro tokenization validation
pub fn test_lexer_syntax_macros() -> bool {
    let tokens = tokenize_syntax_macro_program();
    if tokens.len() != 26 {
        return false;
    }
    // index 0: macro (51), index 1: def_calc (10), index 3: $ (53), index 4: val (10)
    if tokens[0].kind != 51 || tokens[1].lexeme != "def_calc" || tokens[3].kind != 53 || tokens[4].lexeme != "val" {
        return false;
    }
    // invocation: index 20: def_calc (10), index 21: ! (50), index 23: 42 (11)
    if tokens[20].lexeme != "def_calc" || tokens[21].kind != 50 || tokens[23].value != 42 {
        return false;
    }
    return true;
}

pub fn main() {
    println("=== IFA Compiler Lexer Module ===");
    let tokens = tokenize_sample_program();
    println("Sample tokens tokenized successfully:", tokens.len());
    let t_ok = test_lexer_stream();
    let t_lut = test_comptime_keyword_lut();
    let t_alias = test_lexer_type_alias();
    let t_tuple = test_lexer_tuples();
    let t_arena = test_lexer_arena();
    let t_const = test_lexer_const_declaration();
    let t_enum = test_lexer_enum_declaration();
    let t_comptime = test_lexer_comptime_directives();
    let t_macro = test_lexer_syntax_macros();
    if t_ok && t_lut && t_alias && t_tuple && t_arena && t_const && t_enum && t_comptime && t_macro {
        println("Lexer stream test: OK");
    } else {
        println("Lexer stream test: FAILED");
    }
}
