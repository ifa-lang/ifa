// Unit test 15: Syntax macro definition and invocation parsing `macro def_calc($val) { ... } def_calc!(42);`
pub fn test_parser_syntax_macros() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 51, value: 0, lexeme: "macro"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "def_calc"));
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 53, value: 0, lexeme: "$"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "val"));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 4, value: 0, lexeme: "return"));
    tokens.push(Token(kind: 53, value: 0, lexeme: "$"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "val"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let md = parse_macro_def(inout cur, tokens, inout pool);
    if md.name != "def_calc" || md.param_name != "val" {
        return false;
    }
    if md.statements.len() != 1 {
        return false;
    }

    // Test macro invocation parsing
    mut inv_tokens: List<Token> = List::new();
    inv_tokens.push(Token(kind: 10, value: 0, lexeme: "def_calc"));
    inv_tokens.push(Token(kind: 50, value: 0, lexeme: "!"));
    inv_tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    inv_tokens.push(Token(kind: 11, value: 42, lexeme: "42"));
    inv_tokens.push(Token(kind: 31, value: 0, lexeme: ")"));

    mut cur_inv: i64 = 0;
    let inv_expr = parse_primary(inout cur_inv, inv_tokens, inout pool);
    if inv_expr.kind != 7 || inv_expr.name != "def_calc" {
        return false;
    }
    let arg_val = inv_expr.left?.val ?? 0;
    return arg_val == 42;
}

// Unit test: While loop AST parsing validation
pub fn test_parser_while_loop() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 27, value: 0, lexeme: "while"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "x"));
    tokens.push(Token(kind: 44, value: 0, lexeme: ">"));
    tokens.push(Token(kind: 11, value: 0, lexeme: "0"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "x"));
    tokens.push(Token(kind: 24, value: 0, lexeme: "="));
    tokens.push(Token(kind: 10, value: 0, lexeme: "x"));
    tokens.push(Token(kind: 21, value: 0, lexeme: "-"));
    tokens.push(Token(kind: 11, value: 1, lexeme: "1"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let w = parse_while(inout cur, tokens, inout pool);
    if w.cond_op != 5 || w.body_target_var != "x" {
        return false;
    }
    let left_name = w.cond_left?.name ?? "";
    let right_val = w.cond_right?.val ?? -1;
    if left_name != "x" || right_val != 0 {
        return false;
    }
    let body_op = w.body_expr?.op ?? 0;
    return body_op == 2;
}

// Unit test: If/else branching AST parsing validation
pub fn test_parser_if_else() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 28, value: 0, lexeme: "if"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "x"));
    tokens.push(Token(kind: 40, value: 0, lexeme: "=="));
    tokens.push(Token(kind: 11, value: 42, lexeme: "42"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 4, value: 0, lexeme: "return"));
    tokens.push(Token(kind: 11, value: 100, lexeme: "100"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));
    tokens.push(Token(kind: 29, value: 0, lexeme: "else"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 4, value: 0, lexeme: "return"));
    tokens.push(Token(kind: 11, value: 0, lexeme: "0"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let if_node = parse_if(inout cur, tokens, inout pool);
    if if_node.cond_op != 1 || !if_node.has_else {
        return false;
    }
    let left_name = if_node.cond_left?.name ?? "";
    let right_val = if_node.cond_right?.val ?? -1;
    let then_val = if_node.then_expr?.val ?? -1;
    let else_val = if_node.else_expr?.val ?? -1;
    return left_name == "x" && right_val == 42 && then_val == 100 && else_val == 0;
}

