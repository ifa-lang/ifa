// Pure IFA Self-Hosting Compiler - Parser Module (`compiler/parser.ifa`)
// Recursive-descent AST parser utilizing generational references (`?ref AstExpr`) and arena pools.

pub struct Token {
    kind: i64,
    value: i64,
    lexeme: String
}

// AST Expression node leveraging generational references for recursive trees
pub struct AstExpr {
    kind: i64, // 1: Integer Literal, 2: Variable, 3: Binary Operation, 4: Call / Tuple, 5: Tuple index, 6: Arena, 7: Macro, 8: Comptime, 9: ArgCons, 15: CoW Mutability Annotation
    val: i64,
    name: String,
    op: i64,   // 1: Add (+), 2: Sub (-), 3: Mul (*), 4: Div (/)
    left: ?ref AstExpr,
    right: ?ref AstExpr
}

// AST Parameter node with mutability and ownership mode (in = 0, inout = 1, sink = 2)
pub struct AstParam {
    name: String,
    ty: String,
    mode: i64
}

// Memory Arena pool for direct allocation of AST expression nodes
pub struct AstArena {
    name: String,
    capacity: i64,
    allocated_count: i64,
    generation: i64
}

pub fn make_ast_arena(name: String, capacity: i64) -> AstArena {
    return AstArena(
        name: name,
        capacity: capacity,
        allocated_count: 0,
        generation: 1
    );
}

// Allocates an AST expression node directly inside the given memory arena pool
pub fn alloc_expr_on_arena(
    inout arena: AstArena,
    inout pool: List<AstExpr>,
    kind: i64,
    val: i64,
    name: String,
    op: i64,
    left: ?ref AstExpr,
    right: ?ref AstExpr
) -> AstExpr {
    let node = AstExpr(kind: kind, val: val, name: name, op: op, left: left, right: right);
    pool.push(node);
    arena = AstArena(
        name: arena.name,
        capacity: arena.capacity,
        allocated_count: arena.allocated_count + 1,
        generation: arena.generation
    );
    return node;
}

// Wraps an expression with an explicit Copy-on-Write mutability annotation (inout = 1, sink = 2)
pub fn make_cow_annotated_expr(
    inout arena: AstArena,
    inout pool: List<AstExpr>,
    mode: i64,
    target: ?ref AstExpr
) -> AstExpr {
    mut mode_name = "inout";
    if mode == 2 {
        mode_name = "sink";
    }
    return alloc_expr_on_arena(inout arena, inout pool, 15, mode, mode_name, 0, target, None);
}

// Resets the arena memory pool (invalidates active allocations and increments generation)
pub fn reset_ast_arena(inout arena: AstArena, inout pool: List<AstExpr>) {
    mut empty_nodes: List<AstExpr> = List::new();
    pool = empty_nodes;
    arena = AstArena(
        name: arena.name,
        capacity: arena.capacity,
        allocated_count: 0,
        generation: arena.generation + 1
    );
}

// Parses function parameters with explicit mutability annotations ('in', 'inout', 'sink')
pub fn parse_function_params(inout cursor: i64, tokens: List<Token>) -> List<AstParam> {
    mut params: List<AstParam> = List::new();
    if cursor >= tokens.len() || tokens[cursor].kind != 30 {
        return params;
    }
    cursor = cursor + 1; // Consume '('
    while cursor < tokens.len() && tokens[cursor].kind != 31 {
        if tokens[cursor].kind == 37 {
            // '...' variadic
            cursor = cursor + 1;
            break;
        }
        mut mode: i64 = 0; // default 'in'
        if tokens[cursor].kind == 5 {
            mode = 1; // inout
            cursor = cursor + 1;
        } else if tokens[cursor].kind == 6 {
            mode = 0; // in
            cursor = cursor + 1;
        } else if tokens[cursor].kind == 7 {
            mode = 2; // sink
            cursor = cursor + 1;
        }
        mut pname = "";
        if cursor < tokens.len() && tokens[cursor].kind == 10 {
            pname = tokens[cursor].lexeme;
            cursor = cursor + 1;
        }
        mut pty = "i64";
        if cursor < tokens.len() && tokens[cursor].kind == 34 {
            cursor = cursor + 1; // Consume ':'
            if cursor < tokens.len() && tokens[cursor].kind == 10 {
                pty = tokens[cursor].lexeme;
                cursor = cursor + 1;
            }
        }
        if pname != "" {
            params.push(AstParam(name: pname, ty: pty, mode: mode));
        }
        if cursor < tokens.len() && tokens[cursor].kind == 39 {
            cursor = cursor + 1; // Consume ','
        } else {
            break;
        }
    }
    if cursor < tokens.len() && tokens[cursor].kind == 31 {
        cursor = cursor + 1; // Consume ')'
    }
    return params;
}

// AST Statement node
pub struct AstStmt {
    is_return: bool,
    target_var: String,
    expr: ?ref AstExpr
}

// AST Function node with multi-parameter and variadic support
pub struct AstFunction {
    name: String,
    param_name: String,
    params: List<String>,
    statements: List<AstStmt>,
    is_variadic: bool
}

// Flattens call arguments from an AstExpr (kind: 4) into an ordered list
pub fn collect_call_arguments(call_expr: ?ref AstExpr, inout args: List<?ref AstExpr>) {
    if call_expr?.left == None {
        return;
    }
    args.push(call_expr?.left);
    if call_expr?.right == None {
        return;
    }
    mut curr = call_expr?.right;
    while curr != None {
        let ck = curr?.kind ?? 0;
        if ck == 9 {
            args.push(curr?.left);
            curr = curr?.right;
        } else {
            args.push(curr);
            curr = None;
        }
    }
}

// High-level AST Field node for Struct definitions
pub struct AstField {
    name: String,
    ty: String
}

// High-level AST Struct node
pub struct AstStruct {
    is_pub: bool,
    name: String,
    fields: List<AstField>
}

// High-level AST Trait Method signature
pub struct AstTraitMethod {
    name: String,
    param_name: String,
    param_ty: String,
    ret_ty: String
}

// High-level AST Trait node
pub struct AstTrait {
    is_pub: bool,
    name: String,
    methods: List<AstTraitMethod>
}

// High-level AST Impl node (trait implementation or inherent implementation)
pub struct AstImpl {
    has_trait: bool,
    trait_name: String,
    target_ty: String,
    methods: List<AstFunction>
}

// High-level AST Pattern node for Pattern Matching
pub struct AstPattern {
    kind: i64,         // 1: Wildcard `_`, 2: Literal, 3: Identifier / Binding, 4: Variant
    val: i64,          // Literal integer value
    name: String,      // Identifier / Variant name
    sub_pat_name: String, // Sub-pattern variable name
    has_sub: bool      // Whether variant has sub-pattern payload
}

// High-level AST Match Arm node (`pattern => expression`)
pub struct AstMatchArm {
    pat: AstPattern,
    expr: ?ref AstExpr
}

// High-level AST Match Expression node
pub struct AstMatch {
    target_var: String,
    arms: List<AstMatchArm>
}

// High-level AST Nested Pattern node (tuples, guards, and nested sub-patterns)
pub struct AstNestedPattern {
    kind: i64,          // 1: Wildcard, 2: Literal, 3: Binding, 4: Tuple, 5: Guarded
    val: i64,
    name: String,
    sub_pat1_kind: i64, // 1: Wildcard, 2: Literal, 3: Binding
    sub_pat1_val: i64,
    sub_pat1_name: String,
    sub_pat2_kind: i64, // 1: Wildcard, 2: Literal, 3: Binding
    sub_pat2_val: i64,
    sub_pat2_name: String,
    has_guard: bool,
    guard_val: i64
}

// High-level AST Nested Match Arm node (`nested_pattern => expression`)
pub struct AstNestedMatchArm {
    pat: AstNestedPattern,
    expr: ?ref AstExpr
}

// High-level AST Nested Match Expression node
pub struct AstNestedMatch {
    target_var: String,
    arms: List<AstNestedMatchArm>
}

// High-level AST Type Alias node (`type Name = TargetType;` or `pub type Name = TargetType;`)
pub struct AstTypeAlias {
    is_pub: bool,
    name: String,
    target_ty: String
}

// High-level AST Arena declaration node (`arena scratch;` or `arena cow scratch = 65536;`)
pub struct AstArenaDecl {
    name: String,
    capacity: i64,
    is_cow: bool,
    page_size: i64
}

// High-level AST Constant declaration node (`pub const Name: Ty = Val;`)
pub struct AstConst {
    is_pub: bool,
    name: String,
    ty: String,
    val: i64
}

// High-level AST Enum Variant node
pub struct AstEnumVariant {
    name: String,
    discriminant: i64
}

// High-level AST Enum declaration node (`pub enum Name { Variant1, Variant2 }`)
pub struct AstEnum {
    is_pub: bool,
    name: String,
    variants: List<AstEnumVariant>
}

// High-level AST Comptime Block node (`comptime { ... }`)
pub struct AstComptimeBlock {
    statements: List<AstStmt>
}

// High-level AST Syntax Macro Definition node (`macro name($param) { ... }`)
pub struct AstMacroDef {
    name: String,
    param_name: String,
    statements: List<AstStmt>
}

// High-level AST representation for While Loop
pub struct AstWhile {
    cond_left: ?ref AstExpr,
    cond_op: i64, // 1: ==, 2: !=, 3: <, 4: <=, 5: >, 6: >=
    cond_right: ?ref AstExpr,
    body_target_var: String,
    body_expr: ?ref AstExpr
}

// High-level AST representation for If/Else conditional branching
pub struct AstIf {
    cond_left: ?ref AstExpr,
    cond_op: i64, // 1: ==, 2: !=, 3: <, 4: <=, 5: >, 6: >=
    cond_right: ?ref AstExpr,
    then_expr: ?ref AstExpr,
    has_else: bool,
    else_expr: ?ref AstExpr
}

// Full Program AST containing all top-level module items
pub struct AstProgram {
    traits: List<AstTrait>,
    impls: List<AstImpl>,
    structs: List<AstStruct>,
    type_aliases: List<AstTypeAlias>,
    arenas: List<AstArenaDecl>,
    constants: List<AstConst>,
    enums: List<AstEnum>,
    comptime_blocks: List<AstComptimeBlock>,
    macros: List<AstMacroDef>,
    functions: List<AstFunction>
}

// Recursive-descent parser: primary expressions (literals, variables, parenthesized sub-trees, tuples, arena alloc)
pub fn parse_primary(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstExpr {
    if cursor >= tokens.len() {
        return AstExpr(kind: 0, val: 0, name: "", op: 0, left: None, right: None);
    }
    let tok = tokens[cursor];
    if tok.kind == 11 {
        // Integer Literal
        cursor = cursor + 1;
        return AstExpr(kind: 1, val: tok.value, name: "", op: 0, left: None, right: None);
    }
    if tok.kind == 10 {
        // Check for arena allocation primitive: `alloc(expr, arena)`
        if tok.lexeme == "alloc" {
            if cursor + 1 < tokens.len() && tokens[cursor + 1].kind == 30 {
                cursor = cursor + 2; // Consume 'alloc' and '('
                let inner_arg = parse_additive(inout cursor, tokens, inout pool);
                mut arena_name = "scratch";
                if cursor < tokens.len() && tokens[cursor].kind == 39 {
                    cursor = cursor + 1; // Consume ','
                    if cursor < tokens.len() && tokens[cursor].kind == 10 {
                        arena_name = tokens[cursor].lexeme;
                        cursor = cursor + 1;
                    }
                }
                if cursor < tokens.len() && tokens[cursor].kind == 31 {
                    cursor = cursor + 1; // Consume ')'
                }
                pool.push(inner_arg);
                let arg_idx = pool.len() - 1;
                return AstExpr(
                    kind: 6, // Arena Allocation
                    val: 0,
                    name: arena_name,
                    op: 0,
                    left: ref pool[arg_idx],
                    right: None
                );
            }
        }

        // Variable Identifier with possible function call `name(...)` or macro invocation `name!(arg)` or tuple member access: `var.0`, `var.1`
        let var_name = tok.lexeme;
        cursor = cursor + 1;
        if cursor < tokens.len() && tokens[cursor].kind == 30 {
            // Function call with 0, 1, 2, or arbitrary N arguments: ident(arg0, arg1, ..., argN-1)
            cursor = cursor + 1; // Consume '('
            if cursor < tokens.len() && tokens[cursor].kind == 31 {
                cursor = cursor + 1; // Consume ')'
                return AstExpr(
                    kind: 4, // Function Call
                    val: 0,  // 0 args
                    name: var_name,
                    op: 0,
                    left: None,
                    right: None
                );
            }
            mut arg_indices: List<i64> = List::new();
            let first_arg = parse_additive(inout cursor, tokens, inout pool);
            pool.push(first_arg);
            arg_indices.push(pool.len() - 1);

            while cursor < tokens.len() && tokens[cursor].kind == 39 {
                cursor = cursor + 1; // Consume ','
                let next_arg = parse_additive(inout cursor, tokens, inout pool);
                pool.push(next_arg);
                arg_indices.push(pool.len() - 1);
            }

            if cursor < tokens.len() && tokens[cursor].kind == 31 {
                cursor = cursor + 1; // Consume ')'
            }

            let num_args = arg_indices.len();
            if num_args == 1 {
                let a0 = arg_indices[0];
                return AstExpr(
                    kind: 4,
                    val: 1,
                    name: var_name,
                    op: 0,
                    left: ref pool[a0],
                    right: None
                );
            }
            if num_args == 2 {
                let a0 = arg_indices[0];
                let a1 = arg_indices[1];
                return AstExpr(
                    kind: 4,
                    val: 2,
                    name: var_name,
                    op: 0,
                    left: ref pool[a0],
                    right: ref pool[a1]
                );
            }
            // For N >= 3 arguments: construct an argument chain (Cons-List) using kind: 9 (ArgCons)
            mut tail_idx = arg_indices[num_args - 1];
            mut j = num_args - 2;
            while j >= 1 {
                let cons = AstExpr(
                    kind: 9, // ArgCons node
                    val: j,
                    name: "",
                    op: 0,
                    left: ref pool[arg_indices[j]],
                    right: ref pool[tail_idx]
                );
                pool.push(cons);
                tail_idx = pool.len() - 1;
                j = j - 1;
            }
            let a0 = arg_indices[0];
            return AstExpr(
                kind: 4,
                val: num_args,
                name: var_name,
                op: 0,
                left: ref pool[a0],
                right: ref pool[tail_idx]
            );
        }
        if cursor < tokens.len() && tokens[cursor].kind == 50 {
            // Macro invocation: ident!(arg)
            cursor = cursor + 1; // Consume '!'
            if cursor < tokens.len() && tokens[cursor].kind == 30 {
                cursor = cursor + 1; // Consume '('
            }
            let macro_arg = parse_additive(inout cursor, tokens, inout pool);
            if cursor < tokens.len() && tokens[cursor].kind == 31 {
                cursor = cursor + 1; // Consume ')'
            }
            pool.push(macro_arg);
            let arg_idx = pool.len() - 1;
            return AstExpr(
                kind: 7, // Macro Invocation
                val: 0,
                name: var_name,
                op: 0,
                left: ref pool[arg_idx],
                right: None
            );
        }
        if cursor < tokens.len() && tokens[cursor].kind == 42 {
            cursor = cursor + 1; // Consume '.'
            if cursor < tokens.len() && tokens[cursor].kind == 11 {
                let idx_val = tokens[cursor].value;
                cursor = cursor + 1; // Consume index
                return AstExpr(
                    kind: 5, // Tuple Index Access
                    val: idx_val,
                    name: var_name,
                    op: 0,
                    left: None,
                    right: None
                );
            }
        }
        return AstExpr(kind: 2, val: 0, name: var_name, op: 0, left: None, right: None);
    }
    if tok.kind == 52 {
        // Comptime expression: comptime <expr>
        cursor = cursor + 1; // Consume 'comptime'
        let inner_expr = parse_additive(inout cursor, tokens, inout pool);
        pool.push(inner_expr);
        let c_idx = pool.len() - 1;
        return AstExpr(
            kind: 8, // Comptime Expression
            val: 0,
            name: "comptime",
            op: 0,
            left: ref pool[c_idx],
            right: None
        );
    }
    if tok.kind == 53 {
        // Macro substituted identifier: $var
        cursor = cursor + 1; // Consume '$'
        mut subst_name = "";
        if cursor < tokens.len() && tokens[cursor].kind == 10 {
            subst_name = tokens[cursor].lexeme;
            cursor = cursor + 1;
        }
        return AstExpr(kind: 9, val: 0, name: "$" + subst_name, op: 0, left: None, right: None);
    }
    if tok.kind == 5 || tok.kind == 7 {
        // Copy-on-Write mutability annotation: `inout <expr>` or `sink <expr>`
        cursor = cursor + 1; // Consume 'inout' or 'sink'
        mut mode: i64 = 1;
        mut mode_name = "inout";
        if tok.kind == 7 {
            mode = 2;
            mode_name = "sink";
        }
        let inner_expr = parse_primary(inout cursor, tokens, inout pool);
        pool.push(inner_expr);
        let inner_idx = pool.len() - 1;
        return AstExpr(
            kind: 15, // CoW Mutability Annotation
            val: mode,
            name: mode_name,
            op: 0,
            left: ref pool[inner_idx],
            right: None
        );
    }
    if tok.kind == 30 {
        // Left parenthesis '(' -> check for tuple `(e1, e2)` or sub-expression `(e)`
        cursor = cursor + 1;
        let first = parse_additive(inout cursor, tokens, inout pool);
        if cursor < tokens.len() {
            let next_tok = tokens[cursor];
            if next_tok.kind == 39 {
                // Comma ',' -> Tuple expression! (kind 4)
                cursor = cursor + 1; // Consume ','
                let second = parse_additive(inout cursor, tokens, inout pool);
                if cursor < tokens.len() && tokens[cursor].kind == 31 {
                    cursor = cursor + 1; // Consume ')'
                }
                pool.push(first);
                let first_idx = pool.len() - 1;
                pool.push(second);
                let second_idx = pool.len() - 1;
                return AstExpr(
                    kind: 4, // Tuple Expression
                    val: 2, // 2-element tuple
                    name: "tuple",
                    op: 0,
                    left: ref pool[first_idx],
                    right: ref pool[second_idx]
                );
            } else if next_tok.kind == 31 {
                cursor = cursor + 1; // Consume ')'
            }
        }
        return first;
    }
    return AstExpr(kind: 0, val: 0, name: "", op: 0, left: None, right: None);
}

// Recursive-descent parser: multiplicative expressions (* and /)
pub fn parse_multiplicative(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstExpr {
    mut current = parse_primary(inout cursor, tokens, inout pool);
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else {
            let tok = tokens[cursor];
            if tok.kind == 22 {
                // Op: * (Multiplication)
                cursor = cursor + 1;
                pool.push(current);
                let left_idx = pool.len() - 1;
                let right_expr = parse_primary(inout cursor, tokens, inout pool);
                pool.push(right_expr);
                let right_idx = pool.len() - 1;
                current = AstExpr(
                    kind: 3,
                    val: 0,
                    name: "",
                    op: 3,
                    left: ref pool[left_idx],
                    right: ref pool[right_idx]
                );
            } else if tok.kind == 23 {
                // Op: / (Division)
                cursor = cursor + 1;
                pool.push(current);
                let left_idx = pool.len() - 1;
                let right_expr = parse_primary(inout cursor, tokens, inout pool);
                pool.push(right_expr);
                let right_idx = pool.len() - 1;
                current = AstExpr(
                    kind: 3,
                    val: 0,
                    name: "",
                    op: 4,
                    left: ref pool[left_idx],
                    right: ref pool[right_idx]
                );
            } else {
                parsing = false;
            }
        }
    }
    return current;
}

// Recursive-descent parser: additive expressions (+ and -)
pub fn parse_additive(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstExpr {
    mut current = parse_multiplicative(inout cursor, tokens, inout pool);
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else {
            let tok = tokens[cursor];
            if tok.kind == 20 {
                // Op: + (Addition)
                cursor = cursor + 1;
                pool.push(current);
                let left_idx = pool.len() - 1;
                let right_expr = parse_multiplicative(inout cursor, tokens, inout pool);
                pool.push(right_expr);
                let right_idx = pool.len() - 1;
                current = AstExpr(
                    kind: 3,
                    val: 0,
                    name: "",
                    op: 1,
                    left: ref pool[left_idx],
                    right: ref pool[right_idx]
                );
            } else if tok.kind == 21 {
                // Op: - (Subtraction)
                cursor = cursor + 1;
                pool.push(current);
                let left_idx = pool.len() - 1;
                let right_expr = parse_multiplicative(inout cursor, tokens, inout pool);
                pool.push(right_expr);
                let right_idx = pool.len() - 1;
                current = AstExpr(
                    kind: 3,
                    val: 0,
                    name: "",
                    op: 2,
                    left: ref pool[left_idx],
                    right: ref pool[right_idx]
                );
            } else {
                parsing = false;
            }
        }
    }
    return current;
}

// Entrypoint for expression parsing
pub fn parse_expression(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstExpr {
    return parse_additive(inout cursor, tokens, inout pool);
}

// Recursive-descent parser: statement declarations (`let var = expr;`, `mut var = expr;`, `return expr;`, assignments)
pub fn parse_statement(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstStmt {
    if cursor >= tokens.len() {
        return AstStmt(is_return: false, target_var: "", expr: None);
    }
    let tok = tokens[cursor];
    if tok.kind == 2 || tok.kind == 3 {
        // let <var> = <expr>; or mut <var> = <expr>; or let mut <var> = <expr>;
        cursor = cursor + 1;
        if cursor < tokens.len() && (tokens[cursor].kind == 2 || tokens[cursor].kind == 3) {
            cursor = cursor + 1; // Consume optional second 'mut'
        }
        mut var_name = "";
        if cursor < tokens.len() && tokens[cursor].kind == 10 {
            var_name = tokens[cursor].lexeme;
            cursor = cursor + 1;
        }
        // Optional type annotation `: Type`
        if cursor < tokens.len() && tokens[cursor].kind == 34 {
            cursor = cursor + 1; // Consume ':'
            if cursor < tokens.len() && tokens[cursor].kind == 10 {
                cursor = cursor + 1; // Consume type
            }
        }
        if cursor < tokens.len() && tokens[cursor].kind == 24 {
            cursor = cursor + 1; // Consume '='
        }
        let expr = parse_expression(inout cursor, tokens, inout pool);
        pool.push(expr);
        let expr_idx = pool.len() - 1;
        if cursor < tokens.len() && tokens[cursor].kind == 35 {
            cursor = cursor + 1; // Consume ';'
        }
        return AstStmt(is_return: false, target_var: var_name, expr: ref pool[expr_idx]);
    }
    if tok.kind == 4 {
        // return <expr>; or return;
        cursor = cursor + 1;
        if cursor < tokens.len() && tokens[cursor].kind == 35 {
            cursor = cursor + 1; // Consume ';'
            return AstStmt(is_return: true, target_var: "", expr: None);
        }
        let expr = parse_expression(inout cursor, tokens, inout pool);
        pool.push(expr);
        let expr_idx = pool.len() - 1;
        if cursor < tokens.len() && tokens[cursor].kind == 35 {
            cursor = cursor + 1; // Consume ';'
        }
        return AstStmt(is_return: true, target_var: "", expr: ref pool[expr_idx]);
    }
    if tok.kind == 10 {
        // Reassignment: `var = expr;` or expression statement: `expr;`
        let ident_name = tok.lexeme;
        if cursor + 1 < tokens.len() && tokens[cursor + 1].kind == 24 {
            cursor = cursor + 2; // Consume ident and '='
            let expr = parse_expression(inout cursor, tokens, inout pool);
            pool.push(expr);
            let expr_idx = pool.len() - 1;
            if cursor < tokens.len() && tokens[cursor].kind == 35 {
                cursor = cursor + 1; // Consume ';'
            }
            return AstStmt(is_return: false, target_var: ident_name, expr: ref pool[expr_idx]);
        }
        // Expression statement: function call or expression
        let expr = parse_expression(inout cursor, tokens, inout pool);
        pool.push(expr);
        let expr_idx = pool.len() - 1;
        if cursor < tokens.len() && tokens[cursor].kind == 35 {
            cursor = cursor + 1; // Consume ';'
        }
        return AstStmt(is_return: false, target_var: "_", expr: ref pool[expr_idx]);
    }
    // Advance by 1 to make progress on unrecognized tokens
    cursor = cursor + 1;
    return AstStmt(is_return: false, target_var: "", expr: None);
}

// Recursive-descent parser: function declarations (`fn name(...) -> R { ... }`)
pub fn parse_function(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstFunction {
    if cursor >= tokens.len() {
        mut empty_stmts: List<AstStmt> = List::new();
        return AstFunction(name: "compute", param_name: "x", params: List::new(), statements: empty_stmts, is_variadic: false);
    }
    if cursor < tokens.len() && tokens[cursor].kind == 1 {
        cursor = cursor + 1; // Consume 'fn'
    }
    mut fn_name = "";
    if cursor < tokens.len() && tokens[cursor].kind == 10 {
        fn_name = tokens[cursor].lexeme;
        cursor = cursor + 1; // Consume function name
    } else {
        fn_name = "compute";
    }
    if cursor < tokens.len() && tokens[cursor].kind == 30 {
        cursor = cursor + 1; // Consume '('
    }
    mut params: List<String> = List::new();
    mut is_variadic = false;
    if cursor < tokens.len() && tokens[cursor].kind != 31 {
        while cursor < tokens.len() && tokens[cursor].kind != 31 {
            if tokens[cursor].kind == 37 {
                cursor = cursor + 1; // Consume '...'
                is_variadic = true;
                break;
            }
            if tokens[cursor].kind == 5 || tokens[cursor].kind == 6 || tokens[cursor].kind == 7 {
                cursor = cursor + 1; // Consume 'inout', 'in', 'sink'
            }
            if cursor < tokens.len() && tokens[cursor].kind == 10 {
                let pname = tokens[cursor].lexeme;
                cursor = cursor + 1; // Consume parameter name
                params.push(pname);
            }
            if cursor < tokens.len() && tokens[cursor].kind == 34 {
                cursor = cursor + 1; // Consume ':'
                if cursor < tokens.len() && tokens[cursor].kind == 10 {
                    cursor = cursor + 1; // Consume parameter type
                }
            }
            if cursor < tokens.len() && tokens[cursor].kind == 39 {
                cursor = cursor + 1; // Consume ','
            } else {
                break;
            }
        }
    }
    if cursor < tokens.len() && tokens[cursor].kind == 31 {
        cursor = cursor + 1; // Consume ')'
    }
    mut param_name = "";
    if params.len() > 0 {
        param_name = params[0];
    }
    // Optional return type `-> Type` or `-> (T1, T2)`
    if cursor < tokens.len() && tokens[cursor].kind == 36 {
        cursor = cursor + 1; // Consume '->'
        if cursor < tokens.len() && tokens[cursor].kind == 30 {
            cursor = cursor + 1; // Consume '('
            while cursor < tokens.len() && tokens[cursor].kind != 31 {
                cursor = cursor + 1;
            }
            if cursor < tokens.len() && tokens[cursor].kind == 31 {
                cursor = cursor + 1; // Consume ')'
            }
        } else if cursor < tokens.len() && tokens[cursor].kind == 10 {
            cursor = cursor + 1; // Consume return type name
        }
    }
    if cursor < tokens.len() && tokens[cursor].kind == 32 {
        cursor = cursor + 1; // Consume '{'
    }

    mut stmts: List<AstStmt> = List::new();
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else if tokens[cursor].kind == 33 {
            cursor = cursor + 1; // Consume '}'
            parsing = false;
        } else if tokens[cursor].kind == 0 {
            parsing = false;
        } else {
            let stmt = parse_statement(inout cursor, tokens, inout pool);
            stmts.push(stmt);
        }
    }

    return AstFunction(name: fn_name, param_name: param_name, params: params, statements: stmts, is_variadic: is_variadic);
}

// High-level parser: pattern matching (`_`, literal, identifier, `Some(x)`)
pub fn parse_pattern(inout cursor: i64, tokens: List<Token>) -> AstPattern {
    if cursor >= tokens.len() {
        return AstPattern(kind: 1, val: 0, name: "_", sub_pat_name: "", has_sub: false);
    }
    let tok = tokens[cursor];
    if tok.kind == 38 {
        // Wildcard '_'
        cursor = cursor + 1;
        return AstPattern(kind: 1, val: 0, name: "_", sub_pat_name: "", has_sub: false);
    }
    if tok.kind == 11 {
        // Integer literal pattern
        cursor = cursor + 1;
        return AstPattern(kind: 2, val: tok.value, name: "", sub_pat_name: "", has_sub: false);
    }
    if tok.kind == 10 {
        let ident_name = tok.lexeme;
        cursor = cursor + 1;
        // Check if followed by '(' for variant pattern e.g. Some(x)
        if cursor < tokens.len() && tokens[cursor].kind == 30 {
            cursor = cursor + 1; // Consume '('
            mut sub_name = "";
            if cursor < tokens.len() && tokens[cursor].kind == 10 {
                sub_name = tokens[cursor].lexeme;
                cursor = cursor + 1;
            }
            if cursor < tokens.len() && tokens[cursor].kind == 31 {
                cursor = cursor + 1; // Consume ')'
            }
            return AstPattern(kind: 4, val: 0, name: ident_name, sub_pat_name: sub_name, has_sub: true);
        }
        return AstPattern(kind: 3, val: 0, name: ident_name, sub_pat_name: "", has_sub: false);
    }
    return AstPattern(kind: 1, val: 0, name: "_", sub_pat_name: "", has_sub: false);
}

// High-level parser: match expressions (`match target { pat => expr, ... }`)
pub fn parse_match(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstMatch {
    cursor = cursor + 1; // Consume 'match'
    let target_name = tokens[cursor].lexeme;
    cursor = cursor + 1; // Consume target variable

    if cursor < tokens.len() && tokens[cursor].kind == 32 {
        cursor = cursor + 1; // Consume '{'
    }

    mut arms: List<AstMatchArm> = List::new();
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else if tokens[cursor].kind == 33 {
            cursor = cursor + 1; // Consume '}'
            parsing = false;
        } else {
            let pat = parse_pattern(inout cursor, tokens);
            if cursor < tokens.len() && tokens[cursor].kind == 37 {
                cursor = cursor + 1; // Consume '=>'
            }
            let body_expr = parse_expression(inout cursor, tokens, inout pool);
            pool.push(body_expr);
            let body_idx = pool.len() - 1;

            if cursor < tokens.len() && (tokens[cursor].kind == 39 || tokens[cursor].kind == 35) {
                cursor = cursor + 1; // Consume ',' or ';'
            }

            arms.push(AstMatchArm(pat: pat, expr: ref pool[body_idx]));
        }
    }

    return AstMatch(target_var: target_name, arms: arms);
}

// High-level parser: nested patterns with tuple destructuring and guards:
// e.g. `_`, `42`, `(0, y)`, `(x, y) if x == y`
pub fn parse_nested_pattern(inout cursor: i64, tokens: List<Token>) -> AstNestedPattern {
    if cursor >= tokens.len() {
        return AstNestedPattern(
            kind: 1, val: 0, name: "_",
            sub_pat1_kind: 0, sub_pat1_val: 0, sub_pat1_name: "",
            sub_pat2_kind: 0, sub_pat2_val: 0, sub_pat2_name: "",
            has_guard: false, guard_val: 0
        );
    }
    let tok = tokens[cursor];
    // 1. Wildcard `_`
    if tok.kind == 38 {
        cursor = cursor + 1;
        return AstNestedPattern(
            kind: 1, val: 0, name: "_",
            sub_pat1_kind: 0, sub_pat1_val: 0, sub_pat1_name: "",
            sub_pat2_kind: 0, sub_pat2_val: 0, sub_pat2_name: "",
            has_guard: false, guard_val: 0
        );
    }
    // 2. Integer literal
    if tok.kind == 11 {
        cursor = cursor + 1;
        return AstNestedPattern(
            kind: 2, val: tok.value, name: "",
            sub_pat1_kind: 0, sub_pat1_val: 0, sub_pat1_name: "",
            sub_pat2_kind: 0, sub_pat2_val: 0, sub_pat2_name: "",
            has_guard: false, guard_val: 0
        );
    }
    // 3. Tuple pattern: `(p1, p2)` or `(p1, p2) if guard`
    if tok.kind == 30 {
        cursor = cursor + 1; // Consume '('
        mut p1_k: i64 = 1;
        mut p1_v: i64 = 0;
        mut p1_n = "";
        if cursor < tokens.len() {
            let t1 = tokens[cursor];
            if t1.kind == 38 {
                p1_k = 1;
                cursor = cursor + 1;
            } else if t1.kind == 11 {
                p1_k = 2;
                p1_v = t1.value;
                cursor = cursor + 1;
            } else if t1.kind == 10 {
                p1_k = 3;
                p1_n = t1.lexeme;
                cursor = cursor + 1;
            }
        }
        if cursor < tokens.len() && tokens[cursor].kind == 39 {
            cursor = cursor + 1; // Consume ','
        }
        mut p2_k: i64 = 1;
        mut p2_v: i64 = 0;
        mut p2_n = "";
        if cursor < tokens.len() {
            let t2 = tokens[cursor];
            if t2.kind == 38 {
                p2_k = 1;
                cursor = cursor + 1;
            } else if t2.kind == 11 {
                p2_k = 2;
                p2_v = t2.value;
                cursor = cursor + 1;
            } else if t2.kind == 10 {
                p2_k = 3;
                p2_n = t2.lexeme;
                cursor = cursor + 1;
            }
        }
        if cursor < tokens.len() && tokens[cursor].kind == 31 {
            cursor = cursor + 1; // Consume ')'
        }
        mut has_guard = false;
        mut guard_val: i64 = 0;
        if cursor < tokens.len() && tokens[cursor].kind == 28 {
            // 'if' guard
            cursor = cursor + 1; // Consume 'if'
            has_guard = true;
            // Parse simple guard expression until '=>'
            while cursor < tokens.len() && tokens[cursor].kind != 37 {
                if tokens[cursor].kind == 11 {
                    guard_val = tokens[cursor].value;
                }
                cursor = cursor + 1;
            }
        }
        return AstNestedPattern(
            kind: 4, val: 0, name: "tuple",
            sub_pat1_kind: p1_k, sub_pat1_val: p1_v, sub_pat1_name: p1_n,
            sub_pat2_kind: p2_k, sub_pat2_val: p2_v, sub_pat2_name: p2_n,
            has_guard: has_guard, guard_val: guard_val
        );
    }
    // 4. Identifier binding: `x`
    if tok.kind == 10 {
        let id_name = tok.lexeme;
        cursor = cursor + 1;
        return AstNestedPattern(
            kind: 3, val: 0, name: id_name,
            sub_pat1_kind: 0, sub_pat1_val: 0, sub_pat1_name: "",
            sub_pat2_kind: 0, sub_pat2_val: 0, sub_pat2_name: "",
            has_guard: false, guard_val: 0
        );
    }
    return AstNestedPattern(
        kind: 1, val: 0, name: "_",
        sub_pat1_kind: 0, sub_pat1_val: 0, sub_pat1_name: "",
        sub_pat2_kind: 0, sub_pat2_val: 0, sub_pat2_name: "",
        has_guard: false, guard_val: 0
    );
}

// High-level parser: nested match expressions (`match target { (0, y) => expr, ... }`)
pub fn parse_nested_match(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstNestedMatch {
    cursor = cursor + 1; // Consume 'match'
    let target_name = tokens[cursor].lexeme;
    cursor = cursor + 1; // Consume target variable

    if cursor < tokens.len() && tokens[cursor].kind == 32 {
        cursor = cursor + 1; // Consume '{'
    }

    mut arms: List<AstNestedMatchArm> = List::new();
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else if tokens[cursor].kind == 33 {
            cursor = cursor + 1; // Consume '}'
            parsing = false;
        } else {
            let pat = parse_nested_pattern(inout cursor, tokens);
            if cursor < tokens.len() && tokens[cursor].kind == 37 {
                cursor = cursor + 1; // Consume '=>'
            }
            let body_expr = parse_expression(inout cursor, tokens, inout pool);
            pool.push(body_expr);
            let body_idx = pool.len() - 1;

            if cursor < tokens.len() && (tokens[cursor].kind == 39 || tokens[cursor].kind == 35) {
                cursor = cursor + 1; // Consume ',' or ';'
            }

            arms.push(AstNestedMatchArm(pat: pat, expr: ref pool[body_idx]));
        }
    }

    return AstNestedMatch(target_var: target_name, arms: arms);
}

// High-level parser: trait definitions (`pub trait Name { fn meth(self) -> Ret; }`)
pub fn parse_trait(inout cursor: i64, tokens: List<Token>) -> AstTrait {
    mut is_pub = false;
    if cursor < tokens.len() && tokens[cursor].kind == 15 {
        is_pub = true;
        cursor = cursor + 1; // Consume 'pub'
    }
    if cursor < tokens.len() && tokens[cursor].kind == 9 {
        cursor = cursor + 1; // Consume 'trait'
    }
    let trait_name = tokens[cursor].lexeme;
    cursor = cursor + 1; // Consume trait name

    if cursor < tokens.len() && tokens[cursor].kind == 32 {
        cursor = cursor + 1; // Consume '{'
    }

    mut methods: List<AstTraitMethod> = List::new();
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else if tokens[cursor].kind == 33 {
            cursor = cursor + 1; // Consume '}'
            parsing = false;
        } else if tokens[cursor].kind == 1 {
            cursor = cursor + 1; // Consume 'fn'
            let meth_name = tokens[cursor].lexeme;
            cursor = cursor + 1; // Consume method name
            cursor = cursor + 1; // Consume '('
            let p_name = tokens[cursor].lexeme;
            cursor = cursor + 1; // Consume param name
            mut p_ty = "";
            if cursor < tokens.len() && tokens[cursor].kind == 34 {
                cursor = cursor + 1; // Consume ':'
                p_ty = tokens[cursor].lexeme;
                cursor = cursor + 1; // Consume param type
            }
            cursor = cursor + 1; // Consume ')'
            mut r_ty = "";
            if cursor < tokens.len() && tokens[cursor].kind == 36 {
                cursor = cursor + 1; // Consume '->'
                r_ty = tokens[cursor].lexeme;
                cursor = cursor + 1; // Consume return type
            }
            if cursor < tokens.len() && tokens[cursor].kind == 35 {
                cursor = cursor + 1; // Consume ';'
            }
            methods.push(AstTraitMethod(
                name: meth_name,
                param_name: p_name,
                param_ty: p_ty,
                ret_ty: r_ty
            ));
        } else {
            cursor = cursor + 1;
        }
    }

    return AstTrait(is_pub: is_pub, name: trait_name, methods: methods);
}

// High-level parser: impl definitions (`impl Trait for Target { ... }` or `impl Target { ... }`)
pub fn parse_impl(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstImpl {
    cursor = cursor + 1; // Consume 'impl'
    let first_tok = tokens[cursor];
    cursor = cursor + 1;

    mut has_trait = false;
    mut trait_name = "";
    mut target_ty = "";

    if cursor < tokens.len() && tokens[cursor].kind == 13 {
        // 'for' keyword found: `impl Trait for Target`
        has_trait = true;
        trait_name = first_tok.lexeme;
        cursor = cursor + 1; // Consume 'for'
        target_ty = tokens[cursor].lexeme;
        cursor = cursor + 1; // Consume target type
    } else {
        // Inherent impl: `impl Target`
        has_trait = false;
        trait_name = "";
        target_ty = first_tok.lexeme;
    }

    if cursor < tokens.len() && tokens[cursor].kind == 32 {
        cursor = cursor + 1; // Consume '{'
    }

    mut methods: List<AstFunction> = List::new();
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else if tokens[cursor].kind == 33 {
            cursor = cursor + 1; // Consume '}'
            parsing = false;
        } else if tokens[cursor].kind == 1 || (tokens[cursor].kind == 15 && cursor + 1 < tokens.len() && tokens[cursor + 1].kind == 1) {
            if tokens[cursor].kind == 15 {
                cursor = cursor + 1; // Consume optional 'pub'
            }
            let func = parse_function(inout cursor, tokens, inout pool);
            methods.push(func);
        } else {
            cursor = cursor + 1;
        }
    }

    return AstImpl(
        has_trait: has_trait,
        trait_name: trait_name,
        target_ty: target_ty,
        methods: methods
    );
}

// High-level parser: struct definitions (`pub struct Name { field: Ty, ... }`)
pub fn parse_struct(inout cursor: i64, tokens: List<Token>) -> AstStruct {
    mut is_pub = false;
    if cursor < tokens.len() && tokens[cursor].kind == 15 {
        is_pub = true;
        cursor = cursor + 1; // Consume 'pub'
    }
    if cursor < tokens.len() && tokens[cursor].kind == 8 {
        cursor = cursor + 1; // Consume 'struct'
    }
    let st_name = tokens[cursor].lexeme;
    cursor = cursor + 1; // Consume struct name

    if cursor < tokens.len() && tokens[cursor].kind == 32 {
        cursor = cursor + 1; // Consume '{'
    }

    mut fields: List<AstField> = List::new();
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else if tokens[cursor].kind == 33 {
            cursor = cursor + 1; // Consume '}'
            parsing = false;
        } else if tokens[cursor].kind == 10 {
            let f_name = tokens[cursor].lexeme;
            cursor = cursor + 1;
            cursor = cursor + 1; // Consume ':'
            let f_ty = tokens[cursor].lexeme;
            cursor = cursor + 1; // Consume type
            if cursor < tokens.len() && (tokens[cursor].kind == 39 || tokens[cursor].kind == 35) {
                cursor = cursor + 1; // Consume ',' or ';'
            }
            fields.push(AstField(name: f_name, ty: f_ty));
        } else {
            cursor = cursor + 1;
        }
    }

    return AstStruct(is_pub: is_pub, name: st_name, fields: fields);
}

// High-level parser: type alias definitions (`pub type Name = Target;` or `type Name = Target;`)
pub fn parse_type_alias(inout cursor: i64, tokens: List<Token>) -> AstTypeAlias {
    mut is_pub = false;
    if cursor < tokens.len() && tokens[cursor].kind == 15 {
        is_pub = true;
        cursor = cursor + 1; // Consume 'pub'
    }
    if cursor < tokens.len() && tokens[cursor].kind == 17 {
        cursor = cursor + 1; // Consume 'type'
    }
    mut name = "";
    if cursor < tokens.len() && tokens[cursor].kind == 10 {
        name = tokens[cursor].lexeme;
        cursor = cursor + 1; // Consume alias name
    }
    if cursor < tokens.len() && tokens[cursor].kind == 24 {
        cursor = cursor + 1; // Consume '='
    }
    mut target_ty = "";
    if cursor < tokens.len() {
        if tokens[cursor].kind == 30 {
            // Tuple type `(i64, i64)`
            target_ty = "(";
            cursor = cursor + 1;
            while cursor < tokens.len() && tokens[cursor].kind != 31 {
                target_ty = target_ty + tokens[cursor].lexeme;
                cursor = cursor + 1;
            }
            if cursor < tokens.len() && tokens[cursor].kind == 31 {
                target_ty = target_ty + ")";
                cursor = cursor + 1;
            }
        } else if tokens[cursor].kind == 10 {
            target_ty = tokens[cursor].lexeme;
            cursor = cursor + 1;
        }
    }
    if cursor < tokens.len() && tokens[cursor].kind == 35 {
        cursor = cursor + 1; // Consume ';'
    }
    return AstTypeAlias(is_pub: is_pub, name: name, target_ty: target_ty);
}

// High-level parser: explicit arena declarations (`arena scratch;` or `arena cow scratch = 65536;`)
pub fn parse_arena_decl(inout cursor: i64, tokens: List<Token>) -> AstArenaDecl {
    mut is_cow = false;
    if cursor < tokens.len() && tokens[cursor].kind == 54 {
        is_cow = true;
        cursor = cursor + 1; // Consume 'cow' prefix
    }
    if cursor < tokens.len() && tokens[cursor].kind == 18 {
        cursor = cursor + 1; // Consume 'arena'
    }
    if cursor < tokens.len() && tokens[cursor].kind == 54 {
        is_cow = true;
        cursor = cursor + 1; // Consume 'cow' after 'arena'
    }
    mut name = "scratch";
    if cursor < tokens.len() && tokens[cursor].kind == 10 {
        name = tokens[cursor].lexeme;
        cursor = cursor + 1; // Consume arena identifier
    }
    mut capacity: i64 = 65536;
    mut page_size: i64 = 4096;
    if cursor < tokens.len() && tokens[cursor].kind == 30 {
        // Parenthesized parameters: (page_size: 4096, capacity: 65536)
        cursor = cursor + 1; // Consume '('
        while cursor < tokens.len() && tokens[cursor].kind != 31 {
            let opt_name = tokens[cursor].lexeme;
            cursor = cursor + 1;
            if cursor < tokens.len() && tokens[cursor].kind == 34 {
                cursor = cursor + 1; // Consume ':'
            }
            if cursor < tokens.len() && tokens[cursor].kind == 11 {
                let opt_val = tokens[cursor].value;
                cursor = cursor + 1;
                if opt_name == "page_size" {
                    page_size = opt_val;
                } else if opt_name == "capacity" {
                    capacity = opt_val;
                }
            }
            if cursor < tokens.len() && tokens[cursor].kind == 39 {
                cursor = cursor + 1; // Consume ','
            }
        }
        if cursor < tokens.len() && tokens[cursor].kind == 31 {
            cursor = cursor + 1; // Consume ')'
        }
    } else if cursor < tokens.len() && tokens[cursor].kind == 24 {
        cursor = cursor + 1; // Consume '='
        if cursor < tokens.len() && tokens[cursor].kind == 11 {
            capacity = tokens[cursor].value;
            cursor = cursor + 1;
        }
    }
    if cursor < tokens.len() && tokens[cursor].kind == 35 {
        cursor = cursor + 1; // Consume ';'
    }
    return AstArenaDecl(name: name, capacity: capacity, is_cow: is_cow, page_size: page_size);
}

// High-level parser: constant declarations (`pub const Name: Ty = Val;` or `const Name: Ty = Val;`)
pub fn parse_const(inout cursor: i64, tokens: List<Token>) -> AstConst {
    mut is_pub = false;
    if cursor < tokens.len() && tokens[cursor].kind == 15 {
        is_pub = true;
        cursor = cursor + 1; // Consume 'pub'
    }
    if cursor < tokens.len() && tokens[cursor].kind == 19 {
        cursor = cursor + 1; // Consume 'const'
    }
    mut name = "";
    if cursor < tokens.len() && tokens[cursor].kind == 10 {
        name = tokens[cursor].lexeme;
        cursor = cursor + 1; // Consume identifier
    }
    mut ty = "i64";
    if cursor < tokens.len() && tokens[cursor].kind == 34 {
        cursor = cursor + 1; // Consume ':'
        if cursor < tokens.len() && tokens[cursor].kind == 10 {
            ty = tokens[cursor].lexeme;
            cursor = cursor + 1; // Consume type
        }
    }
    if cursor < tokens.len() && tokens[cursor].kind == 24 {
        cursor = cursor + 1; // Consume '='
    }
    mut val: i64 = 0;
    if cursor < tokens.len() && tokens[cursor].kind == 11 {
        val = tokens[cursor].value;
        cursor = cursor + 1; // Consume value
    }
    if cursor < tokens.len() && tokens[cursor].kind == 35 {
        cursor = cursor + 1; // Consume ';'
    }
    return AstConst(is_pub: is_pub, name: name, ty: ty, val: val);
}

// High-level parser: enum declarations (`pub enum Name { Variant1, Variant2 }`)
pub fn parse_enum(inout cursor: i64, tokens: List<Token>) -> AstEnum {
    mut is_pub = false;
    if cursor < tokens.len() && tokens[cursor].kind == 15 {
        is_pub = true;
        cursor = cursor + 1; // Consume 'pub'
    }
    if cursor < tokens.len() && tokens[cursor].kind == 26 {
        cursor = cursor + 1; // Consume 'enum'
    }
    mut name = "";
    if cursor < tokens.len() && tokens[cursor].kind == 10 {
        name = tokens[cursor].lexeme;
        cursor = cursor + 1; // Consume enum name
    }
    if cursor < tokens.len() && tokens[cursor].kind == 32 {
        cursor = cursor + 1; // Consume '{'
    }
    mut variants: List<AstEnumVariant> = List::new();
    mut current_disc: i64 = 0;
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else if tokens[cursor].kind == 33 {
            cursor = cursor + 1; // Consume '}'
            parsing = false;
        } else if tokens[cursor].kind == 10 {
            let var_name = tokens[cursor].lexeme;
            cursor = cursor + 1;
            mut disc = current_disc;
            if cursor < tokens.len() && tokens[cursor].kind == 24 {
                cursor = cursor + 1; // Consume '='
                if cursor < tokens.len() && tokens[cursor].kind == 11 {
                    disc = tokens[cursor].value;
                    cursor = cursor + 1;
                }
            }
            current_disc = disc + 1;
            if cursor < tokens.len() && (tokens[cursor].kind == 39 || tokens[cursor].kind == 35) {
                cursor = cursor + 1; // Consume ',' or ';'
            }
            variants.push(AstEnumVariant(name: var_name, discriminant: disc));
        } else {
            cursor = cursor + 1;
        }
    }
    return AstEnum(is_pub: is_pub, name: name, variants: variants);
}

// High-level parser: comptime block (`comptime { let limit = 100; }`)
pub fn parse_comptime_block(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstComptimeBlock {
    cursor = cursor + 1; // Consume 'comptime'
    if cursor < tokens.len() && tokens[cursor].kind == 32 {
        cursor = cursor + 1; // Consume '{'
    }

    mut stmts: List<AstStmt> = List::new();
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else if tokens[cursor].kind == 33 {
            cursor = cursor + 1; // Consume '}'
            parsing = false;
        } else {
            let stmt = parse_statement(inout cursor, tokens, inout pool);
            stmts.push(stmt);
        }
    }

    return AstComptimeBlock(statements: stmts);
}

// High-level parser: syntax macro definition (`macro name($param) { return $param; }`)
pub fn parse_macro_def(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstMacroDef {
    cursor = cursor + 1; // Consume 'macro'
    mut m_name = "";
    if cursor < tokens.len() && tokens[cursor].kind == 10 {
        m_name = tokens[cursor].lexeme;
        cursor = cursor + 1; // Consume macro name
    }
    if cursor < tokens.len() && tokens[cursor].kind == 30 {
        cursor = cursor + 1; // Consume '('
    }
    mut p_name = "";
    if cursor < tokens.len() && tokens[cursor].kind == 53 {
        cursor = cursor + 1; // Consume '$'
    }
    if cursor < tokens.len() && tokens[cursor].kind == 10 {
        p_name = tokens[cursor].lexeme;
        cursor = cursor + 1; // Consume parameter name
    }
    if cursor < tokens.len() && tokens[cursor].kind == 31 {
        cursor = cursor + 1; // Consume ')'
    }
    if cursor < tokens.len() && tokens[cursor].kind == 32 {
        cursor = cursor + 1; // Consume '{'
    }

    mut stmts: List<AstStmt> = List::new();
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else if tokens[cursor].kind == 33 {
            cursor = cursor + 1; // Consume '}'
            parsing = false;
        } else {
            let stmt = parse_statement(inout cursor, tokens, inout pool);
            stmts.push(stmt);
        }
    }

    return AstMacroDef(name: m_name, param_name: p_name, statements: stmts);
}

// Recursive-descent parser: while loops (`while left op right { target = expr; }`)
pub fn parse_while(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstWhile {
    cursor = cursor + 1; // Consume 'while'
    let left_expr = parse_expression(inout cursor, tokens, inout pool);
    pool.push(left_expr);
    let left_idx = pool.len() - 1;

    mut op: i64 = 3; // default <
    if cursor < tokens.len() {
        let op_tok = tokens[cursor];
        if op_tok.kind == 40 { op = 1; }
        else if op_tok.kind == 41 { op = 2; }
        else if op_tok.kind == 42 { op = 3; }
        else if op_tok.kind == 43 { op = 4; }
        else if op_tok.kind == 44 { op = 5; }
        else if op_tok.kind == 45 { op = 6; }
        cursor = cursor + 1;
    }

    let right_expr = parse_expression(inout cursor, tokens, inout pool);
    pool.push(right_expr);
    let right_idx = pool.len() - 1;

    // Consume '{'
    if cursor < tokens.len() && tokens[cursor].kind == 32 {
        cursor = cursor + 1;
    }

    // Parse body assignment: `x = x - 1;` or body expr
    mut target_var = "";
    if cursor < tokens.len() && tokens[cursor].kind == 10 {
        target_var = tokens[cursor].lexeme;
        cursor = cursor + 1;
    }
    if cursor < tokens.len() && tokens[cursor].kind == 24 { // '='
        cursor = cursor + 1;
    }

    let body_expr = parse_expression(inout cursor, tokens, inout pool);
    pool.push(body_expr);
    let body_idx = pool.len() - 1;

    if cursor < tokens.len() && tokens[cursor].kind == 35 { // ';'
        cursor = cursor + 1;
    }
    if cursor < tokens.len() && tokens[cursor].kind == 33 { // '}'
        cursor = cursor + 1;
    }

    return AstWhile(
        cond_left: ref pool[left_idx],
        cond_op: op,
        cond_right: ref pool[right_idx],
        body_target_var: target_var,
        body_expr: ref pool[body_idx]
    );
}

// Recursive-descent parser: if/else conditional branching
pub fn parse_if(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstIf {
    cursor = cursor + 1; // Consume 'if'
    let left_expr = parse_expression(inout cursor, tokens, inout pool);
    pool.push(left_expr);
    let left_idx = pool.len() - 1;

    mut op: i64 = 1; // default ==
    if cursor < tokens.len() {
        let op_tok = tokens[cursor];
        if op_tok.kind == 40 { op = 1; }
        else if op_tok.kind == 41 { op = 2; }
        else if op_tok.kind == 42 { op = 3; }
        else if op_tok.kind == 43 { op = 4; }
        else if op_tok.kind == 44 { op = 5; }
        else if op_tok.kind == 45 { op = 6; }
        cursor = cursor + 1;
    }

    let right_expr = parse_expression(inout cursor, tokens, inout pool);
    pool.push(right_expr);
    let right_idx = pool.len() - 1;

    // Consume '{'
    if cursor < tokens.len() && tokens[cursor].kind == 32 {
        cursor = cursor + 1;
    }

    // Inside then block: parse return or expr
    if cursor < tokens.len() && tokens[cursor].kind == 4 { // 'return'
        cursor = cursor + 1;
    }
    let then_expr = parse_expression(inout cursor, tokens, inout pool);
    pool.push(then_expr);
    let then_idx = pool.len() - 1;

    if cursor < tokens.len() && tokens[cursor].kind == 35 { // ';'
        cursor = cursor + 1;
    }
    if cursor < tokens.len() && tokens[cursor].kind == 33 { // '}'
        cursor = cursor + 1;
    }

    mut has_else = false;
    mut else_idx: i64 = -1;
    if cursor < tokens.len() && tokens[cursor].kind == 29 { // 'else'
        cursor = cursor + 1;
        has_else = true;
        if cursor < tokens.len() && tokens[cursor].kind == 32 { // '{'
            cursor = cursor + 1;
        }
        if cursor < tokens.len() && tokens[cursor].kind == 4 { // 'return'
            cursor = cursor + 1;
        }
        let else_expr = parse_expression(inout cursor, tokens, inout pool);
        pool.push(else_expr);
        else_idx = pool.len() - 1;
        if cursor < tokens.len() && tokens[cursor].kind == 35 { // ';'
            cursor = cursor + 1;
        }
        if cursor < tokens.len() && tokens[cursor].kind == 33 { // '}'
            cursor = cursor + 1;
        }
    }

    mut else_ref: ?ref AstExpr = None;
    if has_else {
        else_ref = ref pool[else_idx];
    }

    return AstIf(
        cond_left: ref pool[left_idx],
        cond_op: op,
        cond_right: ref pool[right_idx],
        then_expr: ref pool[then_idx],
        has_else: has_else,
        else_expr: else_ref
    );
}

// High-level parser: full module program item collection
pub fn parse_program(tokens: List<Token>, inout pool: List<AstExpr>) -> AstProgram {
    mut traits: List<AstTrait> = List::new();
    mut impls: List<AstImpl> = List::new();
    mut structs: List<AstStruct> = List::new();
    mut type_aliases: List<AstTypeAlias> = List::new();
    mut arenas: List<AstArenaDecl> = List::new();
    mut constants: List<AstConst> = List::new();
    mut enums: List<AstEnum> = List::new();
    mut comptime_blocks: List<AstComptimeBlock> = List::new();
    mut macros: List<AstMacroDef> = List::new();
    mut functions: List<AstFunction> = List::new();

    mut cursor: i64 = 0;
    while cursor < tokens.len() {
        let tok = tokens[cursor];
        if tok.kind == 0 {
            // EOF sentinel - terminate parsing cleanly
            cursor = tokens.len();
        } else if tok.kind == 15 {
            // 'pub' prefix
            if cursor + 1 < tokens.len() {
                let next = tokens[cursor + 1];
                if next.kind == 17 {
                    let alias = parse_type_alias(inout cursor, tokens);
                    type_aliases.push(alias);
                } else if next.kind == 19 {
                    let cn = parse_const(inout cursor, tokens);
                    constants.push(cn);
                } else if next.kind == 26 {
                    let en = parse_enum(inout cursor, tokens);
                    enums.push(en);
                } else if next.kind == 9 {
                    let tr = parse_trait(inout cursor, tokens);
                    traits.push(tr);
                } else if next.kind == 8 {
                    let st = parse_struct(inout cursor, tokens);
                    structs.push(st);
                } else if next.kind == 1 {
                    cursor = cursor + 1; // Consume 'pub'
                    let f = parse_function(inout cursor, tokens, inout pool);
                    functions.push(f);
                } else {
                    cursor = cursor + 1;
                }
            } else {
                cursor = cursor + 1;
            }
        } else if tok.kind == 17 {
            let alias = parse_type_alias(inout cursor, tokens);
            type_aliases.push(alias);
        } else if tok.kind == 18 || tok.kind == 54 {
            let ar = parse_arena_decl(inout cursor, tokens);
            arenas.push(ar);
        } else if tok.kind == 19 {
            let cn = parse_const(inout cursor, tokens);
            constants.push(cn);
        } else if tok.kind == 26 {
            let en = parse_enum(inout cursor, tokens);
            enums.push(en);
        } else if tok.kind == 9 {
            let tr = parse_trait(inout cursor, tokens);
            traits.push(tr);
        } else if tok.kind == 12 {
            let im = parse_impl(inout cursor, tokens, inout pool);
            impls.push(im);
        } else if tok.kind == 8 {
            let st = parse_struct(inout cursor, tokens);
            structs.push(st);
        } else if tok.kind == 51 {
            let md = parse_macro_def(inout cursor, tokens, inout pool);
            macros.push(md);
        } else if tok.kind == 52 {
            let cb = parse_comptime_block(inout cursor, tokens, inout pool);
            comptime_blocks.push(cb);
        } else if tok.kind == 1 {
            let f = parse_function(inout cursor, tokens, inout pool);
            functions.push(f);
        } else {
            cursor = cursor + 1;
        }
    }

    return AstProgram(
        traits: traits,
        impls: impls,
        structs: structs,
        type_aliases: type_aliases,
        arenas: arenas,
        constants: constants,
        enums: enums,
        comptime_blocks: comptime_blocks,
        macros: macros,
        functions: functions
    );
}

// Syntax error diagnostic representation for compiler parser
pub struct ParseDiagnostic {
    message: String,
    token_kind: i64,
    token_lexeme: String,
    cursor_pos: i64
}

pub fn make_parse_diagnostic(msg: String, kind: i64, lex: String, pos: i64) -> ParseDiagnostic {
    return ParseDiagnostic(message: msg, token_kind: kind, token_lexeme: lex, cursor_pos: pos);
}

/// Panic mode error recovery: advances cursor until reaching a safe synchronization boundary
/// (semicolon, block closing brace, or start of a new statement/declaration).
pub fn synchronize_to_statement_boundary(inout cursor: i64, tokens: List<Token>) {
    while cursor < tokens.len() {
        let k = tokens[cursor].kind;
        if k == 35 {
            // Semicolon ';': consume to complete synchronization
            cursor = cursor + 1;
            return;
        }
        if k == 33 || k == 0 {
            // Closing brace '}' or EOF: do not consume, allow enclosing parser to exit
            return;
        }
        // Beginning of a new statement or top-level item:
        if k == 1 || k == 2 || k == 3 || k == 4 || k == 8 || k == 9 || k == 12 || k == 15 || k == 17 || k == 18 || k == 19 || k == 26 || k == 27 || k == 28 || k == 51 || k == 52 {
            return;
        }
        cursor = cursor + 1;
    }
}

/// Parse a single statement with explicit diagnostic recording and panic-mode error recovery.
pub fn parse_statement_with_recovery(
    inout cursor: i64,
    tokens: List<Token>,
    inout pool: List<AstExpr>,
    inout diagnostics: List<ParseDiagnostic>
) -> AstStmt {
    if cursor >= tokens.len() {
        return AstStmt(is_return: false, target_var: "", expr: None);
    }
    let tok = tokens[cursor];
    // Valid statement starts: let(2), mut(3), return(4), ident(10)
    if tok.kind == 2 || tok.kind == 3 || tok.kind == 4 || tok.kind == 10 {
        return parse_statement(inout cursor, tokens, inout pool);
    }
    // Unexpected token: record diagnostic and trigger panic-mode synchronization
    let diag = make_parse_diagnostic(
        "unexpected token at start of statement: " + tok.lexeme,
        tok.kind,
        tok.lexeme,
        cursor
    );
    diagnostics.push(diag);
    synchronize_to_statement_boundary(inout cursor, tokens);
    return AstStmt(is_return: false, target_var: "_error_", expr: None);
}

/// Parse a function body with panic-mode recovery on erroneous statements.
pub fn parse_function_with_recovery(
    inout cursor: i64,
    tokens: List<Token>,
    inout pool: List<AstExpr>,
    inout diagnostics: List<ParseDiagnostic>
) -> AstFunction {
    if cursor >= tokens.len() {
        mut empty_stmts: List<AstStmt> = List::new();
        return AstFunction(name: "compute", param_name: "x", params: List::new(), statements: empty_stmts, is_variadic: false);
    }
    if cursor < tokens.len() && tokens[cursor].kind == 1 {
        cursor = cursor + 1; // Consume 'fn'
    }
    mut fn_name = "";
    if cursor < tokens.len() && tokens[cursor].kind == 10 {
        fn_name = tokens[cursor].lexeme;
        cursor = cursor + 1;
    } else {
        fn_name = "compute";
    }
    if cursor < tokens.len() && tokens[cursor].kind == 30 {
        cursor = cursor + 1; // Consume '('
    }
    mut params: List<String> = List::new();
    mut is_variadic = false;
    if cursor < tokens.len() && tokens[cursor].kind != 31 {
        while cursor < tokens.len() && tokens[cursor].kind != 31 {
            if tokens[cursor].kind == 37 {
                cursor = cursor + 1;
                is_variadic = true;
                break;
            }
            if tokens[cursor].kind == 5 || tokens[cursor].kind == 6 || tokens[cursor].kind == 7 {
                cursor = cursor + 1;
            }
            if cursor < tokens.len() && tokens[cursor].kind == 10 {
                let pname = tokens[cursor].lexeme;
                cursor = cursor + 1;
                params.push(pname);
            }
            if cursor < tokens.len() && tokens[cursor].kind == 34 {
                cursor = cursor + 1;
                if cursor < tokens.len() && tokens[cursor].kind == 10 {
                    cursor = cursor + 1;
                }
            }
            if cursor < tokens.len() && tokens[cursor].kind == 39 {
                cursor = cursor + 1;
            } else {
                break;
            }
        }
    }
    if cursor < tokens.len() && tokens[cursor].kind == 31 {
        cursor = cursor + 1; // Consume ')'
    }
    mut param_name = "";
    if params.len() > 0 {
        param_name = params[0];
    }
    if cursor < tokens.len() && tokens[cursor].kind == 36 {
        cursor = cursor + 1; // Consume '->'
        if cursor < tokens.len() && tokens[cursor].kind == 30 {
            cursor = cursor + 1;
            while cursor < tokens.len() && tokens[cursor].kind != 31 {
                cursor = cursor + 1;
            }
            if cursor < tokens.len() && tokens[cursor].kind == 31 {
                cursor = cursor + 1;
            }
        } else if cursor < tokens.len() && tokens[cursor].kind == 10 {
            cursor = cursor + 1;
        }
    }
    if cursor < tokens.len() && tokens[cursor].kind == 32 {
        cursor = cursor + 1; // Consume '{'
    }

    mut stmts: List<AstStmt> = List::new();
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else if tokens[cursor].kind == 33 {
            cursor = cursor + 1; // Consume '}'
            parsing = false;
        } else if tokens[cursor].kind == 0 {
            parsing = false;
        } else {
            let stmt = parse_statement_with_recovery(inout cursor, tokens, inout pool, inout diagnostics);
            stmts.push(stmt);
        }
    }

    return AstFunction(name: fn_name, param_name: param_name, params: params, statements: stmts, is_variadic: is_variadic);
}

/// Parse entire program module while recording diagnostics and recovering from syntax errors.
pub fn parse_program_with_diagnostics(
    tokens: List<Token>,
    inout pool: List<AstExpr>,
    inout diagnostics: List<ParseDiagnostic>
) -> AstProgram {
    mut traits: List<AstTrait> = List::new();
    mut impls: List<AstImpl> = List::new();
    mut structs: List<AstStruct> = List::new();
    mut type_aliases: List<AstTypeAlias> = List::new();
    mut arenas: List<AstArenaDecl> = List::new();
    mut constants: List<AstConst> = List::new();
    mut enums: List<AstEnum> = List::new();
    mut comptime_blocks: List<AstComptimeBlock> = List::new();
    mut macros: List<AstMacroDef> = List::new();
    mut functions: List<AstFunction> = List::new();

    mut cursor: i64 = 0;
    while cursor < tokens.len() {
        let tok = tokens[cursor];
        if tok.kind == 0 {
            cursor = tokens.len();
        } else if tok.kind == 15 {
            if cursor + 1 < tokens.len() {
                let next = tokens[cursor + 1];
                if next.kind == 17 {
                    let alias = parse_type_alias(inout cursor, tokens);
                    type_aliases.push(alias);
                } else if next.kind == 19 {
                    let cn = parse_const(inout cursor, tokens);
                    constants.push(cn);
                } else if next.kind == 26 {
                    let en = parse_enum(inout cursor, tokens);
                    enums.push(en);
                } else if next.kind == 9 {
                    let tr = parse_trait(inout cursor, tokens);
                    traits.push(tr);
                } else if next.kind == 8 {
                    let st = parse_struct(inout cursor, tokens);
                    structs.push(st);
                } else if next.kind == 1 {
                    cursor = cursor + 1; // Consume 'pub'
                    let f = parse_function_with_recovery(inout cursor, tokens, inout pool, inout diagnostics);
                    functions.push(f);
                } else {
                    let diag = make_parse_diagnostic("unrecognized item after pub: " + next.lexeme, next.kind, next.lexeme, cursor + 1);
                    diagnostics.push(diag);
                    cursor = cursor + 1;
                }
            } else {
                cursor = cursor + 1;
            }
        } else if tok.kind == 17 {
            let alias = parse_type_alias(inout cursor, tokens);
            type_aliases.push(alias);
        } else if tok.kind == 18 || tok.kind == 54 {
            let ar = parse_arena_decl(inout cursor, tokens);
            arenas.push(ar);
        } else if tok.kind == 19 {
            let cn = parse_const(inout cursor, tokens);
            constants.push(cn);
        } else if tok.kind == 26 {
            let en = parse_enum(inout cursor, tokens);
            enums.push(en);
        } else if tok.kind == 9 {
            let tr = parse_trait(inout cursor, tokens);
            traits.push(tr);
        } else if tok.kind == 12 {
            let im = parse_impl(inout cursor, tokens, inout pool);
            impls.push(im);
        } else if tok.kind == 8 {
            let st = parse_struct(inout cursor, tokens);
            structs.push(st);
        } else if tok.kind == 51 {
            let md = parse_macro_def(inout cursor, tokens, inout pool);
            macros.push(md);
        } else if tok.kind == 52 {
            let cb = parse_comptime_block(inout cursor, tokens, inout pool);
            comptime_blocks.push(cb);
        } else if tok.kind == 1 {
            let f = parse_function_with_recovery(inout cursor, tokens, inout pool, inout diagnostics);
            functions.push(f);
        } else {
            let diag = make_parse_diagnostic("unexpected top-level token: " + tok.lexeme, tok.kind, tok.lexeme, cursor);
            diagnostics.push(diag);
            synchronize_to_statement_boundary(inout cursor, tokens);
        }
    }

    return AstProgram(
        traits: traits,
        impls: impls,
        structs: structs,
        type_aliases: type_aliases,
        arenas: arenas,
        constants: constants,
        enums: enums,
        comptime_blocks: comptime_blocks,
        macros: macros,
        functions: functions
    );
}

// Unit test 1: Generational reference AST construction
pub fn test_parser_ast_building() -> bool {
    mut node_left = AstExpr(kind: 2, val: 0, name: "x", op: 0, left: None, right: None);
    mut node_right = AstExpr(kind: 1, val: 40, name: "", op: 0, left: None, right: None);

    let bin_expr = AstExpr(
        kind: 3,
        val: 0,
        name: "",
        op: 1,
        left: ref node_left,
        right: ref node_right
    );

    if bin_expr.kind != 3 {
        return false;
    }
    if bin_expr.op != 1 {
        return false;
    }
    return true;
}

// Unit test 2: Operator precedence parsing (2 + 3 * 4)
pub fn test_parser_precedence() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 11, value: 2, lexeme: "2"));
    tokens.push(Token(kind: 20, value: 0, lexeme: "+"));
    tokens.push(Token(kind: 11, value: 3, lexeme: "3"));
    tokens.push(Token(kind: 22, value: 0, lexeme: "*"));
    tokens.push(Token(kind: 11, value: 4, lexeme: "4"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let root = parse_expression(inout cur, tokens, inout pool);

    return root.op == 1; // Root must be '+' addition, with '*' sub-expression on right
}

// Unit test 3: Parenthesized sub-expression grouping ((2 + 3) * 4)
pub fn test_parser_paren_precedence() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 11, value: 2, lexeme: "2"));
    tokens.push(Token(kind: 20, value: 0, lexeme: "+"));
    tokens.push(Token(kind: 11, value: 3, lexeme: "3"));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 22, value: 0, lexeme: "*"));
    tokens.push(Token(kind: 11, value: 4, lexeme: "4"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let root = parse_expression(inout cur, tokens, inout pool);

    return root.op == 3; // Root must be '*' multiplication
}

// Unit test 4: High-level Trait item parsing
pub fn test_parser_trait_declaration() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 15, value: 0, lexeme: "pub"));
    tokens.push(Token(kind: 9, value: 0, lexeme: "trait"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "Diagnosable"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 1, value: 0, lexeme: "fn"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "diagnose"));
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 10, value: 0, lexeme: "self"));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 36, value: 0, lexeme: "->"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "String"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));

    mut cur: i64 = 0;
    let tr = parse_trait(inout cur, tokens);
    if !tr.is_pub {
        return false;
    }
    if tr.name != "Diagnosable" {
        return false;
    }
    if tr.methods.len() != 1 {
        return false;
    }
    let m = tr.methods[0];
    if m.name != "diagnose" {
        return false;
    }
    if m.param_name != "self" {
        return false;
    }
    return m.ret_ty == "String";
}

// Unit test 5: High-level Impl item parsing
pub fn test_parser_impl_declaration() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 12, value: 0, lexeme: "impl"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "Diagnosable"));
    tokens.push(Token(kind: 13, value: 0, lexeme: "for"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "Diagnostic"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 1, value: 0, lexeme: "fn"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "diagnose"));
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 10, value: 0, lexeme: "self"));
    tokens.push(Token(kind: 34, value: 0, lexeme: ":"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "Diagnostic"));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 36, value: 0, lexeme: "->"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "String"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 4, value: 0, lexeme: "return"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "msg"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let im = parse_impl(inout cur, tokens, inout pool);

    if !im.has_trait {
        return false;
    }
    if im.trait_name != "Diagnosable" {
        return false;
    }
    if im.target_ty != "Diagnostic" {
        return false;
    }
    if im.methods.len() != 1 {
        return false;
    }
    return im.methods[0].name == "diagnose";
}

// Unit test 6: High-level Match Expression and Pattern Parsing
pub fn test_parser_match_expression() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 14, value: 0, lexeme: "match"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "val"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 11, value: 1, lexeme: "1"));
    tokens.push(Token(kind: 37, value: 0, lexeme: "=>"));
    tokens.push(Token(kind: 11, value: 10, lexeme: "10"));
    tokens.push(Token(kind: 39, value: 0, lexeme: ","));
    tokens.push(Token(kind: 11, value: 2, lexeme: "2"));
    tokens.push(Token(kind: 37, value: 0, lexeme: "=>"));
    tokens.push(Token(kind: 11, value: 20, lexeme: "20"));
    tokens.push(Token(kind: 39, value: 0, lexeme: ","));
    tokens.push(Token(kind: 38, value: 0, lexeme: "_"));
    tokens.push(Token(kind: 37, value: 0, lexeme: "=>"));
    tokens.push(Token(kind: 11, value: 42, lexeme: "42"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let mat = parse_match(inout cur, tokens, inout pool);

    if mat.target_var != "val" {
        return false;
    }
    if mat.arms.len() != 3 {
        return false;
    }
    let arm0 = mat.arms[0];
    if arm0.pat.kind != 2 || arm0.pat.val != 1 {
        return false;
    }
    let arm1 = mat.arms[1];
    if arm1.pat.kind != 2 || arm1.pat.val != 2 {
        return false;
    }
    let arm2 = mat.arms[2];
    if arm2.pat.kind != 1 {
        return false;
    }
    return true;
}

// Unit test 7: Full Program with high-level traits, structs, and functions
pub fn test_parser_program_high_level_items() -> bool {
    mut tokens: List<Token> = List::new();
    // 1. Trait item
    tokens.push(Token(kind: 15, value: 0, lexeme: "pub"));
    tokens.push(Token(kind: 9, value: 0, lexeme: "trait"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "Diagnosable"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 1, value: 0, lexeme: "fn"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "diagnose"));
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 10, value: 0, lexeme: "self"));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 36, value: 0, lexeme: "->"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "String"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));
    // 2. Struct item
    tokens.push(Token(kind: 15, value: 0, lexeme: "pub"));
    tokens.push(Token(kind: 8, value: 0, lexeme: "struct"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "Diagnostic"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "code"));
    tokens.push(Token(kind: 34, value: 0, lexeme: ":"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "i64"));
    tokens.push(Token(kind: 39, value: 0, lexeme: ","));
    tokens.push(Token(kind: 10, value: 0, lexeme: "msg"));
    tokens.push(Token(kind: 34, value: 0, lexeme: ":"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "String"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));
    // 3. Function item
    tokens.push(Token(kind: 1, value: 0, lexeme: "fn"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "compute"));
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 5, value: 0, lexeme: "inout"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "x"));
    tokens.push(Token(kind: 34, value: 0, lexeme: ":"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "i64"));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 36, value: 0, lexeme: "->"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "i64"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 4, value: 0, lexeme: "return"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "x"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));

    mut pool: List<AstExpr> = List::new();
    let prog = parse_program(tokens, inout pool);

    if prog.traits.len() != 1 {
        return false;
    }
    if prog.structs.len() != 1 {
        return false;
    }
    if prog.functions.len() != 1 {
        return false;
    }
    if prog.traits[0].name != "Diagnosable" {
        return false;
    }
    if prog.structs[0].name != "Diagnostic" {
        return false;
    }
    return prog.functions[0].name == "compute";
}

