    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let access = parse_primary(inout cur, tokens, inout pool);

    if access.kind != 5 {
        return false;
    }
    if access.name != "point" {
        return false;
    }
    return access.val == 0;
}

