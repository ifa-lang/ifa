// Unit test 9: Tuple expression parsing `(10, 42)`
pub fn test_parser_tuple_expression() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 11, value: 10, lexeme: "10"));
    tokens.push(Token(kind: 39, value: 0, lexeme: ","));
    tokens.push(Token(kind: 11, value: 42, lexeme: "42"));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let tup = parse_primary(inout cur, tokens, inout pool);

    if tup.kind != 4 {
        return false;
    }
    if tup.val != 2 {
        return false;
    }
    let left_val = tup.left?.val ?? 0;
    let right_val = tup.right?.val ?? 0;
    return left_val == 10 && right_val == 42;
}

