// Pure IFA Self-Hosting Compiler - Parser Module (`compiler/parser.ifa`)
// Recursive-descent AST parser utilizing generational references (`?ref AstExpr`) and arena pools.

pub struct Token {
    kind: i64,
    value: i64,
    lexeme: String
}

// AST Expression node leveraging generational references for recursive trees
pub struct AstExpr {
    kind: i64, // 1: Integer Literal, 2: Variable, 3: Binary Operation
    val: i64,
    name: String,
    op: i64,   // 1: Add (+), 2: Sub (-), 3: Mul (*), 4: Div (/)
    left: ?ref AstExpr,
    right: ?ref AstExpr
}

// AST Statement node
pub struct AstStmt {
    is_return: bool,
    target_var: String,
    expr: ?ref AstExpr
}

// AST Function node
pub struct AstFunction {
    name: String,
    param_name: String,
    statements: List<AstStmt>
}

// High-level AST Field node for Struct definitions
pub struct AstField {
    name: String,
    ty: String
}

// High-level AST Struct node
pub struct AstStruct {
    is_pub: bool,
    name: String,
    fields: List<AstField>
}

// High-level AST Trait Method signature
pub struct AstTraitMethod {
    name: String,
    param_name: String,
    param_ty: String,
    ret_ty: String
}

// High-level AST Trait node
pub struct AstTrait {
    is_pub: bool,
    name: String,
    methods: List<AstTraitMethod>
}

// High-level AST Impl node (trait implementation or inherent implementation)
pub struct AstImpl {
    has_trait: bool,
    trait_name: String,
    target_ty: String,
    methods: List<AstFunction>
}

// High-level AST Pattern node for Pattern Matching
pub struct AstPattern {
    kind: i64,         // 1: Wildcard `_`, 2: Literal, 3: Identifier / Binding, 4: Variant
    val: i64,          // Literal integer value
    name: String,      // Identifier / Variant name
    has_sub: bool,     // Whether variant has sub-pattern payload
    sub_pat_name: String // Sub-pattern variable name
}

// High-level AST Match Arm node (`pattern => expression`)
pub struct AstMatchArm {
    pat: AstPattern,
    expr: ?ref AstExpr
}

// High-level AST Match Expression node
pub struct AstMatch {
    target_var: String,
    arms: List<AstMatchArm>
}

// High-level AST Type Alias node (`type Name = TargetType;` or `pub type Name = TargetType;`)
pub struct AstTypeAlias {
    is_pub: bool,
    name: String,
    target_ty: String
}

// High-level AST Arena declaration node (`arena scratch;`)
pub struct AstArenaDecl {
    name: String,
    capacity: i64
}

// High-level AST Constant declaration node (`pub const Name: Ty = Val;`)
pub struct AstConst {
    is_pub: bool,
    name: String,
    ty: String,
    val: i64
}

// High-level AST Enum Variant node
pub struct AstEnumVariant {
    name: String,
    discriminant: i64
}

// High-level AST Enum declaration node (`pub enum Name { Variant1, Variant2 }`)
pub struct AstEnum {
    is_pub: bool,
    name: String,
    variants: List<AstEnumVariant>
}

// High-level AST Comptime Block node (`comptime { ... }`)
pub struct AstComptimeBlock {
    statements: List<AstStmt>
}

// High-level AST Syntax Macro Definition node (`macro name($param) { ... }`)
pub struct AstMacroDef {
    name: String,
    param_name: String,
    statements: List<AstStmt>
}

// Full Program AST containing all top-level module items
pub struct AstProgram {
    traits: List<AstTrait>,
    impls: List<AstImpl>,
    structs: List<AstStruct>,
    type_aliases: List<AstTypeAlias>,
    arenas: List<AstArenaDecl>,
    constants: List<AstConst>,
    enums: List<AstEnum>,
    comptime_blocks: List<AstComptimeBlock>,
    macros: List<AstMacroDef>,
    functions: List<AstFunction>
}

// Recursive-descent parser: primary expressions (literals, variables, parenthesized sub-trees, tuples, arena alloc)
pub fn parse_primary(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstExpr {
    if cursor >= tokens.len() {
        return AstExpr(kind: 0, val: 0, name: "", op: 0, left: None, right: None);
    }
    let tok = tokens[cursor];
    if tok.kind == 11 {
        // Integer Literal
        cursor = cursor + 1;
        return AstExpr(kind: 1, val: tok.value, name: "", op: 0, left: None, right: None);
    }
    if tok.kind == 10 {
        // Check for arena allocation primitive: `alloc(expr, arena)`
        if tok.lexeme == "alloc" {
            if cursor + 1 < tokens.len() && tokens[cursor + 1].kind == 30 {
                cursor = cursor + 2; // Consume 'alloc' and '('
                let inner_arg = parse_additive(inout cursor, tokens, inout pool);
                mut arena_name = "scratch";
                if cursor < tokens.len() && tokens[cursor].kind == 39 {
                    cursor = cursor + 1; // Consume ','
                    if cursor < tokens.len() && tokens[cursor].kind == 10 {
                        arena_name = tokens[cursor].lexeme;
                        cursor = cursor + 1;
                    }
                }
                if cursor < tokens.len() && tokens[cursor].kind == 31 {
                    cursor = cursor + 1; // Consume ')'
                }
                pool.push(inner_arg);
                let arg_idx = pool.len() - 1;
                return AstExpr(
                    kind: 6, // Arena Allocation
                    val: 0,
                    name: arena_name,
                    op: 0,
                    left: ref pool[arg_idx],
                    right: None
                );
            }
        }

        // Variable Identifier with possible macro invocation `name!(arg)` or tuple member access: `var.0`, `var.1`
        let var_name = tok.lexeme;
        cursor = cursor + 1;
        if cursor < tokens.len() && tokens[cursor].kind == 50 {
            // Macro invocation: ident!(arg)
            cursor = cursor + 1; // Consume '!'
            if cursor < tokens.len() && tokens[cursor].kind == 30 {
                cursor = cursor + 1; // Consume '('
            }
            let macro_arg = parse_additive(inout cursor, tokens, inout pool);
            if cursor < tokens.len() && tokens[cursor].kind == 31 {
                cursor = cursor + 1; // Consume ')'
            }
            pool.push(macro_arg);
            let arg_idx = pool.len() - 1;
            return AstExpr(
                kind: 7, // Macro Invocation
                val: 0,
                name: var_name,
                op: 0,
                left: ref pool[arg_idx],
                right: None
            );
        }
        if cursor < tokens.len() && tokens[cursor].kind == 42 {
            cursor = cursor + 1; // Consume '.'
            if cursor < tokens.len() && tokens[cursor].kind == 11 {
                let idx_val = tokens[cursor].value;
                cursor = cursor + 1; // Consume index
                return AstExpr(
                    kind: 5, // Tuple Index Access
                    val: idx_val,
                    name: var_name,
                    op: 0,
                    left: None,
                    right: None
                );
            }
        }
        return AstExpr(kind: 2, val: 0, name: var_name, op: 0, left: None, right: None);
    }
    if tok.kind == 52 {
        // Comptime expression: comptime <expr>
        cursor = cursor + 1; // Consume 'comptime'
        let inner_expr = parse_additive(inout cursor, tokens, inout pool);
        pool.push(inner_expr);
        let c_idx = pool.len() - 1;
        return AstExpr(
            kind: 8, // Comptime Expression
            val: 0,
            name: "comptime",
            op: 0,
            left: ref pool[c_idx],
            right: None
        );
    }
    if tok.kind == 53 {
        // Macro substituted identifier: $var
        cursor = cursor + 1; // Consume '$'
        mut subst_name = "";
        if cursor < tokens.len() && tokens[cursor].kind == 10 {
            subst_name = tokens[cursor].lexeme;
            cursor = cursor + 1;
        }
        return AstExpr(kind: 9, val: 0, name: "$" + subst_name, op: 0, left: None, right: None);
    }
    if tok.kind == 30 {
        // Left parenthesis '(' -> check for tuple `(e1, e2)` or sub-expression `(e)`
        cursor = cursor + 1;
        let first = parse_additive(inout cursor, tokens, inout pool);
        if cursor < tokens.len() {
            let next_tok = tokens[cursor];
            if next_tok.kind == 39 {
                // Comma ',' -> Tuple expression! (kind 4)
                cursor = cursor + 1; // Consume ','
                let second = parse_additive(inout cursor, tokens, inout pool);
                if cursor < tokens.len() && tokens[cursor].kind == 31 {
                    cursor = cursor + 1; // Consume ')'
                }
                pool.push(first);
                let first_idx = pool.len() - 1;
                pool.push(second);
                let second_idx = pool.len() - 1;
                return AstExpr(
                    kind: 4, // Tuple Expression
                    val: 2, // 2-element tuple
                    name: "tuple",
                    op: 0,
                    left: ref pool[first_idx],
                    right: ref pool[second_idx]
                );
            } else if next_tok.kind == 31 {
                cursor = cursor + 1; // Consume ')'
            }
        }
        return first;
    }
    return AstExpr(kind: 0, val: 0, name: "", op: 0, left: None, right: None);
}

// Recursive-descent parser: multiplicative expressions (* and /)
pub fn parse_multiplicative(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstExpr {
    mut current = parse_primary(inout cursor, tokens, inout pool);
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else {
            let tok = tokens[cursor];
            if tok.kind == 22 {
                // Op: * (Multiplication)
                cursor = cursor + 1;
                pool.push(current);
                let left_idx = pool.len() - 1;
                let right_expr = parse_primary(inout cursor, tokens, inout pool);
                pool.push(right_expr);
                let right_idx = pool.len() - 1;
                current = AstExpr(
                    kind: 3,
                    val: 0,
                    name: "",
                    op: 3,
                    left: ref pool[left_idx],
                    right: ref pool[right_idx]
                );
            } else if tok.kind == 23 {
                // Op: / (Division)
                cursor = cursor + 1;
                pool.push(current);
                let left_idx = pool.len() - 1;
                let right_expr = parse_primary(inout cursor, tokens, inout pool);
                pool.push(right_expr);
                let right_idx = pool.len() - 1;
                current = AstExpr(
                    kind: 3,
                    val: 0,
                    name: "",
                    op: 4,
                    left: ref pool[left_idx],
                    right: ref pool[right_idx]
                );
            } else {
                parsing = false;
            }
        }
    }
    return current;
}

// Recursive-descent parser: additive expressions (+ and -)
pub fn parse_additive(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstExpr {
    mut current = parse_multiplicative(inout cursor, tokens, inout pool);
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else {
            let tok = tokens[cursor];
            if tok.kind == 20 {
                // Op: + (Addition)
                cursor = cursor + 1;
                pool.push(current);
                let left_idx = pool.len() - 1;
                let right_expr = parse_multiplicative(inout cursor, tokens, inout pool);
                pool.push(right_expr);
                let right_idx = pool.len() - 1;
                current = AstExpr(
                    kind: 3,
                    val: 0,
                    name: "",
                    op: 1,
                    left: ref pool[left_idx],
                    right: ref pool[right_idx]
                );
            } else if tok.kind == 21 {
                // Op: - (Subtraction)
                cursor = cursor + 1;
                pool.push(current);
                let left_idx = pool.len() - 1;
                let right_expr = parse_multiplicative(inout cursor, tokens, inout pool);
                pool.push(right_expr);
                let right_idx = pool.len() - 1;
                current = AstExpr(
                    kind: 3,
                    val: 0,
                    name: "",
                    op: 2,
                    left: ref pool[left_idx],
                    right: ref pool[right_idx]
                );
            } else {
                parsing = false;
            }
        }
    }
    return current;
}

// Entrypoint for expression parsing
pub fn parse_expression(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstExpr {
    return parse_additive(inout cursor, tokens, inout pool);
}

// Recursive-descent parser: statement declarations (`let var = expr;` and `return expr;`)
pub fn parse_statement(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstStmt {
    let tok = tokens[cursor];
    if tok.kind == 2 {
        // let <var> = <expr>;
        cursor = cursor + 1;
        let var_tok = tokens[cursor];
        let var_name = var_tok.lexeme;
        cursor = cursor + 1;
        if cursor < tokens.len() && tokens[cursor].kind == 24 {
            cursor = cursor + 1; // Consume '='
        }
        let expr = parse_expression(inout cursor, tokens, inout pool);
        pool.push(expr);
        let expr_idx = pool.len() - 1;
        if cursor < tokens.len() && tokens[cursor].kind == 35 {
            cursor = cursor + 1; // Consume ';'
        }
        return AstStmt(is_return: false, target_var: var_name, expr: ref pool[expr_idx]);
    }
    if tok.kind == 4 {
        // return <expr>;
        cursor = cursor + 1;
        let expr = parse_expression(inout cursor, tokens, inout pool);
        pool.push(expr);
        let expr_idx = pool.len() - 1;
        if cursor < tokens.len() && tokens[cursor].kind == 35 {
            cursor = cursor + 1; // Consume ';'
        }
        return AstStmt(is_return: true, target_var: "", expr: ref pool[expr_idx]);
    }
    return AstStmt(is_return: false, target_var: "", expr: None);
}

// Recursive-descent parser: function declarations (`fn name(param: T) -> R { ... }`)
pub fn parse_function(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstFunction {
    cursor = cursor + 1; // Consume 'fn'
    let fn_tok = tokens[cursor];
    let fn_name = fn_tok.lexeme;
    cursor = cursor + 1; // Consume function name
    cursor = cursor + 1; // Consume '('
    if cursor < tokens.len() && tokens[cursor].kind == 5 {
        cursor = cursor + 1; // Consume optional 'inout'
    }
    let param_tok = tokens[cursor];
    let param_name = param_tok.lexeme;
    cursor = cursor + 1; // Consume parameter name
    cursor = cursor + 1; // Consume ':'
    cursor = cursor + 1; // Consume parameter type
    cursor = cursor + 1; // Consume ')'
    cursor = cursor + 1; // Consume '->'
    cursor = cursor + 1; // Consume return type
    cursor = cursor + 1; // Consume '{'

    mut stmts: List<AstStmt> = List::new();
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else if tokens[cursor].kind == 33 {
            cursor = cursor + 1; // Consume '}'
            parsing = false;
        } else {
            let stmt = parse_statement(inout cursor, tokens, inout pool);
            stmts.push(stmt);
        }
    }

    return AstFunction(name: fn_name, param_name: param_name, statements: stmts);
}

// High-level parser: pattern matching (`_`, literal, identifier, `Some(x)`)
pub fn parse_pattern(inout cursor: i64, tokens: List<Token>) -> AstPattern {
    if cursor >= tokens.len() {
        return AstPattern(kind: 1, val: 0, name: "_", has_sub: false, sub_pat_name: "");
    }
    let tok = tokens[cursor];
    if tok.kind == 38 {
        // Wildcard '_'
        cursor = cursor + 1;
        return AstPattern(kind: 1, val: 0, name: "_", has_sub: false, sub_pat_name: "");
    }
    if tok.kind == 11 {
        // Integer literal pattern
        cursor = cursor + 1;
        return AstPattern(kind: 2, val: tok.value, name: "", has_sub: false, sub_pat_name: "");
    }
    if tok.kind == 10 {
        let ident_name = tok.lexeme;
        cursor = cursor + 1;
        // Check if followed by '(' for variant pattern e.g. Some(x)
        if cursor < tokens.len() && tokens[cursor].kind == 30 {
            cursor = cursor + 1; // Consume '('
            mut sub_name = "";
            if cursor < tokens.len() && tokens[cursor].kind == 10 {
                sub_name = tokens[cursor].lexeme;
                cursor = cursor + 1;
            }
            if cursor < tokens.len() && tokens[cursor].kind == 31 {
                cursor = cursor + 1; // Consume ')'
            }
            return AstPattern(kind: 4, val: 0, name: ident_name, has_sub: true, sub_pat_name: sub_name);
        }
        return AstPattern(kind: 3, val: 0, name: ident_name, has_sub: false, sub_pat_name: "");
    }
    return AstPattern(kind: 1, val: 0, name: "_", has_sub: false, sub_pat_name: "");
}

// High-level parser: match expressions (`match target { pat => expr, ... }`)
pub fn parse_match(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstMatch {
    cursor = cursor + 1; // Consume 'match'
    let target_name = tokens[cursor].lexeme;
    cursor = cursor + 1; // Consume target variable

    if cursor < tokens.len() && tokens[cursor].kind == 32 {
        cursor = cursor + 1; // Consume '{'
    }

    mut arms: List<AstMatchArm> = List::new();
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else if tokens[cursor].kind == 33 {
            cursor = cursor + 1; // Consume '}'
            parsing = false;
        } else {
            let pat = parse_pattern(inout cursor, tokens);
            if cursor < tokens.len() && tokens[cursor].kind == 37 {
                cursor = cursor + 1; // Consume '=>'
            }
            let body_expr = parse_expression(inout cursor, tokens, inout pool);
            pool.push(body_expr);
            let body_idx = pool.len() - 1;

            if cursor < tokens.len() && (tokens[cursor].kind == 39 || tokens[cursor].kind == 35) {
                cursor = cursor + 1; // Consume ',' or ';'
            }

            arms.push(AstMatchArm(pat: pat, expr: ref pool[body_idx]));
        }
    }

    return AstMatch(target_var: target_name, arms: arms);
}

// High-level parser: trait definitions (`pub trait Name { fn meth(self) -> Ret; }`)
pub fn parse_trait(inout cursor: i64, tokens: List<Token>) -> AstTrait {
    mut is_pub = false;
    if cursor < tokens.len() && tokens[cursor].kind == 15 {
        is_pub = true;
        cursor = cursor + 1; // Consume 'pub'
    }
    if cursor < tokens.len() && tokens[cursor].kind == 9 {
        cursor = cursor + 1; // Consume 'trait'
    }
    let trait_name = tokens[cursor].lexeme;
    cursor = cursor + 1; // Consume trait name

    if cursor < tokens.len() && tokens[cursor].kind == 32 {
        cursor = cursor + 1; // Consume '{'
    }

    mut methods: List<AstTraitMethod> = List::new();
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else if tokens[cursor].kind == 33 {
            cursor = cursor + 1; // Consume '}'
            parsing = false;
        } else if tokens[cursor].kind == 1 {
            cursor = cursor + 1; // Consume 'fn'
            let meth_name = tokens[cursor].lexeme;
            cursor = cursor + 1; // Consume method name
            cursor = cursor + 1; // Consume '('
            let p_name = tokens[cursor].lexeme;
            cursor = cursor + 1; // Consume param name
            mut p_ty = "";
            if cursor < tokens.len() && tokens[cursor].kind == 34 {
                cursor = cursor + 1; // Consume ':'
                p_ty = tokens[cursor].lexeme;
                cursor = cursor + 1; // Consume param type
            }
            cursor = cursor + 1; // Consume ')'
            mut r_ty = "";
            if cursor < tokens.len() && tokens[cursor].kind == 36 {
                cursor = cursor + 1; // Consume '->'
                r_ty = tokens[cursor].lexeme;
                cursor = cursor + 1; // Consume return type
            }
            if cursor < tokens.len() && tokens[cursor].kind == 35 {
                cursor = cursor + 1; // Consume ';'
            }
            methods.push(AstTraitMethod(
                name: meth_name,
                param_name: p_name,
                param_ty: p_ty,
                ret_ty: r_ty
            ));
        } else {
            cursor = cursor + 1;
        }
    }

    return AstTrait(is_pub: is_pub, name: trait_name, methods: methods);
}

// High-level parser: impl definitions (`impl Trait for Target { ... }` or `impl Target { ... }`)
pub fn parse_impl(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstImpl {
    cursor = cursor + 1; // Consume 'impl'
    let first_tok = tokens[cursor];
    cursor = cursor + 1;

    mut has_trait = false;
    mut trait_name = "";
    mut target_ty = "";

    if cursor < tokens.len() && tokens[cursor].kind == 13 {
        // 'for' keyword found: `impl Trait for Target`
        has_trait = true;
        trait_name = first_tok.lexeme;
        cursor = cursor + 1; // Consume 'for'
        target_ty = tokens[cursor].lexeme;
        cursor = cursor + 1; // Consume target type
    } else {
        // Inherent impl: `impl Target`
        has_trait = false;
        trait_name = "";
        target_ty = first_tok.lexeme;
    }

    if cursor < tokens.len() && tokens[cursor].kind == 32 {
        cursor = cursor + 1; // Consume '{'
    }

    mut methods: List<AstFunction> = List::new();
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else if tokens[cursor].kind == 33 {
            cursor = cursor + 1; // Consume '}'
            parsing = false;
        } else if tokens[cursor].kind == 1 || (tokens[cursor].kind == 15 && cursor + 1 < tokens.len() && tokens[cursor + 1].kind == 1) {
            if tokens[cursor].kind == 15 {
                cursor = cursor + 1; // Consume optional 'pub'
            }
            let func = parse_function(inout cursor, tokens, inout pool);
            methods.push(func);
        } else {
            cursor = cursor + 1;
        }
    }

    return AstImpl(
        has_trait: has_trait,
        trait_name: trait_name,
        target_ty: target_ty,
        methods: methods
    );
}

// High-level parser: struct definitions (`pub struct Name { field: Ty, ... }`)
pub fn parse_struct(inout cursor: i64, tokens: List<Token>) -> AstStruct {
    mut is_pub = false;
    if cursor < tokens.len() && tokens[cursor].kind == 15 {
        is_pub = true;
        cursor = cursor + 1; // Consume 'pub'
    }
    if cursor < tokens.len() && tokens[cursor].kind == 8 {
        cursor = cursor + 1; // Consume 'struct'
    }
    let st_name = tokens[cursor].lexeme;
    cursor = cursor + 1; // Consume struct name

    if cursor < tokens.len() && tokens[cursor].kind == 32 {
        cursor = cursor + 1; // Consume '{'
    }

    mut fields: List<AstField> = List::new();
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else if tokens[cursor].kind == 33 {
            cursor = cursor + 1; // Consume '}'
            parsing = false;
        } else if tokens[cursor].kind == 10 {
            let f_name = tokens[cursor].lexeme;
            cursor = cursor + 1;
            cursor = cursor + 1; // Consume ':'
            let f_ty = tokens[cursor].lexeme;
            cursor = cursor + 1; // Consume type
            if cursor < tokens.len() && (tokens[cursor].kind == 39 || tokens[cursor].kind == 35) {
                cursor = cursor + 1; // Consume ',' or ';'
            }
            fields.push(AstField(name: f_name, ty: f_ty));
        } else {
            cursor = cursor + 1;
        }
    }

    return AstStruct(is_pub: is_pub, name: st_name, fields: fields);
}

// High-level parser: type alias definitions (`pub type Name = Target;` or `type Name = Target;`)
pub fn parse_type_alias(inout cursor: i64, tokens: List<Token>) -> AstTypeAlias {
    mut is_pub = false;
    if cursor < tokens.len() && tokens[cursor].kind == 15 {
        is_pub = true;
        cursor = cursor + 1; // Consume 'pub'
    }
    if cursor < tokens.len() && tokens[cursor].kind == 17 {
        cursor = cursor + 1; // Consume 'type'
    }
    mut name = "";
    if cursor < tokens.len() && tokens[cursor].kind == 10 {
        name = tokens[cursor].lexeme;
        cursor = cursor + 1; // Consume alias name
    }
    if cursor < tokens.len() && tokens[cursor].kind == 24 {
        cursor = cursor + 1; // Consume '='
    }
    mut target_ty = "";
    if cursor < tokens.len() {
        if tokens[cursor].kind == 30 {
            // Tuple type `(i64, i64)`
            target_ty = "(";
            cursor = cursor + 1;
            while cursor < tokens.len() && tokens[cursor].kind != 31 {
                target_ty = target_ty + tokens[cursor].lexeme;
                cursor = cursor + 1;
            }
            if cursor < tokens.len() && tokens[cursor].kind == 31 {
                target_ty = target_ty + ")";
                cursor = cursor + 1;
            }
        } else if tokens[cursor].kind == 10 {
            target_ty = tokens[cursor].lexeme;
            cursor = cursor + 1;
        }
    }
    if cursor < tokens.len() && tokens[cursor].kind == 35 {
        cursor = cursor + 1; // Consume ';'
    }
    return AstTypeAlias(is_pub: is_pub, name: name, target_ty: target_ty);
}

// High-level parser: explicit arena declarations (`arena scratch;` or `arena scratch = 65536;`)
pub fn parse_arena_decl(inout cursor: i64, tokens: List<Token>) -> AstArenaDecl {
    if cursor < tokens.len() && tokens[cursor].kind == 18 {
        cursor = cursor + 1; // Consume 'arena'
    }
    mut name = "scratch";
    if cursor < tokens.len() && tokens[cursor].kind == 10 {
        name = tokens[cursor].lexeme;
        cursor = cursor + 1; // Consume arena identifier
    }
    mut capacity: i64 = 65536;
    if cursor < tokens.len() && tokens[cursor].kind == 24 {
        cursor = cursor + 1; // Consume '='
        if cursor < tokens.len() && tokens[cursor].kind == 11 {
            capacity = tokens[cursor].value;
            cursor = cursor + 1;
        }
    }
    if cursor < tokens.len() && tokens[cursor].kind == 35 {
        cursor = cursor + 1; // Consume ';'
    }
    return AstArenaDecl(name: name, capacity: capacity);
}

// High-level parser: constant declarations (`pub const Name: Ty = Val;` or `const Name: Ty = Val;`)
pub fn parse_const(inout cursor: i64, tokens: List<Token>) -> AstConst {
    mut is_pub = false;
    if cursor < tokens.len() && tokens[cursor].kind == 15 {
        is_pub = true;
        cursor = cursor + 1; // Consume 'pub'
    }
    if cursor < tokens.len() && tokens[cursor].kind == 19 {
        cursor = cursor + 1; // Consume 'const'
    }
    mut name = "";
    if cursor < tokens.len() && tokens[cursor].kind == 10 {
        name = tokens[cursor].lexeme;
        cursor = cursor + 1; // Consume identifier
    }
    mut ty = "i64";
    if cursor < tokens.len() && tokens[cursor].kind == 34 {
        cursor = cursor + 1; // Consume ':'
        if cursor < tokens.len() && tokens[cursor].kind == 10 {
            ty = tokens[cursor].lexeme;
            cursor = cursor + 1; // Consume type
        }
    }
    if cursor < tokens.len() && tokens[cursor].kind == 24 {
        cursor = cursor + 1; // Consume '='
    }
    mut val: i64 = 0;
    if cursor < tokens.len() && tokens[cursor].kind == 11 {
        val = tokens[cursor].value;
        cursor = cursor + 1; // Consume value
    }
    if cursor < tokens.len() && tokens[cursor].kind == 35 {
        cursor = cursor + 1; // Consume ';'
    }
    return AstConst(is_pub: is_pub, name: name, ty: ty, val: val);
}

// High-level parser: enum declarations (`pub enum Name { Variant1, Variant2 }`)
pub fn parse_enum(inout cursor: i64, tokens: List<Token>) -> AstEnum {
    mut is_pub = false;
    if cursor < tokens.len() && tokens[cursor].kind == 15 {
        is_pub = true;
        cursor = cursor + 1; // Consume 'pub'
    }
    if cursor < tokens.len() && tokens[cursor].kind == 26 {
        cursor = cursor + 1; // Consume 'enum'
    }
    mut name = "";
    if cursor < tokens.len() && tokens[cursor].kind == 10 {
        name = tokens[cursor].lexeme;
        cursor = cursor + 1; // Consume enum name
    }
    if cursor < tokens.len() && tokens[cursor].kind == 32 {
        cursor = cursor + 1; // Consume '{'
    }
    mut variants: List<AstEnumVariant> = List::new();
    mut current_disc: i64 = 0;
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else if tokens[cursor].kind == 33 {
            cursor = cursor + 1; // Consume '}'
            parsing = false;
        } else if tokens[cursor].kind == 10 {
            let var_name = tokens[cursor].lexeme;
            cursor = cursor + 1;
            mut disc = current_disc;
            if cursor < tokens.len() && tokens[cursor].kind == 24 {
                cursor = cursor + 1; // Consume '='
                if cursor < tokens.len() && tokens[cursor].kind == 11 {
                    disc = tokens[cursor].value;
                    cursor = cursor + 1;
                }
            }
            current_disc = disc + 1;
            if cursor < tokens.len() && (tokens[cursor].kind == 39 || tokens[cursor].kind == 35) {
                cursor = cursor + 1; // Consume ',' or ';'
            }
            variants.push(AstEnumVariant(name: var_name, discriminant: disc));
        } else {
            cursor = cursor + 1;
        }
    }
    return AstEnum(is_pub: is_pub, name: name, variants: variants);
}

// High-level parser: comptime block (`comptime { let limit = 100; }`)
pub fn parse_comptime_block(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstComptimeBlock {
    cursor = cursor + 1; // Consume 'comptime'
    if cursor < tokens.len() && tokens[cursor].kind == 32 {
        cursor = cursor + 1; // Consume '{'
    }

    mut stmts: List<AstStmt> = List::new();
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else if tokens[cursor].kind == 33 {
            cursor = cursor + 1; // Consume '}'
            parsing = false;
        } else {
            let stmt = parse_statement(inout cursor, tokens, inout pool);
            stmts.push(stmt);
        }
    }

    return AstComptimeBlock(statements: stmts);
}

// High-level parser: syntax macro definition (`macro name($param) { return $param; }`)
pub fn parse_macro_def(inout cursor: i64, tokens: List<Token>, inout pool: List<AstExpr>) -> AstMacroDef {
    cursor = cursor + 1; // Consume 'macro'
    mut m_name = "";
    if cursor < tokens.len() && tokens[cursor].kind == 10 {
        m_name = tokens[cursor].lexeme;
        cursor = cursor + 1; // Consume macro name
    }
    if cursor < tokens.len() && tokens[cursor].kind == 30 {
        cursor = cursor + 1; // Consume '('
    }
    mut p_name = "";
    if cursor < tokens.len() && tokens[cursor].kind == 53 {
        cursor = cursor + 1; // Consume '$'
    }
    if cursor < tokens.len() && tokens[cursor].kind == 10 {
        p_name = tokens[cursor].lexeme;
        cursor = cursor + 1; // Consume parameter name
    }
    if cursor < tokens.len() && tokens[cursor].kind == 31 {
        cursor = cursor + 1; // Consume ')'
    }
    if cursor < tokens.len() && tokens[cursor].kind == 32 {
        cursor = cursor + 1; // Consume '{'
    }

    mut stmts: List<AstStmt> = List::new();
    mut parsing = true;
    while parsing {
        if cursor >= tokens.len() {
            parsing = false;
        } else if tokens[cursor].kind == 33 {
            cursor = cursor + 1; // Consume '}'
            parsing = false;
        } else {
            let stmt = parse_statement(inout cursor, tokens, inout pool);
            stmts.push(stmt);
        }
    }

    return AstMacroDef(name: m_name, param_name: p_name, statements: stmts);
}

// High-level parser: full module program item collection
pub fn parse_program(tokens: List<Token>, inout pool: List<AstExpr>) -> AstProgram {
    mut traits: List<AstTrait> = List::new();
    mut impls: List<AstImpl> = List::new();
    mut structs: List<AstStruct> = List::new();
    mut type_aliases: List<AstTypeAlias> = List::new();
    mut arenas: List<AstArenaDecl> = List::new();
    mut constants: List<AstConst> = List::new();
    mut enums: List<AstEnum> = List::new();
    mut comptime_blocks: List<AstComptimeBlock> = List::new();
    mut macros: List<AstMacroDef> = List::new();
    mut functions: List<AstFunction> = List::new();

    mut cursor: i64 = 0;
    while cursor < tokens.len() {
        let tok = tokens[cursor];
        if tok.kind == 15 {
            // 'pub' prefix
            if cursor + 1 < tokens.len() {
                let next = tokens[cursor + 1];
                if next.kind == 17 {
                    let alias = parse_type_alias(inout cursor, tokens);
                    type_aliases.push(alias);
                } else if next.kind == 19 {
                    let cn = parse_const(inout cursor, tokens);
                    constants.push(cn);
                } else if next.kind == 26 {
                    let en = parse_enum(inout cursor, tokens);
                    enums.push(en);
                } else if next.kind == 9 {
                    let tr = parse_trait(inout cursor, tokens);
                    traits.push(tr);
                } else if next.kind == 8 {
                    let st = parse_struct(inout cursor, tokens);
                    structs.push(st);
                } else if next.kind == 1 {
                    cursor = cursor + 1; // Consume 'pub'
                    let f = parse_function(inout cursor, tokens, inout pool);
                    functions.push(f);
                } else {
                    cursor = cursor + 1;
                }
            } else {
                cursor = cursor + 1;
            }
        } else if tok.kind == 17 {
            let alias = parse_type_alias(inout cursor, tokens);
            type_aliases.push(alias);
        } else if tok.kind == 18 {
            let ar = parse_arena_decl(inout cursor, tokens);
            arenas.push(ar);
        } else if tok.kind == 19 {
            let cn = parse_const(inout cursor, tokens);
            constants.push(cn);
        } else if tok.kind == 26 {
            let en = parse_enum(inout cursor, tokens);
            enums.push(en);
        } else if tok.kind == 9 {
            let tr = parse_trait(inout cursor, tokens);
            traits.push(tr);
        } else if tok.kind == 12 {
            let im = parse_impl(inout cursor, tokens, inout pool);
            impls.push(im);
        } else if tok.kind == 8 {
            let st = parse_struct(inout cursor, tokens);
            structs.push(st);
        } else if tok.kind == 51 {
            let md = parse_macro_def(inout cursor, tokens, inout pool);
            macros.push(md);
        } else if tok.kind == 52 {
            let cb = parse_comptime_block(inout cursor, tokens, inout pool);
            comptime_blocks.push(cb);
        } else if tok.kind == 1 {
            let f = parse_function(inout cursor, tokens, inout pool);
            functions.push(f);
        } else {
            cursor = cursor + 1;
        }
    }

    return AstProgram(
        traits: traits,
        impls: impls,
        structs: structs,
        type_aliases: type_aliases,
        arenas: arenas,
        constants: constants,
        enums: enums,
        comptime_blocks: comptime_blocks,
        macros: macros,
        functions: functions
    );
}

// Unit test 1: Generational reference AST construction
pub fn test_parser_ast_building() -> bool {
    mut node_left = AstExpr(kind: 2, val: 0, name: "x", op: 0, left: None, right: None);
    mut node_right = AstExpr(kind: 1, val: 40, name: "", op: 0, left: None, right: None);

    let bin_expr = AstExpr(
        kind: 3,
        val: 0,
        name: "",
        op: 1,
        left: ref node_left,
        right: ref node_right
    );

    if bin_expr.kind != 3 {
        return false;
    }
    if bin_expr.op != 1 {
        return false;
    }
    return true;
}

// Unit test 2: Operator precedence parsing (2 + 3 * 4)
pub fn test_parser_precedence() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 11, value: 2, lexeme: "2"));
    tokens.push(Token(kind: 20, value: 0, lexeme: "+"));
    tokens.push(Token(kind: 11, value: 3, lexeme: "3"));
    tokens.push(Token(kind: 22, value: 0, lexeme: "*"));
    tokens.push(Token(kind: 11, value: 4, lexeme: "4"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let root = parse_expression(inout cur, tokens, inout pool);

    return root.op == 1; // Root must be '+' addition, with '*' sub-expression on right
}

// Unit test 3: Parenthesized sub-expression grouping ((2 + 3) * 4)
pub fn test_parser_paren_precedence() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 11, value: 2, lexeme: "2"));
    tokens.push(Token(kind: 20, value: 0, lexeme: "+"));
    tokens.push(Token(kind: 11, value: 3, lexeme: "3"));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 22, value: 0, lexeme: "*"));
    tokens.push(Token(kind: 11, value: 4, lexeme: "4"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let root = parse_expression(inout cur, tokens, inout pool);

    return root.op == 3; // Root must be '*' multiplication
}

// Unit test 4: High-level Trait item parsing
pub fn test_parser_trait_declaration() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 15, value: 0, lexeme: "pub"));
    tokens.push(Token(kind: 9, value: 0, lexeme: "trait"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "Diagnosable"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 1, value: 0, lexeme: "fn"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "diagnose"));
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 10, value: 0, lexeme: "self"));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 36, value: 0, lexeme: "->"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "String"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));

    mut cur: i64 = 0;
    let tr = parse_trait(inout cur, tokens);
    if !tr.is_pub {
        return false;
    }
    if tr.name != "Diagnosable" {
        return false;
    }
    if tr.methods.len() != 1 {
        return false;
    }
    let m = tr.methods[0];
    if m.name != "diagnose" {
        return false;
    }
    if m.param_name != "self" {
        return false;
    }
    return m.ret_ty == "String";
}

// Unit test 5: High-level Impl item parsing
pub fn test_parser_impl_declaration() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 12, value: 0, lexeme: "impl"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "Diagnosable"));
    tokens.push(Token(kind: 13, value: 0, lexeme: "for"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "Diagnostic"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 1, value: 0, lexeme: "fn"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "diagnose"));
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 10, value: 0, lexeme: "self"));
    tokens.push(Token(kind: 34, value: 0, lexeme: ":"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "Diagnostic"));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 36, value: 0, lexeme: "->"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "String"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 4, value: 0, lexeme: "return"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "msg"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let im = parse_impl(inout cur, tokens, inout pool);

    if !im.has_trait {
        return false;
    }
    if im.trait_name != "Diagnosable" {
        return false;
    }
    if im.target_ty != "Diagnostic" {
        return false;
    }
    if im.methods.len() != 1 {
        return false;
    }
    return im.methods[0].name == "diagnose";
}

// Unit test 6: High-level Match Expression and Pattern Parsing
pub fn test_parser_match_expression() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 14, value: 0, lexeme: "match"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "val"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 11, value: 1, lexeme: "1"));
    tokens.push(Token(kind: 37, value: 0, lexeme: "=>"));
    tokens.push(Token(kind: 11, value: 10, lexeme: "10"));
    tokens.push(Token(kind: 39, value: 0, lexeme: ","));
    tokens.push(Token(kind: 11, value: 2, lexeme: "2"));
    tokens.push(Token(kind: 37, value: 0, lexeme: "=>"));
    tokens.push(Token(kind: 11, value: 20, lexeme: "20"));
    tokens.push(Token(kind: 39, value: 0, lexeme: ","));
    tokens.push(Token(kind: 38, value: 0, lexeme: "_"));
    tokens.push(Token(kind: 37, value: 0, lexeme: "=>"));
    tokens.push(Token(kind: 11, value: 42, lexeme: "42"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let mat = parse_match(inout cur, tokens, inout pool);

    if mat.target_var != "val" {
        return false;
    }
    if mat.arms.len() != 3 {
        return false;
    }
    let arm0 = mat.arms[0];
    if arm0.pat.kind != 2 || arm0.pat.val != 1 {
        return false;
    }
    let arm1 = mat.arms[1];
    if arm1.pat.kind != 2 || arm1.pat.val != 2 {
        return false;
    }
    let arm2 = mat.arms[2];
    if arm2.pat.kind != 1 {
        return false;
    }
    return true;
}

// Unit test 7: Full Program with high-level traits, structs, and functions
pub fn test_parser_program_high_level_items() -> bool {
    mut tokens: List<Token> = List::new();
    // 1. Trait item
    tokens.push(Token(kind: 15, value: 0, lexeme: "pub"));
    tokens.push(Token(kind: 9, value: 0, lexeme: "trait"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "Diagnosable"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 1, value: 0, lexeme: "fn"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "diagnose"));
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 10, value: 0, lexeme: "self"));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 36, value: 0, lexeme: "->"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "String"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));
    // 2. Struct item
    tokens.push(Token(kind: 15, value: 0, lexeme: "pub"));
    tokens.push(Token(kind: 8, value: 0, lexeme: "struct"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "Diagnostic"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "code"));
    tokens.push(Token(kind: 34, value: 0, lexeme: ":"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "i64"));
    tokens.push(Token(kind: 39, value: 0, lexeme: ","));
    tokens.push(Token(kind: 10, value: 0, lexeme: "msg"));
    tokens.push(Token(kind: 34, value: 0, lexeme: ":"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "String"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));
    // 3. Function item
    tokens.push(Token(kind: 1, value: 0, lexeme: "fn"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "compute"));
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 5, value: 0, lexeme: "inout"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "x"));
    tokens.push(Token(kind: 34, value: 0, lexeme: ":"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "i64"));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 36, value: 0, lexeme: "->"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "i64"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 4, value: 0, lexeme: "return"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "x"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));

    mut pool: List<AstExpr> = List::new();
    let prog = parse_program(tokens, inout pool);

    if prog.traits.len() != 1 {
        return false;
    }
    if prog.structs.len() != 1 {
        return false;
    }
    if prog.functions.len() != 1 {
        return false;
    }
    if prog.traits[0].name != "Diagnosable" {
        return false;
    }
    if prog.structs[0].name != "Diagnostic" {
        return false;
    }
    return prog.functions[0].name == "compute";
}

