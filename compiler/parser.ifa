// Unit test 20: Statement parsing with mut declarations and reassignments
pub fn test_parser_mut_statements() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 1, value: 0, lexeme: "fn"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "calc"));
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 10, value: 0, lexeme: "x"));
    tokens.push(Token(kind: 34, value: 0, lexeme: ":"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "i64"));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 36, value: 0, lexeme: "->"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "i64"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    // mut total: i64 = 0;
    tokens.push(Token(kind: 3, value: 0, lexeme: "mut"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "total"));
    tokens.push(Token(kind: 34, value: 0, lexeme: ":"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "i64"));
    tokens.push(Token(kind: 24, value: 0, lexeme: "="));
    tokens.push(Token(kind: 11, value: 0, lexeme: "0"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    // total = total + x;
    tokens.push(Token(kind: 10, value: 0, lexeme: "total"));
    tokens.push(Token(kind: 24, value: 0, lexeme: "="));
    tokens.push(Token(kind: 10, value: 0, lexeme: "total"));
    tokens.push(Token(kind: 20, value: 0, lexeme: "+"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "x"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    // return total;
    tokens.push(Token(kind: 4, value: 0, lexeme: "return"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "total"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let f = parse_function(inout cur, tokens, inout pool);
    if f.name != "calc" || f.statements.len() != 3 {
        return false;
    }
    if f.statements[0].target_var != "total" || f.statements[0].is_return {
        return false;
    }
    if f.statements[1].target_var != "total" || f.statements[1].is_return {
        return false;
    }
    return f.statements[2].is_return;
}

// Unit test 21: Direct function call parsing
pub fn test_parser_direct_call() -> bool {
    mut tokens: List<Token> = List::new();
    // let a = get_val();
    tokens.push(Token(kind: 2, value: 0, lexeme: "let"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "a"));
    tokens.push(Token(kind: 24, value: 0, lexeme: "="));
    tokens.push(Token(kind: 10, value: 0, lexeme: "get_val"));
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));

    // let b = double(a);
    tokens.push(Token(kind: 2, value: 0, lexeme: "let"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "b"));
    tokens.push(Token(kind: 24, value: 0, lexeme: "="));
    tokens.push(Token(kind: 10, value: 0, lexeme: "double"));
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 10, value: 0, lexeme: "a"));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));

    // let c = add(a, 10);
    tokens.push(Token(kind: 2, value: 0, lexeme: "let"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "c"));
    tokens.push(Token(kind: 24, value: 0, lexeme: "="));
    tokens.push(Token(kind: 10, value: 0, lexeme: "add"));
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 10, value: 0, lexeme: "a"));
    tokens.push(Token(kind: 39, value: 0, lexeme: ","));
    tokens.push(Token(kind: 11, value: 10, lexeme: "10"));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let s1 = parse_statement(inout cur, tokens, inout pool);
    let s2 = parse_statement(inout cur, tokens, inout pool);
    let s3 = parse_statement(inout cur, tokens, inout pool);

    let s1_name = s1.expr?.name ?? "";
    if s1.target_var != "a" || s1.expr?.kind != 4 || s1.expr?.val != 0 || s1_name != "get_val" {
        return false;
    }
    let s2_name = s2.expr?.name ?? "";
    if s2.target_var != "b" || s2.expr?.kind != 4 || s2.expr?.val != 1 || s2_name != "double" {
        return false;
    }
    let s3_name = s3.expr?.name ?? "";
    if s3.target_var != "c" || s3.expr?.kind != 4 || s3.expr?.val != 2 || s3_name != "add" {
        return false;
    }
    return true;
}

// Unit test 22: Call parsing with arbitrary argument count (3+ arguments)
pub fn test_parser_arbitrary_call_args() -> bool {
    mut tokens: List<Token> = List::new();
    // let res = sum4(1, 2, 3, 4);
    tokens.push(Token(kind: 2, value: 0, lexeme: "let"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "res"));
    tokens.push(Token(kind: 24, value: 0, lexeme: "="));
    tokens.push(Token(kind: 10, value: 0, lexeme: "sum4"));
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 11, value: 1, lexeme: "1"));
    tokens.push(Token(kind: 39, value: 0, lexeme: ","));
    tokens.push(Token(kind: 11, value: 2, lexeme: "2"));
    tokens.push(Token(kind: 39, value: 0, lexeme: ","));
    tokens.push(Token(kind: 11, value: 3, lexeme: "3"));
    tokens.push(Token(kind: 39, value: 0, lexeme: ","));
    tokens.push(Token(kind: 11, value: 4, lexeme: "4"));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let stmt = parse_statement(inout cur, tokens, inout pool);
    if stmt.target_var != "res" || stmt.expr?.kind != 4 || stmt.expr?.val != 4 {
        return false;
    }
    mut args: List<?ref AstExpr> = List::new();
    collect_call_arguments(stmt.expr, inout args);
    if args.len() != 4 {
        return false;
    }
    let a0 = args[0]?.val ?? 0;
    let a1 = args[1]?.val ?? 0;
    let a2 = args[2]?.val ?? 0;
    let a3 = args[3]?.val ?? 0;
    return a0 == 1 && a1 == 2 && a2 == 3 && a3 == 4;
}

// Unit test 23: Variadic function parsing (`fn printf(fmt: i64, ...) -> i64`)
pub fn test_parser_variadic_function() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 1, value: 0, lexeme: "fn"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "printf"));
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 10, value: 0, lexeme: "fmt"));
    tokens.push(Token(kind: 34, value: 0, lexeme: ":"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "i64"));
    tokens.push(Token(kind: 39, value: 0, lexeme: ","));
    tokens.push(Token(kind: 37, value: 0, lexeme: "..."));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 36, value: 0, lexeme: "->"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "i64"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 4, value: 0, lexeme: "return"));
    tokens.push(Token(kind: 11, value: 0, lexeme: "0"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let f = parse_function(inout cur, tokens, inout pool);
    if f.name != "printf" || !f.is_variadic || f.params.len() != 1 {
        return false;
    }
    return f.params[0] == "fmt";
}

// Unit test 24: Panic mode error recovery inside function body
pub fn test_parser_panic_mode_recovery() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 1, value: 0, lexeme: "fn"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "calc"));
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    // Valid statement: let a = 10;
    tokens.push(Token(kind: 2, value: 0, lexeme: "let"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "a"));
    tokens.push(Token(kind: 24, value: 0, lexeme: "="));
    tokens.push(Token(kind: 11, value: 10, lexeme: "10"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    // Erroneous token sequence: !!! garbage ;
    tokens.push(Token(kind: 50, value: 0, lexeme: "!"));
    tokens.push(Token(kind: 50, value: 0, lexeme: "!"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    // Valid statement after recovery: return a;
    tokens.push(Token(kind: 4, value: 0, lexeme: "return"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "a"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    mut diagnostics: List<ParseDiagnostic> = List::new();
    let f = parse_function_with_recovery(inout cur, tokens, inout pool, inout diagnostics);
    // Should have recorded 1 diagnostic for the unexpected token
    if diagnostics.len() != 1 {
        return false;
    }
    // And should have recovered to successfully parse 3 statement nodes (including the placeholder for the error)
    if f.statements.len() != 3 {
        return false;
    }
    // The last statement must be the return statement
    if !f.statements[2].is_return {
        return false;
    }
    return true;
}

// Unit test 25: Program module diagnostics recording
pub fn test_parser_syntax_diagnostics() -> bool {
    mut tokens: List<Token> = List::new();
    // Unexpected stray token at module level
    tokens.push(Token(kind: 50, value: 0, lexeme: "!"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    // Valid function following the error
    tokens.push(Token(kind: 1, value: 0, lexeme: "fn"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "valid_fn"));
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 4, value: 0, lexeme: "return"));
    tokens.push(Token(kind: 11, value: 1, lexeme: "1"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));
    tokens.push(Token(kind: 0, value: 0, lexeme: ""));

    mut pool: List<AstExpr> = List::new();
    mut diagnostics: List<ParseDiagnostic> = List::new();
    let prog = parse_program_with_diagnostics(tokens, inout pool, inout diagnostics);
    if diagnostics.len() != 1 {
        return false;
    }
    if prog.functions.len() != 1 {
        return false;
    }
    return prog.functions[0].name == "valid_fn";
}

// Unit test 26: Direct construction of AST expression nodes on memory arena
pub fn test_parser_arena_direct_ast_construction() -> bool {
    mut arena = make_ast_arena("ast_scratch", 1024);
    mut pool: List<AstExpr> = List::new();
    if arena.allocated_count != 0 || arena.generation != 1 {
        return false;
    }

    // Allocate binary operator node directly on arena pool
    let left_lit = alloc_expr_on_arena(inout arena, inout pool, 1, 10, "", 0, None, None);
    let right_lit = alloc_expr_on_arena(inout arena, inout pool, 1, 32, "", 0, None, None);
    let bin_op = alloc_expr_on_arena(inout arena, inout pool, 3, 0, "+", 1, ref left_lit, ref right_lit);

    if arena.allocated_count != 3 {
        return false;
    }

    if bin_op.kind != 3 || bin_op.op != 1 {
        return false;
    }
    if bin_op.left?.val != 10 || bin_op.right?.val != 32 {
        return false;
    }

    // Reset arena
    reset_ast_arena(inout arena, inout pool);
    if arena.allocated_count != 0 || arena.generation != 2 || pool.len() != 0 {
        return false;
    }
    return true;
}

// Unit test 27: Parsing and validation of Copy-on-Write mutability annotations (inout / sink)
pub fn test_parser_cow_mutability_annotations() -> bool {
    // 1. Function parameter mutability modes
    mut param_tokens: List<Token> = List::new();
    param_tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    param_tokens.push(Token(kind: 5, value: 0, lexeme: "inout"));
    param_tokens.push(Token(kind: 10, value: 0, lexeme: "ast"));
    param_tokens.push(Token(kind: 34, value: 0, lexeme: ":"));
    param_tokens.push(Token(kind: 10, value: 0, lexeme: "AstNode"));
    param_tokens.push(Token(kind: 39, value: 0, lexeme: ","));
    param_tokens.push(Token(kind: 7, value: 0, lexeme: "sink"));
    param_tokens.push(Token(kind: 10, value: 0, lexeme: "data"));
    param_tokens.push(Token(kind: 34, value: 0, lexeme: ":"));
    param_tokens.push(Token(kind: 10, value: 0, lexeme: "Buffer"));
    param_tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    param_tokens.push(Token(kind: 0, value: 0, lexeme: ""));

    mut p_cur: i64 = 0;
    let params = parse_function_params(inout p_cur, param_tokens);
    if params.len() != 2 {
        return false;
    }
    if params[0].name != "ast" || params[0].mode != 1 || params[0].ty != "AstNode" {
        return false;
    }
    if params[1].name != "data" || params[1].mode != 2 || params[1].ty != "Buffer" {
        return false;
    }

    // 2. CoW annotated call expression with arena allocation
    mut arena = make_ast_arena("cow_arena", 512);
    mut pool: List<AstExpr> = List::new();
    let target_node = alloc_expr_on_arena(inout arena, inout pool, 2, 0, "root_ast", 0, None, None);
    let cow_inout = make_cow_annotated_expr(inout arena, inout pool, 1, ref target_node);
    let cow_sink = make_cow_annotated_expr(inout arena, inout pool, 2, ref target_node);

    if cow_inout.kind != 15 || cow_inout.val != 1 || cow_inout.name != "inout" {
        return false;
    }
    if cow_inout.left?.name != "root_ast" {
        return false;
    }
    if cow_sink.kind != 15 || cow_sink.val != 2 || cow_sink.name != "sink" {
        return false;
    }

    // 3. Parser expression with `inout x`
    mut expr_tokens: List<Token> = List::new();
    expr_tokens.push(Token(kind: 5, value: 0, lexeme: "inout"));
    expr_tokens.push(Token(kind: 10, value: 0, lexeme: "target"));
    expr_tokens.push(Token(kind: 0, value: 0, lexeme: ""));

    mut e_cur: i64 = 0;
    mut expr_pool: List<AstExpr> = List::new();
    let parsed_cow = parse_primary(inout e_cur, expr_tokens, inout expr_pool);
    if parsed_cow.kind != 15 || parsed_cow.val != 1 || parsed_cow.name != "inout" {
        return false;
    }
    if parsed_cow.left?.name != "target" {
        return false;
    }
    return true;
}

// Unit test 28: Advanced Copy-on-Write arena declaration parsing
pub fn test_parser_advanced_cow_arena_decl() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 18, value: 0, lexeme: "arena"));
    tokens.push(Token(kind: 54, value: 0, lexeme: "cow"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "cow_ast"));
    tokens.push(Token(kind: 24, value: 0, lexeme: "="));
    tokens.push(Token(kind: 11, value: 131072, lexeme: "131072"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));

    mut cur: i64 = 0;
    let ar = parse_arena_decl(inout cur, tokens);
    if ar.name != "cow_ast" || !ar.is_cow || ar.capacity != 131072 || ar.page_size != 4096 {
        return false;
    }
    return true;
}

// Unit test 29: Nested pattern matching with tuple destructuring and guards
pub fn test_parser_nested_pattern_matching() -> bool {
    // match pair { (10, y) => y + 2, _ => 0 }
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 14, value: 0, lexeme: "match"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "pair"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    // Arm 1: (10, y) => y + 2,
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 11, value: 10, lexeme: "10"));
    tokens.push(Token(kind: 39, value: 0, lexeme: ","));
    tokens.push(Token(kind: 10, value: 0, lexeme: "y"));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 37, value: 0, lexeme: "=>"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "y"));
    tokens.push(Token(kind: 20, value: 0, lexeme: "+"));
    tokens.push(Token(kind: 11, value: 2, lexeme: "2"));
    tokens.push(Token(kind: 39, value: 0, lexeme: ","));
    // Arm 2: _ => 0
    tokens.push(Token(kind: 38, value: 0, lexeme: "_"));
    tokens.push(Token(kind: 37, value: 0, lexeme: "=>"));
    tokens.push(Token(kind: 11, value: 0, lexeme: "0"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let m = parse_nested_match(inout cur, tokens, inout pool);
    if m.target_var != "pair" || m.arms.len() != 2 {
        return false;
    }
    let a1 = m.arms[0];
    if a1.pat.kind != 4 || a1.pat.sub_pat1_kind != 2 || a1.pat.sub_pat1_val != 10 || a1.pat.sub_pat2_kind != 3 || a1.pat.sub_pat2_name != "y" {
        return false;
    }
    let a2 = m.arms[1];
    if a2.pat.kind != 1 || a2.pat.name != "_" {
        return false;
    }
    return true;
}

