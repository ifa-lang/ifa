// Unit test 12: Constant declaration parsing `pub const MAX_BUFFER_SIZE: i64 = 4096;`
pub fn test_parser_const_declaration() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 15, value: 0, lexeme: "pub"));
    tokens.push(Token(kind: 19, value: 0, lexeme: "const"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "MAX_BUFFER_SIZE"));
    tokens.push(Token(kind: 34, value: 0, lexeme: ":"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "i64"));
    tokens.push(Token(kind: 24, value: 0, lexeme: "="));
    tokens.push(Token(kind: 11, value: 4096, lexeme: "4096"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));

    mut cur: i64 = 0;
    let cn = parse_const(inout cur, tokens);
    if !cn.is_pub {
        return false;
    }
    if cn.name != "MAX_BUFFER_SIZE" {
        return false;
    }
    if cn.ty != "i64" {
        return false;
    }
    return cn.val == 4096;
}

// Unit test 13: Enum declaration parsing `pub enum TokenKind { Eof, Identifier, Number, Plus }`
pub fn test_parser_enum_declaration() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 15, value: 0, lexeme: "pub"));
    tokens.push(Token(kind: 26, value: 0, lexeme: "enum"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "TokenKind"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "Eof"));
    tokens.push(Token(kind: 39, value: 0, lexeme: ","));
    tokens.push(Token(kind: 10, value: 0, lexeme: "Identifier"));
    tokens.push(Token(kind: 39, value: 0, lexeme: ","));
    tokens.push(Token(kind: 10, value: 0, lexeme: "Number"));
    tokens.push(Token(kind: 39, value: 0, lexeme: ","));
    tokens.push(Token(kind: 10, value: 0, lexeme: "Plus"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));

    mut cur: i64 = 0;
    let en = parse_enum(inout cur, tokens);
    if !en.is_pub {
        return false;
    }
    if en.name != "TokenKind" {
        return false;
    }
    if en.variants.len() != 4 {
        return false;
    }
    if en.variants[0].name != "Eof" || en.variants[0].discriminant != 0 {
        return false;
    }
    if en.variants[1].name != "Identifier" || en.variants[1].discriminant != 1 {
        return false;
    }
    if en.variants[2].name != "Number" || en.variants[2].discriminant != 2 {
        return false;
    }
    return en.variants[3].name == "Plus" && en.variants[3].discriminant == 3;
}

// Unit test 14: Comptime directive parsing `comptime { let limit = 100; }`
pub fn test_parser_comptime_directives() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 52, value: 0, lexeme: "comptime"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 2, value: 0, lexeme: "let"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "limit"));
    tokens.push(Token(kind: 24, value: 0, lexeme: "="));
    tokens.push(Token(kind: 11, value: 100, lexeme: "100"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let cb = parse_comptime_block(inout cur, tokens, inout pool);
    if cb.statements.len() != 1 {
        return false;
    }
    let st = cb.statements[0];
    if st.target_var != "limit" {
        return false;
    }
    let val = st.expr?.val ?? 0;
    return val == 100;
}

// Unit test 15: Syntax macro definition and invocation parsing `macro def_calc($val) { ... } def_calc!(42);`
pub fn test_parser_syntax_macros() -> bool {
    mut tokens: List<Token> = List::new();
    tokens.push(Token(kind: 51, value: 0, lexeme: "macro"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "def_calc"));
    tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    tokens.push(Token(kind: 53, value: 0, lexeme: "$"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "val"));
    tokens.push(Token(kind: 31, value: 0, lexeme: ")"));
    tokens.push(Token(kind: 32, value: 0, lexeme: "{"));
    tokens.push(Token(kind: 4, value: 0, lexeme: "return"));
    tokens.push(Token(kind: 53, value: 0, lexeme: "$"));
    tokens.push(Token(kind: 10, value: 0, lexeme: "val"));
    tokens.push(Token(kind: 35, value: 0, lexeme: ";"));
    tokens.push(Token(kind: 33, value: 0, lexeme: "}"));

    mut cur: i64 = 0;
    mut pool: List<AstExpr> = List::new();
    let md = parse_macro_def(inout cur, tokens, inout pool);
    if md.name != "def_calc" || md.param_name != "val" {
        return false;
    }
    if md.statements.len() != 1 {
        return false;
    }

    // Test macro invocation parsing
    mut inv_tokens: List<Token> = List::new();
    inv_tokens.push(Token(kind: 10, value: 0, lexeme: "def_calc"));
    inv_tokens.push(Token(kind: 50, value: 0, lexeme: "!"));
    inv_tokens.push(Token(kind: 30, value: 0, lexeme: "("));
    inv_tokens.push(Token(kind: 11, value: 42, lexeme: "42"));
    inv_tokens.push(Token(kind: 31, value: 0, lexeme: ")"));

    mut cur_inv: i64 = 0;
    let inv_expr = parse_primary(inout cur_inv, inv_tokens, inout pool);
    if inv_expr.kind != 7 || inv_expr.name != "def_calc" {
        return false;
    }
    let arg_val = inv_expr.left?.val ?? 0;
    return arg_val == 42;
}

pub fn main() {
    println("=== IFA Compiler Parser Module ===");
    let t1 = test_parser_ast_building();
    let t2 = test_parser_precedence();
    let t3 = test_parser_paren_precedence();
    let t4 = test_parser_trait_declaration();
    let t5 = test_parser_impl_declaration();
    let t6 = test_parser_match_expression();
    let t7 = test_parser_program_high_level_items();
    let t8 = test_parser_type_alias();
    let t9 = test_parser_tuple_expression();
    let t10 = test_parser_tuple_index_access();
    let t11 = test_parser_arena_declaration();
    let t12 = test_parser_const_declaration();
    let t13 = test_parser_enum_declaration();
    let t14 = test_parser_comptime_directives();
    let t15 = test_parser_syntax_macros();
    if t1 && t2 && t3 && t4 && t5 && t6 && t7 && t8 && t9 && t10 && t11 && t12 && t13 && t14 && t15 {
        println("Parser validation tests: ALL PASSED");
    } else {
        println("Parser validation tests: FAILED");
    }
}
