// Unit Test 7: Verify complex module LLVM IR generation with loops, match and generic calls
pub fn test_driver_complex_module_and_bootstrap_orchestration() -> bool {
    let ir = compile_complex_module_to_llvm_ir("x86_64-unknown-linux-gnu");
    if ir.len() < 50 {
        return false;
    }
    // Verify essential function definitions exist
    mut has_identity = false;
    mut has_pipeline = false;
    mut has_main = false;

    mut i: i64 = 0;
    while i < ir.len() {
        let line = ir[i];
        if line == "define i64 @identity$i64(i64 %val) {" {
            has_identity = true;
        } else if line == "define i64 @complex_pipeline(i64 %seed) {" {
            has_pipeline = true;
        } else if line == "define i64 @main() {" {
            has_main = true;
        }
        i = i + 1;
    }

    return has_identity && has_pipeline && has_main;
}

// Unit Test 8: Verify multi-module symbol catalog and unified LLVM assembly
pub fn test_driver_multi_module_symbol_resolution() -> bool {
    mut catalog = make_module_catalog();
    register_module_symbol(inout catalog, "lexer", "Token", 4);
    register_module_symbol(inout catalog, "lexer", "tokenize_source", 6);
    register_module_symbol(inout catalog, "parser", "parse_program", 6);
    register_module_symbol(inout catalog, "sema", "Describable", 5);
    register_module_symbol(inout catalog, "codegen_llvm", "PAGE_SIZE", 1);

    if catalog.entries.len() != 5 {
        return false;
    }

    let sym_fn = resolve_module_symbol(catalog, "parser", "parse_program");
    if sym_fn != "parser$parse_program" {
        return false;
    }

    let sym_tr = resolve_module_symbol(catalog, "sema", "Describable");
    if sym_tr != "sema$Describable" {
        return false;
    }

    mut body: List<String> = List::new();
    body.push("define i64 @main() {");
    body.push("entry:");
    body.push("  %res = call i64 @parser$parse_program(i64 0)");
    body.push("  call void @ifa_rt_println_i64(i64 %res)");
    body.push("  ret i64 0");
    body.push("}");

    let assembled = assemble_multi_module_llvm(catalog, body, "x86_64-unknown-linux-gnu");
    if assembled.len() < 15 {
        return false;
    }

    mut has_decl_fn = false;
    mut has_vtable = false;
    mut i: i64 = 0;
    while i < assembled.len() {
        let line = assembled[i];
        if line == "declare i64 @parser$parse_program(i64)" {
            has_decl_fn = true;
        } else if line == "@sema$Describable$vtable = external global ptr" {
            has_vtable = true;
        }
        i = i + 1;
    }

    return has_decl_fn && has_vtable;
}

// Unit Test 9: Verify import graph DAG ordering, cycle detection, and transitive closure
pub fn test_driver_import_graph_and_transitive_deps() -> bool {
    mut graph = make_import_graph();

    mut empty_deps: List<String> = List::new();
    register_module(inout graph, "lexer", "compiler/lexer.ifa", empty_deps);

    mut parser_deps: List<String> = List::new();
    parser_deps.push("lexer");
    register_module(inout graph, "parser", "compiler/parser.ifa", parser_deps);

    mut sema_deps: List<String> = List::new();
    sema_deps.push("lexer");
    sema_deps.push("parser");
    register_module(inout graph, "sema", "compiler/sema.ifa", sema_deps);

    mut codegen_deps: List<String> = List::new();
    codegen_deps.push("lexer");
    codegen_deps.push("parser");
    codegen_deps.push("sema");
    register_module(inout graph, "codegen_llvm", "compiler/codegen_llvm.ifa", codegen_deps);

    mut driver_deps: List<String> = List::new();
    driver_deps.push("codegen_llvm");
    driver_deps.push("sema");
    register_module(inout graph, "driver", "compiler/driver.ifa", driver_deps);

    mut main_deps: List<String> = List::new();
    main_deps.push("driver");
    main_deps.push("sema");
    register_module(inout graph, "main", "compiler/main.ifa", main_deps);

    if graph.modules.len() != 6 {
        return false;
    }

    // Verify DAG is acyclic
    if has_circular_dependency(graph) {
        return false;
    }

    let topo = topological_sort_modules(graph);
    if topo.len() != 6 {
        return false;
    }
    // Lexer must precede parser, parser precede sema, sema precede codegen, codegen precede driver, driver precede main
    let idx_lex = find_index_in_list(topo, "lexer");
    let idx_par = find_index_in_list(topo, "parser");
    let idx_sem = find_index_in_list(topo, "sema");
    let idx_cg = find_index_in_list(topo, "codegen_llvm");
    let idx_drv = find_index_in_list(topo, "driver");
    let idx_main = find_index_in_list(topo, "main");

    if !(idx_lex < idx_par && idx_par < idx_sem && idx_sem < idx_cg && idx_cg < idx_drv && idx_drv < idx_main) {
        return false;
    }

    // Transitive dependencies of "driver" (should be lexer, parser, sema, codegen_llvm)
    let drv_trans = resolve_transitive_dependencies(graph, "driver");
    if drv_trans.len() != 4 {
        return false;
    }
    if drv_trans[0] != "lexer" || drv_trans[1] != "parser" || drv_trans[2] != "sema" || drv_trans[3] != "codegen_llvm" {
        return false;
    }

    // Compilation plan for "main"
    let plan = create_multi_file_compilation_plan(graph, "main");
    if !plan.is_valid || plan.modules_in_order.len() != 6 {
        return false;
    }
    if plan.modules_in_order[5] != "main" {
        return false;
    }

    // Circular dependency detection
    mut cycle_graph = make_import_graph();
    mut mod_a_deps: List<String> = List::new();
    mod_a_deps.push("mod_b");
    register_module(inout cycle_graph, "mod_a", "a.ifa", mod_a_deps);

    mut mod_b_deps: List<String> = List::new();
    mod_b_deps.push("mod_a");
    register_module(inout cycle_graph, "mod_b", "b.ifa", mod_b_deps);

    if !has_circular_dependency(cycle_graph) {
        return false;
    }

    let cycle_plan = create_multi_file_compilation_plan(cycle_graph, "mod_a");
    if cycle_plan.is_valid {
        return false;
    }

    // Assemble LLVM with dependency graph
    mut cat = make_module_catalog();
    register_module_symbol(inout cat, "lexer", "Token", 4);
    register_module_symbol(inout cat, "lexer", "tokenize_source", 6);
    register_module_symbol(inout cat, "driver", "compile_full_pipeline", 6);

    mut body: List<String> = List::new();
    body.push("define i64 @main() {");
    body.push("entry:");
    body.push("  ret i64 0");
    body.push("}");

    let assembled = assemble_dependency_graph_llvm(graph, cat, "main", body, "x86_64-unknown-linux-gnu");
    if assembled.len() < 12 {
        return false;
    }

    return true;
}

// Unit Test 10: Verify native C header and PHP 8.4+ FFI bridge generation
pub fn test_driver_ffi_header_and_php_bridge_generation() -> bool {
    mut cat = make_ffi_catalog();

    mut p1: List<FfiExportParam> = List::new();
    p1.push(FfiExportParam(name: "a", type_name: "i64"));
    p1.push(FfiExportParam(name: "b", type_name: "i64"));
    register_ffi_function(inout cat, "math", "fast_add", p1, "i64", true);

    mut p2: List<FfiExportParam> = List::new();
    p2.push(FfiExportParam(name: "data", type_name: "ptr"));
    register_ffi_function(inout cat, "crypto", "hash_bytes", p2, "i64", false);

    let c_lines = generate_c_header_lines(cat, "calc");
    if c_lines.len() < 18 {
        return false;
    }
    if c_lines[1] != "#ifndef IFA_calc_H" || c_lines[2] != "#define IFA_calc_H" {
        return false;
    }
    if c_lines[14] != "int64_t ifa_math_fast_add(int64_t a, int64_t b);" {
        return false;
    }
    if c_lines[17] != "int64_t ifa_crypto_hash_bytes(const char* data);" {
        return false;
    }

    let php_lines = generate_php_ffi_bridge_lines(cat, "calc", "CalcBridge");
    if php_lines.len() < 25 {
        return false;
    }
    if php_lines[4] != "namespace Ifa\\calc;" {
        return false;
    }
    if php_lines[10] != "final class CalcBridge" {
        return false;
    }
    if php_lines[21] != "    public function fast_add(int $a, int $b): int" {
        return false;
    }
    if php_lines[23] != "        return $this->ffi->ifa_math_fast_add($a, $b);" {
        return false;
    }
    if php_lines[26] != "    public function hash_bytes(string $data): int" {
        return false;
    }

    let c_text = generate_c_header_text(cat, "calc");
    let php_text = generate_php_ffi_bridge_text(cat, "calc", "CalcBridge");
    if c_text == "" || php_text == "" {
        return false;
    }

    return true;
}

