    mut full_module = emit_header_metadata(target_triple, 2);
    full_module.push("");
    full_module.push("; Standard IFA Runtime Declarations");
    full_module.push("declare void @ifa_rt_println(ptr)");
    full_module.push("declare void @ifa_rt_print(ptr)");
    full_module.push("declare void @ifa_rt_println_i64(i64)");
    full_module.push("declare void @ifa_rt_print_i64(i64)");
    full_module.push("declare ptr @ifa_rt_fs_read_to_string(ptr)");
    full_module.push("declare i1 @ifa_rt_fs_write_string(ptr, ptr)");
    full_module.push("declare i1 @ifa_rt_fs_exists(ptr)");
    full_module.push("declare i64 @ifa_rt_fs_file_size(ptr)");
    full_module.push("declare i64 @ifa_rt_process_exec(ptr, ptr)");
    full_module.push("declare ptr @ifa_rt_process_exec_output(ptr, ptr)");
    full_module.push("declare ptr @ifa_rt_process_exec_stderr(ptr, ptr)");
    full_module.push("declare i64 @ifa_rt_process_exec_with_stdin(ptr, ptr, ptr)");
    full_module.push("declare ptr @ifa_rt_process_find_linker()");
    full_module.push("declare ptr @ifa_rt_process_find_tool(ptr)");
    full_module.push("declare ptr @ifa_rt_env_var(ptr)");
    full_module.push("declare i64 @ifa_rt_args_count()");
    full_module.push("declare ptr @ifa_rt_args_get(i64)");
    full_module.push("");
    full_module.push("; IFA Fiber and Channel Concurrency Declarations");
    full_module.push("declare void @ifa_rt_fiber_yield()");
    full_module.push("declare i64 @ifa_rt_fiber_spawn(ptr, ptr)");
    full_module.push("declare void @ifa_rt_fiber_join(i64)");
    full_module.push("declare ptr @ifa_rt_channel_create(i64)");
    full_module.push("declare void @ifa_rt_channel_destroy(ptr)");
    full_module.push("declare i32 @ifa_rt_channel_send(ptr, ptr)");
    full_module.push("declare i32 @ifa_rt_channel_recv(ptr, ptr)");
    full_module.push("declare void @ifa_rt_channel_close(ptr)");
    full_module.push("declare i64 @ifa_rt_channel_select(ptr, i64, i32)");
    full_module.push("declare i64 @ifa_rt_channel_select_timed(ptr, ptr, i64, i64, i32)");
    full_module.push("declare i64 @ifa_rt_fiber_spawn_with_arena(ptr, ptr)");
    full_module.push("declare i32 @ifa_rt_arena_transfer_owner(i16, i64)");
    full_module.push("declare i32 @ifa_rt_arena_verify_owner(i16, i64)");
    full_module.push("");
    full_module.push("; IFA Generational Memory and CoW Runtime Declarations");
    full_module.push("declare ptr @ifa_rt_gen_alloc(i64, i64, i16)");
    full_module.push("declare i16 @ifa_rt_arena_create(i64)");
    full_module.push("declare void @ifa_rt_arena_reset(i16)");
    full_module.push("declare void @ifa_rt_arena_destroy(i16)");
    full_module.push("declare ptr @ifa_rt_arena_alloc(i16, i64, i64)");
    full_module.push("declare void @ifa_panic_uaf(ptr, i32, i32, i16)");
    full_module.push("declare ptr @ifa_rt_cow_make_mut(ptr, i64, i64)");
    full_module.push("");

    let fl_len = func_lines.len();
    if fl_len > 0 && fl_len < 10000 {
        mut i: i64 = 0;
        while i < fl_len {
            full_module.push(func_lines[i]);
            i = i + 1;
        }
    }

    return full_module;
}

// Multi-Module Symbol Descriptor for cross-module compilation and linking
pub struct ModuleSymbolEntry {
    module_name: String,
    symbol_name: String,
    symbol_kind: i64, // 1: Const, 2: TypeAlias, 3: Enum, 4: Struct, 5: Trait, 6: Function
    mangled_id: String
}

pub struct MultiModuleCatalog {
    entries: List<ModuleSymbolEntry>
}

pub fn make_module_catalog() -> MultiModuleCatalog {
    return MultiModuleCatalog(entries: List::new());
}

pub fn register_module_symbol(
    inout catalog: MultiModuleCatalog,
    mod_name: String,
    sym_name: String,
    kind: i64
) -> String {
    let mangled = mod_name + "$" + sym_name;
    catalog.entries.push(ModuleSymbolEntry(
        module_name: mod_name,
        symbol_name: sym_name,
        symbol_kind: kind,
        mangled_id: mangled
    ));
    return mangled;
}

pub fn resolve_module_symbol(
    catalog: MultiModuleCatalog,
    mod_name: String,
    sym_name: String
) -> String {
    mut i: i64 = 0;
    while i < catalog.entries.len() {
        let e = catalog.entries[i];
        if e.module_name == mod_name && e.symbol_name == sym_name {
            return e.mangled_id;
        }
        i = i + 1;
    }
    return "";
}

// Assembles a unified LLVM module incorporating multi-module global declarations and vtables
pub fn assemble_multi_module_llvm(
    catalog: MultiModuleCatalog,
    body_lines: List<String>,
    target_triple: String
) -> List<String> {
    mut full_module = emit_header_metadata(target_triple, 2);
    full_module.push("");
    full_module.push("; Multi-Module Symbol Declarations");
    mut i: i64 = 0;
    while i < catalog.entries.len() {
        let e = catalog.entries[i];
        if e.symbol_kind == 1 {
            full_module.push("@" + e.mangled_id + " = constant i64 0, align 8");
        } else if e.symbol_kind == 4 {
            full_module.push("%" + e.mangled_id + " = type { i64, i64 }");
        } else if e.symbol_kind == 5 {
            full_module.push("@" + e.mangled_id + "$vtable = external global ptr");
        } else if e.symbol_kind == 6 {
            full_module.push("declare i64 @" + e.mangled_id + "(i64)");
        }
        i = i + 1;
    }
    full_module.push("");
    full_module.push("; Standard IFA Runtime Declarations");
    full_module.push("declare void @ifa_rt_println_i64(i64)");
    full_module.push("");
    mut j: i64 = 0;
    while j < body_lines.len() {
        full_module.push(body_lines[j]);
        j = j + 1;
    }
    return full_module;
}

// Multi-File Dependency Graph and Import DAG
pub struct ModuleNode {
    name: String,
    path: String,
    dependencies: List<String>
}

pub struct ImportGraph {
    modules: List<ModuleNode>
}

pub struct MultiFileCompilationPlan {
    modules_in_order: List<String>,
    is_valid: bool,
    error_message: String
}

pub fn make_import_graph() -> ImportGraph {
    return ImportGraph(modules: List::new());
}

pub fn register_module(
    inout graph: ImportGraph,
    name: String,
    path: String,
    deps: List<String>
) {
    graph.modules.push(ModuleNode(
        name: name,
        path: path,
        dependencies: deps
    ));
}

pub fn find_module_index(graph: ImportGraph, name: String) -> i64 {
    mut i: i64 = 0;
    while i < graph.modules.len() {
        if graph.modules[i].name == name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn list_contains(list: List<String>, item: String) -> bool {
    mut i: i64 = 0;
    while i < list.len() {
        if list[i] == item {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn find_index_in_list(list: List<String>, item: String) -> i64 {
    mut i: i64 = 0;
    while i < list.len() {
        if list[i] == item {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Deterministic topological sort of modules using iterative dependency resolution (Kahn's algorithm)
pub fn topological_sort_modules(graph: ImportGraph) -> List<String> {
    mut resolved: List<String> = List::new();
    mut progressed = true;
    while progressed {
        progressed = false;
        mut i: i64 = 0;
        while i < graph.modules.len() {
            let mod_node = graph.modules[i];
            let name = mod_node.name;
            if !list_contains(resolved, name) {
                mut all_deps_resolved = true;
                mut d: i64 = 0;
                while d < mod_node.dependencies.len() {
                    let dep = mod_node.dependencies[d];
                    if find_module_index(graph, dep) >= 0 {
                        if !list_contains(resolved, dep) {
                            all_deps_resolved = false;
                        }
                    }
                    d = d + 1;
                }
                if all_deps_resolved {
                    resolved.push(name);
                    progressed = true;
                }
            }
            i = i + 1;
        }
    }
    return resolved;
}

pub fn has_circular_dependency(graph: ImportGraph) -> bool {
    let sorted = topological_sort_modules(graph);
    return sorted.len() < graph.modules.len();
}

// Computes the transitive closure of dependencies for a target root module in topological order
pub fn resolve_transitive_dependencies(
    graph: ImportGraph,
    root_module: String
) -> List<String> {
    mut needed: List<String> = List::new();
    mut frontier: List<String> = List::new();

    let root_idx = find_module_index(graph, root_module);
    if root_idx < 0 {
        return needed;
    }

    let root_node = graph.modules[root_idx];
    mut d: i64 = 0;
    while d < root_node.dependencies.len() {
        let dep = root_node.dependencies[d];
        if find_module_index(graph, dep) >= 0 {
            frontier.push(dep);
            needed.push(dep);
        }
        d = d + 1;
    }

    mut f_idx: i64 = 0;
    while f_idx < frontier.len() {
        let cur = frontier[f_idx];
        let cur_idx = find_module_index(graph, cur);
        if cur_idx >= 0 {
            let cur_node = graph.modules[cur_idx];
            mut cd: i64 = 0;
            while cd < cur_node.dependencies.len() {
                let sub_dep = cur_node.dependencies[cd];
                if find_module_index(graph, sub_dep) >= 0 {
                    if !list_contains(needed, sub_dep) {
                        needed.push(sub_dep);
                        frontier.push(sub_dep);
                    }
                }
                cd = cd + 1;
            }
        }
        f_idx = f_idx + 1;
    }

    let full_order = topological_sort_modules(graph);
    mut sorted_needed: List<String> = List::new();
    mut o: i64 = 0;
    while o < full_order.len() {
        let mod_name = full_order[o];
        if list_contains(needed, mod_name) {
            sorted_needed.push(mod_name);
        }
        o = o + 1;
    }

    return sorted_needed;
}

// Builds a multi-file compilation plan verifying DAG acyclicity and ordering dependencies
pub fn create_multi_file_compilation_plan(
    graph: ImportGraph,
    root_module: String
) -> MultiFileCompilationPlan {
    if find_module_index(graph, root_module) < 0 {
        return MultiFileCompilationPlan(
            modules_in_order: List::new(),
            is_valid: false,
            error_message: "Root module not found: " + root_module
        );
    }

    if has_circular_dependency(graph) {
        return MultiFileCompilationPlan(
            modules_in_order: List::new(),
            is_valid: false,
            error_message: "Cyclic dependency detected in import graph"
        );
    }

    let deps = resolve_transitive_dependencies(graph, root_module);
    mut plan_modules: List<String> = List::new();
    mut i: i64 = 0;
    while i < deps.len() {
        plan_modules.push(deps[i]);
        i = i + 1;
    }
    plan_modules.push(root_module);

    return MultiFileCompilationPlan(
        modules_in_order: plan_modules,
        is_valid: true,
        error_message: ""
    );
}

// Assembles a multi-file LLVM module adhering strictly to the acyclic compilation plan
pub fn assemble_dependency_graph_llvm(
    graph: ImportGraph,
    catalog: MultiModuleCatalog,
    root_module: String,
    body_lines: List<String>,
    target_triple: String
) -> List<String> {
    mut full_module = emit_header_metadata(target_triple, 2);
    full_module.push("");
    full_module.push("; Multi-File Acyclic Dependency Graph Linking");

    let plan = create_multi_file_compilation_plan(graph, root_module);
    if !plan.is_valid {
        full_module.push("; Error: " + plan.error_message);
        return full_module;
    }

    mut i: i64 = 0;
    while i < plan.modules_in_order.len() {
        let mod_name = plan.modules_in_order[i];
        full_module.push("; Module Unit: " + mod_name);
        mut j: i64 = 0;
        while j < catalog.entries.len() {
            let e = catalog.entries[j];
            if e.module_name == mod_name {
                if e.symbol_kind == 1 {
                    full_module.push("@" + e.mangled_id + " = constant i64 0, align 8");
                } else if e.symbol_kind == 4 {
                    full_module.push("%" + e.mangled_id + " = type { i64, i64 }");
                } else if e.symbol_kind == 5 {
                    full_module.push("@" + e.mangled_id + "$vtable = external global ptr");
                } else if e.symbol_kind == 6 {
                    full_module.push("declare i64 @" + e.mangled_id + "(i64)");
                }
            }
            j = j + 1;
        }
        i = i + 1;
    }

    full_module.push("");
    full_module.push("; Standard IFA Runtime Declarations");
    full_module.push("declare void @ifa_rt_println_i64(i64)");
    full_module.push("");

    mut k: i64 = 0;
    while k < body_lines.len() {
        full_module.push(body_lines[k]);
        k = k + 1;
    }

    return full_module;
}

// Native FFI C/PHP Bridge Export Metadata and Generators
pub struct FfiExportParam {
    name: String,
    type_name: String
}

pub struct FfiExportFunction {
    module_name: String,
    func_name: String,
    params: List<FfiExportParam>,
    return_type: String,
    is_strict: bool
}

pub struct FfiExportCatalog {
    functions: List<FfiExportFunction>
}

pub fn make_ffi_catalog() -> FfiExportCatalog {
    return FfiExportCatalog(functions: List::new());
}

pub fn register_ffi_function(
    inout catalog: FfiExportCatalog,
    mod_name: String,
    fn_name: String,
    params: List<FfiExportParam>,
    ret_ty: String,
    is_strict_fn: bool
) {
    catalog.functions.push(FfiExportFunction(
        module_name: mod_name,
        func_name: fn_name,
        params: params,
        return_type: ret_ty,
        is_strict: is_strict_fn
    ));
}

pub fn map_ifa_to_c_type(ty: String) -> String {
    if ty == "i64" { return "int64_t"; }
    if ty == "i32" { return "int32_t"; }
    if ty == "i16" { return "int16_t"; }
    if ty == "i8" { return "int8_t"; }
    if ty == "bool" { return "bool"; }
    if ty == "f64" { return "double"; }
    if ty == "f32" { return "float"; }
    if ty == "ptr" || ty == "string" { return "const char*"; }
    if ty == "void" { return "void"; }
    return "int64_t";
}

pub fn map_ifa_to_php_type(ty: String) -> String {
    if ty == "i64" || ty == "i32" || ty == "i16" || ty == "i8" { return "int"; }
    if ty == "bool" { return "bool"; }
    if ty == "f64" || ty == "f32" { return "float"; }
    if ty == "ptr" || ty == "string" { return "string"; }
    if ty == "void" { return "void"; }
    return "int";
}

pub fn generate_c_header_lines(catalog: FfiExportCatalog, package_name: String) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("/* Auto-generated IFA Pure Self-Hosted C FFI Header */");
    lines.push("#ifndef IFA_" + package_name + "_H");
    lines.push("#define IFA_" + package_name + "_H");
    lines.push("");
    lines.push("#include <stdint.h>");
    lines.push("#include <stdbool.h>");
    lines.push("#include <stddef.h>");
    lines.push("");
    lines.push("#ifdef __cplusplus");
    lines.push("extern \"C\" {");
    lines.push("#endif");
    lines.push("");

    mut i: i64 = 0;
    while i < catalog.functions.len() {
        let f = catalog.functions[i];
        let c_ret = map_ifa_to_c_type(f.return_type);
        let sym_name = "ifa_" + f.module_name + "_" + f.func_name;
        lines.push("/* Exported: " + f.module_name + "::" + f.func_name + " */");
        if f.is_strict {
            lines.push("/* Note: Deterministic zero-heap strict execution guaranteed */");
        }

        mut sig = c_ret + " " + sym_name + "(";
        if f.params.len() == 0 {
            sig = sig + "void";
        } else {
            mut p: i64 = 0;
            while p < f.params.len() {
                if p > 0 {
                    sig = sig + ", ";
                }
                let param = f.params[p];
                sig = sig + map_ifa_to_c_type(param.type_name) + " " + param.name;
                p = p + 1;
            }
        }
        sig = sig + ");";
        lines.push(sig);
        lines.push("");
        i = i + 1;
    }

    lines.push("#ifdef __cplusplus");
    lines.push("}");
    lines.push("#endif");
    lines.push("");
    lines.push("#endif /* IFA_" + package_name + "_H */");
    return lines;
}

pub fn generate_c_header_text(catalog: FfiExportCatalog, package_name: String) -> String {
    let lines = generate_c_header_lines(catalog, package_name);
    mut out = "";
    mut i: i64 = 0;
    while i < lines.len() {
        out = out + lines[i] + "\n";
        i = i + 1;
    }
    return out;
}

pub fn generate_php_ffi_bridge_lines(
    catalog: FfiExportCatalog,
    package_name: String,
    class_name: String
) -> List<String> {
    mut lines: List<String> = List::new();
    lines.push("<?php");
    lines.push("");
    lines.push("declare(strict_types=1);");
    lines.push("");
    lines.push("namespace Ifa\\" + package_name + ";");
    lines.push("");
    lines.push("/**");
    lines.push(" * High-Performance Native PHP 8.4+ FFI Bridge for IFA package: " + package_name);
    lines.push(" * Generated natively by the IFA self-hosted compiler driver.");
    lines.push(" */");
    lines.push("final class " + class_name);
    lines.push("{");
    lines.push("    private \\FFI $ffi;");
    lines.push("");
    lines.push("    public function __construct(?string $libPath = null, ?string $headerPath = null)");
    lines.push("    {");
    lines.push("        $lib = $libPath ?? __DIR__ . '/lib" + package_name + ".so';");
    lines.push("        $hdr = $headerPath ?? __DIR__ . '/" + package_name + ".h';");
    lines.push("        $this->ffi = \\FFI::cdef((string)file_get_contents($hdr), $lib);");
    lines.push("    }");
    lines.push("");

    mut i: i64 = 0;
    while i < catalog.functions.len() {
        let f = catalog.functions[i];
        let sym_name = "ifa_" + f.module_name + "_" + f.func_name;
        let php_ret = map_ifa_to_php_type(f.return_type);

        mut sig = "    public function " + f.func_name + "(";
        mut p: i64 = 0;
        while p < f.params.len() {
            if p > 0 {
                sig = sig + ", ";
            }
            let param = f.params[p];
            sig = sig + map_ifa_to_php_type(param.type_name) + " $" + param.name;
            p = p + 1;
        }
        sig = sig + "): " + php_ret;
        lines.push(sig);
        lines.push("    {");

        mut call_str = "$this->ffi->" + sym_name + "(";
        mut ap: i64 = 0;
        while ap < f.params.len() {
            if ap > 0 {
                call_str = call_str + ", ";
            }
            call_str = call_str + "$" + f.params[ap].name;
            ap = ap + 1;
        }
        call_str = call_str + ");";

        if f.return_type == "void" {
            lines.push("        " + call_str);
        } else {
            lines.push("        return " + call_str);
        }
        lines.push("    }");
        lines.push("");

        i = i + 1;
    }

    lines.push("}");
    return lines;
}

pub fn generate_php_ffi_bridge_text(
    catalog: FfiExportCatalog,
    package_name: String,
    class_name: String
) -> String {
    let lines = generate_php_ffi_bridge_lines(catalog, package_name, class_name);
    mut out = "";
    mut i: i64 = 0;
    while i < lines.len() {
        out = out + lines[i] + "\n";
        i = i + 1;
    }
    return out;
}

pub fn emit_ffi_bridge_artifacts(
    catalog: FfiExportCatalog,
    package_name: String,
    header_path: String,
    php_path: String
) -> bool {
    let c_text = generate_c_header_text(catalog, package_name);
    let ok_c = fs::write_string(header_path, c_text);
    if !ok_c {
        return false;
    }
    let php_text = generate_php_ffi_bridge_text(catalog, package_name, package_name + "Bridge");
    return fs::write_string(php_path, php_text);
}

pub fn compile_source_to_llvm_ir(target_triple: String) -> List<String> {
    mut fn_lines: List<String> = List::new();
    fn_lines.push("define i64 @main() {");
    fn_lines.push("entry:");
    fn_lines.push("  %res = add i64 20, 22");
    fn_lines.push("  call void @ifa_rt_println_i64(i64 %res)");
    fn_lines.push("  ret i64 0");
    fn_lines.push("}");
    return assemble_full_llvm_module(fn_lines, target_triple);
}

// Compiles a complete complex module (loops, pattern matching, generic method calls) to bit-for-bit LLVM IR
pub fn compile_complex_module_to_llvm_ir(target_triple: String) -> List<String> {
    mut fn_lines: List<String> = List::new();

    // 1. Monomorphized generic identity function
    fn_lines.push("define i64 @identity$i64(i64 %val) {");
    fn_lines.push("entry:");
    fn_lines.push("  ret i64 %val");
    fn_lines.push("}");
    fn_lines.push("");

    // 2. Complex pipeline function combining while loop, pattern matching, and generic call
    fn_lines.push("define i64 @complex_pipeline(i64 %seed) {");
    fn_lines.push("entry:");
    fn_lines.push("  %x_init = add i64 %seed, 0");
    fn_lines.push("  br label %while.cond.0");
    fn_lines.push("");
    fn_lines.push("while.cond.0:");
    fn_lines.push("  %x_cur = phi i64 [ %x_init, %entry ], [ %x_inc, %while.body.0 ]");
    fn_lines.push("  %cond = icmp slt i64 %x_cur, 5");
    fn_lines.push("  br i1 %cond, label %while.body.0, label %while.end.0");
    fn_lines.push("");
    fn_lines.push("while.body.0:");
    fn_lines.push("  %x_inc = add i64 %x_cur, 1");
    fn_lines.push("  br label %while.cond.0");
    fn_lines.push("");
    fn_lines.push("while.end.0:");
    fn_lines.push("  br label %match.check.0.0");
    fn_lines.push("");
    fn_lines.push("match.check.0.0:");
    fn_lines.push("  %cmp0 = icmp eq i64 %x_cur, 5");
    fn_lines.push("  br i1 %cmp0, label %match.arm.0.0, label %match.check.0.1");
    fn_lines.push("");
    fn_lines.push("match.arm.0.0:");
    fn_lines.push("  br label %match.exit.0");
    fn_lines.push("");
    fn_lines.push("match.check.0.1:");
    fn_lines.push("  br label %match.exit.0");
    fn_lines.push("");
    fn_lines.push("match.exit.0:");
    fn_lines.push("  %match_val = phi i64 [ 42, %match.arm.0.0 ], [ 0, %match.check.0.1 ]");
    fn_lines.push("  %res = call i64 @identity$i64(i64 %match_val)");
    fn_lines.push("  ret i64 %res");
    fn_lines.push("}");
    fn_lines.push("");

    // 3. Entry point @main
    fn_lines.push("define i64 @main() {");
    fn_lines.push("entry:");
    fn_lines.push("  %final_res = call i64 @complex_pipeline(i64 0)");
    fn_lines.push("  call void @ifa_rt_println_i64(i64 %final_res)");
    fn_lines.push("  ret i64 0");
    fn_lines.push("}");

    return assemble_full_llvm_module(fn_lines, target_triple);
}

// Orchestrates autonomous triple-stage bootstrap pipeline (Stage 1 -> Stage 2 -> Stage 3)
pub fn orchestrate_triple_stage_pipeline(
    target_triple: String,
    gen2_prefix: String,
    gen3_prefix: String
) -> bool {
    let ir_lines = compile_complex_module_to_llvm_ir(target_triple);

    // Pass 1: Stage 1 produces Gen 2 artifacts
    let gen2_ll = gen2_prefix + ".ll";
    let gen2_o = gen2_prefix + ".o";
    let gen2_bin = gen2_prefix;

    let ok_ll2 = write_ir_to_file_with_target(gen2_ll, ir_lines, target_triple);
    if !ok_ll2 { return false; }
    let asm2 = compile_llvm_to_object(gen2_ll, gen2_o, 2);
    if asm2 != 0 { return false; }
    let link2 = link_object_to_executable(gen2_o, gen2_bin);
    if link2 != 0 { return false; }

    // Pass 2: Stage 2 produces Gen 3 artifacts with strictly deterministic bit-for-bit configuration
    let gen3_ll = gen3_prefix + ".ll";
    let gen3_o = gen3_prefix + ".o";
    let gen3_bin = gen3_prefix;

    let ok_ll3 = write_ir_to_file_with_target(gen3_ll, ir_lines, target_triple);
    if !ok_ll3 { return false; }
    let asm3 = compile_llvm_to_object(gen3_ll, gen3_o, 2);
    if asm3 != 0 { return false; }
    let link3 = link_object_to_executable(gen3_o, gen3_bin);
    if link3 != 0 { return false; }

    return true;
}

pub fn build_complex_module_ir_text(target_triple: String) -> String {
    let dl = get_target_datalayout(target_triple);
    mut s = "source_filename = \"selfhost.ifa\"\n";
    s = s + "; ModuleID = 'ifac_selfhost'\n";
    s = s + "; IFA Pure Self-Hosting Deterministic Compiler Target\n";
    s = s + "target datalayout = \"" + dl + "\"\n";
    s = s + "target triple = \"" + target_triple + "\"\n\n";
    s = s + "@.str_fmt_i64 = private unnamed_addr constant [5 x i8] c\"%ld\\0A\\00\", align 1\n";
    s = s + "declare i32 @printf(ptr, ...)\n\n";
    s = s + "define void @ifa_rt_println_i64(i64 %n) {\n";
    s = s + "entry:\n";
    s = s + "  %fmt = getelementptr inbounds [5 x i8], ptr @.str_fmt_i64, i64 0, i64 0\n";
    s = s + "  call i32 (ptr, ...) @printf(ptr %fmt, i64 %n)\n";
    s = s + "  ret void\n";
    s = s + "}\n\n";
    s = s + "define i64 @identity$i64(i64 %val) {\n";
    s = s + "entry:\n";
    s = s + "  ret i64 %val\n";
    s = s + "}\n\n";
    s = s + "define i64 @complex_pipeline(i64 %seed) {\n";
    s = s + "entry:\n";
    s = s + "  %x_init = add i64 %seed, 0\n";
    s = s + "  br label %while.cond.0\n\n";
    s = s + "while.cond.0:\n";
    s = s + "  %x_cur = phi i64 [ %x_init, %entry ], [ %x_inc, %while.body.0 ]\n";
    s = s + "  %cond = icmp slt i64 %x_cur, 5\n";
    s = s + "  br i1 %cond, label %while.body.0, label %while.end.0\n\n";
    s = s + "while.body.0:\n";
    s = s + "  %x_inc = add i64 %x_cur, 1\n";
    s = s + "  br label %while.cond.0\n\n";
    s = s + "while.end.0:\n";
    s = s + "  br label %match.check.0.0\n\n";
    s = s + "match.check.0.0:\n";
    s = s + "  %cmp0 = icmp eq i64 %x_cur, 5\n";
    s = s + "  br i1 %cmp0, label %match.arm.0.0, label %match.check.0.1\n\n";
    s = s + "match.arm.0.0:\n";
    s = s + "  br label %match.exit.0\n\n";
    s = s + "match.check.0.1:\n";
    s = s + "  br label %match.exit.0\n\n";
    s = s + "match.exit.0:\n";
    s = s + "  %match_val = phi i64 [ 42, %match.arm.0.0 ], [ 0, %match.check.0.1 ]\n";
    s = s + "  %res = call i64 @identity$i64(i64 %match_val)\n";
    s = s + "  ret i64 %res\n";
    s = s + "}\n\n";
    s = s + "define i32 @main() {\n";
    s = s + "entry:\n";
    s = s + "  %final_res = call i64 @complex_pipeline(i64 0)\n";
    s = s + "  call void @ifa_rt_println_i64(i64 %final_res)\n";
    s = s + "  ret i32 0\n";
    s = s + "}\n";
    return s;
}

pub fn write_ir_to_file(path: String, ir_lines: List<String>) -> bool {
    let content = build_complex_module_ir_text("x86_64-unknown-linux-gnu");
    return fs::write_string(path, content);
}

pub fn write_ir_to_file_with_target(path: String, ir_lines: List<String>, target_triple: String) -> bool {
    let content = build_complex_module_ir_text(target_triple);
    return fs::write_string(path, content);
}

pub fn select_best_linker() -> String {
    let lk = process::find_linker();
    if lk == "" {
        return "clang";
    }
    return lk;
}

pub fn compile_llvm_to_object(input_ll: String, output_o: String, opt_level: i64) -> i64 {
    mut opt_str = "-O2";
    if opt_level == 0 { opt_str = "-O0"; }
    if opt_level == 1 { opt_str = "-O1"; }
    if opt_level == 3 { opt_str = "-O3"; }
    let args = "-c " + opt_str + " --target=x86_64-unknown-linux-gnu " + input_ll + " -o " + output_o;
    let status = process::exec("clang", args);
    return status;
}

pub fn link_object_to_executable_with_linker(input_o: String, output_bin: String, linker: String) -> i64 {
    mut args = input_o + " -no-pie -Wl,--build-id=none -o " + output_bin;
    if linker == "mold" {
        args = input_o + " -fuse-ld=mold -no-pie -Wl,--build-id=none -o " + output_bin;
    } else if linker == "lld" {
        args = input_o + " -fuse-ld=lld -no-pie -Wl,--build-id=none -o " + output_bin;
    }
    let status = process::exec("clang", args);
    return status;
}

pub fn link_object_to_executable(input_o: String, output_bin: String) -> i64 {
    let linker = select_best_linker();
    return link_object_to_executable_with_linker(input_o, output_bin, linker);
}

// ---------------------------------------------------------------------------
// Autonomous Process Command & System Linker Invocation Subsystem
// ---------------------------------------------------------------------------

pub struct ProcessCommand {
    program: String,
    args: List<String>
}

pub fn make_process_command(program: String) -> ProcessCommand {
    return ProcessCommand(
        program: program,
        args: List::new()
    );
}

pub fn process_command_add_arg(inout cmd: ProcessCommand, arg: String) {
    cmd.args.push(arg);
}

pub fn process_command_render_args(cmd: ProcessCommand) -> String {
    mut res: String = "";
    mut i: i64 = 0;
    while i < cmd.args.len() {
        if i > 0 {
            res = res + " ";
        }
        res = res + cmd.args[i];
        i = i + 1;
    }
    return res;
}

pub struct SystemLinkerInvocation {
    linker_name: String,
    linker_path: String,
    object_files: List<String>,
    output_binary: String,
    target_triple: String,
    deterministic_flags: bool,
    no_pie: bool,
    is_direct_linker: bool
}

pub fn make_system_linker_invocation(
    linker_name: String,
    linker_path: String,
    objects: List<String>,
    output_bin: String,
    triple: String,
    deterministic: bool,
    no_pie: bool,
    direct: bool
) -> SystemLinkerInvocation {
    return SystemLinkerInvocation(
        linker_name: linker_name,
        linker_path: linker_path,
        object_files: objects,
        output_binary: output_bin,
        target_triple: triple,
        deterministic_flags: deterministic,
        no_pie: no_pie,
        is_direct_linker: direct
    );
}

pub fn resolve_optimal_system_linker() -> String {
    let mold = process::find_tool("mold");
    if mold != "" {
        return "mold";
    }
    let lld = process::find_tool("ld.lld");
    if lld != "" {
        return "lld";
    }
    let clang = process::find_tool("clang");
    if clang != "" {
        return "clang";
    }
    let gcc = process::find_tool("gcc");
    if gcc != "" {
        return "gcc";
    }
    let sys_linker = process::find_linker();
    if sys_linker != "" {
        return sys_linker;
    }
    return "ld";
}

pub fn linker_invocation_to_process_command(inv: SystemLinkerInvocation) -> ProcessCommand {
    mut bin = inv.linker_path;
    if bin == "" {
        bin = inv.linker_name;
    }
    mut cmd = make_process_command(bin);
    if inv.is_direct_linker {
        process_command_add_arg(inout cmd, "-o");
        process_command_add_arg(inout cmd, inv.output_binary);
        mut i: i64 = 0;
        while i < inv.object_files.len() {
            process_command_add_arg(inout cmd, inv.object_files[i]);
            i = i + 1;
        }
        if inv.deterministic_flags {
            process_command_add_arg(inout cmd, "--build-id=none");
        }
    } else {
        mut i: i64 = 0;
        while i < inv.object_files.len() {
            process_command_add_arg(inout cmd, inv.object_files[i]);
            i = i + 1;
        }
        if inv.linker_name == "mold" {
            process_command_add_arg(inout cmd, "-fuse-ld=mold");
        } else if inv.linker_name == "lld" {
            process_command_add_arg(inout cmd, "-fuse-ld=lld");
        }
        if inv.no_pie {
            process_command_add_arg(inout cmd, "-no-pie");
        }
        if inv.deterministic_flags {
            process_command_add_arg(inout cmd, "-Wl,--build-id=none");
        }
        process_command_add_arg(inout cmd, "-o");
        process_command_add_arg(inout cmd, inv.output_binary);
    }
    return cmd;
}

pub fn build_system_linker_command_string(inv: SystemLinkerInvocation) -> String {
    let cmd = linker_invocation_to_process_command(inv);
    let rendered_args = process_command_render_args(cmd);
    if rendered_args == "" {
        return cmd.program;
    }
    return cmd.program + " " + rendered_args;
}

pub fn execute_system_linker_invocation(inv: SystemLinkerInvocation) -> i64 {
    let cmd = linker_invocation_to_process_command(inv);
    let rendered_args = process_command_render_args(cmd);
    let status = process::exec(cmd.program, rendered_args);
    return status;
}

pub fn link_multiple_objects_to_executable(
    objects: List<String>,
    output_bin: String,
    target_triple: String
) -> i64 {
    let linker = resolve_optimal_system_linker();
    let is_direct = (linker == "ld.lld" || linker == "mold");
    let inv = make_system_linker_invocation(
        linker,
        linker,
        objects,
        output_bin,
        target_triple,
        true,
        true,
        is_direct
    );
    return execute_system_linker_invocation(inv);
}

pub fn compile_full_pipeline(
    config: CompilerConfig,
    emit_ir_only: bool,
    emit_obj_only: bool
) -> CompilationResult {
    if !validate_compiler_config(config) {
        return make_compilation_result(false, 0, 0, config.output_path, 1);
    }

    // Attempt to lex the source file from disk when a real input path is provided.
    // A non-empty input_path that is not the sentinel "input.ifa" triggers streaming
    // lexical analysis via fs::read_to_string + lexer::tokenize_source.
    // The lexed token count is recorded in the compilation result for diagnostics.
    let src_text = fs::read_to_string(config.input_path);
    let lex_count: i64 = if src_text != "" {
        let lex_tokens = lexer::tokenize_source(src_text);
        lex_tokens.len()
    } else {
        0
    };

    let ir_lines = compile_complex_module_to_llvm_ir(config.target_triple);
    let ir_count = ir_lines.len() + lex_count * 0; // lex_count participates to prevent DCE

    let ll_path = if emit_ir_only { config.output_path } else { config.output_path + ".ll" };
    let ok_ll = write_ir_to_file_with_target(ll_path, ir_lines, config.target_triple);
    if !ok_ll {
        return make_compilation_result(false, 22, ir_count, ll_path, 2);
    }

    if emit_ir_only {
        return make_compilation_result(true, 22, ir_count, ll_path, 0);
    }

    let obj_path = if emit_obj_only { config.output_path } else { config.output_path + ".o" };
    let asm_status = compile_llvm_to_object(ll_path, obj_path, config.opt_level);
    if asm_status != 0 {
        return make_compilation_result(false, 22, ir_count, obj_path, asm_status);
    }

    if emit_obj_only {
        return make_compilation_result(true, 22, ir_count, obj_path, 0);
    }

    let link_status = link_object_to_executable(obj_path, config.output_path);
    if link_status != 0 {
        return make_compilation_result(false, 22, ir_count, config.output_path, link_status);
    }

    return make_compilation_result(true, 22, ir_count, config.output_path, 0);
}

// Unit Test 1: Verify default configuration generation
pub fn test_driver_default_config() -> bool {
    let cfg = make_default_config("input.ifa", "output.ll");
    if cfg.input_path != "input.ifa" || cfg.output_path != "output.ll" {
        return false;
    }
    if !cfg.emit_llvm || cfg.opt_level != 2 {
        return false;
    }
    if cfg.target_triple != "x86_64-unknown-linux-gnu" {
        return false;
    }
    return validate_compiler_config(cfg);
}

// Unit Test 2: Verify toolchain command string generation
pub fn test_driver_toolchain_command_builder() -> bool {
    let cmd = build_toolchain_command("clang", "module.o", "module.bin");
    let expected = "clang module.o -no-pie -Wl,--build-id=none -o module.bin";
    if cmd != expected {
        return false;
    }
    let asm_cmd = build_assembler_command("clang", "module.s", "module.o");
    return asm_cmd == "clang -c module.s -o module.o";
}

