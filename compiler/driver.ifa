        if ir[i] == "declare ptr @ifa_rt_cow_make_mut(ptr, i64, i64)" {
            has_cow_make_mut = true;
        }
        i = i + 1;
    }

    return has_gen_alloc && has_arena_create && has_arena_reset && has_panic_uaf && has_cow_make_mut;
}

