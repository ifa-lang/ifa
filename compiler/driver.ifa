// Pure IFA Self-Hosting Compiler - Driver & I/O Module (`compiler/driver.ifa`)
// Deterministic orchestration of compiler configuration, toolchain commands, and LLVM IR emission.

pub struct CompilerConfig {
    input_path: String,
    output_path: String,
    emit_llvm: bool,
    opt_level: i64,
    target_triple: String
}

pub struct CompilationResult {
    success: bool,
    tokens_count: i64,
    ir_lines_count: i64,
    output_file: String,
    status_code: i64
}

pub struct MultiFileModuleUnit {
    module_name: String,
    source_path: String,
    ir_lines: List<String>,
    symbols_exported: List<String>
}

pub struct MultiFileCompilationResult {
    success: bool,
    total_modules: i64,
    total_ir_lines: i64,
    output_artifact: String,
    status_code: i64
}

pub fn make_multi_file_module_unit(name: String, path: String) -> MultiFileModuleUnit {
    return MultiFileModuleUnit(
        module_name: name,
        source_path: path,
        ir_lines: List::new(),
        symbols_exported: List::new()
    );
}

pub fn make_default_config(input: String, output: String) -> CompilerConfig {
    return CompilerConfig(
        input_path: input,
        output_path: output,
        emit_llvm: true,
        opt_level: 2,
        target_triple: "x86_64-unknown-linux-gnu"
    );
}

pub fn validate_compiler_config(config: CompilerConfig) -> bool {
    if config.input_path == "" || config.output_path == "" {
        return false;
    }
    if config.opt_level < 0 || config.opt_level > 3 {
        return false;
    }
    if config.target_triple == "" {
        return false;
    }
    return true;
}

pub fn make_compilation_result(
    success: bool,
    tokens: i64,
    ir_lines: i64,
    out_file: String,
    code: i64
) -> CompilationResult {
    return CompilationResult(
        success: success,
        tokens_count: tokens,
        ir_lines_count: ir_lines,
        output_file: out_file,
        status_code: code
    );
}

pub fn build_toolchain_command(compiler_bin: String, input_obj: String, output_bin: String) -> String {
    let base_cmd = compiler_bin + " " + input_obj + " -no-pie -Wl,--build-id=none -o " + output_bin;
    return base_cmd;
}

pub fn build_assembler_command(assembler_bin: String, input_asm: String, output_obj: String) -> String {
    let base_cmd = assembler_bin + " -c " + input_asm + " -o " + output_obj;
    return base_cmd;
}

/// Returns LLVM optimization flag string corresponding to numeric opt_level
pub fn get_llvm_opt_flag(opt_level: i64) -> String {
    if opt_level == 0 { return "-O0"; }
    if opt_level == 1 { return "-O1"; }
    if opt_level == 3 { return "-O3"; }
    return "-O2";
}

/// Returns LLVM function attributes corresponding to optimization level (-O1, -O2, -O3)
pub fn get_llvm_function_attributes(opt_level: i64) -> String {
    if opt_level == 0 {
        return "attributes #0 = { noinline optnone \"target-cpu\"=\"generic\" }";
    }
    if opt_level == 1 {
        return "attributes #0 = { optsize nounwind \"target-cpu\"=\"generic\" }";
    }
    if opt_level == 3 {
        return "attributes #0 = { nounwind \"target-cpu\"=\"generic\" }";
    }
    return "attributes #0 = { nounwind \"target-cpu\"=\"generic\" }";
}

pub fn get_target_datalayout(target: String) -> String {
    if target == "aarch64-unknown-linux-gnu" || target == "arm64" {
        return "e-m:e-i8:8:32-i16:16:32-i64:64-i128:128-n32:64-S128";
    }
    if target == "aarch64-apple-darwin" {
        return "e-m:o-i64:64-i128:128-n32:64-S128";
    }
    if target == "x86_64-apple-darwin" {
        return "e-m:o-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128";
    }
    if target == "x86_64-pc-windows-msvc" || target == "x86_64-pc-windows-gnu" {
        return "e-m:w-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128";
    }
    if target == "aarch64-pc-windows-msvc" || target == "aarch64-pc-windows-gnu" {
        return "e-m:w-p:64:64-i32:32-i64:64-i128:128-n32:64-S128";
    }
    return "e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128";
}

pub fn emit_header_metadata(target: String, opt_level: i64) -> List<String> {
    mut meta: List<String> = List::new();
    meta.push("; ModuleID = 'ifac_selfhost'");
    meta.push("; IFA Pure Self-Hosting Deterministic Compiler Target");
    let dl = get_target_datalayout(target);
    meta.push("target datalayout = \"" + dl + "\"");
    meta.push("target triple = \"" + target + "\"");
    return meta;
}

/// Assembles a complete LLVM IR module incorporating optimization metadata and function attributes.
pub fn assemble_full_llvm_module_with_opt(
    func_lines: List<String>,
    target_triple: String,
    opt_level: i64
) -> List<String> {
    mut full_module: List<String> = List::new();
    full_module.push("; ModuleID = 'ifac_selfhost'");
    full_module.push("; IFA Pure Self-Hosting Deterministic Compiler Target");
    let opt_flag = get_llvm_opt_flag(opt_level);
    full_module.push("; Optimization: " + opt_flag);
    let dl = get_target_datalayout(target_triple);
    full_module.push("target datalayout = \"" + dl + "\"");
    full_module.push("target triple = \"" + target_triple + "\"");
    full_module.push("");
    full_module.push("; Standard IFA Runtime Declarations");
    full_module.push("declare void @ifa_rt_println(ptr)");
    full_module.push("declare void @ifa_rt_print(ptr)");
    full_module.push("declare void @ifa_rt_println_i64(i64)");
    full_module.push("declare void @ifa_rt_print_i64(i64)");
    full_module.push("declare ptr @ifa_rt_fs_read_to_string(ptr)");
    full_module.push("declare i1 @ifa_rt_fs_write_string(ptr, ptr)");
    full_module.push("declare i1 @ifa_rt_fs_exists(ptr)");
    full_module.push("declare i64 @ifa_rt_fs_file_size(ptr)");
    full_module.push("declare i64 @ifa_rt_process_exec(ptr, ptr)");
    full_module.push("declare ptr @ifa_rt_process_exec_output(ptr, ptr)");
    full_module.push("declare ptr @ifa_rt_process_exec_stderr(ptr, ptr)");
    full_module.push("declare i64 @ifa_rt_process_exec_with_stdin(ptr, ptr, ptr)");
    full_module.push("declare ptr @ifa_rt_process_find_linker()");
    full_module.push("declare ptr @ifa_rt_process_find_tool(ptr)");
    full_module.push("declare ptr @ifa_rt_env_var(ptr)");
    full_module.push("declare i64 @ifa_rt_args_count()");
    full_module.push("declare ptr @ifa_rt_args_get(i64)");
    full_module.push("");
    full_module.push("; IFA Fiber and Channel Concurrency Declarations");
    full_module.push("declare void @ifa_rt_fiber_yield()");
    full_module.push("declare i64 @ifa_rt_fiber_spawn(ptr, ptr)");
    full_module.push("declare void @ifa_rt_fiber_join(i64)");
    full_module.push("declare ptr @ifa_rt_channel_create(i64)");
    full_module.push("declare void @ifa_rt_channel_destroy(ptr)");
    full_module.push("declare i32 @ifa_rt_channel_send(ptr, ptr)");
    full_module.push("declare i32 @ifa_rt_channel_recv(ptr, ptr)");
    full_module.push("declare void @ifa_rt_channel_close(ptr)");
    full_module.push("declare i64 @ifa_rt_channel_select(ptr, i64, i32)");
    full_module.push("declare i64 @ifa_rt_channel_select_timed(ptr, ptr, i64, i64, i32)");
    full_module.push("declare i64 @ifa_rt_fiber_spawn_with_arena(ptr, ptr)");
    full_module.push("declare i32 @ifa_rt_arena_transfer_owner(i16, i64)");
    full_module.push("declare i32 @ifa_rt_arena_verify_owner(i16, i64)");
    full_module.push("");
    full_module.push("; IFA Generational Memory and CoW Runtime Declarations");
    full_module.push("declare ptr @ifa_rt_gen_alloc(i64, i64, i16)");
    full_module.push("declare i16 @ifa_rt_arena_create(i64)");
    full_module.push("declare void @ifa_rt_arena_reset(i16)");
    full_module.push("declare void @ifa_rt_arena_destroy(i16)");
    full_module.push("declare ptr @ifa_rt_arena_alloc(i16, i64, i64)");
    full_module.push("declare void @ifa_panic_uaf(ptr, i32, i32, i16)");
    full_module.push("declare ptr @ifa_rt_cow_make_mut(ptr, i64, i64)");
    full_module.push("");

    let fl_len = func_lines.len();
    if fl_len > 0 && fl_len < 10000 {
        mut i: i64 = 0;
        while i < fl_len {
            full_module.push(func_lines[i]);
            i = i + 1;
        }
    }

    full_module.push("");
    let attr_line = get_llvm_function_attributes(opt_level);
    full_module.push(attr_line);

    return full_module;
}

