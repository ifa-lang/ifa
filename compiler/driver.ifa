pub fn test_driver_linker_selection_and_process_bindings() -> bool {
    let linker = select_best_linker();
    if linker != "mold" && linker != "lld" && linker != "clang" && linker != "gcc" && linker != "ld" {
        return false;
    }
    let echo_status = process::exec("sh", "-c true");
    if echo_status != 0 {
