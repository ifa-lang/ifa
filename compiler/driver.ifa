// Pure IFA Self-Hosting Compiler - Driver & I/O Module (`compiler/driver.ifa`)
// Deterministic orchestration of compiler configuration, toolchain commands, and LLVM IR emission.

pub struct CompilerConfig {
    input_path: String,
    output_path: String,
    emit_llvm: bool,
    opt_level: i64,
    target_triple: String
}

pub struct CompilationResult {
    success: bool,
    tokens_count: i64,
    ir_lines_count: i64,
    output_file: String,
    status_code: i64
}

pub fn make_default_config(input: String, output: String) -> CompilerConfig {
    return CompilerConfig(
        input_path: input,
        output_path: output,
        emit_llvm: true,
        opt_level: 2,
        target_triple: "x86_64-unknown-linux-gnu"
    );
}

pub fn validate_compiler_config(config: CompilerConfig) -> bool {
    if config.input_path == "" || config.output_path == "" {
        return false;
    }
    if config.opt_level < 0 || config.opt_level > 3 {
        return false;
    }
    if config.target_triple == "" {
        return false;
    }
    return true;
}

pub fn make_compilation_result(
    success: bool,
    tokens: i64,
    ir_lines: i64,
    out_file: String,
    code: i64
) -> CompilationResult {
    return CompilationResult(
        success: success,
        tokens_count: tokens,
        ir_lines_count: ir_lines,
        output_file: out_file,
        status_code: code
    );
}

pub fn build_toolchain_command(compiler_bin: String, input_obj: String, output_bin: String) -> String {
    let base_cmd = compiler_bin + " " + input_obj + " -no-pie -fno-ident -Wl,--build-id=none -o " + output_bin;
    return base_cmd;
}

pub fn build_assembler_command(assembler_bin: String, input_asm: String, output_obj: String) -> String {
    let base_cmd = assembler_bin + " -c " + input_asm + " -o " + output_obj;
    return base_cmd;
}

pub fn emit_header_metadata(target: String, opt_level: i64) -> List<String> {
    mut meta: List<String> = List::new();
    meta.push("; ModuleID = 'ifac_selfhost'");
    meta.push("; IFA Pure Self-Hosting Deterministic Compiler Target");
    meta.push("target datalayout = \"e-m:e-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32:64-S128\"");
    meta.push("target triple = \"" + target + "\"");
    return meta;
}

pub fn assemble_full_llvm_module(func_lines: List<String>, target_triple: String) -> List<String> {
    mut full_module = emit_header_metadata(target_triple, 2);
    full_module.push("");
    full_module.push("; Standard IFA Runtime Declarations");
    full_module.push("declare void @ifa_rt_println(ptr)");
    full_module.push("declare void @ifa_rt_print(ptr)");
    full_module.push("declare void @ifa_rt_println_i64(i64)");
    full_module.push("declare void @ifa_rt_print_i64(i64)");
    full_module.push("declare ptr @ifa_rt_fs_read_to_string(ptr)");
    full_module.push("declare i1 @ifa_rt_fs_write_string(ptr, ptr)");
    full_module.push("declare i1 @ifa_rt_fs_exists(ptr)");
    full_module.push("declare i64 @ifa_rt_fs_file_size(ptr)");
    full_module.push("declare i64 @ifa_rt_process_exec(ptr, ptr)");
    full_module.push("declare ptr @ifa_rt_process_exec_output(ptr, ptr)");
    full_module.push("declare ptr @ifa_rt_env_var(ptr)");
    full_module.push("");

    mut i: i64 = 0;
    while i < func_lines.len() {
        full_module.push(func_lines[i]);
        i = i + 1;
    }

    return full_module;
}

// Unit Test 1: Verify default configuration generation
pub fn test_driver_default_config() -> bool {
    let cfg = make_default_config("input.ifa", "output.ll");
    if cfg.input_path != "input.ifa" || cfg.output_path != "output.ll" {
        return false;
    }
    if !cfg.emit_llvm || cfg.opt_level != 2 {
        return false;
    }
    if cfg.target_triple != "x86_64-unknown-linux-gnu" {
        return false;
    }
    return validate_compiler_config(cfg);
}

// Unit Test 2: Verify toolchain command string generation
pub fn test_driver_toolchain_command_builder() -> bool {
    let cmd = build_toolchain_command("clang", "module.o", "module.bin");
    let expected = "clang module.o -no-pie -fno-ident -Wl,--build-id=none -o module.bin";
    if cmd != expected {
        return false;
    }
    let asm_cmd = build_assembler_command("clang", "module.s", "module.o");
    return asm_cmd == "clang -c module.s -o module.o";
}

// Unit Test 3: Verify LLVM header metadata formatting
pub fn test_driver_metadata_emission() -> bool {
    let meta = emit_header_metadata("x86_64-unknown-linux-gnu", 2);
    if meta.len() != 4 {
        return false;
    }
    if meta[0] != "; ModuleID = 'ifac_selfhost'" {
        return false;
    }
    return meta[3] == "target triple = \"x86_64-unknown-linux-gnu\"";
}

// Unit Test 4: Verify full LLVM module assembly with runtime declarations
pub fn test_driver_full_module_assembly() -> bool {
    mut fn_lines: List<String> = List::new();
    fn_lines.push("define i64 @compute(i64 %x) {");
    fn_lines.push("entry:");
    fn_lines.push("  ret i64 42");
    fn_lines.push("}");

    let full_ir = assemble_full_llvm_module(fn_lines, "x86_64-unknown-linux-gnu");
    if full_ir.len() != 22 {
        return false;
    }
    if full_ir[6] != "declare void @ifa_rt_println(ptr)" {
        return false;
    }
    if full_ir[10] != "declare ptr @ifa_rt_fs_read_to_string(ptr)" {
        return false;
    }
    if full_ir[14] != "declare i64 @ifa_rt_process_exec(ptr, ptr)" {
        return false;
    }
    return full_ir[21] == "}";
}

// Unit Test 5: Verify driver compilation result structure
pub fn test_driver_compilation_result() -> bool {
    let res = make_compilation_result(true, 22, 22, "output.ll", 0);
    if !res.success {
        return false;
    }
    if res.status_code != 0 {
        return false;
    }
    if res.tokens_count != 22 {
        return false;
    }
    return res.ir_lines_count == 22;
}

pub fn main() {
    println("=== IFA Compiler Driver & I/O Module ===");
    let t1 = test_driver_default_config();
    let t2 = test_driver_toolchain_command_builder();
    let t3 = test_driver_metadata_emission();
    let t4 = test_driver_full_module_assembly();
    let t5 = test_driver_compilation_result();

    if t1 && t2 && t3 && t4 && t5 {
        println("Driver validation tests: ALL PASSED");
    } else {
        println("Driver validation tests: FAILED");
    }
}
