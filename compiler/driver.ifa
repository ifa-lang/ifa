    }
    if lines[2] != "; StageGeneration: 2" {
        return false;
    }
    if lines[6] != "; DeterministicBitForBit: true" {
        return false;
    }
    return lines[7] == "; ======================================================";
}

// Unit Test 20: Verify driver AST function summary and metadata extraction
pub fn test_driver_ast_function_summary() -> bool {
    let summary = summarize_driver_function("compute_payload", 3, 12, true);
    if summary.name != "compute_payload" {
        return false;
    }
    if summary.param_count != 3 || summary.statement_count != 12 {
