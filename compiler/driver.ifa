    mut i: i64 = 0;
    while i < ir.len() {
        if ir[i] == "declare ptr @ifa_rt_gen_alloc(i64, i64, i16)" {
            has_gen_alloc = true;
        }
        if ir[i] == "declare i16 @ifa_rt_arena_create(i64)" {
            has_arena_create = true;
        }
        if ir[i] == "declare void @ifa_rt_arena_reset(i16)" {
            has_arena_reset = true;
