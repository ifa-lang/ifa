// Pure IFA Standard Library: Tabular CSV Subsystem (`std/csv.ifa`)
// RFC 4180 compliant CSV and TSV parser, encoder, and structured table data representation.

pub struct CsvRow {
    fields: List<String>
}

pub struct CsvTable {
    headers: List<String>,
    rows: List<CsvRow>
}

// ---------------------------------------------------------------------------
// 1. CsvRow & CsvTable Constructors & Accessors
// ---------------------------------------------------------------------------

pub fn csv_row_new() -> CsvRow {
    return CsvRow(fields: List::new());
}

pub fn csv_row_add(inout row: CsvRow, field: String) {
    row.fields.push(field);
}

pub fn csv_row_get(row: CsvRow, idx: i64) -> String {
    if idx >= 0 && idx < row.fields.len() {
        return row.fields[idx];
    }
    return "";
}

pub fn csv_row_len(row: CsvRow) -> i64 {
    return row.fields.len();
}

pub fn csv_table_new(headers: List<String>) -> CsvTable {
    return CsvTable(
        headers: headers,
        rows: List::new()
    );
}

pub fn csv_table_add_row(inout table: CsvTable, row: CsvRow) {
    table.rows.push(row);
}

pub fn csv_table_row_count(table: CsvTable) -> i64 {
    return table.rows.len();
}

pub fn csv_table_col_count(table: CsvTable) -> i64 {
    return table.headers.len();
}

pub fn csv_table_find_col_index(table: CsvTable, col_name: String) -> i64 {
    mut i: i64 = 0;
    while i < table.headers.len() {
        if table.headers[i] == col_name {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn csv_table_get_value(table: CsvTable, row_idx: i64, col_name: String) -> String {
    let col_idx = csv_table_find_col_index(table, col_name);
    if col_idx < 0 {
        return "";
    }
    if row_idx >= 0 && row_idx < table.rows.len() {
        let row = table.rows[row_idx];
        return csv_row_get(row, col_idx);
    }
    return "";
}

// ---------------------------------------------------------------------------
// 2. RFC 4180 CSV Decoder
// ---------------------------------------------------------------------------

pub fn csv_decode(src: String, has_headers: bool, delimiter: String) -> CsvTable {
    let len = string_len(src);
    let delim_char = if string_len(delimiter) > 0 { string_char_at(delimiter, 0) } else { 44 };

    mut all_rows: List<CsvRow> = List::new();
    mut current_row: CsvRow = csv_row_new();
    mut current_field: String = "";
    mut inside_quotes: bool = false;
    mut idx: i64 = 0;

    while idx < len {
        let ch = string_char_at(src, idx);

        if inside_quotes {
            if ch == 34 { // Double quote `"`
                if idx + 1 < len && string_char_at(src, idx + 1) == 34 {
                    // Escaped double quote `""`
                    current_field = current_field + "\"";
                    idx = idx + 2;
                } else {
                    inside_quotes = false;
                    idx = idx + 1;
                }
            } else {
                current_field = current_field + string_substr(src, idx, 1);
                idx = idx + 1;
            }
        } else {
            if ch == 34 {
                inside_quotes = true;
                idx = idx + 1;
            } else if ch == delim_char {
                csv_row_add(inout current_row, current_field);
                current_field = "";
                idx = idx + 1;
            } else if ch == 10 || (ch == 13 && idx + 1 < len && string_char_at(src, idx + 1) == 10) {
                if ch == 13 {
                    idx = idx + 1; // skip '\r'
                }
                csv_row_add(inout current_row, current_field);
                current_field = "";
                all_rows.push(current_row);
                current_row = csv_row_new();
                idx = idx + 1;
            } else {
                current_field = current_field + string_substr(src, idx, 1);
                idx = idx + 1;
            }
        }
    }

    if string_len(current_field) > 0 || csv_row_len(current_row) > 0 {
        csv_row_add(inout current_row, current_field);
        all_rows.push(current_row);
    }

    if all_rows.len() == 0 {
        return csv_table_new(List::new());
    }

    if has_headers {
        let header_row = all_rows[0];
        mut table = csv_table_new(header_row.fields);
        mut r: i64 = 1;
        while r < all_rows.len() {
            csv_table_add_row(inout table, all_rows[r]);
            r = r + 1;
        }
        return table;
    } else {
        let first_row = all_rows[0];
        let col_count = csv_row_len(first_row);
        mut gen_headers: List<String> = List::new();
        mut c: i64 = 0;
        while c < col_count {
            gen_headers.push("col_" + if c == 0 { "0" } else if c == 1 { "1" } else if c == 2 { "2" } else { "3" });
            c = c + 1;
        }
        mut table = csv_table_new(gen_headers);
        mut r: i64 = 0;
        while r < all_rows.len() {
            csv_table_add_row(inout table, all_rows[r]);
            r = r + 1;
        }
        return table;
    }
}

// ---------------------------------------------------------------------------
// 3. RFC 4180 CSV Encoder
// ---------------------------------------------------------------------------

pub fn csv_escape_field(field: String, delimiter: String) -> String {
    let len = string_len(field);
    let delim_char = if string_len(delimiter) > 0 { string_char_at(delimiter, 0) } else { 44 };
    mut needs_quotes = false;
    mut i: i64 = 0;
    while i < len {
        let c = string_char_at(field, i);
        if c == delim_char || c == 34 || c == 10 || c == 13 {
            needs_quotes = true;
        }
        i = i + 1;
    }

    if !needs_quotes {
        return field;
    }

    mut out = "\"";
    i = 0;
    while i < len {
        let c = string_char_at(field, i);
        if c == 34 {
            out = out + "\"\"";
        } else {
            out = out + string_substr(field, i, 1);
        }
        i = i + 1;
    }
    out = out + "\"";
    return out;
}

pub fn csv_encode(table: CsvTable, delimiter: String) -> String {
    mut out = "";

    // 1. Headers
    if table.headers.len() > 0 {
        mut i: i64 = 0;
        while i < table.headers.len() {
            if i > 0 {
                out = out + delimiter;
            }
            out = out + csv_escape_field(table.headers[i], delimiter);
            i = i + 1;
        }
        out = out + "\n";
    }

    // 2. Rows
    mut r: i64 = 0;
    while r < table.rows.len() {
        let row = table.rows[r];
        mut c: i64 = 0;
        while c < row.fields.len() {
            if c > 0 {
                out = out + delimiter;
            }
            out = out + csv_escape_field(row.fields[c], delimiter);
            c = c + 1;
        }
        out = out + "\n";
        r = r + 1;
    }

    return out;
}

// ---------------------------------------------------------------------------
// 4. Unit Tests for CSV Subsystem
// ---------------------------------------------------------------------------

pub fn test_csv_rfc4180_quotes_and_commas() -> bool {
    let csv_src = "id,name,description\n1,Alice,\"Engineer, Systems\"\n2,Bob,\"Has \"\"quoted\"\" text\"\n";
    let table = csv_decode(csv_src, true, ",");

    let t1 = csv_table_row_count(table) == 2;
    let t2 = csv_table_col_count(table) == 3;
    let t3 = table.headers[0] == "id" && table.headers[1] == "name" && table.headers[2] == "description";
    let t4 = csv_table_get_value(table, 0, "name") == "Alice";
    let t5 = csv_table_get_value(table, 0, "description") == "Engineer, Systems";
    let t6 = csv_table_get_value(table, 1, "description") == "Has \"quoted\" text";

    return t1 && t2 && t3 && t4 && t5 && t6;
}

pub fn test_csv_table_access_by_header() -> bool {
    mut headers: List<String> = List::new();
    headers.push("sku");
    headers.push("qty");
    headers.push("price");

    mut table = csv_table_new(headers);

    mut r1 = csv_row_new();
    csv_row_add(inout r1, "PROD-100");
    csv_row_add(inout r1, "42");
    csv_row_add(inout r1, "19.99");
    csv_table_add_row(inout table, r1);

    mut r2 = csv_row_new();
    csv_row_add(inout r2, "PROD-200");
    csv_row_add(inout r2, "10");
    csv_row_add(inout r2, "49.50");
    csv_table_add_row(inout table, r2);

    let t1 = csv_table_row_count(table) == 2;
    let t2 = csv_table_get_value(table, 0, "sku") == "PROD-100";
    let t3 = csv_table_get_value(table, 0, "qty") == "42";
    let t4 = csv_table_get_value(table, 1, "price") == "49.50";
    let t5 = csv_table_get_value(table, 1, "invalid_col") == "";

    return t1 && t2 && t3 && t4 && t5;
}

pub fn test_csv_roundtrip_encode_decode() -> bool {
    let src = "code,city,note\nBEN,Cotonou,\"Capital, economic\"\nFRA,Paris,\"City of \"\"Light\"\"\"\n";
    let table = csv_decode(src, true, ",");
    let encoded = csv_encode(table, ",");
    let re_table = csv_decode(encoded, true, ",");

    let t1 = csv_table_row_count(re_table) == 2;
    let t2 = csv_table_get_value(re_table, 0, "city") == "Cotonou";
    let t3 = csv_table_get_value(re_table, 0, "note") == "Capital, economic";
    let t4 = csv_table_get_value(re_table, 1, "note") == "City of \"Light\"";

    return t1 && t2 && t3 && t4;
}

pub fn test_csv_custom_delimiter_tsv() -> bool {
    let tsv_src = "id\tval\tflag\n101\talpha\ttrue\n102\tbeta\tfalse\n";
    let table = csv_decode(tsv_src, true, "\t");

    let t1 = csv_table_row_count(table) == 2;
    let t2 = csv_table_col_count(table) == 3;
    let t3 = csv_table_get_value(table, 0, "val") == "alpha";
    let t4 = csv_table_get_value(table, 1, "flag") == "false";

    return t1 && t2 && t3 && t4;
}

pub fn test_csv_all() -> bool {
    return test_csv_rfc4180_quotes_and_commas()
        && test_csv_table_access_by_header()
        && test_csv_roundtrip_encode_decode()
        && test_csv_custom_delimiter_tsv();
}

pub fn main() {
    if test_csv_all() {
        println("std/csv: ALL TESTS PASSED");
    } else {
        println("std/csv: TESTS FAILED");
    }
}
