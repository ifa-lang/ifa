// Pure IFA Standard Library: Main Entrypoint (`std/main.ifa`)
// Root module aggregating crypto, fs, process, collections, net, time, and json autonomous subsystems.

import crypto;
import fs;
import process;
import collections;
import net;
import time;
import json;
import sync;

pub fn test_std_all() -> bool {
    let t_crypto = crypto::test_crypto_fnv1a()
        && crypto::test_crypto_murmur3()
        && crypto::test_crypto_sha256_empty()
        && crypto::test_crypto_sha256_abc()
        && crypto::test_crypto_constant_time_eq()
        && crypto::test_crypto_hmac()
        && crypto::test_crypto_blake3_empty()
        && crypto::test_crypto_blake3_abc()
        && crypto::test_crypto_blake3_ifa()
        && crypto::test_crypto_blake3_tree();

    let t_fs = fs::test_fs_path_join()
        && fs::test_fs_path_dirname()
        && fs::test_fs_path_basename()
        && fs::test_fs_path_extension()
        && fs::test_fs_path_stem()
        && fs::test_fs_path_normalize()
        && fs::test_fs_path_is_absolute()
        && fs::test_fs_io_roundtrip()
        && fs::test_fs_append_and_lines_io()
        && fs::test_fs_copy_and_dir_inspection()
        && fs::test_fs_walk_and_filter()
        && fs::test_fs_path_relative_and_extension()
        && fs::test_fs_rename_and_dir_removal();

    let t_process = process::test_process_find_linker()
        && process::test_process_find_tool()
        && process::test_process_build_linker_command()
        && process::test_process_build_assembler_command()
        && process::test_process_echo()
        && process::test_process_cwd();

    let t_collections = collections::test_collections_list()
        && collections::test_collections_map()
        && collections::test_collections_set()
        && collections::test_collections_byte_buffer()
        && collections::test_collections_string_builder()
        && collections::test_collections_ring_buffer()
        && collections::test_collections_int_map()
        && collections::test_collections_binary_heap()
        && collections::test_collections_deque();

    let t_net = net::test_net_all();

    let t_time = time::test_time_all();

    let t_json = json::test_json_all();

    let t_sync = sync::test_sync_all();

    return t_crypto && t_fs && t_process && t_collections && t_net && t_time && t_json && t_sync;
}

pub fn main() {
    if test_std_all() {
        println("std: ALL SUBSYSTEM TESTS PASSED");
    } else {
        println("std: SUBSYSTEM TESTS FAILED");
    }
}
