// Pure IFA Standard Library: JSON Parsing & Synthesis Subsystem (`std/json.ifa`)
// Deterministic recursive JSON parser, canonical serializer (RFC 8785), strict validator,
// deep equality, clone, pointer resolution (RFC 6901), and mutation helpers.

pub struct JsonValue {
    kind: i64, // 0: Null, 1: Bool, 2: Number, 3: String, 4: Array, 5: Object
    bool_val: bool,
    int_val: i64,
    str_val: String,
    arr_val: List<JsonValue>,
    obj_keys: List<String>,
    obj_vals: List<JsonValue>
}

pub struct JsonParseResult {
    is_ok: bool,
    val: JsonValue,
    error_msg: String,
    error_pos: i64
}

// ---------------------------------------------------------------------------
// 1. Constructors & Basic Helpers
// ---------------------------------------------------------------------------

pub fn json_null() -> JsonValue {
    return JsonValue(
        kind: 0,
        bool_val: false,
        int_val: 0,
        str_val: "",
        arr_val: List::new(),
        obj_keys: List::new(),
        obj_vals: List::new()
    );
}

pub fn json_bool(b: bool) -> JsonValue {
    return JsonValue(
        kind: 1,
        bool_val: b,
        int_val: 0,
        str_val: "",
        arr_val: List::new(),
        obj_keys: List::new(),
        obj_vals: List::new()
    );
}

pub fn json_int(n: i64) -> JsonValue {
    return JsonValue(
        kind: 2,
        bool_val: false,
        int_val: n,
        str_val: "",
        arr_val: List::new(),
        obj_keys: List::new(),
        obj_vals: List::new()
    );
}

pub fn json_string(s: String) -> JsonValue {
    return JsonValue(
        kind: 3,
        bool_val: false,
        int_val: 0,
        str_val: s,
        arr_val: List::new(),
        obj_keys: List::new(),
        obj_vals: List::new()
    );
}

pub fn json_array() -> JsonValue {
    return JsonValue(
        kind: 4,
        bool_val: false,
        int_val: 0,
        str_val: "",
        arr_val: List::new(),
        obj_keys: List::new(),
        obj_vals: List::new()
    );
}

pub fn json_object() -> JsonValue {
    return JsonValue(
        kind: 5,
        bool_val: false,
        int_val: 0,
        str_val: "",
        arr_val: List::new(),
        obj_keys: List::new(),
        obj_vals: List::new()
    );
}

pub fn json_result_ok(v: JsonValue) -> JsonParseResult {
    return JsonParseResult(
        is_ok: true,
        val: v,
        error_msg: "",
        error_pos: -1
    );
}

pub fn json_result_err(msg: String, pos: i64) -> JsonParseResult {
    return JsonParseResult(
        is_ok: false,
        val: json_null(),
        error_msg: msg,
        error_pos: pos
    );
}

pub fn json_is_null(v: JsonValue) -> bool {
    return v.kind == 0;
}

pub fn json_is_bool(v: JsonValue) -> bool {
    return v.kind == 1;
}

pub fn json_is_number(v: JsonValue) -> bool {
    return v.kind == 2;
}

pub fn json_is_string(v: JsonValue) -> bool {
    return v.kind == 3;
}

pub fn json_is_array(v: JsonValue) -> bool {
    return v.kind == 4;
}

pub fn json_is_object(v: JsonValue) -> bool {
    return v.kind == 5;
}

pub fn json_get_bool(v: JsonValue) -> bool {
    return v.bool_val;
}

pub fn json_get_int(v: JsonValue) -> i64 {
    return v.int_val;
}

pub fn json_get_string(v: JsonValue) -> String {
    return v.str_val;
}

// ---------------------------------------------------------------------------
// 2. Array Operations
// ---------------------------------------------------------------------------

pub fn json_array_push(inout arr: JsonValue, item: JsonValue) {
    if arr.kind == 4 {
        arr.arr_val.push(item);
    }
}

pub fn json_array_len(arr: JsonValue) -> i64 {
    if arr.kind == 4 {
        return arr.arr_val.len();
    }
    return 0;
}

pub fn json_array_get(arr: JsonValue, idx: i64) -> JsonValue {
    if arr.kind == 4 && idx >= 0 && idx < arr.arr_val.len() {
        return arr.arr_val[idx];
    }
    return json_null();
}

pub fn json_array_set(inout arr: JsonValue, idx: i64, val: JsonValue) -> bool {
    if arr.kind == 4 && idx >= 0 && idx < arr.arr_val.len() {
        arr.arr_val[idx] = val;
        return true;
    }
    return false;
}

pub fn json_is_int(v: JsonValue) -> bool {
    return v.kind == 2;
}

pub fn json_array_pop(inout arr: JsonValue) -> JsonValue {
    if arr.kind != 4 || arr.arr_val.len() == 0 {
        return json_null();
    }
    let last_idx = arr.arr_val.len() - 1;
    let item = arr.arr_val[last_idx];
    mut new_arr: List<JsonValue> = List::new();
    mut i: i64 = 0;
    while i < last_idx {
        new_arr.push(arr.arr_val[i]);
        i = i + 1;
    }
    arr.arr_val = new_arr;
    return item;
}

pub fn json_array_insert(inout arr: JsonValue, idx: i64, val: JsonValue) -> bool {
    if arr.kind != 4 || idx < 0 || idx > arr.arr_val.len() {
        return false;
    }
    mut new_arr: List<JsonValue> = List::new();
    mut i: i64 = 0;
    let count = arr.arr_val.len();
    while i < count {
        if i == idx {
            new_arr.push(json_clone(val));
        }
        new_arr.push(arr.arr_val[i]);
        i = i + 1;
    }
    if idx == count {
        new_arr.push(json_clone(val));
    }
    arr.arr_val = new_arr;
    return true;
}

pub fn json_array_remove(inout arr: JsonValue, idx: i64) -> bool {
    if arr.kind != 4 || idx < 0 || idx >= arr.arr_val.len() {
        return false;
    }
    mut new_arr: List<JsonValue> = List::new();
    mut i: i64 = 0;
    let count = arr.arr_val.len();
    while i < count {
        if i != idx {
            new_arr.push(arr.arr_val[i]);
        }
        i = i + 1;
    }
    arr.arr_val = new_arr;
    return true;
}

pub fn json_array_concat(inout arr: JsonValue, other: JsonValue) -> bool {
    if arr.kind != 4 || other.kind != 4 {
        return false;
    }
    mut i: i64 = 0;
    let count = other.arr_val.len();
    while i < count {
        arr.arr_val.push(json_clone(other.arr_val[i]));
        i = i + 1;
    }
    return true;
}

pub fn json_array_filter_by_kind(arr: JsonValue, target_kind: i64) -> JsonValue {
    mut res = json_array();
    if arr.kind != 4 {
        return res;
    }
    mut i: i64 = 0;
    let count = arr.arr_val.len();
    while i < count {
        let item = arr.arr_val[i];
        if item.kind == target_kind {
            json_array_push(res, json_clone(item));
        }
        i = i + 1;
    }
    return res;
}

pub fn json_array_map_keys(arr: JsonValue, key: String) -> JsonValue {
    mut res = json_array();
    if arr.kind != 4 {
        return res;
    }
    mut i: i64 = 0;
    let count = arr.arr_val.len();
    while i < count {
        let item = arr.arr_val[i];
        if item.kind == 5 && json_object_has(item, key) {
            json_array_push(res, json_object_get(item, key));
        }
        i = i + 1;
    }
    return res;
}

// ---------------------------------------------------------------------------
// 3. Object Operations & Safe Getters
// ---------------------------------------------------------------------------

pub fn json_object_set(inout obj: JsonValue, key: String, val: JsonValue) {
    if obj.kind != 5 {
        return;
    }
    mut i: i64 = 0;
    while i < obj.obj_keys.len() {
        if obj.obj_keys[i] == key {
            obj.obj_vals[i] = val;
            return;
        }
        i = i + 1;
    }
    obj.obj_keys.push(key);
    obj.obj_vals.push(val);
}

pub fn json_object_get(obj: JsonValue, key: String) -> JsonValue {
    if obj.kind != 5 {
        return json_null();
    }
    mut i: i64 = 0;
    while i < obj.obj_keys.len() {
        if obj.obj_keys[i] == key {
            return obj.obj_vals[i];
        }
        i = i + 1;
    }
    return json_null();
}

pub fn json_object_has(obj: JsonValue, key: String) -> bool {
    if obj.kind != 5 {
        return false;
    }
    mut i: i64 = 0;
    while i < obj.obj_keys.len() {
        if obj.obj_keys[i] == key {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn json_object_remove(inout obj: JsonValue, key: String) -> bool {
    if obj.kind != 5 {
        return false;
    }
    mut found_idx: i64 = -1;
    mut i: i64 = 0;
    let count = obj.obj_keys.len();
    while i < count {
        if obj.obj_keys[i] == key {
            found_idx = i;
            break;
        }
        i = i + 1;
    }
    if found_idx == -1 {
        return false;
    }
    mut new_keys: List<String> = List::new();
    mut new_vals: List<JsonValue> = List::new();
    mut j: i64 = 0;
    while j < count {
        if j != found_idx {
            new_keys.push(obj.obj_keys[j]);
            new_vals.push(obj.obj_vals[j]);
        }
        j = j + 1;
    }
    obj.obj_keys = new_keys;
    obj.obj_vals = new_vals;
    return true;
}

pub fn json_object_len(obj: JsonValue) -> i64 {
    if obj.kind == 5 {
        return obj.obj_keys.len();
    }
    return 0;
}

pub fn json_object_key_at(obj: JsonValue, idx: i64) -> String {
    if obj.kind == 5 && idx >= 0 && idx < obj.obj_keys.len() {
        return obj.obj_keys[idx];
    }
    return "";
}

pub fn json_object_val_at(obj: JsonValue, idx: i64) -> JsonValue {
    if obj.kind == 5 && idx >= 0 && idx < obj.obj_vals.len() {
        return obj.obj_vals[idx];
    }
    return json_null();
}

pub fn json_get_string_or(obj: JsonValue, key: String, default_val: String) -> String {
    if obj.kind == 5 && json_object_has(obj, key) {
        let v = json_object_get(obj, key);
        if v.kind == 3 {
            return v.str_val;
        }
    }
    return default_val;
}

pub fn json_get_int_or(obj: JsonValue, key: String, default_val: i64) -> i64 {
    if obj.kind == 5 && json_object_has(obj, key) {
        let v = json_object_get(obj, key);
        if v.kind == 2 {
            return v.int_val;
        }
    }
    return default_val;
}

pub fn json_get_bool_or(obj: JsonValue, key: String, default_val: bool) -> bool {
    if obj.kind == 5 && json_object_has(obj, key) {
        let v = json_object_get(obj, key);
        if v.kind == 1 {
            return v.bool_val;
        }
    }
    return default_val;
}

pub fn json_get_object(obj: JsonValue, key: String) -> JsonValue {
    if obj.kind == 5 && json_object_has(obj, key) {
        let v = json_object_get(obj, key);
        if v.kind == 5 {
            return v;
        }
    }
    return json_null();
}

pub fn json_get_array(obj: JsonValue, key: String) -> JsonValue {
    if obj.kind == 5 && json_object_has(obj, key) {
        let v = json_object_get(obj, key);
        if v.kind == 4 {
            return v;
        }
    }
    return json_null();
}

// ---------------------------------------------------------------------------
// 4. String Escaping, Ordering & Serialization (Standard, Pretty & Canonical)
// ---------------------------------------------------------------------------

pub fn json_string_cmp(s1: String, s2: String) -> i64 {
    let len1 = string_len(s1);
    let len2 = string_len(s2);
    mut min_len: i64 = len1;
    if len2 < min_len {
        min_len = len2;
    }
    mut i: i64 = 0;
    while i < min_len {
        let c1 = string_char_at(s1, i);
        let c2 = string_char_at(s2, i);
        if c1 < c2 {
            return -1;
        }
        if c1 > c2 {
            return 1;
        }
        i = i + 1;
    }
    if len1 < len2 {
        return -1;
    }
    if len1 > len2 {
        return 1;
    }
    return 0;
}

pub fn int_to_digit(d: i64) -> String {
    if d == 0 { return "0"; }
    if d == 1 { return "1"; }
    if d == 2 { return "2"; }
    if d == 3 { return "3"; }
    if d == 4 { return "4"; }
    if d == 5 { return "5"; }
    if d == 6 { return "6"; }
    if d == 7 { return "7"; }
    if d == 8 { return "8"; }
    if d == 9 { return "9"; }
    return "0";
}

pub fn int_to_str(mut n: i64) -> String {
    if n == 0 {
        return "0";
    }
    mut is_neg = false;
    if n < 0 {
        is_neg = true;
        n = 0 - n;
    }
    mut digits = "";
    while n > 0 {
        let rem = n % 10;
        let d = int_to_digit(rem);
        digits = d + digits;
        n = n / 10;
    }
    if is_neg {
        return "-" + digits;
    }
    return digits;
}

pub fn json_escape_string(s: String) -> String {
    let len = string_len(s);
    mut out: String = "";
    mut i: i64 = 0;
    while i < len {
        let c = string_char_at(s, i);
        if c == 34 { // '"'
            out = out + "\\\"";
        } else if c == 92 { // '\'
            out = out + "\\\\";
        } else if c == 10 { // '\n'
            out = out + "\\n";
        } else if c == 9 { // '\t'
            out = out + "\\t";
        } else if c == 13 { // '\r'
            out = out + "\\r";
        } else {
            out = out + string_substr(s, i, 1);
        }
        i = i + 1;
    }
    return out;
}

pub fn json_stringify(v: JsonValue) -> String {
    if v.kind == 0 {
        return "null";
    }
    if v.kind == 1 {
        if v.bool_val {
            return "true";
        }
        return "false";
    }
    if v.kind == 2 {
        return int_to_str(v.int_val);
    }
    if v.kind == 3 {
        return "\"" + json_escape_string(v.str_val) + "\"";
    }
    if v.kind == 4 {
        mut out: String = "[";
        mut i: i64 = 0;
        let count = v.arr_val.len();
        while i < count {
            out = out + json_stringify(v.arr_val[i]);
            if i + 1 < count {
                out = out + ",";
            }
            i = i + 1;
        }
        return out + "]";
    }
    if v.kind == 5 {
        mut out: String = "{";
        mut i: i64 = 0;
        let count = v.obj_keys.len();
        while i < count {
            out = out + "\"" + json_escape_string(v.obj_keys[i]) + "\":" + json_stringify(v.obj_vals[i]);
            if i + 1 < count {
                out = out + ",";
            }
            i = i + 1;
        }
        return out + "}";
    }
    return "null";
}

pub fn json_sort_indices(keys: List<String>) -> List<i64> {
    let count = keys.len();
    mut indices: List<i64> = List::new();
    mut idx: i64 = 0;
    while idx < count {
        indices.push(idx);
        idx = idx + 1;
    }
    mut i: i64 = 0;
    while i < count {
        mut min_idx: i64 = i;
        mut j: i64 = i + 1;
        while j < count {
            let key_j = keys[indices[j]];
            let key_min = keys[indices[min_idx]];
            if json_string_cmp(key_j, key_min) < 0 {
                min_idx = j;
            }
            j = j + 1;
        }
        let tmp = indices[i];
        indices[i] = indices[min_idx];
        indices[min_idx] = tmp;
        i = i + 1;
    }
    return indices;
}

/// RFC 8785 Canonical JSON Serialization (JCS).
/// Deterministically sorts all object keys in lexicographical order,
/// emits zero whitespace around tokens, and handles values uniformly.
pub fn json_stringify_canonical(v: JsonValue) -> String {
    if v.kind == 0 {
        return "null";
    }
    if v.kind == 1 {
        if v.bool_val {
            return "true";
        }
        return "false";
    }
    if v.kind == 2 {
        return int_to_str(v.int_val);
    }
    if v.kind == 3 {
        return "\"" + json_escape_string(v.str_val) + "\"";
    }
    if v.kind == 4 {
        mut out: String = "[";
        mut i: i64 = 0;
        let count = v.arr_val.len();
        while i < count {
            out = out + json_stringify_canonical(v.arr_val[i]);
            if i + 1 < count {
                out = out + ",";
            }
            i = i + 1;
        }
        return out + "]";
    }
    if v.kind == 5 {
        let count = v.obj_keys.len();
        if count == 0 {
            return "{}";
        }
        let indices = json_sort_indices(v.obj_keys);
        mut out: String = "{";
        mut k: i64 = 0;
        while k < count {
            let target_idx = indices[k];
            out = out + "\"" + json_escape_string(v.obj_keys[target_idx]) + "\":" + json_stringify_canonical(v.obj_vals[target_idx]);
            if k + 1 < count {
                out = out + ",";
            }
            k = k + 1;
        }
        return out + "}";
    }
    return "null";
}

pub fn json_make_indent(level: i64) -> String {
    mut s: String = "";
    mut i: i64 = 0;
    while i < level {
        s = s + "  ";
        i = i + 1;
    }
    return s;
}

pub fn json_stringify_pretty_rec(v: JsonValue, indent_level: i64) -> String {
    if v.kind != 4 && v.kind != 5 {
        return json_stringify(v);
    }
    let cur_indent = json_make_indent(indent_level);
    let next_indent = json_make_indent(indent_level + 1);

    if v.kind == 4 {
        let count = v.arr_val.len();
        if count == 0 {
            return "[]";
        }
        mut out: String = "[\n";
        mut i: i64 = 0;
        while i < count {
            out = out + next_indent + json_stringify_pretty_rec(v.arr_val[i], indent_level + 1);
            if i + 1 < count {
                out = out + ",\n";
            } else {
                out = out + "\n";
            }
            i = i + 1;
        }
        return out + cur_indent + "]";
    }

    if v.kind == 5 {
        let count = v.obj_keys.len();
        if count == 0 {
            return "{}";
        }
        mut out: String = "{\n";
        mut i: i64 = 0;
        while i < count {
            out = out + next_indent + "\"" + json_escape_string(v.obj_keys[i]) + "\": " + json_stringify_pretty_rec(v.obj_vals[i], indent_level + 1);
            if i + 1 < count {
                out = out + ",\n";
            } else {
                out = out + "\n";
            }
            i = i + 1;
        }
        return out + cur_indent + "}";
    }
    return "null";
}

pub fn json_stringify_pretty(v: JsonValue) -> String {
    return json_stringify_pretty_rec(v, 0);
}

// ---------------------------------------------------------------------------
// 5. Deep Operations: Equality, Clone, and Merge
// ---------------------------------------------------------------------------

pub fn json_deep_eq(a: JsonValue, b: JsonValue) -> bool {
    if a.kind != b.kind {
        return false;
    }
    if a.kind == 0 {
        return true;
    }
    if a.kind == 1 {
        return a.bool_val == b.bool_val;
    }
    if a.kind == 2 {
        return a.int_val == b.int_val;
    }
    if a.kind == 3 {
        return a.str_val == b.str_val;
    }
    if a.kind == 4 {
        let len_a = a.arr_val.len();
        let len_b = b.arr_val.len();
        if len_a != len_b {
            return false;
        }
        mut i: i64 = 0;
        while i < len_a {
            if !json_deep_eq(a.arr_val[i], b.arr_val[i]) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    if a.kind == 5 {
        let count_a = a.obj_keys.len();
        let count_b = b.obj_keys.len();
        if count_a != count_b {
            return false;
        }
        mut i: i64 = 0;
        while i < count_a {
            let key = a.obj_keys[i];
            if !json_object_has(b, key) {
                return false;
            }
            let val_a = a.obj_vals[i];
            let val_b = json_object_get(b, key);
            if !json_deep_eq(val_a, val_b) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }
    return false;
}

pub fn json_clone(v: JsonValue) -> JsonValue {
    if v.kind == 0 {
        return json_null();
    }
    if v.kind == 1 {
        return json_bool(v.bool_val);
    }
    if v.kind == 2 {
        return json_int(v.int_val);
    }
    if v.kind == 3 {
        return json_string(v.str_val);
    }
    if v.kind == 4 {
        mut new_arr = json_array();
        mut i: i64 = 0;
        let count = v.arr_val.len();
        while i < count {
            json_array_push(new_arr, json_clone(v.arr_val[i]));
            i = i + 1;
        }
        return new_arr;
    }
    if v.kind == 5 {
        mut new_obj = json_object();
        mut i: i64 = 0;
        let count = v.obj_keys.len();
        while i < count {
            json_object_set(new_obj, v.obj_keys[i], json_clone(v.obj_vals[i]));
            i = i + 1;
        }
        return new_obj;
    }
    return json_null();
}

pub fn json_merge(inout target: JsonValue, source: JsonValue) {
    if target.kind != 5 || source.kind != 5 {
        return;
    }
    mut i: i64 = 0;
    let count = source.obj_keys.len();
    while i < count {
        json_object_set(target, source.obj_keys[i], json_clone(source.obj_vals[i]));
        i = i + 1;
    }
}

pub fn json_deep_merge(inout target: JsonValue, source: JsonValue) {
    if target.kind != 5 || source.kind != 5 {
        target = json_clone(source);
        return;
    }
    mut i: i64 = 0;
    let count = source.obj_keys.len();
    while i < count {
        let key = source.obj_keys[i];
        let src_val = source.obj_vals[i];
        if json_object_has(target, key) {
            mut tgt_val = json_object_get(target, key);
            if tgt_val.kind == 5 && src_val.kind == 5 {
                json_deep_merge(tgt_val, src_val);
                json_object_set(target, key, tgt_val);
            } else {
                json_object_set(target, key, json_clone(src_val));
            }
        } else {
            json_object_set(target, key, json_clone(src_val));
        }
        i = i + 1;
    }
}

pub fn json_flatten_into(inout out_obj: JsonValue, prefix: String, val: JsonValue) {
    if val.kind == 5 {
        mut i: i64 = 0;
        let count = val.obj_keys.len();
        while i < count {
            let k = val.obj_keys[i];
            let v = val.obj_vals[i];
            mut next_key = k;
            if prefix.len() > 0 {
                next_key = prefix + "." + k;
            }
            json_flatten_into(out_obj, next_key, v);
            i = i + 1;
        }
    } else if val.kind == 4 {
        mut j: i64 = 0;
        let count = val.arr_val.len();
        while j < count {
            let elem = val.arr_val[j];
            mut next_key = int_to_str(j);
            if prefix.len() > 0 {
                next_key = prefix + "." + int_to_str(j);
            }
            json_flatten_into(out_obj, next_key, elem);
            j = j + 1;
        }
    } else {
        if prefix.len() > 0 {
            json_object_set(out_obj, prefix, json_clone(val));
        }
    }
}

pub fn json_flatten(val: JsonValue, prefix: String) -> JsonValue {
    mut out_obj = json_object();
    json_flatten_into(out_obj, prefix, val);
    return out_obj;
}

// ---------------------------------------------------------------------------
// 6. JSON Pointer (RFC 6901)
// ---------------------------------------------------------------------------

pub fn json_parse_number_simple(s: String) -> i64 {
    let len = string_len(s);
    if len == 0 {
        return -1;
    }
    mut i: i64 = 0;
    mut val: i64 = 0;
    while i < len {
        let c = string_char_at(s, i);
        if c < 48 || c > 57 {
            return -1;
        }
        val = val * 10 + (c - 48);
        i = i + 1;
    }
    return val;
}

pub fn json_pointer_get(root: JsonValue, pointer: String) -> JsonValue {
    let len = string_len(pointer);
    if len == 0 {
        return root;
    }
    if string_char_at(pointer, 0) != 47 { // must start with '/'
        return json_null();
    }
    mut current = root;
    mut pos: i64 = 1;
    while pos <= len {
        mut next_slash: i64 = pos;
        while next_slash < len && string_char_at(pointer, next_slash) != 47 {
            next_slash = next_slash + 1;
        }
        let raw_token = string_substr(pointer, pos, next_slash - pos);
        pos = next_slash + 1;

        // Decode ~1 -> / and ~0 -> ~
        mut token: String = "";
        let token_len = string_len(raw_token);
        mut t_idx: i64 = 0;
        while t_idx < token_len {
            let c = string_char_at(raw_token, t_idx);
            if c == 126 && t_idx + 1 < token_len {
                let c_next = string_char_at(raw_token, t_idx + 1);
                if c_next == 49 { // '1' -> '/'
                    token = token + "/";
                    t_idx = t_idx + 2;
                } else if c_next == 48 { // '0' -> '~'
                    token = token + "~";
                    t_idx = t_idx + 2;
                } else {
                    token = token + string_substr(raw_token, t_idx, 1);
                    t_idx = t_idx + 1;
                }
            } else {
                token = token + string_substr(raw_token, t_idx, 1);
                t_idx = t_idx + 1;
            }
        }

        if current.kind == 5 {
            if !json_object_has(current, token) {
                return json_null();
            }
            current = json_object_get(current, token);
        } else if current.kind == 4 {
            let idx = json_parse_number_simple(token);
            if idx < 0 || idx >= current.arr_val.len() {
                return json_null();
            }
            current = current.arr_val[idx];
        } else {
            return json_null();
        }
    }
    return current;
}

pub fn json_pointer_has(root: JsonValue, pointer: String) -> bool {
    let len = string_len(pointer);
    if len == 0 {
        return true;
    }
    if string_char_at(pointer, 0) != 47 {
        return false;
    }
    mut current = root;
    mut pos: i64 = 1;
    while pos <= len {
        mut next_slash: i64 = pos;
        while next_slash < len && string_char_at(pointer, next_slash) != 47 {
            next_slash = next_slash + 1;
        }
        let raw_token = string_substr(pointer, pos, next_slash - pos);
        pos = next_slash + 1;

        mut token: String = "";
        let token_len = string_len(raw_token);
        mut t_idx: i64 = 0;
        while t_idx < token_len {
            let c = string_char_at(raw_token, t_idx);
            if c == 126 && t_idx + 1 < token_len {
                let c_next = string_char_at(raw_token, t_idx + 1);
                if c_next == 49 {
                    token = token + "/";
                    t_idx = t_idx + 2;
                } else if c_next == 48 {
                    token = token + "~";
                    t_idx = t_idx + 2;
                } else {
                    token = token + string_substr(raw_token, t_idx, 1);
                    t_idx = t_idx + 1;
                }
            } else {
                token = token + string_substr(raw_token, t_idx, 1);
                t_idx = t_idx + 1;
            }
        }

        if current.kind == 5 {
            if !json_object_has(current, token) {
                return false;
            }
            current = json_object_get(current, token);
        } else if current.kind == 4 {
            let idx = json_parse_number_simple(token);
            if idx < 0 || idx >= current.arr_val.len() {
                return false;
            }
            current = current.arr_val[idx];
        } else {
            return false;
        }
    }
    return true;
}

// ---------------------------------------------------------------------------
// 7. Strict Recursive JSON Parser
// ---------------------------------------------------------------------------

pub fn json_skip_whitespace(s: String, inout pos: i64, len: i64) {
    while pos < len {
        let c = string_char_at(s, pos);
        if c == 32 || c == 9 || c == 10 || c == 13 { // ' ', '\t', '\n', '\r'
            pos = pos + 1;
        } else {
            return;
        }
    }
}

pub fn json_parse_string(s: String, inout pos: i64, len: i64) -> String {
    pos = pos + 1; // skip leading '"'
    mut out: String = "";
    while pos < len {
        let c = string_char_at(s, pos);
        if c == 34 { // closing '"'
            pos = pos + 1;
            return out;
        }
        if c == 92 { // '\'
            pos = pos + 1;
            if pos < len {
                let esc = string_char_at(s, pos);
                if esc == 34 { out = out + "\""; }
                else if esc == 92 { out = out + "\\"; }
                else if esc == 110 { out = out + "\n"; }
                else if esc == 116 { out = out + "\t"; }
                else if esc == 114 { out = out + "\r"; }
                else { out = out + string_substr(s, pos, 1); }
                pos = pos + 1;
            }
        } else {
            out = out + string_substr(s, pos, 1);
            pos = pos + 1;
        }
    }
    return out;
}

pub fn json_parse_number(s: String, inout pos: i64, len: i64) -> i64 {
    mut sign: i64 = 1;
    if pos < len && string_char_at(s, pos) == 45 { // '-'
        sign = -1;
        pos = pos + 1;
    }
    mut val: i64 = 0;
    while pos < len {
        let c = string_char_at(s, pos);
        if c >= 48 && c <= 57 {
            val = val * 10 + (c - 48);
            pos = pos + 1;
        } else {
            return sign * val;
        }
    }
    return sign * val;
}

pub fn json_parse_strict_string(s: String, inout pos: i64, len: i64) -> JsonParseResult {
    if pos >= len || string_char_at(s, pos) != 34 {
        return json_result_err("Expected opening double quote for string", pos);
    }
    pos = pos + 1;
    mut out: String = "";
    mut closed: bool = false;
    while pos < len {
        let c = string_char_at(s, pos);
        if c == 34 {
            pos = pos + 1;
            closed = true;
            break;
        }
        if c == 92 { // '\\'
            pos = pos + 1;
            if pos >= len {
                return json_result_err("Unterminated escape sequence in string", pos);
            }
            let esc = string_char_at(s, pos);
            if esc == 34 { out = out + "\""; }
            else if esc == 92 { out = out + "\\"; }
            else if esc == 110 { out = out + "\n"; }
            else if esc == 116 { out = out + "\t"; }
            else if esc == 114 { out = out + "\r"; }
            else if esc == 47 { out = out + "/"; }
            else { return json_result_err("Invalid escape character in string", pos); }
            pos = pos + 1;
        } else {
            if c < 32 {
                return json_result_err("Unescaped control character in string", pos);
            }
            out = out + string_substr(s, pos, 1);
            pos = pos + 1;
        }
    }
    if !closed {
        return json_result_err("Unterminated string literal", pos);
    }
    return json_result_ok(json_string(out));
}

pub fn json_parse_strict_number(s: String, inout pos: i64, len: i64) -> JsonParseResult {
    let start_pos = pos;
    mut sign: i64 = 1;
    if pos < len && string_char_at(s, pos) == 45 {
        sign = -1;
        pos = pos + 1;
    }
    if pos >= len || string_char_at(s, pos) < 48 || string_char_at(s, pos) > 57 {
        return json_result_err("Expected digit after minus sign", pos);
    }
    mut val: i64 = 0;
    while pos < len {
        let c = string_char_at(s, pos);
        if c >= 48 && c <= 57 {
            val = val * 10 + (c - 48);
            pos = pos + 1;
        } else {
            break;
        }
    }
    return json_result_ok(json_int(sign * val));
}

pub fn json_parse_strict_array(s: String, inout pos: i64, len: i64) -> JsonParseResult {
    let start_pos = pos;
    pos = pos + 1; // skip '['
    mut arr = json_array();
    json_skip_whitespace(s, pos, len);
    if pos < len && string_char_at(s, pos) == 93 { // ']'
        pos = pos + 1;
        return json_result_ok(arr);
    }
    while pos < len {
        let elem_res = json_parse_strict_value(s, pos, len);
        if !elem_res.is_ok {
            return elem_res;
        }
        json_array_push(arr, elem_res.val);
        json_skip_whitespace(s, pos, len);
        if pos >= len {
            return json_result_err("Unterminated array, expected ',' or ']'", pos);
        }
        let sep = string_char_at(s, pos);
        if sep == 44 { // ','
            pos = pos + 1;
            json_skip_whitespace(s, pos, len);
            if pos < len && string_char_at(s, pos) == 93 {
                return json_result_err("Trailing comma in array is forbidden in strict JSON", pos);
            }
        } else if sep == 93 { // ']'
            pos = pos + 1;
            return json_result_ok(arr);
        } else {
            return json_result_err("Expected ',' or ']' in array", pos);
        }
    }
    return json_result_err("Unterminated array at EOF", start_pos);
}

pub fn json_parse_strict_object(s: String, inout pos: i64, len: i64) -> JsonParseResult {
    let start_pos = pos;
    pos = pos + 1; // skip '{'
    mut obj = json_object();
    json_skip_whitespace(s, pos, len);
    if pos < len && string_char_at(s, pos) == 125 { // '}'
        pos = pos + 1;
        return json_result_ok(obj);
    }
    while pos < len {
        json_skip_whitespace(s, pos, len);
        if pos >= len || string_char_at(s, pos) != 34 {
            return json_result_err("Expected string key in object", pos);
        }
        let key_res = json_parse_strict_string(s, pos, len);
        if !key_res.is_ok {
            return key_res;
        }
        let key = key_res.val.str_val;
        json_skip_whitespace(s, pos, len);
        if pos >= len || string_char_at(s, pos) != 58 { // ':'
            return json_result_err("Expected ':' after object key", pos);
        }
        pos = pos + 1; // skip ':'
        let val_res = json_parse_strict_value(s, pos, len);
        if !val_res.is_ok {
            return val_res;
        }
        json_object_set(obj, key, val_res.val);
        json_skip_whitespace(s, pos, len);
        if pos >= len {
            return json_result_err("Unterminated object, expected ',' or '}'", pos);
        }
        let sep = string_char_at(s, pos);
        if sep == 44 { // ','
            pos = pos + 1;
            json_skip_whitespace(s, pos, len);
            if pos < len && string_char_at(s, pos) == 125 {
                return json_result_err("Trailing comma in object is forbidden in strict JSON", pos);
            }
        } else if sep == 125 { // '}'
            pos = pos + 1;
            return json_result_ok(obj);
        } else {
            return json_result_err("Expected ',' or '}' in object", pos);
        }
    }
    return json_result_err("Unterminated object at EOF", start_pos);
}

pub fn json_parse_strict_value(s: String, inout pos: i64, len: i64) -> JsonParseResult {
    json_skip_whitespace(s, pos, len);
    if pos >= len {
        return json_result_err("Unexpected end of JSON input", pos);
    }
    let c = string_char_at(s, pos);

    // 1. null
    if c == 110 {
        if pos + 4 <= len && string_substr(s, pos, 4) == "null" {
            pos = pos + 4;
            return json_result_ok(json_null());
        }
        return json_result_err("Expected literal 'null'", pos);
    }

    // 2. true
    if c == 116 {
        if pos + 4 <= len && string_substr(s, pos, 4) == "true" {
            pos = pos + 4;
            return json_result_ok(json_bool(true));
        }
        return json_result_err("Expected literal 'true'", pos);
    }

    // 3. false
    if c == 102 {
        if pos + 5 <= len && string_substr(s, pos, 5) == "false" {
            pos = pos + 5;
            return json_result_ok(json_bool(false));
        }
        return json_result_err("Expected literal 'false'", pos);
    }

    // 4. String
    if c == 34 {
        return json_parse_strict_string(s, pos, len);
    }

    // 5. Number
    if c == 45 || (c >= 48 && c <= 57) {
        return json_parse_strict_number(s, pos, len);
    }

    // 6. Array
    if c == 91 {
        return json_parse_strict_array(s, pos, len);
    }

    // 7. Object
    if c == 123 {
        return json_parse_strict_object(s, pos, len);
    }

    return json_result_err("Unexpected character in JSON input", pos);
}

pub fn json_parse_strict(s: String) -> JsonParseResult {
    let len = string_len(s);
    mut pos: i64 = 0;
    let res = json_parse_strict_value(s, pos, len);
    if !res.is_ok {
        return res;
    }
    json_skip_whitespace(s, pos, len);
    if pos < len {
        return json_result_err("Unexpected trailing content after JSON root value", pos);
    }
    return res;
}

pub fn json_parse_value(s: String, inout pos: i64, len: i64) -> JsonValue {
    let res = json_parse_strict_value(s, pos, len);
    if res.is_ok {
        return res.val;
    }
    return json_null();
}

pub fn json_parse(s: String) -> JsonValue {
    let res = json_parse_strict(s);
    if res.is_ok {
        return res.val;
    }
    return json_null();
}

// ---------------------------------------------------------------------------
// 8. Unit Tests for JSON Subsystem
// ---------------------------------------------------------------------------

pub fn test_json_primitives() -> bool {
    let j_null = json_parse("null");
    let j_true = json_parse("true");
    let j_false = json_parse("false");
    let j_pos = json_parse("12345");
    let j_neg = json_parse("-42");
    let j_str = json_parse("\"hello IFA\"");

    let t1 = json_is_null(j_null) && json_stringify(j_null) == "null";
    let t2 = json_is_bool(j_true) && json_get_bool(j_true) && json_stringify(j_true) == "true";
    let t3 = json_is_bool(j_false) && !json_get_bool(j_false) && json_stringify(j_false) == "false";
    let t4 = json_is_number(j_pos) && json_get_int(j_pos) == 12345 && json_stringify(j_pos) == "12345";
    let t5 = json_is_number(j_neg) && json_get_int(j_neg) == -42 && json_stringify(j_neg) == "-42";
    let t6 = json_is_string(j_str) && json_get_string(j_str) == "hello IFA" && json_stringify(j_str) == "\"hello IFA\"";

    return t1 && t2 && t3 && t4 && t5 && t6;
}

pub fn test_json_arrays() -> bool {
    let raw = "[1, 2, 3, \"test\", false]";
    let parsed = json_parse(raw);

    let t1 = json_is_array(parsed) && json_array_len(parsed) == 5;
    let t2 = json_get_int(json_array_get(parsed, 0)) == 1;
    let t3 = json_get_int(json_array_get(parsed, 1)) == 2;
    let t4 = json_get_int(json_array_get(parsed, 2)) == 3;
    let t5 = json_get_string(json_array_get(parsed, 3)) == "test";
    let t6 = json_get_bool(json_array_get(parsed, 4)) == false;

    mut arr = json_array();
    json_array_push(arr, json_int(100));
    json_array_push(arr, json_int(200));
    let t7 = json_stringify(arr) == "[100,200]";

    return t1 && t2 && t3 && t4 && t5 && t6 && t7;
}

pub fn test_json_objects() -> bool {
    let raw = "{\"name\": \"IFA\", \"version\": 1, \"active\": true}";
    let parsed = json_parse(raw);

    let t1 = json_is_object(parsed) && json_object_len(parsed) == 3;
    let t2 = json_object_has(parsed, "name") && json_get_string(json_object_get(parsed, "name")) == "IFA";
    let t3 = json_object_has(parsed, "version") && json_get_int(json_object_get(parsed, "version")) == 1;
    let t4 = json_object_has(parsed, "active") && json_get_bool(json_object_get(parsed, "active")) == true;
    let t5 = !json_object_has(parsed, "missing");

    mut obj = json_object();
    json_object_set(obj, "alpha", json_int(10));
    json_object_set(obj, "beta", json_string("val"));
    let str_obj = json_stringify(obj);
    let t6 = str_obj == "{\"alpha\":10,\"beta\":\"val\"}";

    return t1 && t2 && t3 && t4 && t5 && t6;
}

pub fn test_json_escaped_strings() -> bool {
    let raw = "\"line 1\\nline 2\\tquoted \\\"word\\\"\"";
    let parsed = json_parse(raw);
    let s = json_get_string(parsed);
    let expected = "line 1\nline 2\tquoted \"word\"";
    let t1 = s == expected;

    let reserialized = json_stringify(parsed);
    let t2 = reserialized == raw;

    return t1 && t2;
}

pub fn test_json_nested_structure() -> bool {
    let raw = "{\"package\": {\"name\": \"compiler\", \"deps\": [\"std\", \"core\"]}, \"status\": 200}";
    let parsed = json_parse(raw);

    let t1 = json_is_object(parsed);
    let status_val = json_get_int(json_object_get(parsed, "status"));
    let t2 = status_val == 200;

    let pkg_val = json_object_get(parsed, "package");
    let t3 = json_is_object(pkg_val);
    let pkg_name = json_get_string(json_object_get(pkg_val, "name"));
    let t4 = pkg_name == "compiler";

    let deps_arr = json_object_get(pkg_val, "deps");
    let t5 = json_is_array(deps_arr) && json_array_len(deps_arr) == 2;
    let dep0 = json_get_string(json_array_get(deps_arr, 0));
    let dep1 = json_get_string(json_array_get(deps_arr, 1));
    let t6 = dep0 == "std" && dep1 == "core";

    return t1 && t2 && t3 && t4 && t5 && t6;
}

pub fn test_json_pretty_formatting() -> bool {
    mut obj = json_object();
    json_object_set(obj, "id", json_int(42));
    mut arr = json_array();
    json_array_push(arr, json_string("one"));
    json_array_push(arr, json_string("two"));
    json_object_set(obj, "items", arr);

    let pretty = json_stringify_pretty(obj);
    let expected = "{\n  \"id\": 42,\n  \"items\": [\n    \"one\",\n    \"two\"\n  ]\n}";
    return pretty == expected;
}

pub fn test_json_canonical_serialization() -> bool {
    // Construct objects with unordered keys
    mut obj1 = json_object();
    json_object_set(obj1, "zebra", json_int(100));
    json_object_set(obj1, "alpha", json_string("first"));
    json_object_set(obj1, "middle", json_bool(true));

    mut obj2 = json_object();
    json_object_set(obj2, "alpha", json_string("first"));
    json_object_set(obj2, "middle", json_bool(true));
    json_object_set(obj2, "zebra", json_int(100));

    let canon1 = json_stringify_canonical(obj1);
    let canon2 = json_stringify_canonical(obj2);

    let expected = "{\"alpha\":\"first\",\"middle\":true,\"zebra\":100}";
    let t1 = canon1 == expected;
    let t2 = canon1 == canon2;

    return t1 && t2;
}

pub fn test_json_strict_parser() -> bool {
    // Valid JSON
    let r1 = json_parse_strict("{\"status\": 200, \"active\": true}");
    let t1 = r1.is_ok && json_get_int(json_object_get(r1.val, "status")) == 200;

    // Trailing garbage rejected
    let r2 = json_parse_strict("{\"status\": 200} trailing");
    let t2 = !r2.is_ok;

    // Trailing comma in array rejected
    let r3 = json_parse_strict("[1, 2, 3,]");
    let t3 = !r3.is_ok;

    // Trailing comma in object rejected
    let r4 = json_parse_strict("{\"a\": 1,}");
    let t4 = !r4.is_ok;

    // Unterminated string rejected
    let r5 = json_parse_strict("\"unterminated");
    let t5 = !r5.is_ok;

    // Unmatched closing bracket rejected
    let r6 = json_parse_strict("[1, 2, 3");
    let t6 = !r6.is_ok;

    return t1 && t2 && t3 && t4 && t5 && t6;
}

pub fn test_json_pointer() -> bool {
    let raw = "{\"package\": {\"name\": \"compiler\", \"deps\": [\"std\", \"core\"], \"author\": {\"name\": \"Prudence\"} } }";
    let doc = json_parse(raw);

    let p_root = json_pointer_get(doc, "");
    let t1 = json_is_object(p_root);

    let p_name = json_pointer_get(doc, "/package/name");
    let t2 = json_is_string(p_name) && json_get_string(p_name) == "compiler";

    let p_dep0 = json_pointer_get(doc, "/package/deps/0");
    let t3 = json_is_string(p_dep0) && json_get_string(p_dep0) == "std";

    let p_dep1 = json_pointer_get(doc, "/package/deps/1");
    let t4 = json_is_string(p_dep1) && json_get_string(p_dep1) == "core";

    let p_author = json_pointer_get(doc, "/package/author/name");
    let t5 = json_is_string(p_author) && json_get_string(p_author) == "Prudence";

    let has_author = json_pointer_has(doc, "/package/author/name");
    let has_missing = json_pointer_has(doc, "/package/missing/key");
    let t6 = has_author && !has_missing;

    return t1 && t2 && t3 && t4 && t5 && t6;
}

pub fn test_json_deep_eq_and_clone() -> bool {
    let raw = "{\"id\": 42, \"tags\": [\"ifa\", \"lang\"], \"meta\": {\"ver\": 1} }";
    let doc1 = json_parse(raw);
    let doc2 = json_clone(doc1);

    let t1 = json_deep_eq(doc1, doc2);

    // Mutate doc2, verify doc1 remains unchanged
    mut doc2_mut = doc2;
    json_object_set(doc2_mut, "id", json_int(99));
    let t2 = !json_deep_eq(doc1, doc2_mut);
    let t3 = json_get_int(json_object_get(doc1, "id")) == 42;

    return t1 && t2 && t3;
}

pub fn test_json_merge_and_remove() -> bool {
    mut base = json_object();
    json_object_set(base, "k1", json_string("v1"));
    json_object_set(base, "k2", json_int(2));

    mut extension = json_object();
    json_object_set(extension, "k2", json_int(200));
    json_object_set(extension, "k3", json_bool(true));

    json_merge(base, extension);

    let t1 = json_get_int(json_object_get(base, "k2")) == 200;
    let t2 = json_get_bool(json_object_get(base, "k3")) == true;
    let t3 = json_get_string(json_object_get(base, "k1")) == "v1";

    let removed = json_object_remove(base, "k2");
    let t4 = removed && !json_object_has(base, "k2");

    let fallback_str = json_get_string_or(base, "missing", "default_val");
    let fallback_int = json_get_int_or(base, "missing", 999);
    let fallback_bool = json_get_bool_or(base, "missing", true);
    let t5 = fallback_str == "default_val" && fallback_int == 999 && fallback_bool == true;

    return t1 && t2 && t3 && t4 && t5;
}

pub fn test_json_heterogeneous_arrays() -> bool {
    mut arr = json_array();
    json_array_push(arr, json_int(100));
    json_array_push(arr, json_string("test"));
    json_array_push(arr, json_bool(true));
    json_array_push(arr, json_null());

    mut obj_item = json_object();
    json_object_set(obj_item, "sub_id", json_int(777));
    json_array_push(arr, obj_item);

    let t1 = json_array_len(arr) == 5;
    let t2 = json_is_int(json_array_get(arr, 0)) && json_get_int(json_array_get(arr, 0)) == 100;
    let t3 = json_is_string(json_array_get(arr, 1)) && json_get_string(json_array_get(arr, 1)) == "test";
    let t4 = json_is_bool(json_array_get(arr, 2)) && json_get_bool(json_array_get(arr, 2)) == true;
    let t5 = json_is_null(json_array_get(arr, 3));
    let t6 = json_is_object(json_array_get(arr, 4));

    // Array pop
    let popped = json_array_pop(arr);
    let t7 = popped.kind == 5 && json_array_len(arr) == 4;

    // Array insert
    let ins = json_array_insert(arr, 1, json_string("inserted"));
    let t8 = ins && json_array_len(arr) == 5 && json_get_string(json_array_get(arr, 1)) == "inserted";

    // Array remove
    let rem = json_array_remove(arr, 1);
    let t9 = rem && json_array_len(arr) == 4 && json_get_string(json_array_get(arr, 1)) == "test";

    // Filter by kind (e.g. integers)
    let ints_only = json_array_filter_by_kind(arr, 2);
    let t10 = json_array_len(ints_only) == 1 && json_get_int(json_array_get(ints_only, 0)) == 100;

    return t1 && t2 && t3 && t4 && t5 && t6 && t7 && t8 && t9 && t10;
}

pub fn test_json_deep_merge_and_flatten() -> bool {
    let raw_base = "{\"server\":{\"host\":\"127.0.0.1\",\"port\":8080},\"mode\":\"debug\"}";
    let raw_ext = "{\"server\":{\"port\":9000,\"tls\":true},\"active\":true}";

    mut doc_base = json_parse(raw_base);
    let doc_ext = json_parse(raw_ext);

    json_deep_merge(doc_base, doc_ext);

    let server_sub = json_get_object(doc_base, "server");
    let t1 = json_get_string(json_object_get(server_sub, "host")) == "127.0.0.1";
    let t2 = json_get_int(json_object_get(server_sub, "port")) == 9000;
    let t3 = json_get_bool(json_object_get(server_sub, "tls")) == true;
    let t4 = json_get_string(json_object_get(doc_base, "mode")) == "debug";
    let t5 = json_get_bool(json_object_get(doc_base, "active")) == true;

    // Flatten
    let flat = json_flatten(doc_base, "");
    let t6 = json_get_string(json_object_get(flat, "server.host")) == "127.0.0.1";
    let t7 = json_get_int(json_object_get(flat, "server.port")) == 9000;
    let t8 = json_get_bool(json_object_get(flat, "server.tls")) == true;
    let t9 = json_get_string(json_object_get(flat, "mode")) == "debug";
    let t10 = json_get_bool(json_object_get(flat, "active")) == true;

    return t1 && t2 && t3 && t4 && t5 && t6 && t7 && t8 && t9 && t10;
}

pub fn test_json_all() -> bool {
    let t1 = test_json_primitives();
    let t2 = test_json_arrays();
    let t3 = test_json_objects();
    let t4 = test_json_escaped_strings();
    let t5 = test_json_nested_structure();
    let t6 = test_json_pretty_formatting();
    let t7 = test_json_canonical_serialization();
    let t8 = test_json_strict_parser();
    let t9 = test_json_pointer();
    let t10 = test_json_deep_eq_and_clone();
    let t11 = test_json_merge_and_remove();
    let t12 = test_json_heterogeneous_arrays();
    let t13 = test_json_deep_merge_and_flatten();
    return t1 && t2 && t3 && t4 && t5 && t6 && t7 && t8 && t9 && t10 && t11 && t12 && t13;
}

pub fn main() {
    if test_json_all() {
        println("std/json: ALL TESTS PASSED");
    } else {
        println("std/json: TESTS FAILED");
    }
}
