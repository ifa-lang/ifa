    && test_net_http_client_server_roundtrip()
    && test_net_http_status_helpers()
    && test_net_http_put_and_delete()
    && test_net_udp_roundtrip()
    && test_net_http_router_and_query_params()
    && test_net_http_headers_and_status_categories()
    && test_net_http_patch_and_head()
    && test_net_http_chunked_streaming()
    && test_net_websocket_framing_and_roundtrip()
    && test_net_tcp_server_multiple_clients()
    && test_net_websocket_server_multiplexing()
    && test_net_crc32_and_adler32()
    && test_net_deflate_compression_roundtrip()
    && test_net_gzip_compression_roundtrip()
    && test_net_http_secure_client_token_negotiation()
    && test_net_url_percent_encoding_roundtrip()
    && test_net_http_cookies_and_session()
    && test_net_multipart_form_data()
    && test_net_http_sse_streaming_and_content_negotiation()
    && test_net_http_auth_cors_and_etag()
    && test_net_http_router_dynamic_params_and_websocket_handshake()
    && test_net_websocket_frame_demux_and_fragmentation()
    && test_net_rate_limiting_and_mime_resolver()
    && test_net_http_reverse_proxy_gateway_and_load_balancer()
    && test_net_http_connection_pooling_and_keep_alive()
    && test_net_http_circuit_breaker()
    && test_net_http_retry_policy()
    && test_net_http_auto_compression();
}

