// Pure IFA Standard Library: Colorless Network & Socket Subsystem (`std/net.ifa`)
// Non-blocking TCP sockets, event-driven streaming, and fiber-cooperative I/O.

pub struct TcpListener {
    fd: i64,
    port: i64,
    is_open: bool
}

pub struct TcpStream {
    fd: i64,
    is_open: bool
}

pub struct HttpRequest {
    method: String,
    path: String,
    version: String,
    body: String
}

pub struct HttpResponse {
    status_code: i64,
    status_text: String,
    content_type: String,
    body: String
}

pub struct Url {
    scheme: String,
    host: String,
    port: i64,
    path: String,
    query: String
}

pub fn make_url(scheme: String, host: String, port: i64, path: String, query: String) -> Url {
    return Url(
        scheme: scheme,
        host: host,
        port: port,
        path: path,
        query: query
    );
}

// Low-Level Syscall Wrappers
pub fn net_tcp_listen(port: i64) -> i64 {
    return tcp_listen(port);
}

pub fn net_tcp_listener_port(listener_fd: i64) -> i64 {
    return tcp_listener_port(listener_fd);
}

pub fn net_tcp_accept(listener_fd: i64) -> i64 {
    return tcp_accept(listener_fd);
}

pub fn net_tcp_connect(host: String, port: i64) -> i64 {
    return tcp_connect(host, port);
}

pub fn net_tcp_write(stream_fd: i64, data: String) -> i64 {
    return tcp_write(stream_fd, data);
}

pub fn net_tcp_read(stream_fd: i64, max_len: i64) -> String {
    return tcp_read(stream_fd, max_len);
}

pub fn net_tcp_close(handle_fd: i64) -> bool {
    return tcp_close(handle_fd);
}

pub fn net_sleep_ms(millis: i64) {
    sleep_ms(millis);
}

// High-Level Structured TCP Abstractions
pub fn make_tcp_listener(port: i64) -> TcpListener {
    let fd = net_tcp_listen(port);
    mut actual_port: i64 = port;
    if fd > 0 {
        let p = net_tcp_listener_port(fd);
        if p > 0 {
            actual_port = p;
        }
    }
    return TcpListener(
        fd: fd,
        port: actual_port,
        is_open: fd > 0
    );
}

pub fn listener_accept(listener: TcpListener) -> TcpStream {
    if !listener.is_open {
        return TcpStream(fd: -1, is_open: false);
    }
    let stream_fd = net_tcp_accept(listener.fd);
    return TcpStream(
        fd: stream_fd,
        is_open: stream_fd > 0
    );
}

pub fn listener_close(inout listener: TcpListener) {
    if listener.is_open {
        net_tcp_close(listener.fd);
        listener.is_open = false;
    }
}

pub fn make_tcp_connect(host: String, port: i64) -> TcpStream {
    let fd = net_tcp_connect(host, port);
    return TcpStream(
        fd: fd,
        is_open: fd > 0
    );
}

pub fn stream_write(stream: TcpStream, data: String) -> i64 {
    if !stream.is_open {
        return -1;
    }
    return net_tcp_write(stream.fd, data);
}

pub fn stream_read(stream: TcpStream, max_len: i64) -> String {
    if !stream.is_open {
        return "";
    }
    return net_tcp_read(stream.fd, max_len);
}

pub fn stream_close(inout stream: TcpStream) {
    if stream.is_open {
        net_tcp_close(stream.fd);
        stream.is_open = false;
    }
}

// HTTP 1.1 Wire Framing Helpers
pub fn make_http_response(status_code: i64, status_text: String, content_type: String, body: String) -> HttpResponse {
    return HttpResponse(
        status_code: status_code,
        status_text: status_text,
        content_type: content_type,
        body: body
    );
}

pub fn parse_http_request(raw: String) -> HttpRequest {
    let len = string_len(raw);
    if len == 0 {
        return HttpRequest(method: "", path: "", version: "", body: "");
    }

    mut sp1: i64 = -1;
    mut sp2: i64 = -1;
    mut crlf: i64 = -1;
    mut i: i64 = 0;

    while i < len {
        let c = string_char_at(raw, i);
        if c == 32 { // ' '
            if sp1 < 0 {
                sp1 = i;
            } else if sp2 < 0 {
                sp2 = i;
            }
        } else if c == 10 { // '\n'
            if crlf < 0 {
                crlf = i;
                i = len; // break
            }
        }
        i = i + 1;
    }

    mut method: String = "GET";
    mut path: String = "/";
    mut version: String = "HTTP/1.1";

    if sp1 > 0 {
        method = string_substr(raw, 0, sp1);
        if sp2 > sp1 {
            path = string_substr(raw, sp1 + 1, sp2 - sp1 - 1);
            if crlf > sp2 {
                let end_ver = if string_char_at(raw, crlf - 1) == 13 { crlf - 1 } else { crlf };
                version = string_substr(raw, sp2 + 1, end_ver - sp2 - 1);
            }
        }
    }

    // Extract body after \r\n\r\n or \n\n
    mut body_start: i64 = -1;
    i = 0;
    while i + 3 < len {
        let c0 = string_char_at(raw, i);
        let c1 = string_char_at(raw, i + 1);
        let c2 = string_char_at(raw, i + 2);
        let c3 = string_char_at(raw, i + 3);
        if c0 == 13 && c1 == 10 && c2 == 13 && c3 == 10 {
            body_start = i + 4;
            i = len;
        } else {
            i = i + 1;
        }
    }

    mut body: String = "";
    if body_start >= 0 && body_start < len {
        body = string_substr(raw, body_start, len - body_start);
    }

    return HttpRequest(
        method: method,
        path: path,
        version: version,
        body: body
    );
}

pub fn int_to_string(n: i64) -> String {
    if n == 0 {
        return "0";
    }
    mut val = if n < 0 { -n } else { n };
    mut s: String = "";
    while val > 0 {
        let digit = val % 10;
        let char_code = 48 + digit;
        // string_char_at equivalent in reverse
        if digit == 0 { s = "0" + s; }
        else if digit == 1 { s = "1" + s; }
        else if digit == 2 { s = "2" + s; }
        else if digit == 3 { s = "3" + s; }
        else if digit == 4 { s = "4" + s; }
        else if digit == 5 { s = "5" + s; }
        else if digit == 6 { s = "6" + s; }
        else if digit == 7 { s = "7" + s; }
        else if digit == 8 { s = "8" + s; }
        else if digit == 9 { s = "9" + s; }
        val = val / 10;
    }
    if n < 0 {
        s = "-" + s;
    }
    return s;
}

pub fn format_http_response(resp: HttpResponse) -> String {
    let body_len = string_len(resp.body);
    let len_str = int_to_string(body_len);
    let code_str = int_to_string(resp.status_code);

    mut res: String = "HTTP/1.1 " + code_str + " " + resp.status_text + "\r\n";
    res = res + "Content-Type: " + resp.content_type + "\r\n";
    res = res + "Content-Length: " + len_str + "\r\n";
    res = res + "Connection: close\r\n";
    res = res + "\r\n";
    res = res + resp.body;
    return res;
}

pub fn string_contains(s: String, sub: String) -> bool {
    let s_len = string_len(s);
    let sub_len = string_len(sub);
    if sub_len == 0 {
        return true;
    }
    if s_len < sub_len {
        return false;
    }
    mut i: i64 = 0;
    while i <= s_len - sub_len {
        mut match_all = true;
        mut j: i64 = 0;
        while j < sub_len {
            if string_char_at(s, i + j) != string_char_at(sub, j) {
                match_all = false;
                j = sub_len; // break
            }
            j = j + 1;
        }
        if match_all {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn parse_url(raw: String) -> Url {
    let len = string_len(raw);
    if len == 0 {
        return Url(scheme: "http", host: "127.0.0.1", port: 80, path: "/", query: "");
    }

    mut scheme = "http";
    mut cursor: i64 = 0;

    // Check for scheme "://"
    mut p: i64 = 0;
    while p + 2 < len {
        if string_char_at(raw, p) == 58 && string_char_at(raw, p + 1) == 47 && string_char_at(raw, p + 2) == 47 { // "://"
            scheme = string_substr(raw, 0, p);
            cursor = p + 3;
            p = len; // break
        }
        p = p + 1;
    }

    // Host & port end at '/' or '?' or end of string
    mut host_end = len;
    mut path_start: i64 = -1;
    mut q_start: i64 = -1;

    mut i = cursor;
    while i < len {
        let c = string_char_at(raw, i);
        if c == 47 { // '/'
            if host_end == len {
                host_end = i;
                path_start = i;
            }
        } else if c == 63 { // '?'
            if host_end == len {
                host_end = i;
            }
            if q_start < 0 {
                q_start = i;
            }
        }
        i = i + 1;
    }

    let host_port = string_substr(raw, cursor, host_end - cursor);
    mut host = host_port;
    mut port: i64 = if scheme == "https" { 443 } else { 80 };

    // Check if host_port has ':'
    mut colon_idx: i64 = -1;
    mut j: i64 = 0;
    let hp_len = string_len(host_port);
    while j < hp_len {
        if string_char_at(host_port, j) == 58 { // ':'
            colon_idx = j;
            j = hp_len; // break
        }
        j = j + 1;
    }

    if colon_idx >= 0 {
        host = string_substr(host_port, 0, colon_idx);
        let port_str = string_substr(host_port, colon_idx + 1, hp_len - colon_idx - 1);
        let parsed_port = string_to_int(port_str);
        if parsed_port > 0 {
            port = parsed_port;
        }
    }

    mut path = "/";
    mut query = "";

    if path_start >= 0 {
        if q_start >= 0 {
            path = string_substr(raw, path_start, q_start - path_start);
            query = string_substr(raw, q_start + 1, len - q_start - 1);
        } else {
            path = string_substr(raw, path_start, len - path_start);
        }
    } else if q_start >= 0 {
        path = "/";
        query = string_substr(raw, q_start + 1, len - q_start - 1);
    }

    return Url(
        scheme: scheme,
        host: host,
        port: port,
        path: path,
        query: query
    );
}

pub fn format_url(url: Url) -> String {
    mut s = url.scheme + "://" + url.host;
    if (url.scheme == "http" && url.port != 80) || (url.scheme == "https" && url.port != 443) {
        s = s + ":" + int_to_string(url.port);
    }
    s = s + url.path;
    if string_len(url.query) > 0 {
        s = s + "?" + url.query;
    }
    return s;
}

pub fn format_http_request(req: HttpRequest, host: String) -> String {
    let body_len = string_len(req.body);
    let len_str = int_to_string(body_len);
    mut out: String = req.method + " " + req.path + " " + req.version + "\r\n";
    out = out + "Host: " + host + "\r\n";
    if body_len > 0 {
        out = out + "Content-Length: " + len_str + "\r\n";
        out = out + "Content-Type: application/json\r\n";
    }
    out = out + "Connection: close\r\n\r\n";
    if body_len > 0 {
        out = out + req.body;
    }
    return out;
}

pub fn parse_http_response(raw: String) -> HttpResponse {
    let len = string_len(raw);
    if len == 0 {
        return HttpResponse(status_code: 500, status_text: "Empty Response", content_type: "", body: "");
    }

    mut sp1: i64 = -1;
    mut sp2: i64 = -1;
    mut status_line_end: i64 = -1;
    mut i: i64 = 0;

    while i < len {
        let c = string_char_at(raw, i);
        if c == 32 { // ' '
            if sp1 < 0 {
                sp1 = i;
            } else if sp2 < 0 {
                sp2 = i;
            }
        } else if c == 10 { // '\n'
            if status_line_end < 0 {
                status_line_end = i;
                i = len; // break
            }
        }
        i = i + 1;
    }

    mut status_code: i64 = 200;
    mut status_text = "OK";
    if sp1 > 0 && sp2 > sp1 {
        let code_str = string_substr(raw, sp1 + 1, sp2 - sp1 - 1);
        status_code = string_to_int(code_str);
        let mut text_end = status_line_end;
        if text_end > 0 && string_char_at(raw, text_end - 1) == 13 { // '\r'
            text_end = text_end - 1;
        }
        if text_end > sp2 {
            status_text = string_substr(raw, sp2 + 1, text_end - sp2 - 1);
        }
    }

    // Find double CRLF or LF LF for body start
    mut body_start = len;
    mut k: i64 = status_line_end;
    while k + 3 < len {
        if string_char_at(raw, k) == 13 && string_char_at(raw, k + 1) == 10 && string_char_at(raw, k + 2) == 13 && string_char_at(raw, k + 3) == 10 {
            body_start = k + 4;
            k = len; // break
        } else if string_char_at(raw, k) == 10 && string_char_at(raw, k + 1) == 10 {
            body_start = k + 2;
            k = len; // break
        }
        k = k + 1;
    }

    mut body = "";
    if body_start < len {
        body = string_substr(raw, body_start, len - body_start);
    }

    mut content_type = "text/plain";
    if string_contains(raw, "application/json") {
        content_type = "application/json";
    }

    return HttpResponse(
        status_code: status_code,
        status_text: status_text,
        content_type: content_type,
        body: body
    );
}

pub fn http_get(host: String, port: i64, path: String) -> HttpResponse {
    mut stream = make_tcp_connect(host, port);
    if !stream.is_open {
        return HttpResponse(status_code: 503, status_text: "Service Unavailable", content_type: "text/plain", body: "Connection failed");
    }

    let req = HttpRequest(method: "GET", path: path, version: "HTTP/1.1", body: "");
    let wire = format_http_request(req, host);
    stream_write(stream, wire);
    let resp_str = stream_read(stream, 65536);
    stream_close(stream);
    return parse_http_response(resp_str);
}

pub fn http_post_json(host: String, port: i64, path: String, json_body: String) -> HttpResponse {
    mut stream = make_tcp_connect(host, port);
    if !stream.is_open {
        return HttpResponse(status_code: 503, status_text: "Service Unavailable", content_type: "text/plain", body: "Connection failed");
    }

    let req = HttpRequest(method: "POST", path: path, version: "HTTP/1.1", body: json_body);
    let wire = format_http_request(req, host);
    stream_write(stream, wire);
    let resp_str = stream_read(stream, 65536);
    stream_close(stream);
    return parse_http_response(resp_str);
}

pub fn http_status_text(code: i64) -> String {
    if code == 200 { return "OK"; }
    if code == 201 { return "Created"; }
    if code == 202 { return "Accepted"; }
    if code == 204 { return "No Content"; }
    if code == 301 { return "Moved Permanently"; }
    if code == 302 { return "Found"; }
    if code == 400 { return "Bad Request"; }
    if code == 401 { return "Unauthorized"; }
    if code == 403 { return "Forbidden"; }
    if code == 404 { return "Not Found"; }
    if code == 405 { return "Method Not Allowed"; }
    if code == 409 { return "Conflict"; }
    if code == 422 { return "Unprocessable Entity"; }
    if code == 500 { return "Internal Server Error"; }
    if code == 502 { return "Bad Gateway"; }
    if code == 503 { return "Service Unavailable"; }
    return "Unknown";
}

pub fn make_json_response(status_code: i64, json_body: String) -> HttpResponse {
    return make_http_response(status_code, http_status_text(status_code), "application/json", json_body);
}

pub fn make_text_response(status_code: i64, text_body: String) -> HttpResponse {
    return make_http_response(status_code, http_status_text(status_code), "text/plain", text_body);
}

pub fn http_put_json(host: String, port: i64, path: String, json_body: String) -> HttpResponse {
    mut stream = make_tcp_connect(host, port);
    if !stream.is_open {
        return HttpResponse(status_code: 503, status_text: "Service Unavailable", content_type: "text/plain", body: "Connection failed");
    }

    let req = HttpRequest(method: "PUT", path: path, version: "HTTP/1.1", body: json_body);
    let wire = format_http_request(req, host);
    stream_write(stream, wire);
    let resp_str = stream_read(stream, 65536);
    stream_close(stream);
    return parse_http_response(resp_str);
}

pub fn http_delete(host: String, port: i64, path: String) -> HttpResponse {
    mut stream = make_tcp_connect(host, port);
    if !stream.is_open {
        return HttpResponse(status_code: 503, status_text: "Service Unavailable", content_type: "text/plain", body: "Connection failed");
    }

    let req = HttpRequest(method: "DELETE", path: path, version: "HTTP/1.1", body: "");
    let wire = format_http_request(req, host);
    stream_write(stream, wire);
    let resp_str = stream_read(stream, 65536);
    stream_close(stream);
    return parse_http_response(resp_str);
}

// === Unit Tests ===

pub fn test_net_tcp_echo() -> bool {
    mut listener = make_tcp_listener(0);
    if !listener.is_open || listener.port <= 0 {
        return false;
    }

    mut client = make_tcp_connect("127.0.0.1", listener.port);
    if !client.is_open {
        listener_close(listener);
        return false;
    }

    mut server = listener_accept(listener);
    if !server.is_open {
        stream_close(client);
        listener_close(listener);
        return false;
    }

    let written = stream_write(client, "PING_IFA_FIBER");
    if written != 14 {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    let req = stream_read(server, 64);
    if req != "PING_IFA_FIBER" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    let reply_len = stream_write(server, "PONG_IFA_FIBER");
    if reply_len != 14 {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    let resp = stream_read(client, 64);
    if resp != "PONG_IFA_FIBER" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    stream_close(client);
    stream_close(server);
    listener_close(listener);
    return true;
}

pub fn test_net_http_wire() -> bool {
    let raw_req = "GET /api/v1/health HTTP/1.1\r\nHost: localhost\r\nContent-Length: 5\r\n\r\nhello";
    let parsed = parse_http_request(raw_req);

    if parsed.method != "GET" {
        return false;
    }
    if parsed.path != "/api/v1/health" {
        return false;
    }
    if parsed.version != "HTTP/1.1" {
        return false;
    }
    if parsed.body != "hello" {
        return false;
    }

    let resp = make_http_response(200, "OK", "application/json", "{\"status\":\"healthy\"}");
    let wire = format_http_response(resp);

    let expected = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 20\r\nConnection: close\r\n\r\n{\"status\":\"healthy\"}";
    return wire == expected;
}

pub fn test_net_nonblocking_fiber_transport() -> bool {
    mut bad_client = make_tcp_connect("127.0.0.1", 1); // unallocated port
    if bad_client.is_open {
        stream_close(bad_client);
        return false;
    }

    mut listener = make_tcp_listener(0);
    if !listener.is_open {
        return false;
    }

    let p = listener.port;
    if p <= 0 {
        listener_close(listener);
        return false;
    }

    listener_close(listener);
    if listener.is_open {
        return false;
    }

    return true;
}

pub fn test_net_url_parsing_and_formatting() -> bool {
    let url_raw = "https://api.ifa-lang.org:8443/v1/packages?lang=ifa&arch=x86_64";
    let u = parse_url(url_raw);

    if u.scheme != "https" {
        return false;
    }
    if u.host != "api.ifa-lang.org" {
        return false;
    }
    if u.port != 8443 {
        return false;
    }
    if u.path != "/v1/packages" {
        return false;
    }
    if u.query != "lang=ifa&arch=x86_64" {
        return false;
    }

    let formatted = format_url(u);
    if formatted != url_raw {
        return false;
    }

    // Default port and no query
    let u_default = parse_url("http://localhost/health");
    if u_default.scheme != "http" || u_default.host != "localhost" || u_default.port != 80 || u_default.path != "/health" || u_default.query != "" {
        return false;
    }
    if format_url(u_default) != "http://localhost/health" {
        return false;
    }

    return true;
}

pub fn test_net_http_client_and_response_parsing() -> bool {
    let wire = "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\nContent-Length: 13\r\nConnection: close\r\n\r\n404 Not Found";
    let resp = parse_http_response(wire);

    if resp.status_code != 404 {
        return false;
    }
    if resp.status_text != "Not Found" {
        return false;
    }
    if resp.content_type != "text/plain" {
        return false;
    }
    if resp.body != "404 Not Found" {
        return false;
    }

    let req = HttpRequest(method: "POST", path: "/rpc/call", version: "HTTP/1.1", body: "{\"method\":\"ping\"}");
    let wire_req = format_http_request(req, "127.0.0.1:8080");
    if !string_contains(wire_req, "POST /rpc/call HTTP/1.1\r\n") {
        return false;
    }
    if !string_contains(wire_req, "Host: 127.0.0.1:8080\r\n") {
        return false;
    }
    if !string_contains(wire_req, "Content-Length: 17\r\n") {
        return false;
    }
    if !string_contains(wire_req, "{\"method\":\"ping\"}") {
        return false;
    }

    return true;
}

pub fn test_net_http_client_server_roundtrip() -> bool {
    mut listener = make_tcp_listener(0);
    if !listener.is_open || listener.port <= 0 {
        return false;
    }

    mut client = make_tcp_connect("127.0.0.1", listener.port);
    if !client.is_open {
        listener_close(listener);
        return false;
    }

    mut server = listener_accept(listener);
    if !server.is_open {
        stream_close(client);
        listener_close(listener);
        return false;
    }

    let req = HttpRequest(method: "GET", path: "/v1/metrics", version: "HTTP/1.1", body: "");
    let wire_req = format_http_request(req, "localhost");
    let sent = stream_write(client, wire_req);
    if sent <= 0 {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    let raw_server_req = stream_read(server, 1024);
    let parsed_req = parse_http_request(raw_server_req);
    if parsed_req.method != "GET" || parsed_req.path != "/v1/metrics" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    let server_resp = make_http_response(200, "OK", "application/json", "{\"active_fibers\":42}");
    let wire_resp = format_http_response(server_resp);
    stream_write(server, wire_resp);

    let raw_client_resp = stream_read(client, 1024);
    let parsed_resp = parse_http_response(raw_client_resp);
    if parsed_resp.status_code != 200 || parsed_resp.status_text != "OK" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }
    if parsed_resp.body != "{\"active_fibers\":42}" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    stream_close(client);
    stream_close(server);
    listener_close(listener);
    return true;
}

pub fn test_net_http_status_helpers() -> bool {
    if http_status_text(200) != "OK" { return false; }
    if http_status_text(201) != "Created" { return false; }
    if http_status_text(204) != "No Content" { return false; }
    if http_status_text(400) != "Bad Request" { return false; }
    if http_status_text(404) != "Not Found" { return false; }
    if http_status_text(500) != "Internal Server Error" { return false; }

    let r_json = make_json_response(201, "{\"status\":\"created\"}");
    if r_json.status_code != 201 || r_json.status_text != "Created" { return false; }
    if r_json.content_type != "application/json" || r_json.body != "{\"status\":\"created\"}" { return false; }

    let r_txt = make_text_response(404, "Route not found");
    if r_txt.status_code != 404 || r_txt.status_text != "Not Found" { return false; }
    if r_txt.content_type != "text/plain" || r_txt.body != "Route not found" { return false; }

    return true;
}

pub fn test_net_http_put_and_delete() -> bool {
    mut listener = make_tcp_listener(0);
    if !listener.is_open || listener.port <= 0 {
        return false;
    }

    // Test PUT
    mut client_put = make_tcp_connect("127.0.0.1", listener.port);
    if !client_put.is_open {
        listener_close(listener);
        return false;
    }
    mut server_put = listener_accept(listener);
    if !server_put.is_open {
        stream_close(client_put);
        listener_close(listener);
        return false;
    }

    let req_put = HttpRequest(method: "PUT", path: "/v1/resource/1", version: "HTTP/1.1", body: "{\"updated\":true}");
    stream_write(client_put, format_http_request(req_put, "localhost"));
    let raw_put = stream_read(server_put, 1024);
    let parsed_put = parse_http_request(raw_put);
    if parsed_put.method != "PUT" || parsed_put.path != "/v1/resource/1" || parsed_put.body != "{\"updated\":true}" {
        stream_close(client_put);
        stream_close(server_put);
        listener_close(listener);
        return false;
    }
    let resp_put = make_json_response(200, "{\"success\":true}");
    stream_write(server_put, format_http_response(resp_put));
    let client_put_resp = parse_http_response(stream_read(client_put, 1024));
    if client_put_resp.status_code != 200 || client_put_resp.body != "{\"success\":true}" {
        stream_close(client_put);
        stream_close(server_put);
        listener_close(listener);
        return false;
    }
    stream_close(client_put);
    stream_close(server_put);

    // Test DELETE
    mut client_del = make_tcp_connect("127.0.0.1", listener.port);
    if !client_del.is_open {
        listener_close(listener);
        return false;
    }
    mut server_del = listener_accept(listener);
    if !server_del.is_open {
        stream_close(client_del);
        listener_close(listener);
        return false;
    }

    let req_del = HttpRequest(method: "DELETE", path: "/v1/resource/1", version: "HTTP/1.1", body: "");
    stream_write(client_del, format_http_request(req_del, "localhost"));
    let raw_del = stream_read(server_del, 1024);
    let parsed_del = parse_http_request(raw_del);
    if parsed_del.method != "DELETE" || parsed_del.path != "/v1/resource/1" {
        stream_close(client_del);
        stream_close(server_del);
        listener_close(listener);
        return false;
    }
    let resp_del = make_json_response(204, "");
    stream_write(server_del, format_http_response(resp_del));
    let client_del_resp = parse_http_response(stream_read(client_del, 1024));
    if client_del_resp.status_code != 204 {
        stream_close(client_del);
        stream_close(server_del);
        listener_close(listener);
        return false;
    }

    stream_close(client_del);
    stream_close(server_del);
    listener_close(listener);
    return true;
}

pub fn test_net_all() -> bool {
    return test_net_tcp_echo()
        && test_net_http_wire()
        && test_net_nonblocking_fiber_transport()
        && test_net_url_parsing_and_formatting()
        && test_net_http_client_and_response_parsing()
        && test_net_http_client_server_roundtrip()
        && test_net_http_status_helpers()
        && test_net_http_put_and_delete();
}

pub fn main() {
    let t1 = test_net_tcp_echo();
    let t2 = test_net_http_wire();
    let t3 = test_net_nonblocking_fiber_transport();
    let t4 = test_net_url_parsing_and_formatting();
    let t5 = test_net_http_client_and_response_parsing();
    let t6 = test_net_http_client_server_roundtrip();
    let t7 = test_net_http_status_helpers();
    let t8 = test_net_http_put_and_delete();
    if t1 && t2 && t3 && t4 && t5 && t6 && t7 && t8 {
        println("std/net: ALL TESTS PASSED");
    } else {
        println("std/net: TESTS FAILED");
    }
}
