pub fn http_head(host: String, port: i64, path: String) -> HttpResponse {
    mut stream = make_tcp_connect(host, port);
    if !stream.is_open {
        return HttpResponse(status_code: 503, status_text: "Service Unavailable", content_type: "text/plain", body: "Connection failed");
    }

    let req = HttpRequest(method: "HEAD", path: path, version: "HTTP/1.1", body: "");
    let wire = format_http_request(req, host);
    stream_write(stream, wire);
    let resp_str = stream_read(stream, 65536);
    stream_close(stream);
    return parse_http_response(resp_str);
}

// HTTP Status Predicates
pub fn http_is_info(code: i64) -> bool {
    return code >= 100 && code <= 199;
}

pub fn http_is_success(code: i64) -> bool {
    return code >= 200 && code <= 299;
}

pub fn http_is_redirect(code: i64) -> bool {
    return code >= 300 && code <= 399;
}

pub fn http_is_client_error(code: i64) -> bool {
    return code >= 400 && code <= 499;
}

pub fn http_is_server_error(code: i64) -> bool {
    return code >= 500 && code <= 599;
}

// HTTP Header and Query String Parsing Helpers
pub fn http_get_header(raw: String, name: String) -> String {
    let raw_len = string_len(raw);
    let name_len = string_len(name);
    if raw_len == 0 || name_len == 0 {
        return "";
    }

    mut i: i64 = 0;
    while i < raw_len {
        let line_start = i;
        mut line_end = raw_len;
        mut j = i;
        while j < raw_len {
            if string_char_at(raw, j) == 10 { // '\n'
                line_end = j;
                j = raw_len;
            }
            j = j + 1;
        }

        let actual_end = if line_end > line_start && string_char_at(raw, line_end - 1) == 13 {
            line_end - 1
        } else {
            line_end
        };

        if actual_end - line_start > name_len + 1 {
            mut is_match = true;
            mut k: i64 = 0;
            while k < name_len {
                mut c1 = string_char_at(raw, line_start + k);
                mut c2 = string_char_at(name, k);
                if c1 >= 65 && c1 <= 90 { c1 = c1 + 32; }
                if c2 >= 65 && c2 <= 90 { c2 = c2 + 32; }
                if c1 != c2 {
                    is_match = false;
                    k = name_len;
                }
                k = k + 1;
            }
            if is_match && string_char_at(raw, line_start + name_len) == 58 { // ':'
                mut val_start = line_start + name_len + 1;
                while val_start < actual_end && string_char_at(raw, val_start) == 32 {
                    val_start = val_start + 1;
                }
                return string_substr(raw, val_start, actual_end - val_start);
            }
        }

        i = line_end + 1;
    }

    return "";
}

pub fn url_get_query_param(query: String, key: String) -> String {
    let q_len = string_len(query);
    let k_len = string_len(key);
    if q_len == 0 || k_len == 0 {
        return "";
    }

    mut i: i64 = 0;
    while i < q_len {
        let pair_start = i;
        mut pair_end = q_len;
        mut j = i;
        while j < q_len {
            if string_char_at(query, j) == 38 { // '&'
                pair_end = j;
                j = q_len;
            }
            j = j + 1;
        }

        if pair_end - pair_start > k_len && string_char_at(query, pair_start + k_len) == 61 { // '='
            mut match_key = true;
            mut k: i64 = 0;
            while k < k_len {
                if string_char_at(query, pair_start + k) != string_char_at(key, k) {
                    match_key = false;
                    k = k_len;
                }
                k = k + 1;
            }
            if match_key {
                let val_start = pair_start + k_len + 1;
                return string_substr(query, val_start, pair_end - val_start);
            }
        }

        i = pair_end + 1;
    }

    return "";
}

// HTTP Router
pub fn make_http_router() -> HttpRouter {
    return HttpRouter(routes: List::new());
}

pub fn router_add_route(inout router: HttpRouter, method: String, path: String, handler_id: i64) {
    router.routes.push(HttpRoute(method: method, path: path, handler_id: handler_id));
}

pub fn router_match_route(router: HttpRouter, method: String, path: String) -> i64 {
    mut i: i64 = 0;
    let n = router.routes.len();
    while i < n {
        let r = router.routes[i];
        if r.method == method && r.path == path {
            return r.handler_id;
        }
        i = i + 1;
    }
    return -1;
}

// === Unit Tests ===

pub fn test_net_tcp_echo() -> bool {
    mut listener = make_tcp_listener(0);
    if !listener.is_open || listener.port <= 0 {
        return false;
    }

    mut client = make_tcp_connect("127.0.0.1", listener.port);
    if !client.is_open {
        listener_close(listener);
        return false;
    }

    mut server = listener_accept(listener);
    if !server.is_open {
        stream_close(client);
        listener_close(listener);
        return false;
    }

    let written = stream_write(client, "PING_IFA_FIBER");
    if written != 14 {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    let req = stream_read(server, 64);
    if req != "PING_IFA_FIBER" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    let reply_len = stream_write(server, "PONG_IFA_FIBER");
    if reply_len != 14 {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    let resp = stream_read(client, 64);
    if resp != "PONG_IFA_FIBER" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    stream_close(client);
    stream_close(server);
    listener_close(listener);
    return true;
}

pub fn test_net_http_wire() -> bool {
    let raw_req = "GET /api/v1/health HTTP/1.1\r\nHost: localhost\r\nContent-Length: 5\r\n\r\nhello";
    let parsed = parse_http_request(raw_req);

    if parsed.method != "GET" {
        return false;
    }
    if parsed.path != "/api/v1/health" {
        return false;
    }
    if parsed.version != "HTTP/1.1" {
        return false;
    }
    if parsed.body != "hello" {
        return false;
    }

    let resp = make_http_response(200, "OK", "application/json", "{\"status\":\"healthy\"}");
    let wire = format_http_response(resp);

    let expected = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 20\r\nConnection: close\r\n\r\n{\"status\":\"healthy\"}";
    return wire == expected;
}

pub fn test_net_nonblocking_fiber_transport() -> bool {
    mut bad_client = make_tcp_connect("127.0.0.1", 1); // unallocated port
    if bad_client.is_open {
        stream_close(bad_client);
        return false;
    }

    mut listener = make_tcp_listener(0);
    if !listener.is_open {
        return false;
    }

    let p = listener.port;
    if p <= 0 {
        listener_close(listener);
        return false;
    }

    listener_close(listener);
    if listener.is_open {
        return false;
    }

    return true;
}

pub fn test_net_url_parsing_and_formatting() -> bool {
    let url_raw = "https://api.ifa-lang.org:8443/v1/packages?lang=ifa&arch=x86_64";
    let u = parse_url(url_raw);

    if u.scheme != "https" {
        return false;
    }
    if u.host != "api.ifa-lang.org" {
        return false;
    }
    if u.port != 8443 {
        return false;
    }
    if u.path != "/v1/packages" {
        return false;
    }
    if u.query != "lang=ifa&arch=x86_64" {
        return false;
    }

    let formatted = format_url(u);
    if formatted != url_raw {
        return false;
    }

    // Default port and no query
    let u_default = parse_url("http://localhost/health");
    if u_default.scheme != "http" || u_default.host != "localhost" || u_default.port != 80 || u_default.path != "/health" || u_default.query != "" {
        return false;
    }
    if format_url(u_default) != "http://localhost/health" {
        return false;
    }

    return true;
}

pub fn test_net_http_client_and_response_parsing() -> bool {
    let wire = "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\nContent-Length: 13\r\nConnection: close\r\n\r\n404 Not Found";
    let resp = parse_http_response(wire);

    if resp.status_code != 404 {
        return false;
    }
    if resp.status_text != "Not Found" {
        return false;
    }
    if resp.content_type != "text/plain" {
        return false;
    }
    if resp.body != "404 Not Found" {
        return false;
    }

    let req = HttpRequest(method: "POST", path: "/rpc/call", version: "HTTP/1.1", body: "{\"method\":\"ping\"}");
    let wire_req = format_http_request(req, "127.0.0.1:8080");
    if !string_contains(wire_req, "POST /rpc/call HTTP/1.1\r\n") {
        return false;
    }
    if !string_contains(wire_req, "Host: 127.0.0.1:8080\r\n") {
        return false;
    }
    if !string_contains(wire_req, "Content-Length: 17\r\n") {
        return false;
    }
    if !string_contains(wire_req, "{\"method\":\"ping\"}") {
        return false;
    }

    return true;
}

pub fn test_net_http_client_server_roundtrip() -> bool {
    mut listener = make_tcp_listener(0);
    if !listener.is_open || listener.port <= 0 {
        return false;
    }

    mut client = make_tcp_connect("127.0.0.1", listener.port);
    if !client.is_open {
        listener_close(listener);
        return false;
    }

    mut server = listener_accept(listener);
    if !server.is_open {
        stream_close(client);
        listener_close(listener);
        return false;
    }

    let req = HttpRequest(method: "GET", path: "/v1/metrics", version: "HTTP/1.1", body: "");
    let wire_req = format_http_request(req, "localhost");
    let sent = stream_write(client, wire_req);
    if sent <= 0 {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    let raw_server_req = stream_read(server, 1024);
    let parsed_req = parse_http_request(raw_server_req);
    if parsed_req.method != "GET" || parsed_req.path != "/v1/metrics" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    let server_resp = make_http_response(200, "OK", "application/json", "{\"active_fibers\":42}");
    let wire_resp = format_http_response(server_resp);
    stream_write(server, wire_resp);

    let raw_client_resp = stream_read(client, 1024);
    let parsed_resp = parse_http_response(raw_client_resp);
    if parsed_resp.status_code != 200 || parsed_resp.status_text != "OK" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }
    if parsed_resp.body != "{\"active_fibers\":42}" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    stream_close(client);
    stream_close(server);
    listener_close(listener);
    return true;
}

pub fn test_net_http_status_helpers() -> bool {
    if http_status_text(200) != "OK" { return false; }
    if http_status_text(201) != "Created" { return false; }
    if http_status_text(204) != "No Content" { return false; }
    if http_status_text(400) != "Bad Request" { return false; }
    if http_status_text(404) != "Not Found" { return false; }
    if http_status_text(500) != "Internal Server Error" { return false; }

    let r_json = make_json_response(201, "{\"status\":\"created\"}");
    if r_json.status_code != 201 || r_json.status_text != "Created" { return false; }
    if r_json.content_type != "application/json" || r_json.body != "{\"status\":\"created\"}" { return false; }

    let r_txt = make_text_response(404, "Route not found");
    if r_txt.status_code != 404 || r_txt.status_text != "Not Found" { return false; }
    if r_txt.content_type != "text/plain" || r_txt.body != "Route not found" { return false; }

    return true;
}

pub fn test_net_http_put_and_delete() -> bool {
    mut listener = make_tcp_listener(0);
    if !listener.is_open || listener.port <= 0 {
        return false;
    }

    // Test PUT
    mut client_put = make_tcp_connect("127.0.0.1", listener.port);
    if !client_put.is_open {
        listener_close(listener);
        return false;
    }
    mut server_put = listener_accept(listener);
    if !server_put.is_open {
        stream_close(client_put);
        listener_close(listener);
        return false;
    }

    let req_put = HttpRequest(method: "PUT", path: "/v1/resource/1", version: "HTTP/1.1", body: "{\"updated\":true}");
    stream_write(client_put, format_http_request(req_put, "localhost"));
    let raw_put = stream_read(server_put, 1024);
    let parsed_put = parse_http_request(raw_put);
    if parsed_put.method != "PUT" || parsed_put.path != "/v1/resource/1" || parsed_put.body != "{\"updated\":true}" {
        stream_close(client_put);
        stream_close(server_put);
        listener_close(listener);
        return false;
    }
    let resp_put = make_json_response(200, "{\"success\":true}");
    stream_write(server_put, format_http_response(resp_put));
    let client_put_resp = parse_http_response(stream_read(client_put, 1024));
    if client_put_resp.status_code != 200 || client_put_resp.body != "{\"success\":true}" {
        stream_close(client_put);
        stream_close(server_put);
        listener_close(listener);
        return false;
    }
    stream_close(client_put);
    stream_close(server_put);

    // Test DELETE
    mut client_del = make_tcp_connect("127.0.0.1", listener.port);
    if !client_del.is_open {
        listener_close(listener);
        return false;
    }
    mut server_del = listener_accept(listener);
    if !server_del.is_open {
        stream_close(client_del);
        listener_close(listener);
        return false;
    }

    let req_del = HttpRequest(method: "DELETE", path: "/v1/resource/1", version: "HTTP/1.1", body: "");
    stream_write(client_del, format_http_request(req_del, "localhost"));
    let raw_del = stream_read(server_del, 1024);
    let parsed_del = parse_http_request(raw_del);
    if parsed_del.method != "DELETE" || parsed_del.path != "/v1/resource/1" {
        stream_close(client_del);
        stream_close(server_del);
        listener_close(listener);
        return false;
    }
    let resp_del = make_json_response(204, "");
    stream_write(server_del, format_http_response(resp_del));
    let client_del_resp = parse_http_response(stream_read(client_del, 1024));
    if client_del_resp.status_code != 204 {
        stream_close(client_del);
        stream_close(server_del);
        listener_close(listener);
        return false;
    }

    stream_close(client_del);
    stream_close(server_del);
    listener_close(listener);
    return true;
}

pub fn test_net_udp_roundtrip() -> bool {
    mut server_sock = make_udp_socket(0);
    if !server_sock.is_open || server_sock.port <= 0 {
        return false;
    }

    mut client_sock = make_udp_socket(0);
    if !client_sock.is_open {
        udp_socket_close(server_sock);
        return false;
    }

    let payload = "UDP_FIBER_PING";
    let sent = udp_socket_send(client_sock, "127.0.0.1", server_sock.port, payload);
    if sent != 14 {
        udp_socket_close(client_sock);
        udp_socket_close(server_sock);
        return false;
    }

    let received = udp_socket_recv(server_sock, 1024);
    if received != "UDP_FIBER_PING" {
        udp_socket_close(client_sock);
        udp_socket_close(server_sock);
        return false;
    }

    // Server responds back to client
    let reply_sent = udp_socket_send(server_sock, "127.0.0.1", client_sock.port, "UDP_FIBER_PONG");
    if reply_sent != 14 {
        udp_socket_close(client_sock);
        udp_socket_close(server_sock);
        return false;
    }

    let client_received = udp_socket_recv(client_sock, 1024);
    if client_received != "UDP_FIBER_PONG" {
        udp_socket_close(client_sock);
        udp_socket_close(server_sock);
        return false;
    }

    udp_socket_close(client_sock);
    udp_socket_close(server_sock);
    return true;
}

pub fn test_net_http_router_and_query_params() -> bool {
    mut router = make_http_router();
    router_add_route(inout router, "GET", "/api/v1/health", 101);
    router_add_route(inout router, "POST", "/api/v1/orders", 102);
    router_add_route(inout router, "GET", "/api/v1/orders", 103);
    router_add_route(inout router, "DELETE", "/api/v1/orders", 104);

    if router_match_route(router, "GET", "/api/v1/health") != 101 { return false; }
    if router_match_route(router, "POST", "/api/v1/orders") != 102 { return false; }
    if router_match_route(router, "GET", "/api/v1/orders") != 103 { return false; }
    if router_match_route(router, "DELETE", "/api/v1/orders") != 104 { return false; }
    if router_match_route(router, "PUT", "/api/v1/orders") != -1 { return false; }
    if router_match_route(router, "GET", "/api/v1/unknown") != -1 { return false; }

    let q = "search=colorless&limit=50&active=true";
    let p_search = url_get_query_param(q, "search");
    let p_limit = url_get_query_param(q, "limit");
    let p_active = url_get_query_param(q, "active");
    let p_missing = url_get_query_param(q, "offset");

    if p_search != "colorless" { return false; }
    if p_limit != "50" { return false; }
    if p_active != "true" { return false; }
    if p_missing != "" { return false; }

    return true;
}

pub fn test_net_http_headers_and_status_categories() -> bool {
    if !http_is_info(100) || !http_is_info(101) || http_is_info(200) { return false; }
    if !http_is_success(200) || !http_is_success(201) || !http_is_success(204) || http_is_success(400) { return false; }
    if !http_is_redirect(301) || !http_is_redirect(302) || http_is_redirect(200) { return false; }
    if !http_is_client_error(400) || !http_is_client_error(404) || !http_is_client_error(422) || http_is_client_error(500) { return false; }
    if !http_is_server_error(500) || !http_is_server_error(502) || !http_is_server_error(503) || http_is_server_error(200) { return false; }

    let raw_msg = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nX-RateLimit-Limit: 100\r\nAuthorization: Bearer test_token_xyz\r\n\r\n{\"ok\":true}";
    let ct = http_get_header(raw_msg, "Content-Type");
    let rl = http_get_header(raw_msg, "X-RateLimit-Limit");
    let auth = http_get_header(raw_msg, "Authorization");
    let none = http_get_header(raw_msg, "X-Unknown");

    if ct != "application/json" { return false; }
    if rl != "100" { return false; }
    if auth != "Bearer test_token_xyz" { return false; }
    if none != "" { return false; }

    return true;
}

