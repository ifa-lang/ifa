// HTTP Status Predicates
pub fn http_is_info(code: i64) -> bool {
    return code >= 100 && code <= 199;
}

pub fn http_is_success(code: i64) -> bool {
    return code >= 200 && code <= 299;
}

pub fn http_is_redirect(code: i64) -> bool {
    return code >= 300 && code <= 399;
}

pub fn http_is_client_error(code: i64) -> bool {
    return code >= 400 && code <= 499;
}

pub fn http_is_server_error(code: i64) -> bool {
    return code >= 500 && code <= 599;
}

// HTTP Header and Query String Parsing Helpers
pub fn http_get_header(raw: String, name: String) -> String {
    let raw_len = string_len(raw);
    let name_len = string_len(name);
    if raw_len == 0 || name_len == 0 {
        return "";
    }

    mut i: i64 = 0;
    while i < raw_len {
        let line_start = i;
        mut line_end = raw_len;
        mut j = i;
        while j < raw_len {
            if string_char_at(raw, j) == 10 { // '\n'
                line_end = j;
                j = raw_len;
            }
            j = j + 1;
        }

        let actual_end = if line_end > line_start && string_char_at(raw, line_end - 1) == 13 {
            line_end - 1
        } else {
            line_end
        };

        if actual_end - line_start > name_len + 1 {
            mut is_match = true;
            mut k: i64 = 0;
            while k < name_len {
                mut c1 = string_char_at(raw, line_start + k);
                mut c2 = string_char_at(name, k);
                if c1 >= 65 && c1 <= 90 { c1 = c1 + 32; }
                if c2 >= 65 && c2 <= 90 { c2 = c2 + 32; }
                if c1 != c2 {
                    is_match = false;
                    k = name_len;
                }
                k = k + 1;
            }
            if is_match && string_char_at(raw, line_start + name_len) == 58 { // ':'
                mut val_start = line_start + name_len + 1;
                while val_start < actual_end && string_char_at(raw, val_start) == 32 {
                    val_start = val_start + 1;
                }
                return string_substr(raw, val_start, actual_end - val_start);
            }
        }

        i = line_end + 1;
    }

    return "";
}

pub fn url_get_query_param(query: String, key: String) -> String {
    let q_len = string_len(query);
    let k_len = string_len(key);
    if q_len == 0 || k_len == 0 {
        return "";
    }

    mut i: i64 = 0;
    while i < q_len {
        let pair_start = i;
        mut pair_end = q_len;
        mut j = i;
        while j < q_len {
            if string_char_at(query, j) == 38 { // '&'
                pair_end = j;
                j = q_len;
            }
            j = j + 1;
        }

        if pair_end - pair_start > k_len && string_char_at(query, pair_start + k_len) == 61 { // '='
            mut match_key = true;
            mut k: i64 = 0;
            while k < k_len {
                if string_char_at(query, pair_start + k) != string_char_at(key, k) {
                    match_key = false;
                    k = k_len;
                }
                k = k + 1;
            }
            if match_key {
                let val_start = pair_start + k_len + 1;
                return string_substr(query, val_start, pair_end - val_start);
            }
        }

        i = pair_end + 1;
    }

    return "";
}

// HTTP Router & Dynamic URI Segment Matching
pub fn make_http_router() -> HttpRouter {
    return HttpRouter(routes: List::new());
}

pub fn path_split_segments(path: String) -> List<String> {
    mut segs: List<String> = List::new();
    let p_len = string_len(path);
    mut i: i64 = 0;
    while i < p_len {
        while i < p_len && string_char_at(path, i) == 47 {
            i = i + 1;
        }
        if i >= p_len {
            return segs;
        }
        let start = i;
        while i < p_len && string_char_at(path, i) != 47 && string_char_at(path, i) != 63 {
            i = i + 1;
        }
        let seg_len = i - start;
        if seg_len > 0 {
            let seg = string_substr(path, start, seg_len);
            segs.push(seg);
        }
        if i < p_len && string_char_at(path, i) == 63 {
            return segs;
        }
    }
    return segs;
}

pub fn route_pattern_matches(pattern: String, path: String) -> bool {
    if pattern == path {
        return true;
    }
    let pat_segs = path_split_segments(pattern);
    let req_segs = path_split_segments(path);

    let pat_len = pat_segs.len();
    let req_len = req_segs.len();

    mut p_idx: i64 = 0;
    mut r_idx: i64 = 0;

    while p_idx < pat_len {
        let p_seg = pat_segs[p_idx];
        let p_s_len = string_len(p_seg);
        if p_s_len > 0 && string_char_at(p_seg, 0) == 42 { // '*' wildcard
            return true;
        }
        if r_idx >= req_len {
            return false;
        }
        let r_seg = req_segs[r_idx];
        if p_s_len > 0 && string_char_at(p_seg, 0) == 58 { // ':' dynamic param
            p_idx = p_idx + 1;
            r_idx = r_idx + 1;
        } else {
            if p_seg != r_seg {
                return false;
            }
            p_idx = p_idx + 1;
            r_idx = r_idx + 1;
        }
    }

    return p_idx == pat_len && r_idx == req_len;
}

pub fn router_extract_param(pattern: String, path: String, param_name: String) -> String {
    let pat_segs = path_split_segments(pattern);
    let req_segs = path_split_segments(path);

    let pat_len = pat_segs.len();
    let req_len = req_segs.len();

    mut p_idx: i64 = 0;
    mut r_idx: i64 = 0;

    let target_colon = ":" + param_name;
    let target_star = "*" + param_name;

    while p_idx < pat_len {
        let p_seg = pat_segs[p_idx];
        if p_seg == target_colon {
            if r_idx < req_len {
                return req_segs[r_idx];
            }
            return "";
        }
        if p_seg == target_star || p_seg == "*" {
            mut rem: String = "";
            mut k: i64 = r_idx;
            while k < req_len {
                if k > r_idx {
                    rem = rem + "/";
                }
                rem = rem + req_segs[k];
                k = k + 1;
            }
            return rem;
        }
        p_idx = p_idx + 1;
        r_idx = r_idx + 1;
    }

    return "";
}

pub fn router_add_route(inout router: HttpRouter, method: String, path: String, handler_id: i64) {
    router.routes.push(HttpRoute(method: method, path: path, handler_id: handler_id));
}

pub fn router_match_route(router: HttpRouter, method: String, path: String) -> i64 {
    mut i: i64 = 0;
    let n = router.routes.len();
    mut dynamic_match: i64 = -1;
    while i < n {
        let r = router.routes[i];
        if r.method == method {
            if r.path == path {
                return r.handler_id;
            }
            if dynamic_match < 0 && route_pattern_matches(r.path, path) {
                dynamic_match = r.handler_id;
            }
        }
        i = i + 1;
    }
    return dynamic_match;
}

// === Unit Tests ===

pub fn test_net_tcp_echo() -> bool {
    mut listener = make_tcp_listener(0);
    if !listener.is_open || listener.port <= 0 {
        return false;
    }

    mut client = make_tcp_connect("127.0.0.1", listener.port);
    if !client.is_open {
        listener_close(listener);
        return false;
    }

    mut server = listener_accept(listener);
    if !server.is_open {
        stream_close(client);
        listener_close(listener);
        return false;
    }

    let written = stream_write(client, "PING_IFA_FIBER");
    if written != 14 {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    let req = stream_read(server, 64);
    if req != "PING_IFA_FIBER" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    let reply_len = stream_write(server, "PONG_IFA_FIBER");
    if reply_len != 14 {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    let resp = stream_read(client, 64);
    if resp != "PONG_IFA_FIBER" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    stream_close(client);
    stream_close(server);
    listener_close(listener);
    return true;
}

pub fn test_net_http_wire() -> bool {
    let raw_req = "GET /api/v1/health HTTP/1.1\r\nHost: localhost\r\nContent-Length: 5\r\n\r\nhello";
    let parsed = parse_http_request(raw_req);

    if parsed.method != "GET" {
        return false;
    }
    if parsed.path != "/api/v1/health" {
        return false;
    }
    if parsed.version != "HTTP/1.1" {
        return false;
    }
    if parsed.body != "hello" {
        return false;
    }

    let resp = make_http_response(200, "OK", "application/json", "{\"status\":\"healthy\"}");
    let wire = format_http_response(resp);

    let expected = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 20\r\nConnection: close\r\n\r\n{\"status\":\"healthy\"}";
    return wire == expected;
}

pub fn test_net_nonblocking_fiber_transport() -> bool {
    mut bad_client = make_tcp_connect("127.0.0.1", 1); // unallocated port
    if bad_client.is_open {
        stream_close(bad_client);
        return false;
    }

    mut listener = make_tcp_listener(0);
    if !listener.is_open {
        return false;
    }

    let p = listener.port;
    if p <= 0 {
        listener_close(listener);
        return false;
    }

    listener_close(listener);
    if listener.is_open {
        return false;
    }

    return true;
}

pub fn test_net_url_parsing_and_formatting() -> bool {
    let url_raw = "https://api.ifa-lang.org:8443/v1/packages?lang=ifa&arch=x86_64";
    let u = parse_url(url_raw);

    if u.scheme != "https" {
        return false;
    }
    if u.host != "api.ifa-lang.org" {
        return false;
    }
    if u.port != 8443 {
        return false;
    }
    if u.path != "/v1/packages" {
        return false;
    }
    if u.query != "lang=ifa&arch=x86_64" {
        return false;
    }

    let formatted = format_url(u);
    if formatted != url_raw {
        return false;
    }

    // Default port and no query
    let u_default = parse_url("http://localhost/health");
    if u_default.scheme != "http" || u_default.host != "localhost" || u_default.port != 80 || u_default.path != "/health" || u_default.query != "" {
        return false;
    }
    if format_url(u_default) != "http://localhost/health" {
        return false;
    }

    return true;
}

pub fn test_net_http_client_and_response_parsing() -> bool {
    let wire = "HTTP/1.1 404 Not Found\r\nContent-Type: text/plain\r\nContent-Length: 13\r\nConnection: close\r\n\r\n404 Not Found";
    let resp = parse_http_response(wire);

    if resp.status_code != 404 {
        return false;
    }
    if resp.status_text != "Not Found" {
        return false;
    }
    if resp.content_type != "text/plain" {
        return false;
    }
    if resp.body != "404 Not Found" {
        return false;
    }

    let req = HttpRequest(method: "POST", path: "/rpc/call", version: "HTTP/1.1", body: "{\"method\":\"ping\"}");
    let wire_req = format_http_request(req, "127.0.0.1:8080");
    if !string_contains(wire_req, "POST /rpc/call HTTP/1.1\r\n") {
        return false;
    }
    if !string_contains(wire_req, "Host: 127.0.0.1:8080\r\n") {
        return false;
    }
    if !string_contains(wire_req, "Content-Length: 17\r\n") {
        return false;
    }
    if !string_contains(wire_req, "{\"method\":\"ping\"}") {
        return false;
    }

    return true;
}

pub fn test_net_http_client_server_roundtrip() -> bool {
    mut listener = make_tcp_listener(0);
    if !listener.is_open || listener.port <= 0 {
        return false;
    }

    mut client = make_tcp_connect("127.0.0.1", listener.port);
    if !client.is_open {
        listener_close(listener);
        return false;
    }

    mut server = listener_accept(listener);
    if !server.is_open {
        stream_close(client);
        listener_close(listener);
        return false;
    }

    let req = HttpRequest(method: "GET", path: "/v1/metrics", version: "HTTP/1.1", body: "");
    let wire_req = format_http_request(req, "localhost");
    let sent = stream_write(client, wire_req);
    if sent <= 0 {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    let raw_server_req = stream_read(server, 1024);
    let parsed_req = parse_http_request(raw_server_req);
    if parsed_req.method != "GET" || parsed_req.path != "/v1/metrics" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    let server_resp = make_http_response(200, "OK", "application/json", "{\"active_fibers\":42}");
    let wire_resp = format_http_response(server_resp);
    stream_write(server, wire_resp);

    let raw_client_resp = stream_read(client, 1024);
    let parsed_resp = parse_http_response(raw_client_resp);
    if parsed_resp.status_code != 200 || parsed_resp.status_text != "OK" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }
    if parsed_resp.body != "{\"active_fibers\":42}" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    stream_close(client);
    stream_close(server);
    listener_close(listener);
    return true;
}

pub fn test_net_http_status_helpers() -> bool {
    if http_status_text(200) != "OK" { return false; }
    if http_status_text(201) != "Created" { return false; }
    if http_status_text(204) != "No Content" { return false; }
    if http_status_text(400) != "Bad Request" { return false; }
    if http_status_text(404) != "Not Found" { return false; }
    if http_status_text(500) != "Internal Server Error" { return false; }

    let r_json = make_json_response(201, "{\"status\":\"created\"}");
    if r_json.status_code != 201 || r_json.status_text != "Created" { return false; }
    if r_json.content_type != "application/json" || r_json.body != "{\"status\":\"created\"}" { return false; }

    let r_txt = make_text_response(404, "Route not found");
    if r_txt.status_code != 404 || r_txt.status_text != "Not Found" { return false; }
    if r_txt.content_type != "text/plain" || r_txt.body != "Route not found" { return false; }

    return true;
}

pub fn test_net_http_put_and_delete() -> bool {
    mut listener = make_tcp_listener(0);
    if !listener.is_open || listener.port <= 0 {
        return false;
    }

    // Test PUT
    mut client_put = make_tcp_connect("127.0.0.1", listener.port);
    if !client_put.is_open {
        listener_close(listener);
        return false;
    }
    mut server_put = listener_accept(listener);
    if !server_put.is_open {
        stream_close(client_put);
        listener_close(listener);
        return false;
    }

    let req_put = HttpRequest(method: "PUT", path: "/v1/resource/1", version: "HTTP/1.1", body: "{\"updated\":true}");
    stream_write(client_put, format_http_request(req_put, "localhost"));
    let raw_put = stream_read(server_put, 1024);
    let parsed_put = parse_http_request(raw_put);
    if parsed_put.method != "PUT" || parsed_put.path != "/v1/resource/1" || parsed_put.body != "{\"updated\":true}" {
        stream_close(client_put);
        stream_close(server_put);
        listener_close(listener);
        return false;
    }
    let resp_put = make_json_response(200, "{\"success\":true}");
    stream_write(server_put, format_http_response(resp_put));
    let client_put_resp = parse_http_response(stream_read(client_put, 1024));
    if client_put_resp.status_code != 200 || client_put_resp.body != "{\"success\":true}" {
        stream_close(client_put);
        stream_close(server_put);
        listener_close(listener);
        return false;
    }
    stream_close(client_put);
    stream_close(server_put);

    // Test DELETE
    mut client_del = make_tcp_connect("127.0.0.1", listener.port);
    if !client_del.is_open {
        listener_close(listener);
        return false;
    }
    mut server_del = listener_accept(listener);
    if !server_del.is_open {
        stream_close(client_del);
        listener_close(listener);
        return false;
    }

    let req_del = HttpRequest(method: "DELETE", path: "/v1/resource/1", version: "HTTP/1.1", body: "");
    stream_write(client_del, format_http_request(req_del, "localhost"));
    let raw_del = stream_read(server_del, 1024);
    let parsed_del = parse_http_request(raw_del);
    if parsed_del.method != "DELETE" || parsed_del.path != "/v1/resource/1" {
        stream_close(client_del);
        stream_close(server_del);
        listener_close(listener);
        return false;
    }
    let resp_del = make_json_response(204, "");
    stream_write(server_del, format_http_response(resp_del));
    let client_del_resp = parse_http_response(stream_read(client_del, 1024));
    if client_del_resp.status_code != 204 {
        stream_close(client_del);
        stream_close(server_del);
        listener_close(listener);
        return false;
    }

    stream_close(client_del);
    stream_close(server_del);
    listener_close(listener);
    return true;
}

pub fn test_net_udp_roundtrip() -> bool {
    mut server_sock = make_udp_socket(0);
    if !server_sock.is_open || server_sock.port <= 0 {
        return false;
    }

    mut client_sock = make_udp_socket(0);
    if !client_sock.is_open {
        udp_socket_close(server_sock);
        return false;
    }

    let payload = "UDP_FIBER_PING";
    let sent = udp_socket_send(client_sock, "127.0.0.1", server_sock.port, payload);
    if sent != 14 {
        udp_socket_close(client_sock);
        udp_socket_close(server_sock);
        return false;
    }

    let received = udp_socket_recv(server_sock, 1024);
    if received != "UDP_FIBER_PING" {
        udp_socket_close(client_sock);
        udp_socket_close(server_sock);
        return false;
    }

    // Server responds back to client
    let reply_sent = udp_socket_send(server_sock, "127.0.0.1", client_sock.port, "UDP_FIBER_PONG");
    if reply_sent != 14 {
        udp_socket_close(client_sock);
        udp_socket_close(server_sock);
        return false;
    }

    let client_received = udp_socket_recv(client_sock, 1024);
    if client_received != "UDP_FIBER_PONG" {
        udp_socket_close(client_sock);
        udp_socket_close(server_sock);
        return false;
    }

    udp_socket_close(client_sock);
    udp_socket_close(server_sock);
    return true;
}

pub fn test_net_http_router_and_query_params() -> bool {
    mut router = make_http_router();
    router_add_route(inout router, "GET", "/api/v1/health", 101);
    router_add_route(inout router, "POST", "/api/v1/orders", 102);
    router_add_route(inout router, "GET", "/api/v1/orders", 103);
    router_add_route(inout router, "DELETE", "/api/v1/orders", 104);

    if router_match_route(router, "GET", "/api/v1/health") != 101 { return false; }
    if router_match_route(router, "POST", "/api/v1/orders") != 102 { return false; }
    if router_match_route(router, "GET", "/api/v1/orders") != 103 { return false; }
    if router_match_route(router, "DELETE", "/api/v1/orders") != 104 { return false; }
    if router_match_route(router, "PUT", "/api/v1/orders") != -1 { return false; }
    if router_match_route(router, "GET", "/api/v1/unknown") != -1 { return false; }

    let q = "search=colorless&limit=50&active=true";
    let p_search = url_get_query_param(q, "search");
    let p_limit = url_get_query_param(q, "limit");
    let p_active = url_get_query_param(q, "active");
    let p_missing = url_get_query_param(q, "offset");

    if p_search != "colorless" { return false; }
    if p_limit != "50" { return false; }
    if p_active != "true" { return false; }
    if p_missing != "" { return false; }

    return true;
}

pub fn test_net_http_headers_and_status_categories() -> bool {
    if !http_is_info(100) || !http_is_info(101) || http_is_info(200) { return false; }
    if !http_is_success(200) || !http_is_success(201) || !http_is_success(204) || http_is_success(400) { return false; }
    if !http_is_redirect(301) || !http_is_redirect(302) || http_is_redirect(200) { return false; }
    if !http_is_client_error(400) || !http_is_client_error(404) || !http_is_client_error(422) || http_is_client_error(500) { return false; }
    if !http_is_server_error(500) || !http_is_server_error(502) || !http_is_server_error(503) || http_is_server_error(200) { return false; }

    let raw_msg = "HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nX-RateLimit-Limit: 100\r\nAuthorization: Bearer test_token_xyz\r\n\r\n{\"ok\":true}";
    let ct = http_get_header(raw_msg, "Content-Type");
    let rl = http_get_header(raw_msg, "X-RateLimit-Limit");
    let auth = http_get_header(raw_msg, "Authorization");
    let none = http_get_header(raw_msg, "X-Unknown");

    if ct != "application/json" { return false; }
    if rl != "100" { return false; }
    if auth != "Bearer test_token_xyz" { return false; }
    if none != "" { return false; }

    return true;
}

pub fn test_net_http_patch_and_head() -> bool {
    mut listener = make_tcp_listener(0);
    if !listener.is_open || listener.port <= 0 {
        return false;
    }

    // Test PATCH
    mut client_patch = make_tcp_connect("127.0.0.1", listener.port);
    if !client_patch.is_open {
        listener_close(listener);
        return false;
    }
    mut server_patch = listener_accept(listener);
    if !server_patch.is_open {
        stream_close(client_patch);
        listener_close(listener);
        return false;
    }

    let req_patch = HttpRequest(method: "PATCH", path: "/v1/items/42", version: "HTTP/1.1", body: "{\"active\":false}");
    stream_write(client_patch, format_http_request(req_patch, "localhost"));
    let raw_patch = stream_read(server_patch, 1024);
    let parsed_patch = parse_http_request(raw_patch);
    if parsed_patch.method != "PATCH" || parsed_patch.path != "/v1/items/42" || parsed_patch.body != "{\"active\":false}" {
        stream_close(client_patch);
        stream_close(server_patch);
        listener_close(listener);
        return false;
    }
    let resp_patch = make_json_response(200, "{\"patched\":true}");
    stream_write(server_patch, format_http_response(resp_patch));
    let client_patch_resp = parse_http_response(stream_read(client_patch, 1024));
    if client_patch_resp.status_code != 200 || client_patch_resp.body != "{\"patched\":true}" {
        stream_close(client_patch);
        stream_close(server_patch);
        listener_close(listener);
        return false;
    }
    stream_close(client_patch);
    stream_close(server_patch);

    // Test HEAD
    mut client_head = make_tcp_connect("127.0.0.1", listener.port);
    if !client_head.is_open {
        listener_close(listener);
        return false;
    }
    mut server_head = listener_accept(listener);
    if !server_head.is_open {
        stream_close(client_head);
        listener_close(listener);
        return false;
    }

    let req_head = HttpRequest(method: "HEAD", path: "/v1/items/42", version: "HTTP/1.1", body: "");
    stream_write(client_head, format_http_request(req_head, "localhost"));
    let raw_head = stream_read(server_head, 1024);
    let parsed_head = parse_http_request(raw_head);
    if parsed_head.method != "HEAD" || parsed_head.path != "/v1/items/42" {
        stream_close(client_head);
        stream_close(server_head);
        listener_close(listener);
        return false;
    }
    let resp_head = make_json_response(200, "");
    stream_write(server_head, format_http_response(resp_head));
    let client_head_resp = parse_http_response(stream_read(client_head, 1024));
    if client_head_resp.status_code != 200 {
        stream_close(client_head);
        stream_close(server_head);
        listener_close(listener);
        return false;
    }
    stream_close(client_head);
    stream_close(server_head);

    listener_close(listener);
    return true;
}

// === HTTP/1.1 Chunked Transfer Encoding & Streaming ===

pub fn int_to_hex_string(val: i64) -> String {
    if val <= 0 {
        return "0";
    }
    mut v = val;
    mut s: String = "";
    while v > 0 {
        let rem = v % 16;
        if rem == 0 { s = "0" + s; }
        else if rem == 1 { s = "1" + s; }
        else if rem == 2 { s = "2" + s; }
        else if rem == 3 { s = "3" + s; }
        else if rem == 4 { s = "4" + s; }
        else if rem == 5 { s = "5" + s; }
        else if rem == 6 { s = "6" + s; }
        else if rem == 7 { s = "7" + s; }
        else if rem == 8 { s = "8" + s; }
        else if rem == 9 { s = "9" + s; }
        else if rem == 10 { s = "a" + s; }
        else if rem == 11 { s = "b" + s; }
        else if rem == 12 { s = "c" + s; }
        else if rem == 13 { s = "d" + s; }
        else if rem == 14 { s = "e" + s; }
        else if rem == 15 { s = "f" + s; }
        v = v / 16;
    }
    return s;
}

pub fn hex_char_to_val(c: i64) -> i64 {
    if c >= 48 && c <= 57 { // '0'-'9'
        return c - 48;
    }
    if c >= 97 && c <= 102 { // 'a'-'f'
        return c - 97 + 10;
    }
    if c >= 65 && c <= 70 { // 'A'-'F'
        return c - 65 + 10;
    }
    return -1;
}

pub fn hex_string_to_int(hex: String) -> i64 {
    let len = string_len(hex);
    mut val: i64 = 0;
    mut i: i64 = 0;
    while i < len {
        let c = string_char_at(hex, i);
        let digit = hex_char_to_val(c);
        if digit < 0 {
            return val;
        }
        val = (val * 16) + digit;
        i = i + 1;
    }
    return val;
}

pub fn encode_http_chunk(chunk: String) -> String {
    let len = string_len(chunk);
    if len == 0 {
        return "0\r\n\r\n";
    }
    let hex_len = int_to_hex_string(len);
    return hex_len + "\r\n" + chunk + "\r\n";
}

pub fn encode_http_chunk_end() -> String {
    return "0\r\n\r\n";
}

pub fn format_http_chunked_response(status_code: i64, content_type: String) -> String {
    let text = http_status_text(status_code);
    let code_str = int_to_string(status_code);
    mut out: String = "HTTP/1.1 " + code_str + " " + text + "\r\n";
    out = out + "Content-Type: " + content_type + "\r\n";
    out = out + "Transfer-Encoding: chunked\r\n";
    out = out + "Connection: keep-alive\r\n\r\n";
    return out;
}

pub fn is_chunked_transfer(raw_http: String) -> bool {
    let te1 = "Transfer-Encoding: chunked";
    let te2 = "transfer-encoding: chunked";
    return string_contains(raw_http, te1) || string_contains(raw_http, te2);
}

pub fn decode_http_chunks(raw_chunks: String) -> String {
    let total_len = string_len(raw_chunks);
    mut cursor: i64 = 0;
    mut assembled: String = "";

    while cursor < total_len {
        mut line_end: i64 = -1;
        mut k = cursor;
        while k < total_len {
            if string_char_at(raw_chunks, k) == 10 { // '\n'
                line_end = k;
                k = total_len; // break
            }
            k = k + 1;
        }

        if line_end < 0 {
            return assembled;
        }

        mut hex_end = line_end;
        if hex_end > cursor && string_char_at(raw_chunks, hex_end - 1) == 13 { // '\r'
            hex_end = hex_end - 1;
        }

        let hex_line = string_substr(raw_chunks, cursor, hex_end - cursor);
        let chunk_size = hex_string_to_int(hex_line);
        if chunk_size <= 0 {
            return assembled;
        }

        let chunk_data_start = line_end + 1;
        if chunk_data_start + chunk_size > total_len {
            let chunk_data = string_substr(raw_chunks, chunk_data_start, total_len - chunk_data_start);
            assembled = assembled + chunk_data;
            return assembled;
        }

        let chunk_data = string_substr(raw_chunks, chunk_data_start, chunk_size);
        assembled = assembled + chunk_data;

        mut next_cursor = chunk_data_start + chunk_size;
        if next_cursor < total_len && string_char_at(raw_chunks, next_cursor) == 13 {
            next_cursor = next_cursor + 1;
        }
        if next_cursor < total_len && string_char_at(raw_chunks, next_cursor) == 10 {
            next_cursor = next_cursor + 1;
        }
        cursor = next_cursor;
    }

    return assembled;
}

// === Low-Level WebSocket RFC 6455 Framing & Protocol ===

pub fn ws_opcode_continuation() -> i64 { return 0; }
pub fn ws_opcode_text() -> i64 { return 1; }
pub fn ws_opcode_binary() -> i64 { return 2; }
pub fn ws_opcode_close() -> i64 { return 8; }
pub fn ws_opcode_ping() -> i64 { return 9; }
pub fn ws_opcode_pong() -> i64 { return 10; }

pub fn make_ws_frame(fin: bool, opcode: i64, is_masked: bool, mask_key: i64, payload: String) -> WsFrame {
    return WsFrame(
        fin: fin,
        opcode: opcode,
        is_masked: is_masked,
        mask_key: mask_key,
        payload: payload
    );
}

pub fn make_ws_text_frame(payload: String, masked: bool) -> WsFrame {
    return make_ws_frame(true, 1, masked, if masked { 305419896 } else { 0 }, payload);
}

pub fn make_ws_ping_frame(payload: String) -> WsFrame {
    return make_ws_frame(true, 9, false, 0, payload);
}

pub fn make_ws_pong_frame(payload: String) -> WsFrame {
    return make_ws_frame(true, 10, false, 0, payload);
}

pub fn make_ws_close_frame(code: i64, reason: String) -> WsFrame {
    let b0 = string_from_char((code >> 8) & 255);
    let b1 = string_from_char(code & 255);
    let payload = b0 + b1 + reason;
    return make_ws_frame(true, 8, false, 0, payload);
}

pub fn make_ws_binary_frame(payload: String, masked: bool) -> WsFrame {
    return make_ws_frame(true, 2, masked, if masked { 305419896 } else { 0 }, payload);
}

pub fn make_ws_continuation_frame(payload: String, fin: bool, masked: bool) -> WsFrame {
    return make_ws_frame(fin, 0, masked, if masked { 305419896 } else { 0 }, payload);
}

pub fn ws_close_code(frame: WsFrame) -> i64 {
    if frame.opcode != 8 || string_len(frame.payload) < 2 {
        return 0;
    }
    let b0 = string_char_at(frame.payload, 0);
    let b1 = string_char_at(frame.payload, 1);
    return (b0 << 8) | b1;
}

pub fn ws_close_reason(frame: WsFrame) -> String {
    if frame.opcode != 8 || string_len(frame.payload) <= 2 {
        return "";
    }
    return string_substr(frame.payload, 2, string_len(frame.payload) - 2);
}

pub fn encode_ws_frame(frame: WsFrame) -> String {
    let payload_len = string_len(frame.payload);
    mut b0: i64 = frame.opcode & 15;
    if frame.fin {
        b0 = b0 | 128;
    }

    mut header: String = string_from_char(b0);
    let mask_bit: i64 = if frame.is_masked { 128 } else { 0 };

    if payload_len < 126 {
        let b1 = mask_bit | payload_len;
        header = header + string_from_char(b1);
    } else if payload_len < 65536 {
        let b1 = mask_bit | 126;
        let l0 = (payload_len >> 8) & 255;
        let l1 = payload_len & 255;
        header = header + string_from_char(b1) + string_from_char(l0) + string_from_char(l1);
    } else {
        let b1 = mask_bit | 127;
        header = header + string_from_char(b1);
        mut shift: i64 = 56;
        while shift >= 0 {
            let b = (payload_len >> shift) & 255;
            header = header + string_from_char(b);
            shift = shift - 8;
        }
    }

    if frame.is_masked {
        let m0 = (frame.mask_key >> 24) & 255;
        let m1 = (frame.mask_key >> 16) & 255;
        let m2 = (frame.mask_key >> 8) & 255;
        let m3 = frame.mask_key & 255;
        header = header + string_from_char(m0) + string_from_char(m1) + string_from_char(m2) + string_from_char(m3);

        mut masked_payload: String = "";
        mut i: i64 = 0;
        while i < payload_len {
            let c = string_char_at(frame.payload, i);
            let rem_i = i % 4;
            let mask_byte = if rem_i == 0 { m0 }
            else if rem_i == 1 { m1 }
            else if rem_i == 2 { m2 }
            else { m3 };
            let xor_val = c ^ mask_byte;
            masked_payload = masked_payload + string_from_char(xor_val);
            i = i + 1;
        }
        return header + masked_payload;
    }

    return header + frame.payload;
}

pub fn ws_decode_frame_stream(raw: String) -> WsDecodeResult {
    let total_len = string_len(raw);
    let empty_frame = WsFrame(fin: false, opcode: 0, is_masked: false, mask_key: 0, payload: "");
    if total_len < 2 {
        return WsDecodeResult(frame: empty_frame, consumed: 0, has_frame: false);
    }

    let b0 = string_char_at(raw, 0);
    let fin = (b0 & 128) != 0;
    let opcode = b0 & 15;

    let b1 = string_char_at(raw, 1);
    let is_masked = (b1 & 128) != 0;
    let raw_len = b1 & 127;
    mut cursor: i64 = 2;

    mut payload_len: i64 = raw_len;
    if raw_len == 126 {
        if total_len < 4 {
            return WsDecodeResult(frame: empty_frame, consumed: 0, has_frame: false);
        }
        let l0 = string_char_at(raw, 2);
        let l1 = string_char_at(raw, 3);
        payload_len = (l0 << 8) | l1;
        cursor = 4;
    } else if raw_len == 127 {
        if total_len < 10 {
            return WsDecodeResult(frame: empty_frame, consumed: 0, has_frame: false);
        }
        mut p_len: i64 = 0;
        mut k: i64 = 0;
        while k < 8 {
            let b = string_char_at(raw, 2 + k);
            p_len = (p_len << 8) | b;
            k = k + 1;
        }
        payload_len = p_len;
        cursor = 10;
    }

    mut m0: i64 = 0;
    mut m1: i64 = 0;
    mut m2: i64 = 0;
    mut m3: i64 = 0;
    mut mask_key: i64 = 0;

    if is_masked {
        if total_len < cursor + 4 {
            return WsDecodeResult(frame: empty_frame, consumed: 0, has_frame: false);
        }
        m0 = string_char_at(raw, cursor);
        m1 = string_char_at(raw, cursor + 1);
        m2 = string_char_at(raw, cursor + 2);
        m3 = string_char_at(raw, cursor + 3);
        mask_key = (m0 << 24) | (m1 << 16) | (m2 << 8) | m3;
        cursor = cursor + 4;
    }

    if total_len < cursor + payload_len {
        return WsDecodeResult(frame: empty_frame, consumed: 0, has_frame: false);
    }

    mut payload: String = "";
    if is_masked {
        mut i: i64 = 0;
        while i < payload_len {
            let c = string_char_at(raw, cursor + i);
            let rem_i = i % 4;
            let mb = if rem_i == 0 { m0 }
            else if rem_i == 1 { m1 }
            else if rem_i == 2 { m2 }
            else { m3 };
            payload = payload + string_from_char(c ^ mb);
            i = i + 1;
        }
    } else {
        if payload_len > 0 {
            payload = string_substr(raw, cursor, payload_len);
        }
    }

    let frame = WsFrame(
        fin: fin,
        opcode: opcode,
        is_masked: is_masked,
        mask_key: mask_key,
        payload: payload
    );
    return WsDecodeResult(frame: frame, consumed: cursor + payload_len, has_frame: true);
}

pub fn decode_ws_frame(raw: String) -> WsFrame {
    let res = ws_decode_frame_stream(raw);
    return res.frame;
}

pub fn ws_demux_frames(raw: String) -> List<WsFrame> {
    mut list: List<WsFrame> = List::new();
    mut remainder: String = raw;
    while string_len(remainder) > 0 {
        let dec = ws_decode_frame_stream(remainder);
        if !dec.has_frame || dec.consumed <= 0 {
            return list;
        }
        list.push(dec.frame);
        remainder = string_substr(remainder, dec.consumed, string_len(remainder) - dec.consumed);
    }
    return list;
}

pub fn ws_reassemble_messages(frames: List<WsFrame>) -> List<WsFrame> {
    mut res: List<WsFrame> = List::new();
    let count = frames.len();
    mut in_fragment = false;
    mut frag_opcode: i64 = 0;
    mut frag_payload: String = "";

    mut i: i64 = 0;
    while i < count {
        let f = frames[i];
        if f.opcode == 9 || f.opcode == 10 || f.opcode == 8 {
            // Control frames (Ping, Pong, Close) pass through immediately
            res.push(f);
        } else if f.opcode == 1 || f.opcode == 2 {
            if f.fin {
                res.push(f);
            } else {
                in_fragment = true;
                frag_opcode = f.opcode;
                frag_payload = f.payload;
            }
        } else if f.opcode == 0 {
            // Continuation frame
            if in_fragment {
                frag_payload = frag_payload + f.payload;
                if f.fin {
                    res.push(WsFrame(
                        fin: true,
                        opcode: frag_opcode,
                        is_masked: false,
                        mask_key: 0,
                        payload: frag_payload
                    ));
                    in_fragment = false;
                    frag_payload = "";
                }
            }
        }
        i = i + 1;
    }
    return res;
}

pub fn format_websocket_upgrade_response(accept_key: String) -> String {
    mut res: String = "HTTP/1.1 101 Switching Protocols\r\n";
    res = res + "Upgrade: websocket\r\n";
    res = res + "Connection: Upgrade\r\n";
    res = res + "Sec-WebSocket-Accept: " + accept_key + "\r\n\r\n";
    return res;
}

pub fn format_websocket_handshake_request(host: String, port: i64, path: String, key: String) -> String {
    mut req: String = "GET " + path + " HTTP/1.1\r\n";
    req = req + "Host: " + host + ":" + int_to_string(port) + "\r\n";
    req = req + "Upgrade: websocket\r\n";
    req = req + "Connection: Upgrade\r\n";
    req = req + "Sec-WebSocket-Key: " + key + "\r\n";
    req = req + "Sec-WebSocket-Version: 13\r\n\r\n";
    return req;
}

pub fn websocket_is_handshake_request(raw_http: String) -> bool {
    return string_contains(raw_http, "Upgrade: websocket")
    && string_contains(raw_http, "Sec-WebSocket-Key:");
}

pub fn websocket_extract_key(raw_http: String) -> String {
    let key_marker = "Sec-WebSocket-Key: ";
    let m_len = string_len(key_marker);
    let s_len = string_len(raw_http);
    if s_len < m_len {
        return "";
    }
    mut i: i64 = 0;
    while i <= s_len - m_len {
        mut match_all = true;
        mut j: i64 = 0;
        while j < m_len {
            if string_char_at(raw_http, i + j) != string_char_at(key_marker, j) {
                match_all = false;
                j = m_len;
            }
            j = j + 1;
        }
        if match_all {
            let start = i + m_len;
            mut end = start;
            while end < s_len && string_char_at(raw_http, end) != 13 && string_char_at(raw_http, end) != 10 {
                end = end + 1;
            }
            return string_substr(raw_http, start, end - start);
        }
        i = i + 1;
    }
    return "";
}

pub fn make_ws_server(port: i64, max_clients: i64) -> WsServer {
    let tcp = make_tcp_server(port, max_clients);
    mut upgraded: List<bool> = List::new();
    return WsServer(server: tcp, upgraded_clients: upgraded);
}

pub fn ws_server_port(ws: WsServer) -> i64 {
    return tcp_server_port(ws.server);
}

pub fn ws_server_client_count(ws: WsServer) -> i64 {
    return tcp_server_client_count(ws.server);
}

pub fn ws_server_accept_client(inout ws: WsServer, accept_key: String) -> bool {
    let accepted = tcp_server_accept_client(ws.server);
    if !accepted {
        return false;
    }
    let idx = ws.server.clients.len() - 1;
    let raw_req = stream_read(ws.server.clients[idx], 1024);
    if websocket_is_handshake_request(raw_req) {
        let resp = format_websocket_upgrade_response(accept_key);
        stream_write(ws.server.clients[idx], resp);
        ws.upgraded_clients.push(true);
        return true;
    } else {
        ws.upgraded_clients.push(false);
        return false;
    }
}

pub fn ws_server_broadcast_text(ws: WsServer, text: String) -> i64 {
    let frame = make_ws_text_frame(text, false);
    let wire = encode_ws_frame(frame);
    mut delivered: i64 = 0;
    let count = tcp_server_client_count(ws.server);
    mut i: i64 = 0;
    while i < count {
        if i < ws.upgraded_clients.len() && ws.upgraded_clients[i] {
            let sent = stream_write(ws.server.clients[i], wire);
            if sent > 0 {
                delivered = delivered + 1;
            }
        }
        i = i + 1;
    }
    return delivered;
}

pub fn ws_server_broadcast_binary(ws: WsServer, data: String) -> i64 {
    let frame = make_ws_binary_frame(data, false);
    let wire = encode_ws_frame(frame);
    mut delivered: i64 = 0;
    let count = tcp_server_client_count(ws.server);
    mut i: i64 = 0;
    while i < count {
        if i < ws.upgraded_clients.len() && ws.upgraded_clients[i] {
            let sent = stream_write(ws.server.clients[i], wire);
            if sent > 0 {
                delivered = delivered + 1;
            }
        }
        i = i + 1;
    }
    return delivered;
}

pub fn ws_server_poll_messages(ws: WsServer) -> List<String> {
    mut msgs: List<String> = List::new();
    let count = tcp_server_client_count(ws.server);
    mut i: i64 = 0;
    while i < count {
        if i < ws.upgraded_clients.len() && ws.upgraded_clients[i] {
            let raw = stream_read(ws.server.clients[i], 2048);
            if string_len(raw) > 0 {
                let frame = decode_ws_frame(raw);
                if frame.opcode == 1 {
                    msgs.push(frame.payload);
                } else if frame.opcode == 9 {
                    let pong = make_ws_pong_frame(frame.payload);
                    stream_write(ws.server.clients[i], encode_ws_frame(pong));
                }
            }
        }
        i = i + 1;
    }
    return msgs;
}

pub fn ws_server_close(inout ws: WsServer) {
    tcp_server_close(ws.server);
}

pub fn ws_client_connect(host: String, port: i64, path: String, key: String, expected_accept: String) -> WsClientSession {
    mut stream = make_tcp_connect(host, port);
    if !stream.is_open {
        return WsClientSession(stream: stream, is_upgraded: false, expected_accept: expected_accept);
    }
    let req = format_websocket_handshake_request(host, port, path, key);
    stream_write(stream, req);
    return WsClientSession(stream: stream, is_upgraded: false, expected_accept: expected_accept);
}

pub fn ws_client_poll_handshake(inout client: WsClientSession) -> bool {
    if client.is_upgraded {
        return true;
    }
    let raw = stream_read(client.stream, 1024);
    if string_contains(raw, "101 Switching Protocols") && string_contains(raw, client.expected_accept) {
        client.is_upgraded = true;
        return true;
    }
    return false;
}

pub fn ws_client_send_text(client: WsClientSession, text: String) -> bool {
    let frame = make_ws_text_frame(text, true);
    return stream_write(client.stream, encode_ws_frame(frame)) > 0;
}

pub fn ws_client_send_binary(client: WsClientSession, data: String) -> bool {
    let frame = make_ws_binary_frame(data, true);
    return stream_write(client.stream, encode_ws_frame(frame)) > 0;
}

pub fn ws_client_send_ping(client: WsClientSession, payload: String) -> bool {
    let frame = make_ws_frame(true, 9, true, 305419896, payload);
    return stream_write(client.stream, encode_ws_frame(frame)) > 0;
}

pub fn ws_client_poll_text(client: WsClientSession) -> String {
    let raw = stream_read(client.stream, 2048);
    if string_len(raw) == 0 {
        return "";
    }
    let frame = decode_ws_frame(raw);
    if frame.opcode == 1 {
        return frame.payload;
    }
    return "";
}

pub fn ws_client_poll_binary(client: WsClientSession) -> String {
    let raw = stream_read(client.stream, 2048);
    if string_len(raw) == 0 {
        return "";
    }
    let frame = decode_ws_frame(raw);
    if frame.opcode == 2 {
        return frame.payload;
    }
    return "";
}

pub fn ws_client_close(inout client: WsClientSession) {
    let close_f = make_ws_close_frame(1000, "Normal Closure");
    stream_write(client.stream, encode_ws_frame(close_f));
    stream_close(client.stream);
}

pub fn test_net_http_chunked_streaming() -> bool {
    // 1. Unitaire : encodage et décodage
    let c1 = encode_http_chunk("Alpha");
    let c2 = encode_http_chunk("Beta");
    let c3 = encode_http_chunk("Gamma");
    let c_end = encode_http_chunk_end();

    if c1 != "5\r\nAlpha\r\n" { return false; }
    if c2 != "4\r\nBeta\r\n" { return false; }
    if c_end != "0\r\n\r\n" { return false; }

    let wire_chunks = c1 + c2 + c3 + c_end;
    let decoded = decode_http_chunks(wire_chunks);
    if decoded != "AlphaBetaGamma" {
        return false;
    }

    let resp_header = format_http_chunked_response(200, "text/event-stream");
    if !is_chunked_transfer(resp_header) {
        return false;
    }

    // 2. Intégration sur socket TCP non-bloquant
    mut listener = make_tcp_listener(0);
    if !listener.is_open || listener.port <= 0 {
        return false;
    }

    mut client = make_tcp_connect("127.0.0.1", listener.port);
    if !client.is_open {
        listener_close(listener);
        return false;
    }
    mut server = listener_accept(listener);
    if !server.is_open {
        stream_close(client);
        listener_close(listener);
        return false;
    }

    // Client requests streaming resource
    let client_req = HttpRequest(method: "GET", path: "/stream/events", version: "HTTP/1.1", body: "");
    stream_write(client, format_http_request(client_req, "localhost"));

    let server_raw_req = stream_read(server, 1024);
    let parsed_req = parse_http_request(server_raw_req);
    if parsed_req.method != "GET" || parsed_req.path != "/stream/events" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    // Server streams response chunks
    stream_write(server, resp_header);
    stream_write(server, encode_http_chunk("data:event1\n\n"));
    stream_write(server, encode_http_chunk("data:event2\n\n"));
    stream_write(server, encode_http_chunk_end());

    let client_received = stream_read(client, 4096);
    if !is_chunked_transfer(client_received) {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    // Extract chunked body portion after double CRLF
    let parsed_resp = parse_http_response(client_received);
    let stream_body = decode_http_chunks(parsed_resp.body);
    if stream_body != "data:event1\n\ndata:event2\n\n" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    stream_close(client);
    stream_close(server);
    listener_close(listener);
    return true;
}

pub fn test_net_websocket_framing_and_roundtrip() -> bool {
    // 1. Unitaire : WebSocket framing
    let text_unmasked = make_ws_text_frame("Hello IFA WebSocket!", false);
    let wire_unmasked = encode_ws_frame(text_unmasked);
    let dec_unmasked = decode_ws_frame(wire_unmasked);
    if !dec_unmasked.fin || dec_unmasked.opcode != 1 || dec_unmasked.is_masked || dec_unmasked.payload != "Hello IFA WebSocket!" {
        return false;
    }

    // Text frame masquée (RFC 6455 client-to-server)
    let text_masked = make_ws_text_frame("Secret Message 42", true);
    let wire_masked = encode_ws_frame(text_masked);
    let dec_masked = decode_ws_frame(wire_masked);
    if !dec_masked.fin || dec_masked.opcode != 1 || !dec_masked.is_masked || dec_masked.payload != "Secret Message 42" {
        return false;
    }

    // Ping / Pong frames
    let ping_f = make_ws_ping_frame("heartbeat-id");
    let dec_ping = decode_ws_frame(encode_ws_frame(ping_f));
    if !dec_ping.fin || dec_ping.opcode != 9 || dec_ping.payload != "heartbeat-id" {
        return false;
    }

    let pong_f = make_ws_pong_frame("heartbeat-id");
    let dec_pong = decode_ws_frame(encode_ws_frame(pong_f));
    if !dec_pong.fin || dec_pong.opcode != 10 || dec_pong.payload != "heartbeat-id" {
        return false;
    }

    // Close frame
    let close_f = make_ws_close_frame(1000, "Normal Closure");
    let dec_close = decode_ws_frame(encode_ws_frame(close_f));
    if !dec_close.fin || dec_close.opcode != 8 {
        return false;
    }

    // Handshake helper
    let upgrade_wire = format_websocket_upgrade_response("s3pPLMBiTxaQ9kYGzzhZRbK+xOo=");
    if !string_contains(upgrade_wire, "101 Switching Protocols") || !string_contains(upgrade_wire, "Upgrade: websocket") {
        return false;
    }

    // 2. Intégration sur socket TCP non-bloquant
    mut listener = make_tcp_listener(0);
    if !listener.is_open || listener.port <= 0 {
        return false;
    }

    mut client = make_tcp_connect("127.0.0.1", listener.port);
    if !client.is_open {
        listener_close(listener);
        return false;
    }
    mut server = listener_accept(listener);
    if !server.is_open {
        stream_close(client);
        listener_close(listener);
        return false;
    }

    // Client sends masked text frame over TCP
    let client_ws_msg = make_ws_text_frame("ifa-ws-client-query", true);
    stream_write(client, encode_ws_frame(client_ws_msg));

    let server_raw_ws = stream_read(server, 1024);
    let server_dec_ws = decode_ws_frame(server_raw_ws);
    if !server_dec_ws.fin || server_dec_ws.opcode != 1 || !server_dec_ws.is_masked || server_dec_ws.payload != "ifa-ws-client-query" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    // Server replies with unmasked response frame
    let server_ws_reply = make_ws_text_frame("ifa-ws-server-response", false);
    stream_write(server, encode_ws_frame(server_ws_reply));

    let client_raw_reply = stream_read(client, 1024);
    let client_dec_reply = decode_ws_frame(client_raw_reply);
    if !client_dec_reply.fin || client_dec_reply.opcode != 1 || client_dec_reply.is_masked || client_dec_reply.payload != "ifa-ws-server-response" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    stream_close(client);
    stream_close(server);
    listener_close(listener);
    return true;
}

pub fn test_net_tcp_server_multiple_clients() -> bool {
    mut server = make_tcp_server(0, 8);
    if !server.is_running {
        return false;
    }
    let port = tcp_server_port(server);
    if port <= 0 {
        tcp_server_close(server);
        return false;
    }

    // Connect client 1
    mut c1 = make_tcp_connect("127.0.0.1", port);
    if !c1.is_open {
        tcp_server_close(server);
        return false;
    }
    let acc1 = tcp_server_accept_client(server);
    if !acc1 || tcp_server_client_count(server) != 1 {
        stream_close(c1);
        tcp_server_close(server);
        return false;
    }

    // Connect client 2
    mut c2 = make_tcp_connect("127.0.0.1", port);
    if !c2.is_open {
        stream_close(c1);
        tcp_server_close(server);
        return false;
    }
    let acc2 = tcp_server_accept_client(server);
    if !acc2 || tcp_server_client_count(server) != 2 {
        stream_close(c1);
        stream_close(c2);
        tcp_server_close(server);
        return false;
    }

    // Server broadcasts to both clients
    let delivered = tcp_server_broadcast(server, "IFA_MULTI_CLIENT_BROADCAST");
    if delivered != 2 {
        stream_close(c1);
        stream_close(c2);
        tcp_server_close(server);
        return false;
    }

    // Clients read broadcast
    let r1 = stream_read(c1, 1024);
    let r2 = stream_read(c2, 1024);
    if r1 != "IFA_MULTI_CLIENT_BROADCAST" || r2 != "IFA_MULTI_CLIENT_BROADCAST" {
        stream_close(c1);
        stream_close(c2);
        tcp_server_close(server);
        return false;
    }

    // Client 1 sends message to server
    stream_write(c1, "PAYLOAD_CLIENT_1");
    let msgs = tcp_server_poll(server);
    if msgs.len() != 1 || msgs[0] != "PAYLOAD_CLIENT_1" {
        stream_close(c1);
        stream_close(c2);
        tcp_server_close(server);
        return false;
    }

    // Disconnect client 0
    let dis = tcp_server_disconnect_client(server, 0);
    if !dis {
        stream_close(c1);
        stream_close(c2);
        tcp_server_close(server);
        return false;
    }

    stream_close(c1);
    stream_close(c2);
    tcp_server_close(server);
    return true;
}

pub fn test_net_websocket_server_multiplexing() -> bool {
    let test_key = "dGhlIHNhbXBsZSBub25jZQ==";
    let expected_accept = "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=";

    // 1. Helpers
    let hs_req = format_websocket_handshake_request("127.0.0.1", 8080, "/ws", test_key);
    if !websocket_is_handshake_request(hs_req) {
        return false;
    }
    let extracted_k = websocket_extract_key(hs_req);
    if extracted_k != test_key {
        return false;
    }

    // 2. Server setup
    mut ws_srv = make_ws_server(0, 4);
    let port = ws_server_port(ws_srv);
    if port <= 0 {
        ws_server_close(ws_srv);
        return false;
    }

    // Connect Client 1
    mut c1 = ws_client_connect("127.0.0.1", port, "/ws", test_key, expected_accept);
    let acc1 = ws_server_accept_client(ws_srv, expected_accept);
    if !acc1 || ws_server_client_count(ws_srv) != 1 {
        ws_client_close(c1);
        ws_server_close(ws_srv);
        return false;
    }

    // Connect Client 2
    mut c2 = ws_client_connect("127.0.0.1", port, "/ws", test_key, expected_accept);
    let acc2 = ws_server_accept_client(ws_srv, expected_accept);
    if !acc2 || ws_server_client_count(ws_srv) != 2 {
        ws_client_close(c1);
        ws_client_close(c2);
        ws_server_close(ws_srv);
        return false;
    }

    // Poll handshake on clients
    let h1 = ws_client_poll_handshake(c1);
    let h2 = ws_client_poll_handshake(c2);
    if !h1 || !h2 || !c1.is_upgraded || !c2.is_upgraded {
        ws_client_close(c1);
        ws_client_close(c2);
        ws_server_close(ws_srv);
        return false;
    }

    // Server broadcasts to all WebSocket clients
    let delivered = ws_server_broadcast_text(ws_srv, "IFA_WS_BROADCAST_MSG");
    if delivered != 2 {
        ws_client_close(c1);
        ws_client_close(c2);
        ws_server_close(ws_srv);
        return false;
    }

    // Clients receive broadcast
    let r1 = ws_client_poll_text(c1);
    let r2 = ws_client_poll_text(c2);
    if r1 != "IFA_WS_BROADCAST_MSG" || r2 != "IFA_WS_BROADCAST_MSG" {
        ws_client_close(c1);
        ws_client_close(c2);
        ws_server_close(ws_srv);
        return false;
    }

    // Client 1 and Client 2 send messages to server
    ws_client_send_text(c1, "PAYLOAD_FROM_WS_CLIENT_1");
    ws_client_send_text(c2, "PAYLOAD_FROM_WS_CLIENT_2");
    let msgs = ws_server_poll_messages(ws_srv);
    if msgs.len() != 2 || msgs[0] != "PAYLOAD_FROM_WS_CLIENT_1" || msgs[1] != "PAYLOAD_FROM_WS_CLIENT_2" {
        ws_client_close(c1);
        ws_client_close(c2);
        ws_server_close(ws_srv);
        return false;
    }

    ws_client_close(c1);
    ws_client_close(c2);
    ws_server_close(ws_srv);
    return true;
}

pub fn test_net_websocket_frame_demux_and_fragmentation() -> bool {
    // 1. Binary Frame encoding & decoding
    let bin_frame = make_ws_binary_frame("BINARY_PAYLOAD_DATA", false);
    let bin_wire = encode_ws_frame(bin_frame);
    let bin_dec = decode_ws_frame(bin_wire);
    if !bin_dec.fin || bin_dec.opcode != 2 || bin_dec.is_masked || bin_dec.payload != "BINARY_PAYLOAD_DATA" {
        return false;
    }

    // 2. Close frame with code and reason extraction
    let close_f = make_ws_close_frame(1001, "Server shutdown");
    let close_wire = encode_ws_frame(close_f);
    let close_dec = decode_ws_frame(close_wire);
    if !close_dec.fin || close_dec.opcode != 8 || ws_close_code(close_dec) != 1001 || ws_close_reason(close_dec) != "Server shutdown" {
        return false;
    }

    // 3. Multi-frame streaming demultiplexer
    let f1 = make_ws_text_frame("STREAM_MSG_1", false);
    let f2 = make_ws_ping_frame("STREAM_PING");
    let f3 = make_ws_binary_frame("STREAM_BIN_3", false);
    let stream_wire = encode_ws_frame(f1) + encode_ws_frame(f2) + encode_ws_frame(f3);

    let demuxed = ws_demux_frames(stream_wire);
    if demuxed.len() != 3 {
        return false;
    }
    if demuxed[0].opcode != 1 || demuxed[0].payload != "STREAM_MSG_1" {
        return false;
    }
    if demuxed[1].opcode != 9 || demuxed[1].payload != "STREAM_PING" {
        return false;
    }
    if demuxed[2].opcode != 2 || demuxed[2].payload != "STREAM_BIN_3" {
        return false;
    }

    // 4. Fragmented message reassembly with interleaved Ping
    mut frags: List<WsFrame> = List::new();
    frags.push(make_ws_frame(false, 1, false, 0, "ChunkA-"));
    frags.push(make_ws_ping_frame("HEARTBEAT"));
    frags.push(make_ws_continuation_frame("ChunkB-", false, false));
    frags.push(make_ws_continuation_frame("ChunkC", true, false));

    let reassembled = ws_reassemble_messages(frags);
    if reassembled.len() != 2 {
        return false;
    }
    if reassembled[0].opcode != 9 || reassembled[0].payload != "HEARTBEAT" {
        return false;
    }
    if reassembled[1].opcode != 1 || !reassembled[1].fin || reassembled[1].payload != "ChunkA-ChunkB-ChunkC" {
        return false;
    }

    // 5. Intégration sur socket TCP non-bloquant : client/serveur binaire et ping/pong
    mut listener = make_tcp_listener(0);
    if !listener.is_open || listener.port <= 0 {
        return false;
    }
    mut client = make_tcp_connect("127.0.0.1", listener.port);
    if !client.is_open {
        listener_close(listener);
        return false;
    }
    mut server = listener_accept(listener);
    if !server.is_open {
        stream_close(client);
        listener_close(listener);
        return false;
    }

    // Client sends masked binary frame over TCP
    let client_bin = make_ws_binary_frame("TCP_BIN_MSG", true);
    stream_write(client, encode_ws_frame(client_bin));

    let raw_server = stream_read(server, 1024);
    let s_dec = decode_ws_frame(raw_server);
    if s_dec.opcode != 2 || !s_dec.is_masked || s_dec.payload != "TCP_BIN_MSG" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    // Server sends close frame to client
    let s_close = make_ws_close_frame(1000, "Clean TCP Close");
    stream_write(server, encode_ws_frame(s_close));

    let raw_client = stream_read(client, 1024);
    let c_dec = decode_ws_frame(raw_client);
    if c_dec.opcode != 8 || ws_close_code(c_dec) != 1000 || ws_close_reason(c_dec) != "Clean TCP Close" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    stream_close(client);
    stream_close(server);
    listener_close(listener);
    return true;
}

// ===========================================================================
// Native Stream Compression Subsystem (RFC 1951 Deflate, RFC 1952 Gzip, Zlib)
// ===========================================================================

pub fn net_crc32(bytes: List<i64>) -> i64 {
    mut crc: i64 = 4294967295; // 0xFFFFFFFF
    let len = bytes.len();
    mut i: i64 = 0;
    while i < len {
        let b = bytes[i] & 255;
        crc = crc ^ b;
        mut j: i64 = 0;
        while j < 8 {
            if (crc & 1) != 0 {
                crc = (crc >> 1) ^ 3988292384; // 0xEDB88320
            } else {
                crc = crc >> 1;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return (crc ^ 4294967295) & 4294967295;
}

pub fn net_crc32_string(text: String) -> i64 {
    let bytes = net_string_to_bytes(text);
    return net_crc32(bytes);
}

pub fn net_adler32(bytes: List<i64>) -> i64 {
    mut s1: i64 = 1;
    mut s2: i64 = 0;
    let len = bytes.len();
    mut i: i64 = 0;
    while i < len {
        let b = bytes[i] & 255;
        s1 = (s1 + b) % 65521;
        s2 = (s2 + s1) % 65521;
        i = i + 1;
    }
    return ((s2 << 16) | s1) & 4294967295;
}

pub fn net_adler32_string(text: String) -> i64 {
    let bytes = net_string_to_bytes(text);
    return net_adler32(bytes);
}

pub fn net_string_to_bytes(s: String) -> List<i64> {
    let len = string_len(s);
    mut bytes: List<i64> = List::new();
    mut i: i64 = 0;
    while i < len {
        bytes.push(string_char_at(s, i));
        i = i + 1;
    }
    return bytes;
}

pub fn net_bytes_to_string(bytes: List<i64>) -> String {
    let chars = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
    let len = bytes.len();
    mut out = "";
    mut i: i64 = 0;
    while i < len {
        let b = bytes[i] & 255;
        if b == 10 {
            out = out + "\n";
        } else if b == 13 {
            out = out + "\r";
        } else if b == 9 {
            out = out + "\t";
        } else if b >= 32 && b <= 126 {
            out = out + string_substr(chars, b - 32, 1);
        }
        i = i + 1;
    }
    return out;
}

pub fn net_bytes_to_binary_string(bytes: List<i64>) -> String {
    let len = bytes.len();
    mut out = "";
    mut i: i64 = 0;
    while i < len {
        out = out + string_from_char(bytes[i] & 255);
        i = i + 1;
    }
    return out;
}

pub fn net_binary_string_to_bytes(s: String) -> List<i64> {
    let len = string_len(s);
    mut bytes: List<i64> = List::new();
    mut i: i64 = 0;
    while i < len {
        bytes.push(string_char_at(s, i) & 255);
        i = i + 1;
    }
    return bytes;
}

pub fn deflate_compress_bytes(data: List<i64>) -> List<i64> {
    mut out: List<i64> = List::new();
    let total_len = data.len();
    if total_len == 0 {
        out.push(1); // BFINAL=1, BTYPE=00
        out.push(0);
        out.push(0);
        out.push(255);
        out.push(255);
        return out;
    }

    mut pos: i64 = 0;
    while pos < total_len {
        mut chunk_len = total_len - pos;
        if chunk_len > 32768 {
            chunk_len = 32768;
        }
        let is_final = if pos + chunk_len >= total_len { 1 } else { 0 };
        out.push(is_final);
        out.push(chunk_len & 255);
        out.push((chunk_len >> 8) & 255);
        let nlen = 65535 - chunk_len;
        out.push(nlen & 255);
        out.push((nlen >> 8) & 255);

        mut k: i64 = 0;
        while k < chunk_len {
            out.push(data[pos + k] & 255);
            k = k + 1;
        }
        pos = pos + chunk_len;
    }
    return out;
}

pub fn deflate_decompress_bytes(compressed: List<i64>) -> List<i64> {
    mut out: List<i64> = List::new();
    let comp_len = compressed.len();
    mut pos: i64 = 0;

    while pos < comp_len {
        let header = compressed[pos];
        pos = pos + 1;
        let is_final = header & 1;
        let btype = (header >> 1) & 3;

        if btype == 0 {
            if pos + 4 > comp_len {
                return out;
            }
            let len_lo = compressed[pos];
            let len_hi = compressed[pos + 1];
            pos = pos + 2;
            let block_len = len_lo | (len_hi << 8);

            let nlen_lo = compressed[pos];
            let nlen_hi = compressed[pos + 1];
            pos = pos + 2;
            let nlen = nlen_lo | (nlen_hi << 8);

            if (block_len ^ nlen) != 65535 {
                return out;
            }

            mut k: i64 = 0;
            while k < block_len && pos < comp_len {
                out.push(compressed[pos]);
                pos = pos + 1;
                k = k + 1;
            }

            if is_final == 1 {
                return out;
            }
        } else {
            return out;
        }
    }

    return out;
}

pub fn deflate_compress_string(text: String) -> List<i64> {
    let bytes = net_string_to_bytes(text);
    return deflate_compress_bytes(bytes);
}

pub fn deflate_decompress_string(compressed: List<i64>) -> String {
    let bytes = deflate_decompress_bytes(compressed);
    return net_bytes_to_string(bytes);
}

pub fn gzip_compress_bytes(data: List<i64>) -> List<i64> {
    mut out: List<i64> = List::new();
    // 10-byte Gzip Header (RFC 1952)
    out.push(31); // 0x1F ID1
    out.push(139); // 0x8B ID2
    out.push(8); // CM = 8 (Deflate)
    out.push(0); // FLG = 0
    out.push(0); // MTIME
    out.push(0);
    out.push(0);
    out.push(0);
    out.push(0); // XFL = 0
    out.push(255); // OS = 255

    // Deflate payload
    let deflated = deflate_compress_bytes(data);
    let def_len = deflated.len();
    mut i: i64 = 0;
    while i < def_len {
        out.push(deflated[i]);
        i = i + 1;
    }

    // 8-byte Trailer: CRC32 (4 bytes LE) + ISIZE (4 bytes LE)
    let crc = net_crc32(data);
    out.push(crc & 255);
    out.push((crc >> 8) & 255);
    out.push((crc >> 16) & 255);
    out.push((crc >> 24) & 255);

    let isize = data.len() & 4294967295;
    out.push(isize & 255);
    out.push((isize >> 8) & 255);
    out.push((isize >> 16) & 255);
    out.push((isize >> 24) & 255);

    return out;
}

pub fn gzip_decompress_bytes(gz: List<i64>) -> List<i64> {
    let gz_len = gz.len();
    if gz_len < 18 {
        return List::new();
    }
    if gz[0] != 31 || gz[1] != 139 || gz[2] != 8 {
        return List::new();
    }

    let flg = gz[3];
    mut pos: i64 = 10;

    if (flg & 4) != 0 && pos + 2 <= gz_len {
        let xlen = gz[pos] | (gz[pos + 1] << 8);
        pos = pos + 2 + xlen;
    }
    if (flg & 8) != 0 {
        while pos < gz_len && gz[pos] != 0 {
            pos = pos + 1;
        }
        pos = pos + 1;
    }
    if (flg & 16) != 0 {
        while pos < gz_len && gz[pos] != 0 {
            pos = pos + 1;
        }
        pos = pos + 1;
    }
    if (flg & 2) != 0 {
        pos = pos + 2;
    }

    if pos >= gz_len - 8 {
        return List::new();
    }

    let payload_end = gz_len - 8;
    mut deflated_slice: List<i64> = List::new();
    mut i = pos;
    while i < payload_end {
        deflated_slice.push(gz[i]);
        i = i + 1;
    }

    let decompressed = deflate_decompress_bytes(deflated_slice);

    let expected_crc = (gz[gz_len - 8] & 255)
    | ((gz[gz_len - 7] & 255) << 8)
    | ((gz[gz_len - 6] & 255) << 16)
    | ((gz[gz_len - 5] & 255) << 24);
    let actual_crc = net_crc32(decompressed);
    if expected_crc != actual_crc {
        return List::new();
    }

    let expected_isize = (gz[gz_len - 4] & 255)
    | ((gz[gz_len - 3] & 255) << 8)
    | ((gz[gz_len - 2] & 255) << 16)
    | ((gz[gz_len - 1] & 255) << 24);
    let actual_isize = decompressed.len() & 4294967295;
    if expected_isize != actual_isize {
        return List::new();
    }

    return decompressed;
}

pub fn gzip_compress_string(text: String) -> List<i64> {
    let bytes = net_string_to_bytes(text);
    return gzip_compress_bytes(bytes);
}

pub fn gzip_decompress_string(gz: List<i64>) -> String {
    let bytes = gzip_decompress_bytes(gz);
    return net_bytes_to_string(bytes);
}

pub fn zlib_compress_bytes(data: List<i64>) -> List<i64> {
    mut out: List<i64> = List::new();
    out.push(120); // 0x78
    out.push(1); // 0x01

    let deflated = deflate_compress_bytes(data);
    let def_len = deflated.len();
    mut i: i64 = 0;
    while i < def_len {
        out.push(deflated[i]);
        i = i + 1;
    }

    let adler = net_adler32(data);
    out.push((adler >> 24) & 255);
    out.push((adler >> 16) & 255);
    out.push((adler >> 8) & 255);
    out.push(adler & 255);

    return out;
}

pub fn zlib_decompress_bytes(z: List<i64>) -> List<i64> {
    let z_len = z.len();
    if z_len < 6 {
        return List::new();
    }
    let cmf = z[0];
    let flg = z[1];
    if (cmf * 256 + flg) % 31 != 0 {
        return List::new();
    }

    let payload_end = z_len - 4;
    mut deflated_slice: List<i64> = List::new();
    mut i: i64 = 2;
    while i < payload_end {
        deflated_slice.push(z[i]);
        i = i + 1;
    }

    let decompressed = deflate_decompress_bytes(deflated_slice);
    let expected_adler = ((z[z_len - 4] & 255) << 24)
    | ((z[z_len - 3] & 255) << 16)
    | ((z[z_len - 2] & 255) << 8)
    | (z[z_len - 1] & 255);
    let actual_adler = net_adler32(decompressed);
    if expected_adler != actual_adler {
        return List::new();
    }

    return decompressed;
}

pub fn zlib_compress_string(text: String) -> List<i64> {
    let bytes = net_string_to_bytes(text);
    return zlib_compress_bytes(bytes);
}

pub fn zlib_decompress_string(z: List<i64>) -> String {
    let bytes = zlib_decompress_bytes(z);
    return net_bytes_to_string(bytes);
}

// ===========================================================================
// HTTP Compression & Automatic Server Negotiation (RFC 1952 / RFC 1951)
// ===========================================================================

pub fn http_header_accepts_encoding(raw_headers_or_req: String, encoding: String) -> bool {
    let accept = http_get_header(raw_headers_or_req, "Accept-Encoding");
    if string_len(accept) == 0 {
        return false;
    }
    return string_contains(accept, encoding);
}

pub fn http_get_content_encoding(raw_headers_or_msg: String) -> String {
    let enc = http_get_header(raw_headers_or_msg, "Content-Encoding");
    if string_len(enc) == 0 {
        return "identity";
    }
    return enc;
}

pub fn http_compress_payload_gzip(body_text: String) -> String {
    let gz_bytes = gzip_compress_string(body_text);
    return net_bytes_to_binary_string(gz_bytes);
}

pub fn http_decompress_payload_gzip(binary_body: String) -> String {
    let gz_bytes = net_binary_string_to_bytes(binary_body);
    return gzip_decompress_string(gz_bytes);
}

pub fn http_compress_payload_deflate(body_text: String) -> String {
    let def_bytes = deflate_compress_string(body_text);
    return net_bytes_to_binary_string(def_bytes);
}

pub fn http_decompress_payload_deflate(binary_body: String) -> String {
    let def_bytes = net_binary_string_to_bytes(binary_body);
    return deflate_decompress_string(def_bytes);
}

pub fn format_http_compressed_response(resp: HttpResponse, req_raw: String, min_compression_len: i64) -> String {
    let body_len = string_len(resp.body);
    let accepts_gz = http_header_accepts_encoding(req_raw, "gzip");
    let accepts_def = http_header_accepts_encoding(req_raw, "deflate");

    mut final_body = resp.body;
    mut content_encoding = "";

    if body_len >= min_compression_len {
        if accepts_gz {
            let gz_bytes = gzip_compress_string(resp.body);
            final_body = net_bytes_to_binary_string(gz_bytes);
            content_encoding = "gzip";
        } else if accepts_def {
            let def_bytes = deflate_compress_string(resp.body);
            final_body = net_bytes_to_binary_string(def_bytes);
            content_encoding = "deflate";
        }
    }

    let comp_body_len = string_len(final_body);
    let len_str = int_to_string(comp_body_len);
    let code_str = int_to_string(resp.status_code);

    mut res: String = "HTTP/1.1 " + code_str + " " + resp.status_text + "\r\n";
    res = res + "Content-Type: " + resp.content_type + "\r\n";
    if string_len(content_encoding) > 0 {
        res = res + "Content-Encoding: " + content_encoding + "\r\n";
    }
    res = res + "Content-Length: " + len_str + "\r\n";
    res = res + "Connection: close\r\n";
    res = res + "\r\n";
    res = res + final_body;
    return res;
}

pub fn http_decompress_response_body(resp: HttpResponse, raw_resp: String) -> String {
    let enc = http_get_content_encoding(raw_resp);
    if enc == "gzip" {
        return http_decompress_payload_gzip(resp.body);
    } else if enc == "deflate" {
        return http_decompress_payload_deflate(resp.body);
    }
    return resp.body;
}

// ===========================================================================
// Secure HTTP Client & Token Negotiation Subsystem
// ===========================================================================

pub fn format_http_request_with_headers(req: HttpRequest, host: String, headers: List<HttpHeader>) -> String {
    let body_len = string_len(req.body);
    let len_str = int_to_string(body_len);
    mut out: String = req.method + " " + req.path + " " + req.version + "\r\n";
    out = out + "Host: " + host + "\r\n";
    let h_len = headers.len();
    mut i: i64 = 0;
    while i < h_len {
        let hdr = headers[i];
        out = out + hdr.name + ": " + hdr.value + "\r\n";
        i = i + 1;
    }
    if body_len > 0 {
        out = out + "Content-Length: " + len_str + "\r\n";
    }
    out = out + "Connection: close\r\n\r\n";
    if body_len > 0 {
        out = out + req.body;
    }
    return out;
}

pub fn format_http_request_secure(req: HttpRequest, host: String, config: HttpClientConfig) -> String {
    let body_len = string_len(req.body);
    let len_str = int_to_string(body_len);
    mut out: String = req.method + " " + req.path + " " + req.version + "\r\n";
    out = out + "Host: " + host + "\r\n";
    if string_len(config.user_agent) > 0 {
        out = out + "User-Agent: " + config.user_agent + "\r\n";
    }
    if string_len(config.accept_encoding) > 0 {
        out = out + "Accept-Encoding: " + config.accept_encoding + "\r\n";
    }
    if string_len(config.bearer_token) > 0 {
        out = out + "Authorization: Bearer " + config.bearer_token + "\r\n";
    }
    if string_len(config.api_key_header) > 0 && string_len(config.api_key_value) > 0 {
        out = out + config.api_key_header + ": " + config.api_key_value + "\r\n";
    }
    if body_len > 0 {
        out = out + "Content-Length: " + len_str + "\r\n";
        out = out + "Content-Type: " + config.content_type + "\r\n";
    }
    out = out + "Connection: close\r\n\r\n";
    if body_len > 0 {
        out = out + req.body;
    }
    return out;
}

pub fn http_execute_request(host: String, port: i64, req: HttpRequest, config: HttpClientConfig) -> HttpResponse {
    mut stream = make_tcp_connect(host, port);
    if !stream.is_open {
        return HttpResponse(status_code: 503, status_text: "Service Unavailable", content_type: "text/plain", body: "Connection failed");
    }

    let wire = format_http_request_secure(req, host, config);
    stream_write(stream, wire);
    let resp_str = stream_read(stream, 65536);
    stream_close(stream);
    return parse_http_response(resp_str);
}

pub fn http_get_secure(host: String, port: i64, path: String, config: HttpClientConfig) -> HttpResponse {
    let req = HttpRequest(method: "GET", path: path, version: "HTTP/1.1", body: "");
    return http_execute_request(host, port, req, config);
}

pub fn http_post_secure(host: String, port: i64, path: String, body: String, config: HttpClientConfig) -> HttpResponse {
    let req = HttpRequest(method: "POST", path: path, version: "HTTP/1.1", body: body);
    return http_execute_request(host, port, req, config);
}

pub fn http_put_secure(host: String, port: i64, path: String, body: String, config: HttpClientConfig) -> HttpResponse {
    let req = HttpRequest(method: "PUT", path: path, version: "HTTP/1.1", body: body);
    return http_execute_request(host, port, req, config);
}

pub fn http_delete_secure(host: String, port: i64, path: String, config: HttpClientConfig) -> HttpResponse {
    let req = HttpRequest(method: "DELETE", path: path, version: "HTTP/1.1", body: "");
    return http_execute_request(host, port, req, config);
}

pub fn json_extract_string_field(json_str: String, field_name: String) -> String {
    let key = "\"" + field_name + "\"";
    let k_len = string_len(key);
    let total_len = string_len(json_str);
    mut i: i64 = 0;
    while i <= total_len - k_len {
        mut matches = true;
        mut k: i64 = 0;
        while k < k_len {
            if string_char_at(json_str, i + k) != string_char_at(key, k) {
                matches = false;
                k = k_len;
            }
            k = k + 1;
        }

        if matches {
            mut pos = i + k_len;
            while pos < total_len && string_char_at(json_str, pos) != 58 { // ':'
                pos = pos + 1;
            }
            pos = pos + 1;
            while pos < total_len && (string_char_at(json_str, pos) == 32 || string_char_at(json_str, pos) == 9) {
                pos = pos + 1;
            }
            if pos < total_len && string_char_at(json_str, pos) == 34 { // '"'
                pos = pos + 1;
                let start_val = pos;
                while pos < total_len && string_char_at(json_str, pos) != 34 {
                    pos = pos + 1;
                }
                return string_substr(json_str, start_val, pos - start_val);
            }
        }
        i = i + 1;
    }
    return "";
}

pub fn json_extract_int_field(json_str: String, field_name: String) -> i64 {
    let key = "\"" + field_name + "\"";
    let k_len = string_len(key);
    let total_len = string_len(json_str);
    mut i: i64 = 0;
    while i <= total_len - k_len {
        mut matches = true;
        mut k: i64 = 0;
        while k < k_len {
            if string_char_at(json_str, i + k) != string_char_at(key, k) {
                matches = false;
                k = k_len;
            }
            k = k + 1;
        }

        if matches {
            mut pos = i + k_len;
            while pos < total_len && string_char_at(json_str, pos) != 58 { // ':'
                pos = pos + 1;
            }
            pos = pos + 1;
            while pos < total_len && (string_char_at(json_str, pos) == 32 || string_char_at(json_str, pos) == 9) {
                pos = pos + 1;
            }
            let start_val = pos;
            while pos < total_len && string_char_at(json_str, pos) >= 48 && string_char_at(json_str, pos) <= 57 {
                pos = pos + 1;
            }
            let val_str = string_substr(json_str, start_val, pos - start_val);
            return string_to_int(val_str);
        }
        i = i + 1;
    }
    return 0;
}

pub fn parse_token_response(json_payload: String) -> TokenNegotiationResponse {
    let token = json_extract_string_field(json_payload, "access_token");
    let t_type = json_extract_string_field(json_payload, "token_type");
    let exp = json_extract_int_field(json_payload, "expires_in");
    let refresh = json_extract_string_field(json_payload, "refresh_token");
    let is_valid = string_len(token) > 0;
    return TokenNegotiationResponse(
        access_token: token,
        token_type: if string_len(t_type) > 0 { t_type } else { "Bearer" },
        expires_in: if exp > 0 { exp } else { 3600 },
        refresh_token: refresh,
        is_valid: is_valid
    );
}

pub fn http_negotiate_token(host: String, port: i64, auth_path: String, client_id: String, client_secret: String) -> TokenNegotiationResponse {
    let payload = "{\"client_id\":\"" + client_id + "\",\"client_secret\":\"" + client_secret + "\",\"grant_type\":\"client_credentials\"}";
    let cfg = make_http_client_config();
    let resp = http_post_secure(host, port, auth_path, payload, cfg);
    if resp.status_code != 200 {
        return make_token_response("", "", 0, "", false);
    }
    return parse_token_response(resp.body);
}

pub fn http_refresh_token(host: String, port: i64, refresh_path: String, refresh_token: String) -> TokenNegotiationResponse {
    let payload = "{\"refresh_token\":\"" + refresh_token + "\",\"grant_type\":\"refresh_token\"}";
    let cfg = make_http_client_config();
    let resp = http_post_secure(host, port, refresh_path, payload, cfg);
    if resp.status_code != 200 {
        return make_token_response("", "", 0, "", false);
    }
    return parse_token_response(resp.body);
}

pub fn http_authenticate_and_request(host: String, port: i64, auth_path: String, resource_path: String, client_id: String, client_secret: String) -> HttpResponse {
    let tok_resp = http_negotiate_token(host, port, auth_path, client_id, client_secret);
    if !tok_resp.is_valid {
        return HttpResponse(status_code: 401, status_text: "Unauthorized", content_type: "application/json", body: "{\"error\":\"Token negotiation failed\"}");
    }
    let client_cfg = http_client_with_bearer(tok_resp.access_token);
    return http_get_secure(host, port, resource_path, client_cfg);
}

// ===========================================================================
// Tests for Compression and Secure HTTP Client
// ===========================================================================

pub fn test_net_crc32_and_adler32() -> bool {
    let crc = net_crc32_string("123456789");
    if crc != 3421780262 {
        return false;
    }

    let adler = net_adler32_string("Wikipedia");
    if adler != 300286872 {
        return false;
    }

    return true;
}

pub fn test_net_deflate_compression_roundtrip() -> bool {
    let original = "IFA Pure Language Native RFC 1951 Deflate Stream Engine";
    let compressed = deflate_compress_string(original);
    if compressed.len() <= 5 {
        return false;
    }
    if (compressed[0] & 1) != 1 {
        return false;
    }
    let restored = deflate_decompress_string(compressed);
    return restored == original;
}

pub fn test_net_gzip_compression_roundtrip() -> bool {
    let original = "IFA RFC 1952 Gzip Native Compression Header, Deflate and Trailer";
    let gz = gzip_compress_string(original);
    if gz.len() < 18 {
        return false;
    }
    if gz[0] != 31 || gz[1] != 139 || gz[2] != 8 {
        return false;
    }
    let restored = gzip_decompress_string(gz);
    return restored == original;
}

pub fn test_net_http_secure_client_token_negotiation() -> bool {
    mut listener = make_tcp_listener(0);
    if !listener.is_open || listener.port <= 0 {
        return false;
    }

    // Step 1: Client negotiates token with auth server
    mut client = make_tcp_connect("127.0.0.1", listener.port);
    if !client.is_open {
        listener_close(listener);
        return false;
    }

    mut server = listener_accept(listener);
    if !server.is_open {
        stream_close(client);
        listener_close(listener);
        return false;
    }

    let auth_body = "{\"client_id\":\"ifa-app\",\"client_secret\":\"ifa-secret-77\"}";
    let client_cfg = make_http_client_config();
    let auth_req = HttpRequest(method: "POST", path: "/oauth/token", version: "HTTP/1.1", body: auth_body);
    let wire_auth_req = format_http_request_secure(auth_req, "127.0.0.1", client_cfg);
    stream_write(client, wire_auth_req);

    let raw_auth_req = stream_read(server, 1024);
    let parsed_auth_req = parse_http_request(raw_auth_req);
    if parsed_auth_req.method != "POST" || parsed_auth_req.path != "/oauth/token" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    let token_json = "{\"access_token\":\"ifa_bearer_sec_9911\",\"token_type\":\"Bearer\",\"expires_in\":3600,\"refresh_token\":\"ifa_ref_5522\"}";
    let auth_resp = make_http_response(200, "OK", "application/json", token_json);
    let wire_auth_resp = format_http_response(auth_resp);
    stream_write(server, wire_auth_resp);

    let raw_auth_resp = stream_read(client, 1024);
    let parsed_auth_resp = parse_http_response(raw_auth_resp);
    let tok = parse_token_response(parsed_auth_resp.body);
    if !tok.is_valid || tok.access_token != "ifa_bearer_sec_9911" || tok.expires_in != 3600 || tok.refresh_token != "ifa_ref_5522" {
        stream_close(client);
        stream_close(server);
        listener_close(listener);
        return false;
    }

    stream_close(client);
    stream_close(server);

    // Step 2: Client performs authenticated API request using negotiated Bearer token
    mut client2 = make_tcp_connect("127.0.0.1", listener.port);
    if !client2.is_open {
        listener_close(listener);
        return false;
    }

    mut server2 = listener_accept(listener);
    if !server2.is_open {
        stream_close(client2);
        listener_close(listener);
        return false;
    }

    let auth_cfg = http_client_with_bearer(tok.access_token);
    let api_req = HttpRequest(method: "GET", path: "/api/v1/protected-data", version: "HTTP/1.1", body: "");
    let wire_api_req = format_http_request_secure(api_req, "127.0.0.1", auth_cfg);
    stream_write(client2, wire_api_req);

    let raw_api_req = stream_read(server2, 1024);
    let auth_header = http_get_header(raw_api_req, "Authorization");
    if auth_header != "Bearer ifa_bearer_sec_9911" {
        stream_close(client2);
        stream_close(server2);
        listener_close(listener);
        return false;
    }

    let api_resp = make_http_response(200, "OK", "application/json", "{\"status\":\"authorized\",\"identity\":\"ifa-app\"}");
    let wire_api_resp = format_http_response(api_resp);
    stream_write(server2, wire_api_resp);

    let raw_api_resp = stream_read(client2, 1024);
    let parsed_api_resp = parse_http_response(raw_api_resp);
    if parsed_api_resp.status_code != 200 || !string_contains(parsed_api_resp.body, "authorized") {
        stream_close(client2);
        stream_close(server2);
        listener_close(listener);
        return false;
    }

    stream_close(client2);
    stream_close(server2);
    listener_close(listener);
    return true;
}

pub fn hex_nibble_to_char(nibble: i64) -> String {
    if nibble == 0 { return "0"; }
    else if nibble == 1 { return "1"; }
    else if nibble == 2 { return "2"; }
    else if nibble == 3 { return "3"; }
    else if nibble == 4 { return "4"; }
    else if nibble == 5 { return "5"; }
    else if nibble == 6 { return "6"; }
    else if nibble == 7 { return "7"; }
    else if nibble == 8 { return "8"; }
    else if nibble == 9 { return "9"; }
    else if nibble == 10 { return "A"; }
    else if nibble == 11 { return "B"; }
    else if nibble == 12 { return "C"; }
    else if nibble == 13 { return "D"; }
    else if nibble == 14 { return "E"; }
    else if nibble == 15 { return "F"; }
    return "0";
}

pub fn hex_char_to_nibble(c: i64) -> i64 {
    if c >= 48 && c <= 57 { // '0'..'9'
        return c - 48;
    } else if c >= 65 && c <= 70 { // 'A'..'F'
        return c - 65 + 10;
    } else if c >= 97 && c <= 102 { // 'a'..'f'
        return c - 97 + 10;
    }
    return -1;
}

pub fn is_url_unreserved(c: i64) -> bool {
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
        return true;
    }
    if c == 45 || c == 95 || c == 46 || c == 126 { // '-', '_', '.', '~'
        return true;
    }
    return false;
}

pub fn url_encode(raw: String) -> String {
    let len = string_len(raw);
    mut res: String = "";
    mut i: i64 = 0;
    while i < len {
        let c = string_char_at(raw, i);
        if is_url_unreserved(c) {
            res = res + string_substr(raw, i, 1);
        } else {
            let high = (c / 16) % 16;
            let low = c % 16;
            res = res + "%" + hex_nibble_to_char(high) + hex_nibble_to_char(low);
        }
        i = i + 1;
    }
    return res;
}

pub fn url_decode(raw: String) -> String {
    let len = string_len(raw);
    mut res: String = "";
    mut i: i64 = 0;
    while i < len {
        let c = string_char_at(raw, i);
        if c == 37 && i + 2 < len { // '%'
            let h1 = hex_char_to_nibble(string_char_at(raw, i + 1));
            let h2 = hex_char_to_nibble(string_char_at(raw, i + 2));
            if h1 >= 0 && h2 >= 0 {
                let code = h1 * 16 + h2;
                res = res + string_from_char(code);
                i = i + 2;
            } else {
                res = res + string_substr(raw, i, 1);
            }
        } else if c == 43 { // '+' -> ' '
            res = res + " ";
        } else {
            res = res + string_substr(raw, i, 1);
        }
        i = i + 1;
    }
    return res;
}

pub fn form_urlencoded_set(existing: String, key: String, value: String) -> String {
    let enc_k = url_encode(key);
    let enc_v = url_encode(value);
    let pair = enc_k + "=" + enc_v;
    if string_len(existing) == 0 {
        return pair;
    }
    return existing + "&" + pair;
}

pub fn form_urlencoded_get(body: String, key: String) -> String {
    let b_len = string_len(body);
    let k_len = string_len(key);
    if b_len == 0 || k_len == 0 {
        return "";
    }
    let target_key = url_encode(key);

    mut i: i64 = 0;
    while i < b_len {
        let pair_start = i;
        mut pair_end = b_len;
        mut eq_idx: i64 = -1;
        mut j = i;
        while j < b_len {
            let c = string_char_at(body, j);
            if c == 61 && eq_idx < 0 { // '='
                eq_idx = j;
            } else if c == 38 { // '&'
                pair_end = j;
                j = b_len;
            }
            j = j + 1;
        }

        if eq_idx > pair_start {
            let k_found = string_substr(body, pair_start, eq_idx - pair_start);
            if k_found == target_key || url_decode(k_found) == key {
                let v_enc = string_substr(body, eq_idx + 1, pair_end - eq_idx - 1);
                return url_decode(v_enc);
            }
        }
        i = pair_end + 1;
    }
    return "";
}

pub fn http_cookie_get(cookie_header: String, name: String) -> String {
    let h_len = string_len(cookie_header);
    let n_len = string_len(name);
    if h_len == 0 || n_len == 0 {
        return "";
    }

    mut i: i64 = 0;
    while i < h_len {
        while i < h_len && (string_char_at(cookie_header, i) == 32 || string_char_at(cookie_header, i) == 9) {
            i = i + 1;
        }
        let pair_start = i;
        mut pair_end = h_len;
        mut eq_idx: i64 = -1;
        mut j = i;
        while j < h_len {
            let c = string_char_at(cookie_header, j);
            if c == 61 && eq_idx < 0 { // '='
                eq_idx = j;
            } else if c == 59 { // ';'
                pair_end = j;
                j = h_len;
            }
            j = j + 1;
        }

        if eq_idx > pair_start {
            let k_found = string_substr(cookie_header, pair_start, eq_idx - pair_start);
            if k_found == name {
                return string_substr(cookie_header, eq_idx + 1, pair_end - eq_idx - 1);
            }
        }
        i = pair_end + 1;
    }
    return "";
}

pub fn http_format_set_cookie(name: String, value: String, path: String, max_age_secs: i64, secure: bool, http_only: bool, same_site: String) -> String {
    mut res: String = name + "=" + value;
    if string_len(path) > 0 {
        res = res + "; Path=" + path;
    }
    if max_age_secs >= 0 {
        res = res + "; Max-Age=" + int_to_string(max_age_secs);
    }
    if string_len(same_site) > 0 {
        res = res + "; SameSite=" + same_site;
    }
    if secure {
        res = res + "; Secure";
    }
    if http_only {
        res = res + "; HttpOnly";
    }
    return res;
}

pub fn make_http_cookie(name: String, value: String) -> HttpCookie {
    return HttpCookie(
        name: name,
        value: value,
        path: "/",
        domain: "",
        max_age_secs: -1,
        secure: false,
        http_only: false,
        same_site: "Lax",
        created_at_sec: 0
    );
}

pub fn make_http_cookie_jar() -> HttpCookieJar {
    return HttpCookieJar(cookies: List::new());
}

pub fn cookie_jar_len(jar: HttpCookieJar) -> i64 {
    return jar.cookies.len();
}

pub fn cookie_jar_add(inout jar: HttpCookieJar, cookie: HttpCookie) {
    mut next: List<HttpCookie> = List::new();
    mut i: i64 = 0;
    let n = jar.cookies.len();
    mut replaced: bool = false;
    while i < n {
        if jar.cookies[i].name == cookie.name {
            next.push(cookie);
            replaced = true;
        } else {
            next.push(jar.cookies[i]);
        }
        i = i + 1;
    }
    if !replaced {
        next.push(cookie);
    }
    jar.cookies = next;
}

pub fn cookie_jar_get(jar: HttpCookieJar, name: String) -> String {
    mut i: i64 = 0;
    let n = jar.cookies.len();
    while i < n {
        if jar.cookies[i].name == name {
            return jar.cookies[i].value;
        }
        i = i + 1;
    }
    return "";
}

pub fn cookie_jar_remove(inout jar: HttpCookieJar, name: String) -> bool {
    mut next: List<HttpCookie> = List::new();
    mut i: i64 = 0;
    let n = jar.cookies.len();
    mut removed: bool = false;
    while i < n {
        if jar.cookies[i].name == name {
            removed = true;
        } else {
            next.push(jar.cookies[i]);
        }
        i = i + 1;
    }
    jar.cookies = next;
    return removed;
}

pub fn cookie_jar_to_header(jar: HttpCookieJar) -> String {
    mut res: String = "";
    mut i: i64 = 0;
    let n = jar.cookies.len();
    while i < n {
        if i > 0 {
            res = res + "; ";
        }
        res = res + jar.cookies[i].name + "=" + jar.cookies[i].value;
        i = i + 1;
    }
    return res;
}

pub fn make_http_session(session_id: String, user_id: String, role: String, ttl_secs: i64, now_sec: i64) -> HttpSession {
    return HttpSession(
        session_id: session_id,
        user_id: user_id,
        role: role,
        created_at_sec: now_sec,
        last_accessed_sec: now_sec,
        ttl_secs: ttl_secs,
        is_active: true
    );
}

pub fn make_http_session_store(default_ttl_secs: i64) -> HttpSessionStore {
    return HttpSessionStore(
        sessions: List::new(),
        default_ttl_secs: default_ttl_secs,
        counter: 1000
    );
}

pub fn session_is_valid(session: HttpSession, now_sec: i64) -> bool {
    if !session.is_active {
        return false;
    }
    if session.ttl_secs > 0 && (now_sec - session.last_accessed_sec >= session.ttl_secs) {
        return false;
    }
    return true;
}

pub fn session_store_create(inout store: HttpSessionStore, user_id: String, role: String, now_sec: i64) -> String {
    store.counter = store.counter + 1;
    let sid = "ifa_sess_" + int_to_string(store.counter);
    let sess = make_http_session(sid, user_id, role, store.default_ttl_secs, now_sec);
    store.sessions.push(sess);
    return sid;
}

pub fn session_store_find(store: HttpSessionStore, session_id: String, now_sec: i64) -> HttpSession {
    mut i: i64 = 0;
    let n = store.sessions.len();
    while i < n {
        let s = store.sessions[i];
        if s.session_id == session_id && session_is_valid(s, now_sec) {
            return s;
        }
        i = i + 1;
    }
    return HttpSession(
        session_id: "",
        user_id: "",
        role: "",
        created_at_sec: 0,
        last_accessed_sec: 0,
        ttl_secs: 0,
        is_active: false
    );
}

pub fn session_store_touch(inout store: HttpSessionStore, session_id: String, now_sec: i64) -> bool {
    mut next: List<HttpSession> = List::new();
    mut i: i64 = 0;
    let n = store.sessions.len();
    mut found: bool = false;
    while i < n {
        let s = store.sessions[i];
        if s.session_id == session_id && session_is_valid(s, now_sec) {
            let updated = HttpSession(
                session_id: s.session_id,
                user_id: s.user_id,
                role: s.role,
                created_at_sec: s.created_at_sec,
                last_accessed_sec: now_sec,
                ttl_secs: s.ttl_secs,
                is_active: s.is_active
            );
            next.push(updated);
            found = true;
        } else {
            next.push(s);
        }
        i = i + 1;
    }
    store.sessions = next;
    return found;
}

pub fn session_store_invalidate(inout store: HttpSessionStore, session_id: String) -> bool {
    mut next: List<HttpSession> = List::new();
    mut i: i64 = 0;
    let n = store.sessions.len();
    mut found: bool = false;
    while i < n {
        let s = store.sessions[i];
        if s.session_id == session_id {
            let updated = HttpSession(
                session_id: s.session_id,
                user_id: s.user_id,
                role: s.role,
                created_at_sec: s.created_at_sec,
                last_accessed_sec: s.last_accessed_sec,
                ttl_secs: s.ttl_secs,
                is_active: false
            );
            next.push(updated);
            found = true;
        } else {
            next.push(s);
        }
        i = i + 1;
    }
    store.sessions = next;
    return found;
}

pub fn session_store_active_count(store: HttpSessionStore, now_sec: i64) -> i64 {
    mut count: i64 = 0;
    mut i: i64 = 0;
    let n = store.sessions.len();
    while i < n {
        if session_is_valid(store.sessions[i], now_sec) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn make_multipart_boundary(seed: i64) -> String {
    return "---------------------------ifaBoundary" + int_to_string(seed);
}

pub fn format_multipart_field(boundary: String, name: String, value: String) -> String {
    mut res: String = "--" + boundary + "\r\n";
    res = res + "Content-Disposition: form-data; name=\"" + name + "\"\r\n\r\n";
    res = res + value + "\r\n";
    return res;
}

pub fn format_multipart_file(boundary: String, name: String, filename: String, content_type: String, content: String) -> String {
    mut res: String = "--" + boundary + "\r\n";
    res = res + "Content-Disposition: form-data; name=\"" + name + "\"; filename=\"" + filename + "\"\r\n";
    res = res + "Content-Type: " + content_type + "\r\n\r\n";
    res = res + content + "\r\n";
    return res;
}

pub fn format_multipart_end(boundary: String) -> String {
    return "--" + boundary + "--\r\n";
}

pub fn parse_multipart_field(body: String, boundary: String, field_name: String) -> String {
    let b_len = string_len(body);
    let marker = "name=\"" + field_name + "\"";
    let m_len = string_len(marker);
    if b_len == 0 || m_len == 0 {
        return "";
    }

    mut match_pos: i64 = -1;
    mut i: i64 = 0;
    while i + m_len <= b_len {
        mut found = true;
        mut k: i64 = 0;
        while k < m_len {
            if string_char_at(body, i + k) != string_char_at(marker, k) {
                found = false;
                k = m_len;
            }
            k = k + 1;
        }
        if found {
            match_pos = i;
            i = b_len; // break
        }
        i = i + 1;
    }

    if match_pos < 0 {
        return "";
    }

    mut val_start: i64 = -1;
    mut j = match_pos + m_len;
    while j + 3 < b_len {
        if string_char_at(body, j) == 13 && string_char_at(body, j + 1) == 10 && string_char_at(body, j + 2) == 13 && string_char_at(body, j + 3) == 10 {
            val_start = j + 4;
            j = b_len; // break
        }
        j = j + 1;
    }

    if val_start < 0 {
        return "";
    }

    let delim = "\r\n--" + boundary;
    let d_len = string_len(delim);
    mut val_end: i64 = -1;
    mut p = val_start;
    while p + d_len <= b_len {
        mut d_match = true;
        mut q: i64 = 0;
        while q < d_len {
            if string_char_at(body, p + q) != string_char_at(delim, q) {
                d_match = false;
                q = d_len;
            }
            q = q + 1;
        }
        if d_match {
            val_end = p;
            p = b_len; // break
        }
        p = p + 1;
    }

    if val_end >= val_start {
        return string_substr(body, val_start, val_end - val_start);
    }
    return "";
}

pub fn test_net_url_percent_encoding_roundtrip() -> bool {
    let input = "Hello World! & IFA = 100%?";
    let encoded = url_encode(input);
    if encoded != "Hello%20World%21%20%26%20IFA%20%3D%20100%25%3F" {
        return false;
    }
    let decoded = url_decode(encoded);
    if decoded != input {
        return false;
    }

    let with_plus = "IFA+Systems+Programming";
    if url_decode(with_plus) != "IFA Systems Programming" {
        return false;
    }

    mut form = form_urlencoded_set("", "user", "Dieudonné Assogba");
    form = form_urlencoded_set(form, "email", "jprud67@gmail.com");
    form = form_urlencoded_set(form, "status", "active & verified");

    let u = form_urlencoded_get(form, "user");
    let e = form_urlencoded_get(form, "email");
    let s = form_urlencoded_get(form, "status");
    let missing = form_urlencoded_get(form, "unknown");

    return u == "Dieudonné Assogba" && e == "jprud67@gmail.com" && s == "active & verified" && missing == "";
}

pub fn test_net_http_cookies_and_session() -> bool {
    let cookie_hdr = "sessionId=ifa_sec_token_9876; user_role=admin; theme=dark";
    let sid = http_cookie_get(cookie_hdr, "sessionId");
    let role = http_cookie_get(cookie_hdr, "user_role");
    let theme = http_cookie_get(cookie_hdr, "theme");
    let missing = http_cookie_get(cookie_hdr, "unknown");

    if sid != "ifa_sec_token_9876" || role != "admin" || theme != "dark" || missing != "" {
        return false;
    }

    let set_cookie = http_format_set_cookie("sessionId", "ifa_sec_token_9876", "/api", 7200, true, true, "Strict");
    let expected = "sessionId=ifa_sec_token_9876; Path=/api; Max-Age=7200; SameSite=Strict; Secure; HttpOnly";
    if set_cookie != expected {
        return false;
    }

    // Cookie Jar lifecycle test
    mut jar = make_http_cookie_jar();
    if cookie_jar_len(jar) != 0 {
        return false;
    }
    mut c1 = make_http_cookie("session", "sess_alpha_123");
    mut c2 = make_http_cookie("theme", "dracula");
    cookie_jar_add(jar, c1);
    cookie_jar_add(jar, c2);

    if cookie_jar_len(jar) != 2 {
        return false;
    }
    if cookie_jar_get(jar, "session") != "sess_alpha_123" {
        return false;
    }
    if cookie_jar_get(jar, "theme") != "dracula" {
        return false;
    }
    let jar_hdr = cookie_jar_to_header(jar);
    if jar_hdr != "session=sess_alpha_123; theme=dracula" {
        return false;
    }
    let removed = cookie_jar_remove(jar, "session");
    if !removed || cookie_jar_len(jar) != 1 || cookie_jar_get(jar, "session") != "" {
        return false;
    }

    // Session Store lifecycle test
    mut store = make_http_session_store(3600);
    if session_store_active_count(store, 100) != 0 {
        return false;
    }
    let sid1 = session_store_create(store, "user_42", "admin", 100);
    if sid1 != "ifa_sess_1001" {
        return false;
    }
    if session_store_active_count(store, 100) != 1 {
        return false;
    }

    let s1 = session_store_find(store, sid1, 200);
    if !s1.is_active || s1.user_id != "user_42" || s1.role != "admin" {
        return false;
    }

    // Touch session
    let touched = session_store_touch(store, sid1, 250);
    if !touched {
        return false;
    }

    // Expiration check: after 3600s + 250s = 3850s
    let s_expired = session_store_find(store, sid1, 3851);
    if s_expired.is_active {
        return false;
    }

    // Invalidation
    let sid2 = session_store_create(store, "user_99", "editor", 4000);
    if session_store_active_count(store, 4000) != 1 {
        return false;
    }
    let inv = session_store_invalidate(store, sid2);
    if !inv || session_store_active_count(store, 4000) != 0 {
        return false;
    }

    return true;
}

pub fn test_net_multipart_form_data() -> bool {
    let boundary = make_multipart_boundary(4242);
    mut body = format_multipart_field(boundary, "username", "prudence");
    body = body + format_multipart_field(boundary, "description", "IFA Systems Programming");
    body = body + format_multipart_file(boundary, "document", "report.txt", "text/plain", "Deterministic compilation fixed point OK");
    body = body + format_multipart_end(boundary);

    let u = parse_multipart_field(body, boundary, "username");
    let desc = parse_multipart_field(body, boundary, "description");
    let doc = parse_multipart_field(body, boundary, "document");
    let missing = parse_multipart_field(body, boundary, "nonexistent");

    return u == "prudence" && desc == "IFA Systems Programming" && doc == "Deterministic compilation fixed point OK" && missing == "";
}

pub fn sse_format_event(event_type: String, data: String, id: String, retry_ms: i64) -> String {
    mut res: String = "";
    if string_len(id) > 0 {
        res = res + "id: " + id + "\n";
    }
    if string_len(event_type) > 0 {
        res = res + "event: " + event_type + "\n";
    }
    if retry_ms > 0 {
        res = res + "retry: " + int_to_string(retry_ms) + "\n";
    }

    let d_len = string_len(data);
    if d_len == 0 {
        res = res + "data:\n";
    } else {
        mut line_start: i64 = 0;
        mut i: i64 = 0;
        while i <= d_len {
            let is_end = (i == d_len) || (string_char_at(data, i) == 10); // '\n'
            if is_end {
                mut line_len = i - line_start;
                if line_len > 0 && string_char_at(data, line_start + line_len - 1) == 13 { // '\r'
                    line_len = line_len - 1;
                }
                res = res + "data: " + string_substr(data, line_start, line_len) + "\n";
                line_start = i + 1;
            }
            i = i + 1;
        }
    }

    res = res + "\n";
    return res;
}

pub fn sse_extract_field(raw_block: String, field_name: String) -> String {
    let b_len = string_len(raw_block);
    let prefix = field_name + ": ";
    let p_len = string_len(prefix);
    mut i: i64 = 0;
    while i + p_len <= b_len {
        let is_line_start = (i == 0) || (string_char_at(raw_block, i - 1) == 10);
        if is_line_start {
            mut match_prefix = true;
            mut j: i64 = 0;
            while j < p_len {
                if string_char_at(raw_block, i + j) != string_char_at(prefix, j) {
                    match_prefix = false;
                    j = p_len;
                }
                j = j + 1;
            }
            if match_prefix {
                let val_start = i + p_len;
                mut val_end = val_start;
                while val_end < b_len && string_char_at(raw_block, val_end) != 10 && string_char_at(raw_block, val_end) != 13 {
                    val_end = val_end + 1;
                }
                return string_substr(raw_block, val_start, val_end - val_start);
            }
        }
        i = i + 1;
    }
    return "";
}

pub fn sse_parse_event_data(raw_block: String) -> String {
    let b_len = string_len(raw_block);
    let prefix = "data: ";
    let p_len = string_len(prefix);
    mut res: String = "";
    mut i: i64 = 0;
    while i + p_len <= b_len {
        let is_line_start = (i == 0) || (string_char_at(raw_block, i - 1) == 10);
        if is_line_start {
            mut match_prefix = true;
            mut j: i64 = 0;
            while j < p_len {
                if string_char_at(raw_block, i + j) != string_char_at(prefix, j) {
                    match_prefix = false;
                    j = p_len;
                }
                j = j + 1;
            }
            if match_prefix {
                let val_start = i + p_len;
                mut val_end = val_start;
                while val_end < b_len && string_char_at(raw_block, val_end) != 10 && string_char_at(raw_block, val_end) != 13 {
                    val_end = val_end + 1;
                }
                let line = string_substr(raw_block, val_start, val_end - val_start);
                if string_len(res) > 0 {
                    res = res + "\n" + line;
                } else {
                    res = line;
                }
                i = val_end;
            }
        }
        i = i + 1;
    }
    return res;
}

pub fn sse_parse_event_name(raw_block: String) -> String {
    return sse_extract_field(raw_block, "event");
}

pub fn sse_parse_event_id(raw_block: String) -> String {
    return sse_extract_field(raw_block, "id");
}

pub fn http_response_sse_header() -> String {
    return "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nConnection: keep-alive\r\n\r\n";
}

pub fn string_find_char(s: String, ch: i64) -> i64 {
    let len = string_len(s);
    mut i: i64 = 0;
    while i < len {
        if string_char_at(s, i) == ch {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn http_accepts_mime(accept_header: String, target_mime: String) -> bool {
    let h_len = string_len(accept_header);
    if h_len == 0 {
        return true;
    }
    if string_contains(accept_header, "*/*") {
        return true;
    }
    if string_contains(accept_header, target_mime) {
        return true;
    }

    let slash_idx = string_find_char(target_mime, 47); // '/'
    if slash_idx > 0 {
        let prefix = string_substr(target_mime, 0, slash_idx + 1) + "*";
        if string_contains(accept_header, prefix) {
            return true;
        }
    }

    return false;
}

pub fn http_negotiate_content_type(accept_header: String, available_csv: String) -> String {
    let a_len = string_len(available_csv);
    if a_len == 0 {
        return "";
    }
    if string_len(accept_header) == 0 || string_contains(accept_header, "*/*") {
        let comma = string_find_char(available_csv, 44); // ','
        if comma >= 0 {
            return string_substr(available_csv, 0, comma);
        }
        return available_csv;
    }

    mut start: i64 = 0;
    mut i: i64 = 0;
    while i <= a_len {
        let is_end = (i == a_len) || (string_char_at(available_csv, i) == 44); // ','
        if is_end {
            let item = string_substr(available_csv, start, i - start);
            if http_accepts_mime(accept_header, item) {
                return item;
            }
            start = i + 1;
        }
        i = i + 1;
    }

    return "";
}

pub fn test_net_http_sse_streaming_and_content_negotiation() -> bool {
    let ev1 = sse_format_event("status_update", "Fiber reactor healthy and running", "evt-101", 3000);
    let ev_name1 = sse_parse_event_name(ev1);
    let ev_id1 = sse_parse_event_id(ev1);
    let ev_data1 = sse_parse_event_data(ev1);

    if ev_name1 != "status_update" || ev_id1 != "evt-101" || ev_data1 != "Fiber reactor healthy and running" {
        return false;
    }

    let multiline_data = "chunk_alpha\nchunk_beta\nchunk_gamma";
    let ev2 = sse_format_event("data_feed", multiline_data, "", 0);
    let ev_data2 = sse_parse_event_data(ev2);
    if ev_data2 != multiline_data {
        return false;
    }

    let sse_header = http_response_sse_header();
    if !string_contains(sse_header, "text/event-stream") || !string_contains(sse_header, "no-cache") {
        return false;
    }

    let available = "application/json,text/html,text/plain";
    let chosen_json = http_negotiate_content_type("application/json", available);
    if chosen_json != "application/json" {
        return false;
    }

    let chosen_wildcard = http_negotiate_content_type("*/*", available);
    if chosen_wildcard != "application/json" {
        return false;
    }

    let chosen_text = http_negotiate_content_type("text/*", available);
    if chosen_text != "text/html" {
        return false;
    }

    let chosen_none = http_negotiate_content_type("image/png", available);
    if chosen_none != "" {
        return false;
    }

    let accepts_json = http_accepts_mime("application/json, text/plain", "application/json");
    let accepts_sse = http_accepts_mime("text/event-stream", "text/event-stream");
    let rejects_xml = http_accepts_mime("application/json", "application/xml");

    return accepts_json && accepts_sse && !rejects_xml;
}

pub fn get_net_b64_char(idx: i64) -> String {
    let chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    if idx >= 0 && idx < 64 {
        return string_substr(chars, idx, 1);
    }
    return "=";
}

pub fn get_net_b64_val(c: i64) -> i64 {
    if c >= 65 && c <= 90 { return c - 65; }
    if c >= 97 && c <= 122 { return c - 97 + 26; }
    if c >= 48 && c <= 57 { return c - 48 + 52; }
    if c == 43 { return 62; }
    if c == 47 { return 63; }
    return -1;
}

pub fn net_base64_encode(input: String) -> String {
    mut out: String = "";
    let len = string_len(input);
    mut i: i64 = 0;
    while i + 3 <= len {
        let b0 = string_char_at(input, i) & 255;
        let b1 = string_char_at(input, i + 1) & 255;
        let b2 = string_char_at(input, i + 2) & 255;

        out = out + get_net_b64_char(b0 >> 2);
        out = out + get_net_b64_char(((b0 & 3) << 4) | (b1 >> 4));
        out = out + get_net_b64_char(((b1 & 15) << 2) | (b2 >> 6));
        out = out + get_net_b64_char(b2 & 63);

        i = i + 3;
    }

    let rem = len - i;
    if rem == 1 {
        let b0 = string_char_at(input, i) & 255;
        out = out + get_net_b64_char(b0 >> 2);
        out = out + get_net_b64_char((b0 & 3) << 4);
        out = out + "==";
    } else if rem == 2 {
        let b0 = string_char_at(input, i) & 255;
        let b1 = string_char_at(input, i + 1) & 255;
        out = out + get_net_b64_char(b0 >> 2);
        out = out + get_net_b64_char(((b0 & 3) << 4) | (b1 >> 4));
        out = out + get_net_b64_char((b1 & 15) << 2);
        out = out + "=";
    }

    return out;
}

pub fn net_base64_decode(input: String) -> String {
    let len = string_len(input);
    mut clean: List<i64> = List::new();
    mut i: i64 = 0;
    while i < len {
        let c = string_char_at(input, i);
        if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 43 || c == 47 || c == 61 {
            clean.push(c);
        }
        i = i + 1;
    }

    let c_len = clean.len();
    mut out: String = "";
    mut idx: i64 = 0;
    while idx + 4 <= c_len {
        let c0 = clean[idx];
        let c1 = clean[idx + 1];
        let c2 = clean[idx + 2];
        let c3 = clean[idx + 3];

        let v0 = get_net_b64_val(c0);
        let v1 = get_net_b64_val(c1);

        if c2 == 61 {
            let b0 = ((v0 << 2) | (v1 >> 4)) & 255;
            out = out + string_from_char(b0);
            return out;
        }

        let v2 = get_net_b64_val(c2);
        let b0 = ((v0 << 2) | (v1 >> 4)) & 255;
        out = out + string_from_char(b0);

        if c3 == 61 {
            let b1 = ((v1 & 15) << 4) | (v2 >> 2);
            out = out + string_from_char(b1);
            return out;
        }

        let v3 = get_net_b64_val(c3);
        let b1 = ((v1 & 15) << 4) | (v2 >> 2);
        let b2 = ((v2 & 3) << 6) | v3;
        out = out + string_from_char(b1);
        out = out + string_from_char(b2);

        idx = idx + 4;
    }
    return out;
}

pub fn http_encode_basic_auth(username: String, password: String) -> String {
    let creds = username + ":" + password;
    return "Basic " + net_base64_encode(creds);
}

pub fn http_parse_basic_auth(auth_header: String) -> String {
    let len = string_len(auth_header);
    if len < 6 {
        return "";
    }
    let pfx = string_substr(auth_header, 0, 6);
    if (pfx != "Basic ") && (pfx != "basic ") && (pfx != "BASIC ") {
        return "";
    }
    mut b64_part = string_substr(auth_header, 6, len - 6);
    while string_len(b64_part) > 0 && string_char_at(b64_part, 0) == 32 {
        b64_part = string_substr(b64_part, 1, string_len(b64_part) - 1);
    }
    while string_len(b64_part) > 0 && string_char_at(b64_part, string_len(b64_part) - 1) == 32 {
        b64_part = string_substr(b64_part, 0, string_len(b64_part) - 1);
    }
    return net_base64_decode(b64_part);
}

pub fn http_parse_bearer_token(auth_header: String) -> String {
    let len = string_len(auth_header);
    if len < 7 {
        return "";
    }
    let pfx = string_substr(auth_header, 0, 7);
    if (pfx != "Bearer ") && (pfx != "bearer ") && (pfx != "BEARER ") {
        return "";
    }
    mut tok = string_substr(auth_header, 7, len - 7);
    while string_len(tok) > 0 && string_char_at(tok, 0) == 32 {
        tok = string_substr(tok, 1, string_len(tok) - 1);
    }
    while string_len(tok) > 0 && string_char_at(tok, string_len(tok) - 1) == 32 {
        tok = string_substr(tok, 0, string_len(tok) - 1);
    }
    return tok;
}

pub fn http_is_cors_preflight(method: String, origin: String, req_method: String) -> bool {
    return (method == "OPTIONS") && (string_len(origin) > 0) && (string_len(req_method) > 0);
}

pub fn http_format_cors_headers(origin: String, methods: String, headers: String, max_age: i64) -> String {
    mut res: String = "Access-Control-Allow-Origin: " + origin + "\r\n";
    if string_len(methods) > 0 {
        res = res + "Access-Control-Allow-Methods: " + methods + "\r\n";
    }
    if string_len(headers) > 0 {
        res = res + "Access-Control-Allow-Headers: " + headers + "\r\n";
    }
    if max_age > 0 {
        res = res + "Access-Control-Max-Age: " + int_to_string(max_age) + "\r\n";
    }
    return res;
}

pub fn http_cors_preflight_response(origin: String, methods: String, headers: String, max_age: i64) -> String {
    return "HTTP/1.1 204 No Content\r\n"
        + http_format_cors_headers(origin, methods, headers, max_age)
        + "Content-Length: 0\r\n\r\n";
}

pub fn http_compute_etag(body: String, weak: bool) -> String {
    let crc = net_crc32_string(body);
    let len = string_len(body);
    let tag = "\"" + int_to_hex_string(crc) + "-" + int_to_string(len) + "\"";
    if weak {
        return "W/" + tag;
    }
    return tag;
}

pub fn http_strip_etag(raw_tag: String) -> String {
    mut t = raw_tag;
    while string_len(t) > 0 && string_char_at(t, 0) == 32 {
        t = string_substr(t, 1, string_len(t) - 1);
    }
    while string_len(t) > 0 && string_char_at(t, string_len(t) - 1) == 32 {
        t = string_substr(t, 0, string_len(t) - 1);
    }
    if string_len(t) >= 2 && string_substr(t, 0, 2) == "W/" {
        t = string_substr(t, 2, string_len(t) - 2);
    }
    if string_len(t) >= 2 && string_char_at(t, 0) == 34 && string_char_at(t, string_len(t) - 1) == 34 {
        t = string_substr(t, 1, string_len(t) - 2);
    }
    return t;
}

pub fn http_matches_if_none_match(current_etag: String, header_val: String) -> bool {
    let h_len = string_len(header_val);
    if h_len == 0 {
        return false;
    }
    if string_contains(header_val, "*") {
        return true;
    }
    let target = http_strip_etag(current_etag);

    mut start: i64 = 0;
    mut i: i64 = 0;
    while i <= h_len {
        let is_end = (i == h_len) || (string_char_at(header_val, i) == 44); // ','
        if is_end {
            let part = string_substr(header_val, start, i - start);
            let cleaned = http_strip_etag(part);
            if cleaned == target {
                return true;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

pub fn http_matches_if_match(current_etag: String, header_val: String) -> bool {
    let h_len = string_len(header_val);
    if h_len == 0 {
        return true;
    }
    if string_len(current_etag) >= 2 && string_substr(current_etag, 0, 2) == "W/" {
        return false;
    }
    if string_contains(header_val, "*") {
        return true;
    }

    mut target = current_etag;
    while string_len(target) > 0 && string_char_at(target, 0) == 32 {
        target = string_substr(target, 1, string_len(target) - 1);
    }
    while string_len(target) > 0 && string_char_at(target, string_len(target) - 1) == 32 {
        target = string_substr(target, 0, string_len(target) - 1);
    }
    if string_len(target) >= 2 && string_char_at(target, 0) == 34 && string_char_at(target, string_len(target) - 1) == 34 {
        target = string_substr(target, 1, string_len(target) - 2);
    }

    mut start: i64 = 0;
    mut i: i64 = 0;
    while i <= h_len {
        let is_end = (i == h_len) || (string_char_at(header_val, i) == 44); // ','
        if is_end {
            mut part = string_substr(header_val, start, i - start);
            while string_len(part) > 0 && string_char_at(part, 0) == 32 {
                part = string_substr(part, 1, string_len(part) - 1);
            }
            while string_len(part) > 0 && string_char_at(part, string_len(part) - 1) == 32 {
                part = string_substr(part, 0, string_len(part) - 1);
            }
            if !(string_len(part) >= 2 && string_substr(part, 0, 2) == "W/") {
                if string_len(part) >= 2 && string_char_at(part, 0) == 34 && string_char_at(part, string_len(part) - 1) == 34 {
                    part = string_substr(part, 1, string_len(part) - 2);
                }
                if part == target {
                    return true;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

pub fn http_response_304_not_modified(etag: String) -> String {
    return "HTTP/1.1 304 Not Modified\r\nETag: " + etag + "\r\nConnection: keep-alive\r\n\r\n";
}

pub fn test_net_http_auth_cors_and_etag() -> bool {
    let b_auth = http_encode_basic_auth("aladdin", "open sesame");
    if b_auth != "Basic YWxhZGRpbjpvcGVuIHNlc2FtZQ==" {
        return false;
    }
    let parsed_creds = http_parse_basic_auth(b_auth);
    if parsed_creds != "aladdin:open sesame" {
        return false;
    }
    let invalid_basic = http_parse_basic_auth("Bearer 12345");
    if invalid_basic != "" {
        return false;
    }

    let b_hdr = "Bearer sec_live_tok_991823746";
    let tok = http_parse_bearer_token(b_hdr);
    if tok != "sec_live_tok_991823746" {
        return false;
    }
    let invalid_bearer = http_parse_bearer_token("Basic YWxhZGRpbjpvcGVuIHNlc2FtZQ==");
    if invalid_bearer != "" {
        return false;
    }

    let is_preflight = http_is_cors_preflight("OPTIONS", "https://ifa-lang.org", "POST");
    let is_not_preflight = http_is_cors_preflight("GET", "https://ifa-lang.org", "");
    if !is_preflight || is_not_preflight {
        return false;
    }

    let cors_resp = http_cors_preflight_response("https://ifa-lang.org", "GET, POST, OPTIONS", "Content-Type, Authorization", 7200);
    if !string_contains(cors_resp, "HTTP/1.1 204 No Content")
        || !string_contains(cors_resp, "Access-Control-Allow-Origin: https://ifa-lang.org")
        || !string_contains(cors_resp, "Access-Control-Max-Age: 7200") {
        return false;
    }

    let content = "IFA High-Performance Fiber Engine";
    let strong_etag = http_compute_etag(content, false);
    let weak_etag = http_compute_etag(content, true);

    if !string_contains(strong_etag, "\"") || string_contains(strong_etag, "W/") {
        return false;
    }
    if !string_contains(weak_etag, "W/\"") {
        return false;
    }

    let match_exact = http_matches_if_none_match(strong_etag, strong_etag);
    let match_weak = http_matches_if_none_match(strong_etag, weak_etag);
    let match_wildcard = http_matches_if_none_match(strong_etag, "*");
    let match_list = http_matches_if_none_match(strong_etag, "\"random-tag\", " + strong_etag);
    let no_match = http_matches_if_none_match(strong_etag, "\"tag-diff-999\"");

    if !match_exact || !match_weak || !match_wildcard || !match_list || no_match {
        return false;
    }

    let if_match_exact = http_matches_if_match(strong_etag, strong_etag);
    let if_match_weak_candidate = http_matches_if_match(weak_etag, strong_etag);
    let if_match_weak_header = http_matches_if_match(strong_etag, weak_etag);
    let if_match_wildcard = http_matches_if_match(strong_etag, "*");

    if !if_match_exact || if_match_weak_candidate || if_match_weak_header || !if_match_wildcard {
        return false;
    }

    let resp_304 = http_response_304_not_modified(strong_etag);
    if !string_contains(resp_304, "304 Not Modified") || !string_contains(resp_304, strong_etag) {
        return false;
    }

    return true;
}

pub fn http_is_websocket_upgrade(raw_req: String) -> bool {
    let req_len = string_len(raw_req);
    if req_len < 4 {
        return false;
    }
    if string_substr(raw_req, 0, 4) != "GET " {
        return false;
    }

    let up = http_get_header(raw_req, "Upgrade");
    let conn = http_get_header(raw_req, "Connection");
    let ver = http_get_header(raw_req, "Sec-WebSocket-Version");
    let key = http_get_header(raw_req, "Sec-WebSocket-Key");

    return string_contains(up, "websocket")
        && (string_contains(conn, "Upgrade") || string_contains(conn, "upgrade"))
        && string_len(key) > 0
        && ver == "13";
}

pub fn http_websocket_key(raw_req: String) -> String {
    return http_get_header(raw_req, "Sec-WebSocket-Key");
}

pub fn http_websocket_accept_response(accept_key: String) -> String {
    mut res: String = "HTTP/1.1 101 Switching Protocols\r\n";
    res = res + "Upgrade: websocket\r\n";
    res = res + "Connection: Upgrade\r\n";
    res = res + "Sec-WebSocket-Accept: " + accept_key + "\r\n";
    res = res + "\r\n";
    return res;
}

pub fn http_response_is_websocket_101(raw_resp: String) -> bool {
    return string_contains(raw_resp, "101 Switching Protocols")
        && string_contains(raw_resp, "Upgrade: websocket")
        && string_contains(raw_resp, "Sec-WebSocket-Accept:");
}

pub fn test_net_http_router_dynamic_params_and_websocket_handshake() -> bool {
    // 1. Dynamic router pattern matching
    mut router = make_http_router();
    router_add_route(inout router, "GET", "/api/v1/health", 100);
    router_add_route(inout router, "GET", "/api/v1/users/:user_id/posts/:post_id", 200);
    router_add_route(inout router, "POST", "/orders/:order_id/items", 300);
    router_add_route(inout router, "GET", "/assets/*path", 400);

    // Exact route
    if router_match_route(router, "GET", "/api/v1/health") != 100 {
        return false;
    }

    // Dynamic segments
    let matched_user = router_match_route(router, "GET", "/api/v1/users/usr-99/posts/pst-42");
    if matched_user != 200 {
        return false;
    }
    let p_user = router_extract_param("/api/v1/users/:user_id/posts/:post_id", "/api/v1/users/usr-99/posts/pst-42", "user_id");
    let p_post = router_extract_param("/api/v1/users/:user_id/posts/:post_id", "/api/v1/users/usr-99/posts/pst-42", "post_id");
    if p_user != "usr-99" || p_post != "pst-42" {
        return false;
    }

    // Dynamic POST route
    let matched_order = router_match_route(router, "POST", "/orders/ORD-888/items");
    if matched_order != 300 {
        return false;
    }
    let p_order = router_extract_param("/orders/:order_id/items", "/orders/ORD-888/items", "order_id");
    if p_order != "ORD-888" {
        return false;
    }

    // Wildcard route
    let matched_asset = router_match_route(router, "GET", "/assets/images/branding/logo.svg");
    if matched_asset != 400 {
        return false;
    }
    let p_path = router_extract_param("/assets/*path", "/assets/images/branding/logo.svg", "path");
    if p_path != "images/branding/logo.svg" {
        return false;
    }

    // Negative matches
    if router_match_route(router, "PUT", "/api/v1/health") != -1 {
        return false;
    }
    if router_match_route(router, "GET", "/api/v1/users/usr-99") != -1 {
        return false;
    }

    // 2. RFC 6455 WebSocket Handshake
    let client_key = "dGhlIHNhbXBsZSBub25jZQ==";
    let expected_accept = "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=";
    let raw_ws_req = "GET /chat HTTP/1.1\r\nHost: server.example.com\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: " + client_key + "\r\nSec-WebSocket-Version: 13\r\n\r\n";

    if !http_is_websocket_upgrade(raw_ws_req) {
        return false;
    }
    let extracted_k = http_websocket_key(raw_ws_req);
    if extracted_k != client_key {
        return false;
    }

    let ws_resp = http_websocket_accept_response(expected_accept);
    if !http_response_is_websocket_101(ws_resp) {
        return false;
    }
    if !string_contains(ws_resp, expected_accept) {
        return false;
    }

    // Bad handshake requests
    let bad_req_1 = "POST /chat HTTP/1.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: abc\r\nSec-WebSocket-Version: 13\r\n\r\n";
    let bad_req_2 = "GET /chat HTTP/1.1\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: abc\r\nSec-WebSocket-Version: 8\r\n\r\n";
    if http_is_websocket_upgrade(bad_req_1) || http_is_websocket_upgrade(bad_req_2) {
        return false;
    }

    return true;
}

pub fn make_token_bucket(capacity: i64, refill_rate: i64, now_sec: i64) -> TokenBucket {
    return TokenBucket(
        capacity: capacity,
        tokens: capacity,
        refill_rate: refill_rate,
        last_refill: now_sec
    );
}

pub fn token_bucket_refill(inout tb: TokenBucket, now_sec: i64) {
    if now_sec > tb.last_refill {
        let elapsed = now_sec - tb.last_refill;
        let added = elapsed * tb.refill_rate;
        tb.tokens = tb.tokens + added;
        if tb.tokens > tb.capacity {
            tb.tokens = tb.capacity;
        }
        tb.last_refill = now_sec;
    }
}

pub fn token_bucket_try_consume(inout tb: TokenBucket, count: i64, now_sec: i64) -> bool {
    token_bucket_refill(inout tb, now_sec);
    if tb.tokens >= count {
        tb.tokens = tb.tokens - count;
        return true;
    }
    return false;
}

pub fn token_bucket_remaining(tb: TokenBucket) -> i64 {
    return tb.tokens;
}

pub fn token_bucket_seconds_until_reset(tb: TokenBucket) -> i64 {
    if tb.tokens >= tb.capacity || tb.refill_rate <= 0 {
        return 0;
    }
    let needed = tb.capacity - tb.tokens;
    return (needed + tb.refill_rate - 1) / tb.refill_rate;
}

pub fn format_rate_limit_headers(limit: i64, remaining: i64, reset_sec: i64) -> String {
    mut h = "X-RateLimit-Limit: ";
    h = h + int_to_string(limit);
    h = h + "\r\nX-RateLimit-Remaining: ";
    h = h + int_to_string(remaining);
    h = h + "\r\nX-RateLimit-Reset: ";
    h = h + int_to_string(reset_sec);
    h = h + "\r\n";
    return h;
}

pub fn make_rate_limited_response(retry_after_sec: i64, limit: i64, reset_sec: i64) -> HttpResponse {
    let body = "{\"error\":\"Too Many Requests\",\"retry_after\":" + int_to_string(retry_after_sec) + "}";
    return HttpResponse(
        status_code: 429,
        status_text: "Too Many Requests",
        content_type: "application/json",
        body: body
    );
}

pub fn net_mime_type_lookup(extension: String) -> String {
    let ext = extension;
    if ext == "html" || ext == "htm" {
        return "text/html; charset=utf-8";
    }
    if ext == "css" {
        return "text/css; charset=utf-8";
    }
    if ext == "js" || ext == "mjs" {
        return "application/javascript";
    }
    if ext == "json" {
        return "application/json";
    }
    if ext == "xml" {
        return "application/xml";
    }
    if ext == "txt" {
        return "text/plain; charset=utf-8";
    }
    if ext == "csv" {
        return "text/csv; charset=utf-8";
    }
    if ext == "png" {
        return "image/png";
    }
    if ext == "jpg" || ext == "jpeg" {
        return "image/jpeg";
    }
    if ext == "gif" {
        return "image/gif";
    }
    if ext == "svg" {
        return "image/svg+xml";
    }
    if ext == "ico" {
        return "image/x-icon";
    }
    if ext == "webp" {
        return "image/webp";
    }
    if ext == "wasm" {
        return "application/wasm";
    }
    if ext == "pdf" {
        return "application/pdf";
    }
    if ext == "zip" {
        return "application/zip";
    }
    return "application/octet-stream";
}

pub fn http_serve_static_content(content: String, extension: String, etag: String, if_none_match: String) -> HttpResponse {
    let mime = net_mime_type_lookup(extension);
    if if_none_match != "" && http_matches_if_none_match(etag, if_none_match) {
        return HttpResponse(
            status_code: 304,
            status_text: "Not Modified",
            content_type: mime,
            body: ""
        );
    }
    return HttpResponse(
        status_code: 200,
        status_text: "OK",
        content_type: mime,
        body: content
    );
}

pub fn test_net_rate_limiting_and_mime_resolver() -> bool {
    // 1. Token Bucket Burst and Throttling
    mut tb = make_token_bucket(10, 2, 1000);
    if token_bucket_remaining(tb) != 10 {
        return false;
    }
    // Consume 6 tokens
    if !token_bucket_try_consume(inout tb, 6, 1000) {
        return false;
    }
    if token_bucket_remaining(tb) != 4 {
        return false;
    }
    // Consume remaining 4 tokens
    if !token_bucket_try_consume(inout tb, 4, 1000) {
        return false;
    }
    if token_bucket_remaining(tb) != 0 {
        return false;
    }
    // Next attempt must fail (rate limited)
    if token_bucket_try_consume(inout tb, 1, 1000) {
        return false;
    }

    // Refill after 3 seconds (+6 tokens at 2 tokens/sec)
    if !token_bucket_try_consume(inout tb, 5, 1003) {
        return false;
    }
    if token_bucket_remaining(tb) != 1 {
        return false;
    }

    // Reset calculation: capacity 10 - remaining 1 = 9 needed => ceil(9 / 2) = 5 sec
    let reset_sec = token_bucket_seconds_until_reset(tb);
    if reset_sec != 5 {
        return false;
    }

    // Rate limit headers
    let rl_headers = format_rate_limit_headers(10, 1, reset_sec);
    if !string_contains(rl_headers, "X-RateLimit-Limit: 10")
        || !string_contains(rl_headers, "X-RateLimit-Remaining: 1")
        || !string_contains(rl_headers, "X-RateLimit-Reset: 5") {
        return false;
    }

    // 429 Too Many Requests response
    let resp_429 = make_rate_limited_response(5, 10, reset_sec);
    if resp_429.status_code != 429
        || resp_429.status_text != "Too Many Requests"
        || resp_429.content_type != "application/json"
        || !string_contains(resp_429.body, "retry_after") {
        return false;
    }

    // 2. MIME Type Lookup
    if net_mime_type_lookup("html") != "text/html; charset=utf-8" {
        return false;
    }
    if net_mime_type_lookup("json") != "application/json" {
        return false;
    }
    if net_mime_type_lookup("wasm") != "application/wasm" {
        return false;
    }
    if net_mime_type_lookup("png") != "image/png" {
        return false;
    }
    if net_mime_type_lookup("unknown_ext") != "application/octet-stream" {
        return false;
    }

    // 3. Static File & ETag Conditional Serving
    let asset_html = "<!DOCTYPE html><html><body><h1>IFA Web</h1></body></html>";
    let asset_etag = http_compute_etag(asset_html, false);

    // Initial 200 OK
    let resp_init = http_serve_static_content(asset_html, "html", asset_etag, "");
    if resp_init.status_code != 200
        || resp_init.content_type != "text/html; charset=utf-8"
        || resp_init.body != asset_html {
        return false;
    }

    // Conditional 304 Not Modified
    let resp_cached = http_serve_static_content(asset_html, "html", asset_etag, asset_etag);
    if resp_cached.status_code != 304
        || resp_cached.status_text != "Not Modified"
        || string_len(resp_cached.body) != 0 {
        return false;
    }

    return true;
}

pub fn make_upstream_backend(host: String, port: i64, weight: i64) -> UpstreamBackend {
    return UpstreamBackend(
        host: host,
        port: port,
        weight: weight,
        is_healthy: true,
        active_conns: 0
    );
}

pub fn make_http_load_balancer(backends: List<UpstreamBackend>) -> HttpLoadBalancer {
    return HttpLoadBalancer(
        backends: backends,
        current_idx: 0
    );
}

pub fn load_balancer_count(lb: HttpLoadBalancer) -> i64 {
    return lb.backends.len();
}

pub fn load_balancer_healthy_count(lb: HttpLoadBalancer) -> i64 {
    mut count: i64 = 0;
    mut i: i64 = 0;
    while i < lb.backends.len() {
        if lb.backends[i].is_healthy {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn load_balancer_set_healthy(inout lb: HttpLoadBalancer, host: String, port: i64, healthy: bool) {
    mut updated: List<UpstreamBackend> = List::new();
    mut i: i64 = 0;
    while i < lb.backends.len() {
        let b = lb.backends[i];
        if b.host == host && b.port == port {
            updated.push(UpstreamBackend(
                host: b.host,
                port: b.port,
                weight: b.weight,
                is_healthy: healthy,
                active_conns: b.active_conns
            ));
        } else {
            updated.push(b);
        }
        i = i + 1;
    }
    lb.backends = updated;
}

pub fn load_balancer_next(inout lb: HttpLoadBalancer) -> UpstreamBackend {
    let total = lb.backends.len();
    if total == 0 {
        return UpstreamBackend(host: "", port: 0, weight: 0, is_healthy: false, active_conns: 0);
    }
    mut cur: i64 = lb.current_idx;
    mut attempts: i64 = 0;
    while attempts < total {
        let idx = cur % total;
        cur = (cur + 1) % total;
        if lb.backends[idx].is_healthy {
            lb.current_idx = cur;
            return lb.backends[idx];
        }
        attempts = attempts + 1;
    }
    lb.current_idx = cur;
    return lb.backends[0];
}

pub fn string_to_lower(input: String) -> String {
    let len = string_len(input);
    mut out = "";
    mut i: i64 = 0;
    while i < len {
        let c = string_char_at(input, i);
        if c >= 65 && c <= 90 {
            out = out + string_from_char(c + 32);
        } else {
            out = out + string_from_char(c);
        }
        i = i + 1;
    }
    return out;
}

pub fn http_is_hop_by_hop_header(name: String) -> bool {
    let lower = string_to_lower(name);
    return lower == "connection"
        || lower == "keep-alive"
        || lower == "proxy-authenticate"
        || lower == "proxy-authorization"
        || lower == "te"
        || lower == "trailer"
        || lower == "trailers"
        || lower == "transfer-encoding"
        || lower == "upgrade";
}

pub fn make_http_proxy_gateway(via_name: String, strip_prefix: String, preserve_host: bool) -> HttpProxyGateway {
    return HttpProxyGateway(
        via_name: via_name,
        strip_prefix: strip_prefix,
        preserve_host: preserve_host
    );
}

pub fn http_proxy_rewrite_path(gateway: HttpProxyGateway, incoming_path: String) -> String {
    let prefix_len = string_len(gateway.strip_prefix);
    if prefix_len == 0 {
        return incoming_path;
    }
    if string_len(incoming_path) >= prefix_len {
        let sub = string_substr(incoming_path, 0, prefix_len);
        if sub == gateway.strip_prefix {
            let remainder = string_substr(incoming_path, prefix_len, string_len(incoming_path) - prefix_len);
            if string_len(remainder) == 0 {
                return "/";
            }
            if string_char_at(remainder, 0) != 47 {
                return "/" + remainder;
            }
            return remainder;
        }
    }
    return incoming_path;
}

pub fn http_proxy_format_forwarded_headers(client_ip: String, proto: String, host: String, prefix: String, via: String) -> String {
    mut out: String = "";
    if string_len(client_ip) > 0 {
        out = out + "X-Forwarded-For: " + client_ip + "\r\n";
    }
    if string_len(proto) > 0 {
        out = out + "X-Forwarded-Proto: " + proto + "\r\n";
    }
    if string_len(host) > 0 {
        out = out + "X-Forwarded-Host: " + host + "\r\n";
    }
    if string_len(prefix) > 0 {
        out = out + "X-Forwarded-Prefix: " + prefix + "\r\n";
    }
    if string_len(via) > 0 {
        out = out + "Via: " + via + "\r\n";
    }
    return out;
}

pub fn http_proxy_build_upstream_request(
    gateway: HttpProxyGateway,
    req: HttpRequest,
    headers: List<HttpHeader>,
    client_ip: String,
    client_proto: String,
    original_host: String,
    upstream_host: String,
    upstream_port: i64
) -> String {
    let rewritten_path = http_proxy_rewrite_path(gateway, req.path);
    mut host_header_val = upstream_host;
    if upstream_port != 80 && upstream_port != 443 {
        host_header_val = upstream_host + ":" + int_to_string(upstream_port);
    }
    if gateway.preserve_host && string_len(original_host) > 0 {
        host_header_val = original_host;
    }

    mut out: String = req.method + " " + rewritten_path + " " + req.version + "\r\n";
    out = out + "Host: " + host_header_val + "\r\n";

    mut i: i64 = 0;
    while i < headers.len() {
        let h = headers[i];
        let lower = string_to_lower(h.name);
        if lower != "host" && !http_is_hop_by_hop_header(h.name) {
            out = out + h.name + ": " + h.value + "\r\n";
        }
        i = i + 1;
    }

    out = out + http_proxy_format_forwarded_headers(client_ip, client_proto, original_host, gateway.strip_prefix, gateway.via_name);

    let body_len = string_len(req.body);
    if body_len > 0 {
        out = out + "Content-Length: " + int_to_string(body_len) + "\r\n";
    }
    out = out + "Connection: close\r\n\r\n";
    if body_len > 0 {
        out = out + req.body;
    }
    return out;
}

pub fn http_proxy_sanitize_response(gateway: HttpProxyGateway, resp: HttpResponse) -> HttpResponse {
    return HttpResponse(
        status_code: resp.status_code,
        status_text: resp.status_text,
        content_type: resp.content_type,
        body: resp.body
    );
}

pub fn make_http_pooled_connection(id: i64, host: String, port: i64, created_at: i64) -> HttpPooledConnection {
    return HttpPooledConnection(
        id: id,
        host: host,
        port: port,
        created_at: created_at,
        last_used_at: created_at,
        use_count: 1,
        is_active: true
    );
}

pub fn make_http_connection_pool(max_idle_per_host: i64, max_total_conns: i64, idle_timeout_ms: i64) -> HttpConnectionPool {
    return HttpConnectionPool(
        max_idle_per_host: max_idle_per_host,
        max_total_conns: max_total_conns,
        idle_timeout_ms: idle_timeout_ms,
        connections: List::new(),
        next_conn_id: 1,
        total_acquired: 0,
        total_reused: 0
    );
}

pub fn connection_pool_idle_count(pool: HttpConnectionPool, host: String, port: i64) -> i64 {
    mut count: i64 = 0;
    mut i: i64 = 0;
    while i < pool.connections.len() {
        let c = pool.connections[i];
        if c.host == host && c.port == port && !c.is_active {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn connection_pool_active_count(pool: HttpConnectionPool, host: String, port: i64) -> i64 {
    mut count: i64 = 0;
    mut i: i64 = 0;
    while i < pool.connections.len() {
        let c = pool.connections[i];
        if c.host == host && c.port == port && c.is_active {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn connection_pool_total_idle(pool: HttpConnectionPool) -> i64 {
    mut count: i64 = 0;
    mut i: i64 = 0;
    while i < pool.connections.len() {
        if !pool.connections[i].is_active {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn connection_pool_total_active(pool: HttpConnectionPool) -> i64 {
    mut count: i64 = 0;
    mut i: i64 = 0;
    while i < pool.connections.len() {
        if pool.connections[i].is_active {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

pub fn connection_pool_prune_expired(inout pool: HttpConnectionPool, now_ms: i64) -> i64 {
    mut kept: List<HttpPooledConnection> = List::new();
    mut purged: i64 = 0;
    mut i: i64 = 0;
    while i < pool.connections.len() {
        let c = pool.connections[i];
        if !c.is_active && (now_ms - c.last_used_at >= pool.idle_timeout_ms) {
            purged = purged + 1;
        } else {
            kept.push(c);
        }
        i = i + 1;
    }
    pool.connections = kept;
    return purged;
}

pub fn connection_pool_acquire(inout pool: HttpConnectionPool, host: String, port: i64, now_ms: i64) -> HttpPooledConnection {
    mut target_idx: i64 = -1;
    mut i: i64 = 0;
    while i < pool.connections.len() {
        let c = pool.connections[i];
        if c.host == host && c.port == port && !c.is_active {
            if now_ms - c.last_used_at < pool.idle_timeout_ms {
                target_idx = i;
                i = pool.connections.len();
            }
        }
        i = i + 1;
    }

    if target_idx >= 0 {
        mut updated: List<HttpPooledConnection> = List::new();
        mut reused_conn = pool.connections[target_idx];
        reused_conn.is_active = true;
        reused_conn.last_used_at = now_ms;
        reused_conn.use_count = reused_conn.use_count + 1;

        mut j: i64 = 0;
        while j < pool.connections.len() {
            if j == target_idx {
                updated.push(reused_conn);
            } else {
                updated.push(pool.connections[j]);
            }
            j = j + 1;
        }
        pool.connections = updated;
        pool.total_acquired = pool.total_acquired + 1;
        pool.total_reused = pool.total_reused + 1;
        return reused_conn;
    }

    let conn_id = pool.next_conn_id;
    pool.next_conn_id = pool.next_conn_id + 1;
    let new_conn = HttpPooledConnection(
        id: conn_id,
        host: host,
        port: port,
        created_at: now_ms,
        last_used_at: now_ms,
        use_count: 1,
        is_active: true
    );

    pool.connections.push(new_conn);
    pool.total_acquired = pool.total_acquired + 1;
    return new_conn;
}

pub fn connection_pool_release(inout pool: HttpConnectionPool, conn: HttpPooledConnection, can_reuse: bool, now_ms: i64) {
    mut updated: List<HttpPooledConnection> = List::new();
    let cur_idle_count = connection_pool_idle_count(pool, conn.host, conn.port);
    let cur_total_idle = connection_pool_total_idle(pool);

    let should_keep = can_reuse
        && (now_ms - conn.last_used_at < pool.idle_timeout_ms)
        && (cur_idle_count < pool.max_idle_per_host)
        && (cur_total_idle < pool.max_total_conns);

    mut i: i64 = 0;
    while i < pool.connections.len() {
        let c = pool.connections[i];
        if c.id == conn.id {
            if should_keep {
                mut idle_conn = c;
                idle_conn.is_active = false;
                idle_conn.last_used_at = now_ms;
                updated.push(idle_conn);
            }
        } else {
            updated.push(c);
        }
        i = i + 1;
    }
    pool.connections = updated;
}

pub fn connection_pool_clear(inout pool: HttpConnectionPool) {
    pool.connections = List::new();
}

pub fn http_should_keep_alive(status_code: i64, headers: List<HttpHeader>) -> bool {
    mut i: i64 = 0;
    mut has_close: bool = false;
    mut has_keep_alive: bool = false;
    mut has_content_length: bool = false;
    mut has_chunked: bool = false;

    while i < headers.len() {
        let h = headers[i];
        let name_lower = string_to_lower(h.name);
        let val_lower = string_to_lower(h.value);
        if name_lower == "connection" {
            if string_contains(val_lower, "close") {
                has_close = true;
            }
            if string_contains(val_lower, "keep-alive") {
                has_keep_alive = true;
            }
        }
        if name_lower == "content-length" {
            has_content_length = true;
        }
        if name_lower == "transfer-encoding" && string_contains(val_lower, "chunked") {
            has_chunked = true;
        }
        i = i + 1;
    }

    if has_close {
        return false;
    }
    if has_keep_alive {
        return true;
    }
    if status_code == 204 || status_code == 304 {
        return true;
    }
    if has_content_length || has_chunked {
        return true;
    }
    return false;
}

pub const CIRCUIT_STATE_CLOSED: i64 = 0;
pub const CIRCUIT_STATE_OPEN: i64 = 1;
pub const CIRCUIT_STATE_HALF_OPEN: i64 = 2;

pub struct HttpCircuitBreaker {
    pub state: i64,
    pub failure_threshold: i64,
    pub success_threshold: i64,
    pub recovery_timeout_ms: i64,
    pub consecutive_failures: i64,
    pub consecutive_successes: i64,
    pub last_state_change_ms: i64,
    pub total_trips: i64,
    pub total_requests: i64,
    pub total_rejected: i64
}

pub fn make_http_circuit_breaker(failure_threshold: i64, success_threshold: i64, recovery_timeout_ms: i64) -> HttpCircuitBreaker {
    return HttpCircuitBreaker(
        state: CIRCUIT_STATE_CLOSED,
        failure_threshold: failure_threshold,
        success_threshold: success_threshold,
        recovery_timeout_ms: recovery_timeout_ms,
        consecutive_failures: 0,
        consecutive_successes: 0,
        last_state_change_ms: 0,
        total_trips: 0,
        total_requests: 0,
        total_rejected: 0
    );
}

pub fn circuit_breaker_allow_request(inout cb: HttpCircuitBreaker, now_ms: i64) -> bool {
    if cb.state == CIRCUIT_STATE_CLOSED {
        cb.total_requests = cb.total_requests + 1;
        return true;
    }
    if cb.state == CIRCUIT_STATE_OPEN {
        if now_ms - cb.last_state_change_ms >= cb.recovery_timeout_ms {
            cb.state = CIRCUIT_STATE_HALF_OPEN;
            cb.consecutive_successes = 0;
            cb.last_state_change_ms = now_ms;
            cb.total_requests = cb.total_requests + 1;
            return true;
        } else {
            cb.total_rejected = cb.total_rejected + 1;
            return false;
        }
    }
    // Half-Open
    cb.total_requests = cb.total_requests + 1;
    return true;
}

pub fn circuit_breaker_record_success(inout cb: HttpCircuitBreaker, now_ms: i64) {
    if cb.state == CIRCUIT_STATE_HALF_OPEN {
        cb.consecutive_successes = cb.consecutive_successes + 1;
        if cb.consecutive_successes >= cb.success_threshold {
            cb.state = CIRCUIT_STATE_CLOSED;
            cb.consecutive_failures = 0;
            cb.consecutive_successes = 0;
            cb.last_state_change_ms = now_ms;
        }
    } else if cb.state == CIRCUIT_STATE_CLOSED {
        cb.consecutive_failures = 0;
    }
}

pub fn circuit_breaker_record_failure(inout cb: HttpCircuitBreaker, now_ms: i64) {
    if cb.state == CIRCUIT_STATE_CLOSED {
        cb.consecutive_failures = cb.consecutive_failures + 1;
        if cb.consecutive_failures >= cb.failure_threshold {
            cb.state = CIRCUIT_STATE_OPEN;
            cb.total_trips = cb.total_trips + 1;
            cb.consecutive_failures = 0;
            cb.consecutive_successes = 0;
            cb.last_state_change_ms = now_ms;
        }
    } else if cb.state == CIRCUIT_STATE_HALF_OPEN {
        cb.state = CIRCUIT_STATE_OPEN;
        cb.total_trips = cb.total_trips + 1;
        cb.consecutive_failures = 0;
        cb.consecutive_successes = 0;
        cb.last_state_change_ms = now_ms;
    }
}

pub fn circuit_breaker_record_status(inout cb: HttpCircuitBreaker, status_code: i64, now_ms: i64) {
    if status_code >= 500 && status_code <= 504 {
        circuit_breaker_record_failure(inout cb, now_ms);
    } else {
        circuit_breaker_record_success(inout cb, now_ms);
    }
}

pub fn circuit_breaker_reset(inout cb: HttpCircuitBreaker) {
    cb.state = CIRCUIT_STATE_CLOSED;
    cb.consecutive_failures = 0;
    cb.consecutive_successes = 0;
    cb.last_state_change_ms = 0;
}

pub fn test_net_http_circuit_breaker() -> bool {
    mut cb = make_http_circuit_breaker(3, 2, 5000);
    if cb.state != CIRCUIT_STATE_CLOSED
        || cb.total_trips != 0
        || cb.total_requests != 0
        || cb.total_rejected != 0 {
        return false;
    }

    // 1. Initial requests pass
    if !circuit_breaker_allow_request(inout cb, 1000) {
        return false;
    }
    circuit_breaker_record_status(inout cb, 200, 1010);
    if cb.state != CIRCUIT_STATE_CLOSED || cb.consecutive_failures != 0 {
        return false;
    }

    // 2. Failures below threshold
    circuit_breaker_record_status(inout cb, 503, 1020);
    circuit_breaker_record_status(inout cb, 502, 1030);
    if cb.consecutive_failures != 2 || cb.state != CIRCUIT_STATE_CLOSED {
        return false;
    }

    // 3. Third failure trips circuit to Open
    circuit_breaker_record_status(inout cb, 500, 1040);
    if cb.state != CIRCUIT_STATE_OPEN || cb.total_trips != 1 {
        return false;
    }

    // 4. Fast-failing while Open before recovery timeout
    if circuit_breaker_allow_request(inout cb, 2000) {
        return false;
    }
    if cb.total_rejected != 1 {
        return false;
    }

    // 5. Expiration of recovery timeout (1040 + 5000 = 6040 ms -> test at 6100 ms)
    if !circuit_breaker_allow_request(inout cb, 6100) {
        return false;
    }
    if cb.state != CIRCUIT_STATE_HALF_OPEN {
        return false;
    }

    // 6. First probe success in Half-Open
    circuit_breaker_record_status(inout cb, 200, 6110);
    if cb.state != CIRCUIT_STATE_HALF_OPEN || cb.consecutive_successes != 1 {
        return false;
    }

    // 7. Second probe success closes circuit (fully recovered)
    circuit_breaker_record_status(inout cb, 200, 6120);
    if cb.state != CIRCUIT_STATE_CLOSED
        || cb.consecutive_successes != 0
        || cb.consecutive_failures != 0 {
        return false;
    }

    // 8. Re-trip and test half-open probe failure
    circuit_breaker_record_failure(inout cb, 7000);
    circuit_breaker_record_failure(inout cb, 7010);
    circuit_breaker_record_failure(inout cb, 7020);
    if cb.state != CIRCUIT_STATE_OPEN || cb.total_trips != 2 {
        return false;
    }

    // Wait and transition to half-open
    if !circuit_breaker_allow_request(inout cb, 13000) {
        return false;
    }
    if cb.state != CIRCUIT_STATE_HALF_OPEN {
        return false;
    }

    // Probe fails: re-trips immediately to open
    circuit_breaker_record_failure(inout cb, 13010);
    if cb.state != CIRCUIT_STATE_OPEN || cb.total_trips != 3 {
        return false;
    }

    // 9. Reset
    circuit_breaker_reset(inout cb);
    if cb.state != CIRCUIT_STATE_CLOSED || cb.consecutive_failures != 0 {
        return false;
    }

    return true;
}

pub fn make_http_retry_policy(max_retries: i64, initial_delay_ms: i64, max_delay_ms: i64, backoff_factor: i64) -> HttpRetryPolicy {
    return HttpRetryPolicy(
        max_retries: max_retries,
        initial_delay_ms: initial_delay_ms,
        max_delay_ms: max_delay_ms,
        backoff_factor: backoff_factor,
        retry_on_5xx: true,
        retry_on_429: true,
        retry_on_network_error: true
    );
}

pub fn http_retry_policy_default() -> HttpRetryPolicy {
    return make_http_retry_policy(3, 50, 2000, 2);
}

pub fn http_retry_is_status_retryable(policy: HttpRetryPolicy, status_code: i64) -> bool {
    if policy.retry_on_429 && status_code == 429 {
        return true;
    }
    if status_code == 408 {
        return true;
    }
    if policy.retry_on_5xx && (status_code == 500 || status_code == 502 || status_code == 503 || status_code == 504) {
        return true;
    }
    return false;
}

pub fn http_retry_is_method_idempotent(method: String) -> bool {
    return method == "GET" || method == "HEAD" || method == "PUT" || method == "DELETE" || method == "OPTIONS";
}

pub fn http_retry_calculate_delay_ms(policy: HttpRetryPolicy, attempt: i64) -> i64 {
    if attempt <= 1 {
        return policy.initial_delay_ms;
    }
    mut delay: i64 = policy.initial_delay_ms;
    mut i: i64 = 1;
    while i < attempt {
        delay = delay * policy.backoff_factor;
        if delay >= policy.max_delay_ms {
            return policy.max_delay_ms;
        }
        i = i + 1;
    }
    return delay;
}

pub fn test_net_http_retry_policy() -> bool {
    let policy = make_http_retry_policy(4, 10, 100, 2);

    // 1. Backoff progression
    if http_retry_calculate_delay_ms(policy, 1) != 10 {
        return false;
    }
    if http_retry_calculate_delay_ms(policy, 2) != 20 {
        return false;
    }
    if http_retry_calculate_delay_ms(policy, 3) != 40 {
        return false;
    }
    if http_retry_calculate_delay_ms(policy, 4) != 80 {
        return false;
    }
    if http_retry_calculate_delay_ms(policy, 5) != 100 {
        return false;
    }

    // 2. Status filtering
    if !http_retry_is_status_retryable(policy, 503)
        || !http_retry_is_status_retryable(policy, 502)
        || !http_retry_is_status_retryable(policy, 500)
        || !http_retry_is_status_retryable(policy, 504)
        || !http_retry_is_status_retryable(policy, 429)
        || !http_retry_is_status_retryable(policy, 408) {
        return false;
    }
    if http_retry_is_status_retryable(policy, 200)
        || http_retry_is_status_retryable(policy, 404)
        || http_retry_is_status_retryable(policy, 400)
        || http_retry_is_status_retryable(policy, 401) {
        return false;
    }

    // 3. Method idempotency
    if !http_retry_is_method_idempotent("GET")
        || !http_retry_is_method_idempotent("HEAD")
        || !http_retry_is_method_idempotent("PUT")
        || !http_retry_is_method_idempotent("DELETE")
        || !http_retry_is_method_idempotent("OPTIONS") {
        return false;
    }
    if http_retry_is_method_idempotent("POST")
        || http_retry_is_method_idempotent("PATCH") {
        return false;
    }

    // 4. Report creation
    let report = HttpRetryReport(
        attempts: 3,
        retries: 2,
        succeeded: true,
        last_status: 200,
        total_backoff_ms: 30
    );
    if report.attempts != 3 || report.retries != 2 || !report.succeeded || report.last_status != 200 || report.total_backoff_ms != 30 {
        return false;
    }

    return true;
}

pub fn test_net_http_connection_pooling_and_keep_alive() -> bool {
    // 1. Initialize Connection Pool
    mut pool = make_http_connection_pool(2, 4, 10000);
    if connection_pool_total_idle(pool) != 0
        || connection_pool_total_active(pool) != 0
        || pool.total_acquired != 0
        || pool.total_reused != 0 {
        return false;
    }

    // 2. First acquisition
    let c1 = connection_pool_acquire(pool, "api.internal", 8080, 1000);
    if c1.id != 1 || c1.use_count != 1 || !c1.is_active {
        return false;
    }
    if pool.total_acquired != 1 || pool.total_reused != 0 {
        return false;
    }
    if connection_pool_active_count(pool, "api.internal", 8080) != 1
        || connection_pool_idle_count(pool, "api.internal", 8080) != 0 {
        return false;
    }

    // 3. Release c1 with keep-alive
    connection_pool_release(pool, c1, true, 1050);
    if connection_pool_active_count(pool, "api.internal", 8080) != 0
        || connection_pool_idle_count(pool, "api.internal", 8080) != 1 {
        return false;
    }

    // 4. Second acquisition: should reuse c1
    let c2 = connection_pool_acquire(pool, "api.internal", 8080, 1100);
    if c2.id != 1 || c2.use_count != 2 || !c2.is_active {
        return false;
    }
    if pool.total_acquired != 2 || pool.total_reused != 1 {
        return false;
    }
    if connection_pool_idle_count(pool, "api.internal", 8080) != 0 {
        return false;
    }

    // 5. Concurrent acquisition for same host: establishes new connection c3
    let c3 = connection_pool_acquire(pool, "api.internal", 8080, 1150);
    if c3.id != 2 || c3.use_count != 1 || !c3.is_active {
        return false;
    }
    if connection_pool_active_count(pool, "api.internal", 8080) != 2 {
        return false;
    }

    // 6. Release both connections
    connection_pool_release(pool, c2, true, 1200);
    connection_pool_release(pool, c3, true, 1210);
    if connection_pool_idle_count(pool, "api.internal", 8080) != 2
        || connection_pool_total_idle(pool) != 2 {
        return false;
    }

    // 7. Acquire connection for another endpoint
    let c4 = connection_pool_acquire(pool, "db.internal", 5432, 1250);
    if c4.id != 3 || c4.use_count != 1 {
        return false;
    }
    connection_pool_release(pool, c4, true, 1260);
    if connection_pool_total_idle(pool) != 3 {
        return false;
    }

    // 8. Test idle timeout expiration: at t = 13000 ms, (13000 - 1200 = 11800 ms > 10000 ms)
    let purged = connection_pool_prune_expired(pool, 13000);
    if purged != 3 || connection_pool_total_idle(pool) != 0 {
        return false;
    }

    // 9. RFC 7230 Keep-Alive determination rules
    mut headers_close: List<HttpHeader> = List::new();
    headers_close.push(make_http_header("Connection", "close"));
    headers_close.push(make_http_header("Content-Length", "50"));
    if http_should_keep_alive(200, headers_close) {
        return false;
    }

    mut headers_keep: List<HttpHeader> = List::new();
    headers_keep.push(make_http_header("Connection", "keep-alive"));
    if !http_should_keep_alive(200, headers_keep) {
        return false;
    }

    mut headers_chunked: List<HttpHeader> = List::new();
    headers_chunked.push(make_http_header("Transfer-Encoding", "chunked"));
    if !http_should_keep_alive(200, headers_chunked) {
        return false;
    }

    mut headers_204: List<HttpHeader> = List::new();
    if !http_should_keep_alive(204, headers_204) {
        return false;
    }

    mut headers_none: List<HttpHeader> = List::new();
    if http_should_keep_alive(200, headers_none) {
        return false;
    }

    // 10. Clear pool
    connection_pool_clear(pool);
    if pool.connections.len() != 0 {
        return false;
    }

    return true;
}

pub fn test_net_http_reverse_proxy_gateway_and_load_balancer() -> bool {
    // 1. Hop-by-hop headers
    if !http_is_hop_by_hop_header("Connection")
        || !http_is_hop_by_hop_header("keep-alive")
        || !http_is_hop_by_hop_header("Upgrade")
        || !http_is_hop_by_hop_header("Transfer-Encoding")
        || !http_is_hop_by_hop_header("Proxy-Authorization") {
        return false;
    }
    if http_is_hop_by_hop_header("Content-Type")
        || http_is_hop_by_hop_header("Authorization")
        || http_is_hop_by_hop_header("X-Custom-Header") {
        return false;
    }

    // 2. Load Balancer Round Robin & Health Tracking
    mut backends: List<UpstreamBackend> = List::new();
    backends.push(make_upstream_backend("10.0.0.1", 8080, 1));
    backends.push(make_upstream_backend("10.0.0.2", 8080, 1));
    backends.push(make_upstream_backend("10.0.0.3", 8080, 1));

    mut lb = make_http_load_balancer(backends);
    if load_balancer_count(lb) != 3 || load_balancer_healthy_count(lb) != 3 {
        return false;
    }

    let b1 = load_balancer_next(inout lb);
    if b1.host != "10.0.0.1" { return false; }
    let b2 = load_balancer_next(inout lb);
    if b2.host != "10.0.0.2" { return false; }
    let b3 = load_balancer_next(inout lb);
    if b3.host != "10.0.0.3" { return false; }
    let b4 = load_balancer_next(inout lb);
    if b4.host != "10.0.0.1" { return false; }

    // Mark 10.0.0.2 unhealthy
    load_balancer_set_healthy(inout lb, "10.0.0.2", 8080, false);
    if load_balancer_healthy_count(lb) != 2 { return false; }

    // Cycling should skip 10.0.0.2
    let b5 = load_balancer_next(inout lb);
    if b5.host != "10.0.0.3" { return false; }
    let b6 = load_balancer_next(inout lb);
    if b6.host != "10.0.0.1" { return false; }
    let b7 = load_balancer_next(inout lb);
    if b7.host != "10.0.0.3" { return false; }

    // 3. Reverse Proxy Gateway Request Construction & Path Rewriting
    let gateway = make_http_proxy_gateway("1.1 ifa-gateway", "/api/v1", false);
    if http_proxy_rewrite_path(gateway, "/api/v1/orders/create") != "/orders/create" {
        return false;
    }
    if http_proxy_rewrite_path(gateway, "/api/v1") != "/" {
        return false;
    }
    if http_proxy_rewrite_path(gateway, "/other/path") != "/other/path" {
        return false;
    }

    mut client_headers: List<HttpHeader> = List::new();
    client_headers.push(make_http_header("User-Agent", "IFA-Client/1.0"));
    client_headers.push(make_http_header("Connection", "keep-alive"));
    client_headers.push(make_http_header("Upgrade", "websocket"));
    client_headers.push(make_http_header("Authorization", "Bearer sec_tok_42"));

    let req = HttpRequest(
        method: "POST",
        path: "/api/v1/orders/create",
        version: "HTTP/1.1",
        body: "{\"order_id\":\"ORD-101\"}"
    );

    let upstream_req_wire = http_proxy_build_upstream_request(
        gateway,
        req,
        client_headers,
        "192.168.1.100",
        "https",
        "api.example.com",
        "backend.internal",
        8080
    );

    // Verify rewritten line
    if !string_contains(upstream_req_wire, "POST /orders/create HTTP/1.1") {
        return false;
    }
    // Verify host header
    if !string_contains(upstream_req_wire, "Host: backend.internal:8080") {
        return false;
    }
    // Verify hop-by-hop headers stripped
    if string_contains(upstream_req_wire, "Upgrade: websocket") {
        return false;
    }
    // Verify standard headers preserved
    if !string_contains(upstream_req_wire, "Authorization: Bearer sec_tok_42") {
        return false;
    }
    if !string_contains(upstream_req_wire, "User-Agent: IFA-Client/1.0") {
        return false;
    }
    // Verify gateway headers injected
    if !string_contains(upstream_req_wire, "X-Forwarded-For: 192.168.1.100")
        || !string_contains(upstream_req_wire, "X-Forwarded-Proto: https")
        || !string_contains(upstream_req_wire, "X-Forwarded-Host: api.example.com")
        || !string_contains(upstream_req_wire, "X-Forwarded-Prefix: /api/v1")
        || !string_contains(upstream_req_wire, "Via: 1.1 ifa-gateway") {
        return false;
    }
    // Verify body & Content-Length
    if !string_contains(upstream_req_wire, "Content-Length: 22")
        || !string_contains(upstream_req_wire, "{\"order_id\":\"ORD-101\"}") {
        return false;
    }

    // 4. Response sanitization
    let resp = HttpResponse(
        status_code: 200,
        status_text: "OK",
        content_type: "application/json",
        body: "{\"status\":\"created\"}"
    );
    let sanitized = http_proxy_sanitize_response(gateway, resp);
    if sanitized.status_code != 200 || sanitized.body != "{\"status\":\"created\"}" {
        return false;
    }

    return true;
}

pub fn test_net_http_auto_compression() -> bool {
    let article_body = "The IFA Programming Language is designed for deterministic high-performance systems with zero GC overhead, colorless async fibers and transparent native HTTP codecs.";

    // 1. Uncompressed / Identity when client does not send Accept-Encoding
    let req_uncompressed = "GET /api/article HTTP/1.1\r\nHost: 127.0.0.1\r\nUser-Agent: IFA/1.0\r\n\r\n";
    let base_resp = HttpResponse(status_code: 200, status_text: "OK", content_type: "text/plain", body: article_body);
    let wire_plain = format_http_compressed_response(base_resp, req_uncompressed, 32);

    let parsed_plain = parse_http_response(wire_plain);
    let enc_plain = http_get_content_encoding(wire_plain);
    if enc_plain != "identity" {
        return false;
    }
    if parsed_plain.body != article_body {
        return false;
    }

    // 2. Gzip compression when client sends Accept-Encoding: gzip, deflate
    let req_gzip = "GET /api/article HTTP/1.1\r\nHost: 127.0.0.1\r\nAccept-Encoding: gzip, deflate\r\n\r\n";
    let wire_gzip = format_http_compressed_response(base_resp, req_gzip, 32);
    let parsed_gzip = parse_http_response(wire_gzip);
    let enc_gzip = http_get_content_encoding(wire_gzip);
    if enc_gzip != "gzip" {
        return false;
    }
    let restored_gzip = http_decompress_response_body(parsed_gzip, wire_gzip);
    if restored_gzip != article_body {
        return false;
    }

    // 3. Deflate compression when client sends Accept-Encoding: deflate only
    let req_deflate = "GET /api/article HTTP/1.1\r\nHost: 127.0.0.1\r\nAccept-Encoding: deflate\r\n\r\n";
    let wire_def = format_http_compressed_response(base_resp, req_deflate, 32);
    let parsed_def = parse_http_response(wire_def);
    let enc_def = http_get_content_encoding(wire_def);
    if enc_def != "deflate" {
        return false;
    }
    let restored_def = http_decompress_response_body(parsed_def, wire_def);
    if restored_def != article_body {
        return false;
    }

    // 4. Short payload below threshold (min_size = 64) -> not compressed even if Accept-Encoding: gzip
    let short_resp = HttpResponse(status_code: 200, status_text: "OK", content_type: "text/plain", body: "Hello IFA");
    let wire_short = format_http_compressed_response(short_resp, req_gzip, 64);
    let enc_short = http_get_content_encoding(wire_short);
    if enc_short != "identity" {
        return false;
    }
    let parsed_short = parse_http_response(wire_short);
    if parsed_short.body != "Hello IFA" {
        return false;
    }

    // 5. Integration over loopback TCP socket
    mut listener = make_tcp_listener(0);
    if !listener.is_open || listener.port <= 0 {
        return false;
    }

    mut client = make_tcp_connect("127.0.0.1", listener.port);
    if !client.is_open {
        listener_close(inout listener);
        return false;
    }

    mut server = listener_accept(listener);
    if !server.is_open {
        stream_close(inout client);
        listener_close(inout listener);
        return false;
    }

    // Client sends Gzip-accepting HTTP request
    let client_req = "GET /data HTTP/1.1\r\nHost: 127.0.0.1\r\nAccept-Encoding: gzip\r\n\r\n";
    stream_write(client, client_req);

    let server_raw_req = stream_read(server, 2048);
    let srv_resp = HttpResponse(status_code: 200, status_text: "OK", content_type: "text/plain", body: article_body);
    let srv_wire = format_http_compressed_response(srv_resp, server_raw_req, 32);
    stream_write(server, srv_wire);

    let client_recv_wire = stream_read(client, 65536);
    let client_resp = parse_http_response(client_recv_wire);
    let client_enc = http_get_content_encoding(client_recv_wire);
    if client_enc != "gzip" {
        stream_close(inout server);
        stream_close(inout client);
        listener_close(inout listener);
        return false;
    }
    let client_decompressed = http_decompress_response_body(client_resp, client_recv_wire);
    if client_decompressed != article_body {
        stream_close(inout server);
        stream_close(inout client);
        listener_close(inout listener);
        return false;
    }

    stream_close(inout server);
    stream_close(inout client);
    listener_close(inout listener);

    return true;
}

pub fn test_net_all() -> bool {
    return test_net_tcp_echo()
    && test_net_http_wire()
    && test_net_nonblocking_fiber_transport()
    && test_net_url_parsing_and_formatting()
