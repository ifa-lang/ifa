pub fn test_crypto_fnv1a() -> bool {
    let h1 = fnv1a_str("hello");
    let h2 = fnv1a_str("hello");
    let h3 = fnv1a_str("world");
    if h1 != h2 {
        return false;
    }
    if h1 == h3 {
        return false;
    }
    return true;
}

pub fn test_crypto_murmur3() -> bool {
    let m1 = murmur3_32("compiler_symbol", 42);
    let m2 = murmur3_32("compiler_symbol", 42);
    let m3 = murmur3_32("compiler_symbol", 99);
    if m1 != m2 {
        return false;
    }
    if m1 == m3 {
        return false;
    }
    return true;
}

pub fn test_crypto_sha256_empty() -> bool {
    let empty_hash = sha256_hex("");
    return empty_hash == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
}

pub fn test_crypto_sha256_abc() -> bool {
    let abc_hash = sha256_hex("abc");
    return abc_hash == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
}

pub fn test_crypto_constant_time_eq() -> bool {
    let eq1 = constant_time_eq("deadbeef", "deadbeef");
    let eq2 = constant_time_eq("deadbeef", "deadfeed");
    let eq3 = constant_time_eq("deadbeef", "dead");
    return eq1 && !eq2 && !eq3;
}

pub fn test_crypto_hmac() -> bool {
    let hmac_res = hmac_sha256("key", "The quick brown fox jumps over the lazy dog");
    return hmac_res == "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8";
}

pub fn test_crypto_blake3_empty() -> bool {
    let empty_hash = blake3_hex("");
    return empty_hash == "af1349b9f5f9a1a6a0404dea36dcc9499bcb25c9adc112b7cc9a93cae41f3262";
}

pub fn test_crypto_blake3_abc() -> bool {
