    return abc_hash == "6437b3ac38465133ffb63b75273a8db548c558465d79db03fd359c6cd5bd9d85";
}

pub fn test_crypto_blake3_ifa() -> bool {
    let ifa_hash = blake3_hex("IFA Programming Language");
    return ifa_hash == "eb6b3c8bcf187f9b99c2dacccec7b871b2b31f746b005e5cf58c81947cb3b438";
}

pub fn test_crypto_blake3_tree() -> bool {
    mut bytes: List<i64> = List::new();
    mut i: i64 = 0;
    while i < 2000 {
        bytes.push(65); // 'A'
        i = i + 1;
    }
    let tree_hash = blake3_bytes_hex(bytes);
    return tree_hash == "fc6985444b763593734965947a328514e93ef2bae12db668a6d64147c5dcdde3";
}

pub fn sha1_process_chunk(offset: i64, msg: List<i64>, state: List<i64>) -> List<i64> {
    mut w: List<i64> = List::new();
    mut i: i64 = 0;
    while i < 16 {
        let b0 = msg[offset + i * 4];
        let b1 = msg[offset + i * 4 + 1];
        let b2 = msg[offset + i * 4 + 2];
        let b3 = msg[offset + i * 4 + 3];
        let word = ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & 4294967295;
        w.push(word);
        i = i + 1;
    }

    while i < 80 {
        let w_val = rotl32(w[i - 3] ^ w[i - 8] ^ w[i - 14] ^ w[i - 16], 1);
        w.push(w_val);
        i = i + 1;
    }

    mut a = state[0];
    mut b = state[1];
    mut c = state[2];
    mut d = state[3];
    mut e = state[4];

    mut j: i64 = 0;
    while j < 80 {
        mut f: i64 = 0;
        mut k: i64 = 0;
        if j < 20 {
            f = ((b & c) | ((b ^ 4294967295) & d)) & 4294967295;
            k = 1518500249; // 0x5a827999
        } else if j < 40 {
            f = b ^ c ^ d;
            k = 1859775393; // 0x6ed9eba1
        } else if j < 60 {
            f = ((b & c) | (b & d) | (c & d)) & 4294967295;
            k = 2400959708; // 0x8f1bbcdc
        } else {
            f = b ^ c ^ d;
            k = 3395469782; // 0xca62c1d6
        }

        let temp = (rotl32(a, 5) + f + e + k + w[j]) & 4294967295;
        e = d;
        d = c;
        c = rotl32(b, 30);
        b = a;
        a = temp;
        j = j + 1;
    }

    mut new_state: List<i64> = List::new();
    new_state.push((state[0] + a) & 4294967295);
    new_state.push((state[1] + b) & 4294967295);
    new_state.push((state[2] + c) & 4294967295);
    new_state.push((state[3] + d) & 4294967295);
    new_state.push((state[4] + e) & 4294967295);
    return new_state;
}

pub fn sha1_bytes(data: List<i64>) -> List<i64> {
    mut state: List<i64> = List::new();
    state.push(1732584193); // 0x67452301
    state.push(4023233417); // 0xefcdab89
    state.push(2562383102); // 0x98badcfe
    state.push(271733878);  // 0x10325476
    state.push(3285377520); // 0xc3d2e1f0

    let orig_len = data.len();
    let bit_len: i64 = orig_len * 8;

    mut msg: List<i64> = List::new();
    mut i: i64 = 0;
    while i < orig_len {
        msg.push(data[i] & 255);
        i = i + 1;
    }

    // Append single '1' bit (0x80)
    msg.push(128);

    // Append zeros until length % 64 == 56
    while (msg.len() % 64) != 56 {
        msg.push(0);
    }

    // Append 64-bit big-endian length
    msg.push((bit_len >> 56) & 255);
    msg.push((bit_len >> 48) & 255);
    msg.push((bit_len >> 40) & 255);
    msg.push((bit_len >> 32) & 255);
    msg.push((bit_len >> 24) & 255);
    msg.push((bit_len >> 16) & 255);
    msg.push((bit_len >> 8) & 255);
    msg.push(bit_len & 255);

    mut chunk_idx: i64 = 0;
    let num_chunks = msg.len() / 64;

    while chunk_idx < num_chunks {
        let offset = chunk_idx * 64;
        state = sha1_process_chunk(offset, msg, state);
        chunk_idx = chunk_idx + 1;
    }

    mut digest: List<i64> = List::new();
    mut w_idx: i64 = 0;
    while w_idx < 5 {
        let val = state[w_idx];
        digest.push((val >> 24) & 255);
        digest.push((val >> 16) & 255);
        digest.push((val >> 8) & 255);
        digest.push(val & 255);
        w_idx = w_idx + 1;
    }

    return digest;
}

pub fn sha1_hex(input: String) -> String {
    mut bytes: List<i64> = List::new();
    let len = string_len(input);
    mut i: i64 = 0;
    while i < len {
        bytes.push(string_char_at(input, i));
        i = i + 1;
    }
    let digest = sha1_bytes(bytes);
    return bytes_to_hex(digest);
}

pub fn get_base64_char(idx: i64) -> String {
    let chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    if idx >= 0 && idx < 64 {
        return string_substr(chars, idx, 1);
    }
    return "=";
}

pub fn get_base64_val(c: i64) -> i64 {
    if c >= 65 && c <= 90 {
        return c - 65;
    }
    if c >= 97 && c <= 122 {
        return c - 97 + 26;
    }
    if c >= 48 && c <= 57 {
        return c - 48 + 52;
    }
    if c == 43 {
        return 62;
    }
    if c == 47 {
        return 63;
    }
    return -1;
}

pub fn base64_encode_bytes(bytes: List<i64>) -> String {
    mut out: String = "";
    let len = bytes.len();
    mut i: i64 = 0;

    while i + 3 <= len {
        let b0 = bytes[i] & 255;
        let b1 = bytes[i + 1] & 255;
        let b2 = bytes[i + 2] & 255;

        out = out + get_base64_char(b0 >> 2);
        out = out + get_base64_char(((b0 & 3) << 4) | (b1 >> 4));
        out = out + get_base64_char(((b1 & 15) << 2) | (b2 >> 6));
        out = out + get_base64_char(b2 & 63);

        i = i + 3;
    }

    let rem = len - i;
    if rem == 1 {
        let b0 = bytes[i] & 255;
        out = out + get_base64_char(b0 >> 2);
        out = out + get_base64_char((b0 & 3) << 4);
        out = out + "==";
    } else if rem == 2 {
        let b0 = bytes[i] & 255;
        let b1 = bytes[i + 1] & 255;
        out = out + get_base64_char(b0 >> 2);
        out = out + get_base64_char(((b0 & 3) << 4) | (b1 >> 4));
        out = out + get_base64_char((b1 & 15) << 2);
        out = out + "=";
    }

    return out;
}

pub fn base64_encode_str(input: String) -> String {
    mut bytes: List<i64> = List::new();
    let len = string_len(input);
    mut i: i64 = 0;
    while i < len {
        bytes.push(string_char_at(input, i));
        i = i + 1;
    }
    return base64_encode_bytes(bytes);
}

pub fn base64_decode_str(input: String) -> List<i64> {
    mut clean: List<i64> = List::new();
    let len = string_len(input);
    mut i: i64 = 0;
    while i < len {
        let c = string_char_at(input, i);
        if c > 32 {
            clean.push(c);
        }
        i = i + 1;
    }

    mut out: List<i64> = List::new();
    let clean_len = clean.len();
    if clean_len % 4 != 0 {
        return out;
    }

    mut idx: i64 = 0;
    while idx < clean_len {
        let c0 = clean[idx];
        let c1 = clean[idx + 1];
        let c2 = clean[idx + 2];
        let c3 = clean[idx + 3];

        let v0 = get_base64_val(c0);
        let v1 = get_base64_val(c1);

        if c2 == 61 {
            out.push(((v0 << 2) | (v1 >> 4)) & 255);
            return out;
        }

        let v2 = get_base64_val(c2);
        out.push(((v0 << 2) | (v1 >> 4)) & 255);

        if c3 == 61 {
            out.push(((v1 & 15) << 4) | (v2 >> 2));
            return out;
        }

        let v3 = get_base64_val(c3);
        out.push(((v1 & 15) << 4) | (v2 >> 2));
        out.push(((v2 & 3) << 6) | v3);

        idx = idx + 4;
    }

    return out;
}

pub fn get_base64url_char(idx: i64) -> String {
    let chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
    if idx >= 0 && idx < 64 {
        return string_substr(chars, idx, 1);
    }
    return "";
}

pub fn base64url_encode_bytes(bytes: List<i64>) -> String {
    mut out: String = "";
    let len = bytes.len();
    mut i: i64 = 0;

    while i + 3 <= len {
        let b0 = bytes[i] & 255;
        let b1 = bytes[i + 1] & 255;
        let b2 = bytes[i + 2] & 255;

        out = out + get_base64url_char(b0 >> 2);
        out = out + get_base64url_char(((b0 & 3) << 4) | (b1 >> 4));
        out = out + get_base64url_char(((b1 & 15) << 2) | (b2 >> 6));
        out = out + get_base64url_char(b2 & 63);

        i = i + 3;
    }

    let rem = len - i;
    if rem == 1 {
        let b0 = bytes[i] & 255;
        out = out + get_base64url_char(b0 >> 2);
        out = out + get_base64url_char((b0 & 3) << 4);
    } else if rem == 2 {
        let b0 = bytes[i] & 255;
        let b1 = bytes[i + 1] & 255;
        out = out + get_base64url_char(b0 >> 2);
        out = out + get_base64url_char(((b0 & 3) << 4) | (b1 >> 4));
        out = out + get_base64url_char((b1 & 15) << 2);
    }

    return out;
}

pub fn base64url_encode_str(input: String) -> String {
    mut bytes: List<i64> = List::new();
    let len = string_len(input);
    mut i: i64 = 0;
    while i < len {
        bytes.push(string_char_at(input, i));
        i = i + 1;
    }
    return base64url_encode_bytes(bytes);
}

pub fn base64url_decode_str(input: String) -> List<i64> {
    let trimmed = crypto_trim(input);
    let len = string_len(trimmed);
    mut s: String = "";
    mut i: i64 = 0;
    while i < len {
        let c = string_char_at(trimmed, i);
        if c == 45 {
            s = s + "+";
        } else if c == 95 {
            s = s + "/";
        } else {
            s = s + string_substr(trimmed, i, 1);
        }
        i = i + 1;
    }
    let rem = string_len(s) % 4;
    if rem == 2 {
        s = s + "==";
    } else if rem == 3 {
        s = s + "=";
    }
    return base64_decode_str(s);
}

pub fn crypto_trim(s: String) -> String {
    let len = string_len(s);
    if len == 0 {
        return "";
    }
    mut start: i64 = 0;
    while start < len && string_char_at(s, start) <= 32 {
        start = start + 1;
    }
    if start >= len {
        return "";
    }
    mut end: i64 = len;
    while end > start && string_char_at(s, end - 1) <= 32 {
        end = end - 1;
    }
    return string_substr(s, start, end - start);
}

pub fn websocket_accept_key(client_key: String) -> String {
    let ws_guid = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
    let concatenated = crypto_trim(client_key) + ws_guid;
    mut bytes: List<i64> = List::new();
    let len = string_len(concatenated);
    mut i: i64 = 0;
    while i < len {
        bytes.push(string_char_at(concatenated, i));
        i = i + 1;
    }
    let digest = sha1_bytes(bytes);
    return base64_encode_bytes(digest);
}

pub fn test_crypto_sha1_vectors() -> bool {
    let h1 = sha1_hex("");
    if h1 != "da39a3ee5e6b4b0d3255bfef95601890afd80709" {
        return false;
    }
    let h2 = sha1_hex("abc");
    if h2 != "a9993e364706816aba3e25717850c26c9cd0d89d" {
        return false;
    }
    let h3 = sha1_hex("The quick brown fox jumps over the lazy dog");
    if h3 != "2fd4e1c67a2d28fced849ee1bb76e7391b93eb12" {
        return false;
    }
    return true;
}

pub fn test_crypto_base64_and_websocket_key() -> bool {
    if base64_encode_str("") != "" { return false; }
    if base64_encode_str("f") != "Zg==" { return false; }
    if base64_encode_str("fo") != "Zm8=" { return false; }
    if base64_encode_str("foo") != "Zm9v" { return false; }
    if base64_encode_str("foob") != "Zm9vYg==" { return false; }
    if base64_encode_str("fooba") != "Zm9vYmE=" { return false; }
    if base64_encode_str("foobar") != "Zm9vYmFy" { return false; }

    let dec = base64_decode_str("Zm9vYmFy");
    if dec.len() != 6 || dec[0] != 102 || dec[5] != 114 {
        return false;
    }

    // RFC 6455 Section 1.3 test vector
    let accept = websocket_accept_key("dGhlIHNhbXBsZSBub25jZQ==");
    if accept != "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=" {
        return false;
    }

    // RFC 7515 / RFC 4648 Base64URL test vectors
    let jwt_hdr = "{\"alg\":\"HS256\",\"typ\":\"JWT\"}";
    let enc_url = base64url_encode_str(jwt_hdr);
    if enc_url != "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9" {
        return false;
    }
    let dec_url = base64url_decode_str(enc_url);
    if dec_url.len() != string_len(jwt_hdr) {
        return false;
    }

    return true;
}

// === HMAC, HOTP, TOTP, PBKDF2 EXTENSIONS ===

pub fn hmac_sha256_bytes(key: List<i64>, data: List<i64>) -> List<i64> {
    mut k_bytes: List<i64> = List::new();
    let k_len = key.len();
    if k_len > 64 {
        k_bytes = sha256_bytes(key);
    } else {
        mut i: i64 = 0;
        while i < k_len {
            k_bytes.push(key[i]);
            i = i + 1;
        }
    }
    while k_bytes.len() < 64 {
        k_bytes.push(0);
    }

    mut i_key_pad: List<i64> = List::new();
    mut o_key_pad: List<i64> = List::new();
    mut i: i64 = 0;
    while i < 64 {
        i_key_pad.push(k_bytes[i] ^ 54);
        o_key_pad.push(k_bytes[i] ^ 92);
        i = i + 1;
    }

    i = 0;
    while i < data.len() {
        i_key_pad.push(data[i]);
        i = i + 1;
    }
    let inner_hash = sha256_bytes(i_key_pad);

    i = 0;
    while i < inner_hash.len() {
        o_key_pad.push(inner_hash[i]);
        i = i + 1;
    }
    return sha256_bytes(o_key_pad);
}

pub fn hmac_sha1_bytes(key: List<i64>, data: List<i64>) -> List<i64> {
    mut k_bytes: List<i64> = List::new();
    let k_len = key.len();
    if k_len > 64 {
        k_bytes = sha1_bytes(key);
    } else {
        mut i: i64 = 0;
        while i < k_len {
            k_bytes.push(key[i]);
            i = i + 1;
        }
    }
    while k_bytes.len() < 64 {
        k_bytes.push(0);
    }

    mut i_key_pad: List<i64> = List::new();
    mut o_key_pad: List<i64> = List::new();
    mut i: i64 = 0;
    while i < 64 {
        i_key_pad.push(k_bytes[i] ^ 54);
        o_key_pad.push(k_bytes[i] ^ 92);
        i = i + 1;
    }

    i = 0;
    while i < data.len() {
        i_key_pad.push(data[i]);
        i = i + 1;
    }
    let inner_hash = sha1_bytes(i_key_pad);

    i = 0;
    while i < inner_hash.len() {
        o_key_pad.push(inner_hash[i]);
        i = i + 1;
    }
    return sha1_bytes(o_key_pad);
}

pub fn hmac_sha1(key: String, message: String) -> String {
    mut k: List<i64> = List::new();
    let k_len = string_len(key);
    mut i: i64 = 0;
    while i < k_len {
        k.push(string_char_at(key, i));
        i = i + 1;
    }

    mut d: List<i64> = List::new();
    let d_len = string_len(message);
    i = 0;
    while i < d_len {
        d.push(string_char_at(message, i));
        i = i + 1;
    }

    let h = hmac_sha1_bytes(k, d);
    return bytes_to_hex(h);
}

pub fn crypto_int_to_string(n: i64) -> String {
    if n == 0 {
        return "0";
    }
    mut val = if n < 0 { 0 - n } else { n };
    mut s: String = "";
    while val > 0 {
        let digit = val % 10;
        if digit == 0 { s = "0" + s; }
        else if digit == 1 { s = "1" + s; }
        else if digit == 2 { s = "2" + s; }
        else if digit == 3 { s = "3" + s; }
        else if digit == 4 { s = "4" + s; }
        else if digit == 5 { s = "5" + s; }
        else if digit == 6 { s = "6" + s; }
        else if digit == 7 { s = "7" + s; }
        else if digit == 8 { s = "8" + s; }
        else if digit == 9 { s = "9" + s; }
        val = val / 10;
    }
    if n < 0 {
        s = "-" + s;
    }
    return s;
}

pub fn hotp_bytes(key: List<i64>, counter: i64, digits: i64) -> String {
    mut counter_bytes: List<i64> = List::new();
    mut i: i64 = 7;
    while i >= 0 {
        let b = (counter >> (i * 8)) & 255;
        counter_bytes.push(b);
        i = i - 1;
    }

    let hash = hmac_sha1_bytes(key, counter_bytes);
    let offset = hash[19] & 15;
    let b0 = hash[offset] & 127;
    let b1 = hash[offset + 1] & 255;
    let b2 = hash[offset + 2] & 255;
    let b3 = hash[offset + 3] & 255;
    let binary = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;

    mut modulo: i64 = 1;
    mut d: i64 = 0;
    while d < digits {
        modulo = modulo * 10;
        d = d + 1;
    }
    let token_val = binary % modulo;

    let s = crypto_int_to_string(token_val);
    let s_len = string_len(s);
    mut padded = "";
    mut p: i64 = s_len;
    while p < digits {
        padded = padded + "0";
        p = p + 1;
    }
    return padded + s;
}

pub fn hotp(key: String, counter: i64, digits: i64) -> String {
    mut k: List<i64> = List::new();
    let k_len = string_len(key);
    mut i: i64 = 0;
    while i < k_len {
        k.push(string_char_at(key, i));
        i = i + 1;
    }
    return hotp_bytes(k, counter, digits);
}

pub fn totp(key: String, time_seconds: i64, step_seconds: i64, digits: i64) -> String {
    mut step: i64 = step_seconds;
    if step <= 0 {
        step = 30;
    }
    let counter = time_seconds / step;
    return hotp(key, counter, digits);
}

pub fn totp_verify(key: String, code: String, time_seconds: i64, step_seconds: i64, window_steps: i64) -> bool {
    mut step: i64 = step_seconds;
    if step <= 0 {
        step = 30;
    }
    let current_counter = time_seconds / step;
    let digits = string_len(code);
    if digits == 0 {
        return false;
    }

    mut win: i64 = window_steps;
    if win < 0 {
        win = 0 - win;
    }
    mut offset: i64 = 0 - win;
    while offset <= win {
        let counter = current_counter + offset;
        if counter >= 0 {
            let expected = hotp(key, counter, digits);
            if expected == code {
                return true;
            }
        }
        offset = offset + 1;
    }
    return false;
}

pub fn pbkdf2_hmac_sha256(password: String, salt: String, iterations: i64, key_len: i64) -> List<i64> {
    mut pwd_bytes: List<i64> = List::new();
    let pwd_len = string_len(password);
    mut i: i64 = 0;
    while i < pwd_len {
        pwd_bytes.push(string_char_at(password, i));
        i = i + 1;
    }

    mut salt_bytes: List<i64> = List::new();
    let s_len = string_len(salt);
    i = 0;
    while i < s_len {
        salt_bytes.push(string_char_at(salt, i));
        i = i + 1;
    }

    mut derived: List<i64> = List::new();
    mut block_index: i64 = 1;

    while derived.len() < key_len {
        mut msg: List<i64> = List::new();
        i = 0;
        while i < salt_bytes.len() {
            msg.push(salt_bytes[i]);
            i = i + 1;
        }
        msg.push((block_index >> 24) & 255);
        msg.push((block_index >> 16) & 255);
        msg.push((block_index >> 8) & 255);
        msg.push(block_index & 255);

        mut u = hmac_sha256_bytes(pwd_bytes, msg);
        mut t: List<i64> = List::new();
        i = 0;
        while i < u.len() {
            t.push(u[i]);
            i = i + 1;
        }

        mut iter: i64 = 1;
        while iter < iterations {
            u = hmac_sha256_bytes(pwd_bytes, u);
            i = 0;
            while i < 32 {
                t[i] = t[i] ^ u[i];
                i = i + 1;
            }
            iter = iter + 1;
        }

        let needed = key_len - derived.len();
        mut take: i64 = 32;
        if needed < 32 {
            take = needed;
        }
        i = 0;
        while i < take {
            derived.push(t[i]);
            i = i + 1;
        }

        block_index = block_index + 1;
    }

    return derived;
}

pub fn pbkdf2_hmac_sha256_hex(password: String, salt: String, iterations: i64, key_len: i64) -> String {
    let derived = pbkdf2_hmac_sha256(password, salt, iterations, key_len);
    return bytes_to_hex(derived);
}

pub fn test_crypto_hmac_sha1_vectors() -> bool {
    // RFC 2202 Test Case 2
    let res2 = hmac_sha1("Jefe", "what do ya want for nothing?");
    if res2 != "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79" {
        return false;
    }

    // RFC 2202 Test Case 1: Key = 20 bytes of 0x0b, Data = "Hi There"
    mut key: List<i64> = List::new();
    mut i: i64 = 0;
    while i < 20 {
        key.push(11);
        i = i + 1;
    }
    mut data: List<i64> = List::new();
    let msg = "Hi There";
    i = 0;
    while i < string_len(msg) {
        data.push(string_char_at(msg, i));
        i = i + 1;
    }
    let res1_bytes = hmac_sha1_bytes(key, data);
    let res1 = bytes_to_hex(res1_bytes);
    if res1 != "b617318655057264e28bc0b6fb378c8ef146be00" {
        return false;
    }

    return true;
}

pub fn test_crypto_hotp_totp_vectors() -> bool {
    let secret = "12345678901234567890";
    if hotp(secret, 0, 6) != "755224" { return false; }
    if hotp(secret, 1, 6) != "287082" { return false; }
    if hotp(secret, 2, 6) != "359152" { return false; }
    if hotp(secret, 3, 6) != "969429" { return false; }
    if hotp(secret, 4, 6) != "338314" { return false; }
    if hotp(secret, 5, 6) != "254676" { return false; }
    if hotp(secret, 6, 6) != "287922" { return false; }
    if hotp(secret, 7, 6) != "162583" { return false; }
    if hotp(secret, 8, 6) != "399871" { return false; }
    if hotp(secret, 9, 6) != "520489" { return false; }

    if totp(secret, 59, 30, 6) != "287082" { return false; }
    if !totp_verify(secret, "287082", 59, 30, 1) { return false; }
    if !totp_verify(secret, "287082", 60, 30, 1) { return false; }
    if totp_verify(secret, "000000", 59, 30, 1) { return false; }

    return true;
}

pub fn test_crypto_pbkdf2_vectors() -> bool {
    let c1 = pbkdf2_hmac_sha256_hex("password", "salt", 1, 32);
    if c1 != "120fb6cffcf8b32c43e7225256c4f837a86548c92ccc35480805987cb70be17b" {
        return false;
    }
    let c2 = pbkdf2_hmac_sha256_hex("password", "salt", 2, 32);
    if c2 != "ae4d0c95af6b46d32d0adff928f06dd02a303f8ef3c251dfd6e2d85a95474c43" {
        return false;
    }
    return true;
}

// === RFC 7519 / RFC 7515 Pure IFA JSON Web Token (JWT) HS256 ===

pub fn jwt_hs256_sign(header_json: String, payload_json: String, secret: String) -> String {
    let hdr_b64 = base64url_encode_str(header_json);
    let pay_b64 = base64url_encode_str(payload_json);
    let signing_input = hdr_b64 + "." + pay_b64;

    mut key_bytes: List<i64> = List::new();
    let sec_len = string_len(secret);
    mut i: i64 = 0;
    while i < sec_len {
        key_bytes.push(string_char_at(secret, i));
        i = i + 1;
    }

    mut data_bytes: List<i64> = List::new();
    let data_len = string_len(signing_input);
    mut j: i64 = 0;
    while j < data_len {
        data_bytes.push(string_char_at(signing_input, j));
        j = j + 1;
    }

    let sig_bytes = hmac_sha256_bytes(key_bytes, data_bytes);
    let sig_b64 = base64url_encode_bytes(sig_bytes);
    return signing_input + "." + sig_b64;
}

pub fn jwt_hs256_verify(token: String, secret: String) -> bool {
    let t_len = string_len(token);
    mut dot1: i64 = -1;
    mut dot2: i64 = -1;
    mut i: i64 = 0;
    while i < t_len {
        if string_char_at(token, i) == 46 {
            if dot1 < 0 {
                dot1 = i;
            } else if dot2 < 0 {
                dot2 = i;
            }
        }
        i = i + 1;
    }

    if dot1 <= 0 || dot2 <= dot1 || dot2 >= t_len - 1 {
        return false;
    }

    let signing_input = string_substr(token, 0, dot2);
    let sig_part = string_substr(token, dot2 + 1, t_len - dot2 - 1);

    mut key_bytes: List<i64> = List::new();
    let sec_len = string_len(secret);
    mut k: i64 = 0;
    while k < sec_len {
        key_bytes.push(string_char_at(secret, k));
        k = k + 1;
    }

    mut data_bytes: List<i64> = List::new();
    let data_len = string_len(signing_input);
    mut m: i64 = 0;
    while m < data_len {
        data_bytes.push(string_char_at(signing_input, m));
        m = m + 1;
    }

    let expected_sig_bytes = hmac_sha256_bytes(key_bytes, data_bytes);
    let expected_sig_b64 = base64url_encode_bytes(expected_sig_bytes);

    return constant_time_eq(expected_sig_b64, sig_part);
}

pub fn test_crypto_jwt_hs256() -> bool {
    let hdr = "{\"alg\":\"HS256\",\"typ\":\"JWT\"}";
    let payload = "{\"sub\":\"ifa-admin-1\",\"role\":\"root\"}";
    let secret = "ifa-very-secure-system-secret-key-32b!";

    let token = jwt_hs256_sign(hdr, payload, secret);

    let ok = jwt_hs256_verify(token, secret);
    let wrong_secret = jwt_hs256_verify(token, "wrong-secret");
    let tampered = jwt_hs256_verify(token + "x", secret);

    return ok && !wrong_secret && !tampered;
}

pub fn test_crypto_all() -> bool {
    return test_crypto_fnv1a()
        && test_crypto_murmur3()
        && test_crypto_sha256_empty()
        && test_crypto_sha256_abc()
        && test_crypto_constant_time_eq()
        && test_crypto_hmac()
        && test_crypto_blake3_empty()
        && test_crypto_blake3_abc()
        && test_crypto_blake3_ifa()
        && test_crypto_blake3_tree()
        && test_crypto_sha1_vectors()
        && test_crypto_base64_and_websocket_key()
        && test_crypto_hmac_sha1_vectors()
        && test_crypto_hotp_totp_vectors()
        && test_crypto_pbkdf2_vectors()
        && test_crypto_jwt_hs256();
}

pub fn main() {
    let t1 = test_crypto_fnv1a();
    let t2 = test_crypto_murmur3();
    let t3 = test_crypto_sha256_empty();
    let t4 = test_crypto_sha256_abc();
    let t5 = test_crypto_constant_time_eq();
    let t6 = test_crypto_hmac();
    let t7 = test_crypto_blake3_empty();
    let t8 = test_crypto_blake3_abc();
    let t9 = test_crypto_blake3_ifa();
    let t10 = test_crypto_blake3_tree();
    let t11 = test_crypto_sha1_vectors();
    let t12 = test_crypto_base64_and_websocket_key();
    let t13 = test_crypto_hmac_sha1_vectors();
    let t14 = test_crypto_hotp_totp_vectors();
    let t15 = test_crypto_pbkdf2_vectors();
    let t16 = test_crypto_jwt_hs256();
    if t1 && t2 && t3 && t4 && t5 && t6 && t7 && t8 && t9 && t10 && t11 && t12 && t13 && t14 && t15 && t16 {
        println("std/crypto: ALL TESTS PASSED");
    } else {
        println("std/crypto: TESTS FAILED");
    }
}
