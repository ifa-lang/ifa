// Pure IFA Standard Library: File System and Path Abstractions (`std/fs.ifa`)
// Deterministic path manipulations, normalized tree walking abstractions, and I/O primitives.

pub fn path_is_separator(c: i64) -> bool {
    return c == 47 || c == 92; // '/' or '\\'
}

pub fn path_is_absolute(path: String) -> bool {
    let len = string_len(path);
    if len == 0 {
        return false;
    }
    let first = string_char_at(path, 0);
    return path_is_separator(first);
}

pub fn path_join(base: String, child: String) -> String {
    let base_len = string_len(base);
    let child_len = string_len(child);

    if base_len == 0 {
        return child;
    }
    if child_len == 0 {
        return base;
    }
    if path_is_absolute(child) {
        return child;
    }

    let last_base = string_char_at(base, base_len - 1);
    if path_is_separator(last_base) {
        return base + child;
    }
    return base + "/" + child;
}

pub fn path_basename(path: String) -> String {
    let len = string_len(path);
    if len == 0 {
        return "";
    }

    mut i: i64 = len - 1;
    while i >= 0 {
        let c = string_char_at(path, i);
        if path_is_separator(c) {
            return string_substr(path, i + 1, len - i - 1);
        }
        i = i - 1;
    }
    return path;
}

pub fn path_dirname(path: String) -> String {
    let len = string_len(path);
    if len == 0 {
        return ".";
    }

    mut i: i64 = len - 1;
    while i >= 0 {
        let c = string_char_at(path, i);
        if path_is_separator(c) {
            if i == 0 {
                return "/";
            }
            return string_substr(path, 0, i);
        }
        i = i - 1;
    }
    return ".";
}

pub fn path_extension(path: String) -> String {
    let base = path_basename(path);
    let len = string_len(base);
    if len <= 1 {
        return "";
    }

    mut i: i64 = len - 1;
    while i > 0 {
        let c = string_char_at(base, i);
        if c == 46 { // '.'
            return string_substr(base, i + 1, len - i - 1);
        }
        i = i - 1;
    }
    return "";
}

pub fn path_stem(path: String) -> String {
    let base = path_basename(path);
    let len = string_len(base);
    if len <= 1 {
        return base;
    }

    mut i: i64 = len - 1;
    while i > 0 {
        let c = string_char_at(base, i);
        if c == 46 { // '.'
            return string_substr(base, 0, i);
        }
        i = i - 1;
    }
    return base;
}

pub fn path_has_extension(path: String, ext: String) -> bool {
    let actual = path_extension(path);
    return actual == ext;
}

pub fn path_normalize(path: String) -> String {
    let len = string_len(path);
    if len == 0 {
        return "";
    }

    mut result: String = "";
    mut prev_sep: bool = false;
    mut i: i64 = 0;

    while i < len {
        let c = string_char_at(path, i);
        let is_sep = path_is_separator(c);

        if is_sep {
            if !prev_sep {
                result = result + "/";
                prev_sep = true;
            }
        } else {
            // Check for "/./" segment
            if c == 46 && prev_sep {
                let next_char = if i + 1 < len { string_char_at(path, i + 1) } else { 0 };
                if path_is_separator(next_char) || i + 1 == len {
                    i = i + 1; // skip '.'
                    continue;
                }
            }
            let ch_str = string_substr(path, i, 1);
            result = result + ch_str;
            prev_sep = false;
        }
        i = i + 1;
    }

    let r_len = string_len(result);
    if r_len > 1 {
        let last = string_char_at(result, r_len - 1);
        if path_is_separator(last) {
            return string_substr(result, 0, r_len - 1);
        }
    }
    return result;
}

// Low-Level Native System File Operations
pub fn fs_read_to_string(path: String) -> String {
    return read_to_string(path);
}

pub fn fs_write_string(path: String, content: String) -> bool {
    return write_string(path, content);
}

pub fn fs_exists(path: String) -> bool {
    return exists(path);
}

pub fn fs_file_size(path: String) -> i64 {
    return file_size(path);
}

pub fn fs_remove_file(path: String) -> bool {
    return remove_file(path);
}

pub fn fs_create_dir_all(path: String) -> bool {
    return create_dir_all(path);
}

pub fn fs_read_dir(path: String) -> List<String> {
    let raw = read_dir(path);
    mut res: List<String> = List::new();
    let len = string_len(raw);
    if len == 0 {
        return res;
    }
    mut start: i64 = 0;
    mut i: i64 = 0;
    while i < len {
        let c = string_char_at(raw, i);
        if c == 10 { // '\n'
            if i > start {
                let entry = string_substr(raw, start, i - start);
                res.push(entry);
            }
            start = i + 1;
        }
        i = i + 1;
    }
    if start < len {
        let entry = string_substr(raw, start, len - start);
        res.push(entry);
    }
    return res;
}

pub fn fs_is_dir(path: String) -> bool {
    return is_dir(path);
}

pub fn fs_copy_file(src: String, dst: String) -> bool {
    return copy_file(src, dst);
}

pub fn fs_append_string(path: String, content: String) -> bool {
    let existing = if fs_exists(path) { fs_read_to_string(path) } else { "" };
    return fs_write_string(path, existing + content);
}

pub fn fs_read_lines(path: String) -> List<String> {
    let raw = fs_read_to_string(path);
    mut res: List<String> = List::new();
    let len = string_len(raw);
    if len == 0 {
        return res;
    }
    mut start: i64 = 0;
    mut i: i64 = 0;
    while i < len {
        let c = string_char_at(raw, i);
        if c == 10 { // '\n'
            mut line_len = i - start;
            if line_len > 0 && string_char_at(raw, start + line_len - 1) == 13 { // '\r'
                line_len = line_len - 1;
            }
            let line = string_substr(raw, start, line_len);
            res.push(line);
            start = i + 1;
        }
        i = i + 1;
    }
    if start < len {
        mut line_len = len - start;
        if line_len > 0 && string_char_at(raw, start + line_len - 1) == 13 {
            line_len = line_len - 1;
        }
        let line = string_substr(raw, start, line_len);
        res.push(line);
    }
    return res;
}

pub fn fs_write_lines(path: String, lines: List<String>) -> bool {
    mut content: String = "";
    mut i: i64 = 0;
    while i < lines.len() {
        content = content + lines[i] + "\n";
        i = i + 1;
    }
    return fs_write_string(path, content);
}

pub fn path_with_extension(path: String, new_ext: String) -> String {
    let stem_str = path_stem(path);
    let dir_str = path_dirname(path);
    let file_with_ext = if new_ext == "" { stem_str } else { stem_str + "." + new_ext };
    if dir_str == "." {
        return file_with_ext;
    }
    return path_join(dir_str, file_with_ext);
}

pub fn path_relative(base: String, target: String) -> String {
    let norm_base = path_normalize(base);
    let norm_target = path_normalize(target);
    let base_len = string_len(norm_base);
    let target_len = string_len(norm_target);
    if base_len == 0 {
        return norm_target;
    }
    if norm_base == norm_target {
        return ".";
    }
    if target_len > base_len {
        let prefix = string_substr(norm_target, 0, base_len);
        if prefix == norm_base {
            let sep_char = string_char_at(norm_target, base_len);
            if path_is_separator(sep_char) {
                return string_substr(norm_target, base_len + 1, target_len - base_len - 1);
            }
        }
    }
    return norm_target;
}

pub fn fs_walk_dir(root: String) -> List<String> {
    mut results: List<String> = List::new();
    if !fs_exists(root) {
        return results;
    }
    mut queue: List<String> = List::new();
    queue.push(root);
    mut head: i64 = 0;
    while head < queue.len() {
        let current = queue[head];
        head = head + 1;
        if fs_is_dir(current) {
            let entries = fs_read_dir(current);
            mut i: i64 = 0;
            while i < entries.len() {
                let entry_name = entries[i];
                if entry_name != "." && entry_name != ".." {
                    let sub_path = path_join(current, entry_name);
                    results.push(sub_path);
                    if fs_is_dir(sub_path) {
                        queue.push(sub_path);
                    }
                }
                i = i + 1;
            }
        }
    }
    return results;
}

pub fn fs_walk_matching(root: String, extension: String) -> List<String> {
    let all = fs_walk_dir(root);
    mut filtered: List<String> = List::new();
    mut i: i64 = 0;
    while i < all.len() {
        let p = all[i];
        if path_has_extension(p, extension) {
            filtered.push(p);
        }
        i = i + 1;
    }
    return filtered;
}

// Automated Test Suites for std/fs
pub fn test_fs_path_join() -> bool {
    let j1 = path_join("compiler", "driver.ifa");
    let j2 = path_join("compiler/", "driver.ifa");
    let j3 = path_join("", "driver.ifa");
    let j4 = path_join("compiler", "/root/ifa");
    return j1 == "compiler/driver.ifa"
        && j2 == "compiler/driver.ifa"
        && j3 == "driver.ifa"
        && j4 == "/root/ifa";
}

pub fn test_fs_path_dirname() -> bool {
    let d1 = path_dirname("compiler/driver.ifa");
    let d2 = path_dirname("/root/ifa/std/fs.ifa");
    let d3 = path_dirname("driver.ifa");
    let d4 = path_dirname("/root");
    return d1 == "compiler"
        && d2 == "/root/ifa/std"
        && d3 == "."
        && d4 == "/";
}

pub fn test_fs_path_basename() -> bool {
    let b1 = path_basename("compiler/driver.ifa");
    let b2 = path_basename("/root/ifa/std/fs.ifa");
    let b3 = path_basename("driver.ifa");
    return b1 == "driver.ifa"
        && b2 == "fs.ifa"
        && b3 == "driver.ifa";
}

pub fn test_fs_path_extension() -> bool {
    let e1 = path_extension("driver.ifa");
    let e2 = path_extension("archive.tar.gz");
    let e3 = path_extension("Makefile");
    let e4 = path_extension(".gitignore");
    return e1 == "ifa"
        && e2 == "gz"
        && e3 == ""
        && e4 == "";
}

pub fn test_fs_path_stem() -> bool {
    let s1 = path_stem("driver.ifa");
    let s2 = path_stem("compiler/codegen_llvm.ifa");
    let s3 = path_stem("Makefile");
    return s1 == "driver"
        && s2 == "codegen_llvm"
        && s3 == "Makefile";
}

pub fn test_fs_path_normalize() -> bool {
    let n1 = path_normalize("compiler//driver.ifa");
    let n2 = path_normalize("compiler/./driver.ifa");
    let n3 = path_normalize("/root/ifa/std/");
    return n1 == "compiler/driver.ifa"
        && n2 == "compiler/driver.ifa"
        && n3 == "/root/ifa/std";
}

pub fn test_fs_path_is_absolute() -> bool {
    let a1 = path_is_absolute("/root/ifa");
    let a2 = path_is_absolute("compiler/driver.ifa");
    let a3 = path_is_absolute("");
    return a1 && !a2 && !a3;
}

pub fn test_fs_io_roundtrip() -> bool {
    let test_file = "/tmp/ifa_std_fs_test_roundtrip.txt";
    let payload = "Deterministic IFA File System Roundtrip Verification 2026\n";
    let w_ok = fs_write_string(test_file, payload);
    if !w_ok {
        return false;
    }
    let ex = fs_exists(test_file);
    if !ex {
        return false;
    }
    let sz = fs_file_size(test_file);
    if sz <= 0 {
        return false;
    }
    let read_back = fs_read_to_string(test_file);
    if read_back != payload {
        return false;
    }
    let r_ok = fs_remove_file(test_file);
    return r_ok;
}

pub fn test_fs_append_and_lines_io() -> bool {
    let test_file = "/tmp/ifa_std_fs_lines_test.txt";
    mut lines: List<String> = List::new();
    lines.push("alpha");
    lines.push("beta");
    lines.push("gamma");

    let w_ok = fs_write_lines(test_file, lines);
    if !w_ok {
        return false;
    }

    let append_ok = fs_append_string(test_file, "delta\n");
    if !append_ok {
        let _ = fs_remove_file(test_file);
        return false;
    }

    let read_lines = fs_read_lines(test_file);
    let _ = fs_remove_file(test_file);

    if read_lines.len() != 4 {
        return false;
    }
    return read_lines[0] == "alpha"
        && read_lines[1] == "beta"
        && read_lines[2] == "gamma"
        && read_lines[3] == "delta";
}

pub fn test_fs_copy_and_dir_inspection() -> bool {
    let src = "/tmp/ifa_std_fs_src.txt";
    let dst = "/tmp/ifa_std_fs_dst.txt";
    let _ = fs_write_string(src, "deterministic-copy-content");

    let c_ok = fs_copy_file(src, dst);
    if !c_ok {
        let _ = fs_remove_file(src);
        return false;
    }

    let dst_ex = fs_exists(dst);
    let is_dir_file = fs_is_dir(src);
    let is_dir_tmp = fs_is_dir("/tmp");

    let _ = fs_remove_file(src);
    let _ = fs_remove_file(dst);

    return dst_ex && !is_dir_file && is_dir_tmp;
}

pub fn test_fs_walk_and_filter() -> bool {
    let test_dir = "/tmp/ifa_walk_test_sandbox";
    let sub_dir = "/tmp/ifa_walk_test_sandbox/nested";
    let _ = fs_create_dir_all(sub_dir);

    let f1 = path_join(test_dir, "file_a.ifa");
    let f2 = path_join(test_dir, "file_b.txt");
    let f3 = path_join(sub_dir, "file_c.ifa");

    let _ = fs_write_string(f1, "module a;");
    let _ = fs_write_string(f2, "text");
    let _ = fs_write_string(f3, "module c;");

    let walked = fs_walk_dir(test_dir);
    let matching_ifa = fs_walk_matching(test_dir, "ifa");

    let _ = fs_remove_file(f1);
    let _ = fs_remove_file(f2);
    let _ = fs_remove_file(f3);

    return walked.len() >= 3 && matching_ifa.len() == 2;
}

pub fn test_fs_path_relative_and_extension() -> bool {
    let rel1 = path_relative("/root/ifa", "/root/ifa/std/fs.ifa");
    let rel2 = path_relative("/root/ifa", "/root/ifa");
    let ext1 = path_with_extension("driver.ifa", "o");
    let ext2 = path_with_extension("compiler/driver", "ll");

    return rel1 == "std/fs.ifa"
        && rel2 == "."
        && ext1 == "driver.o"
        && ext2 == "compiler/driver.ll";
}

pub fn test_fs_all() -> bool {
    let t1 = test_fs_path_join();
    let t2 = test_fs_path_dirname();
    let t3 = test_fs_path_basename();
    let t4 = test_fs_path_extension();
    let t5 = test_fs_path_stem();
    let t6 = test_fs_path_normalize();
    let t7 = test_fs_path_is_absolute();
    let t8 = test_fs_io_roundtrip();
    let t9 = test_fs_append_and_lines_io();
    let t10 = test_fs_copy_and_dir_inspection();
    let t11 = test_fs_walk_and_filter();
    let t12 = test_fs_path_relative_and_extension();
    return t1 && t2 && t3 && t4 && t5 && t6 && t7 && t8 && t9 && t10 && t11 && t12;
}

pub fn main() {
    if test_fs_all() {
        println("std/fs: ALL TESTS PASSED");
    } else {
        println("std/fs: TESTS FAILED");
    }
}
